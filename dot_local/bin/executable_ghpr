#!/usr/bin/env bash
# Which of my open PRs hold review threads waiting on me, and who asked.
# GraphQL because GitHub's search index carries no qualifier for review threads.
set -eu

ME="${GITHUB_LOGIN:-gnohj}"
json="$(gh api graphql -f query='
{ search(query:"is:pr is:open author:@me archived:false", type:ISSUE, first:30) {
    nodes { ... on PullRequest {
      number title url isDraft repository { nameWithOwner }
      reviewThreads(first:100) { nodes {
        isResolved isOutdated path
        comments(first:1) { nodes { author { login __typename } bodyText url } } } } } } } }')"

printf '%s' "$json" | jq -r --arg me "$ME" '
  [ .data.search.nodes[] | select(.isDraft | not)
    | { repo: .repository.nameWithOwner, number: .number, title: .title, url: .url,
        threads: [ .reviewThreads.nodes[]
                   | select(.isResolved == false and .isOutdated == false)
                   | select(.comments.nodes[0].author != null
                            and .comments.nodes[0].author.__typename != "Bot"
                            and .comments.nodes[0].author.login != $me)
                   | { who: .comments.nodes[0].author.login, path: .path,
                       link: .comments.nodes[0].url,
                       said: (.comments.nodes[0].bodyText | gsub("\\s+"; " ") | .[0:90]) } ] }
    | select(.threads | length > 0) ]
  | if length == 0 then "nothing waiting on you" else
      .[] | "\(.repo)#\(.number)  \(.threads|length) waiting\n  \(.title)\n  \(.url)/files\n" +
            ( [ .threads[] | "    @\(.who)  \(.path // "conversation")\n      \(.said)\n      \(.link)" ] | join("\n") ) + "\n"
    end'
