#  Zshell entry point
export ZDOTDIR=$HOME/.config/zshrc

# Some panes inherit no LANG; C locale miscounts 3-byte prompt glyphs. C.UTF-8 needs no locale-gen.
case "$OSTYPE" in
  darwin*) export LANG="${LANG:-en_US.UTF-8}" ;;
  *) export LANG="${LANG:-C.UTF-8}" ;;
esac

# PATH lives here, not .zshrc, so Rex/tmux/skhd `zsh -l -c` chains resolve ~/.local/bin; -U lets .zshrc re-prepend without duplicates.
typeset -U path PATH
# nix-profile (home-manager pkgs: lazygit, yazi) - needed by non-interactive chains, same reason as .local/bin below
export PATH="$HOME/.nix-profile/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
# mux/ helper dirs (not top-level `tmux`, that is a binary) for bare-name calls from Rex/tmux binds.
export PATH="$HOME/.local/bin/mux/tmux:$HOME/.local/bin/mux/shared:$PATH"
# Same deal for the mux/ and worktree/ folders, so bare `mux …` / `worktree …` plus worktree/'s worktree-list and wtsync resolve from these non-interactive chains too.
export PATH="$HOME/.local/bin/mux:$HOME/.local/bin/worktree:$PATH"
# mise only activates in .zshrc, so its shims are APPENDED for these chains' bare tool calls, keeping nix/system precedence.
export PATH="$PATH:$HOME/.local/share/mise/shims"
# nix-darwin's /etc/zshenv resets PATH in Rex panes, dropping the rex CLI dir Rex prepended; ahead of mux/ and its rex/ folder.
[[ -n "${REX_BIN_DIR:-}" && -d "$REX_BIN_DIR" ]] && (( ! ${path[(Ie)$REX_BIN_DIR]} )) && path=("$REX_BIN_DIR" $path)
# Linux runs Rex from rex.service, so a rex call while it is down must fail, not start a stray server; mirrors environment.d.
[[ "$OSTYPE" == linux* ]] && export REX_AUTOSTART=0

# Here, not .zshrc: non-interactive `zsh -l -c` chains never read .zshrc, so $EDITOR would be unset and scrollback falls back to plain vi.
export EDITOR="nvim"
export VISUAL="nvim"

# Same reason: ~/.zsh_gnohj_env sets these from .zshrc, so non-interactive chains fell back to ~/Library/Application Support.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# Only Rex.app or rex.service start Rex; a shell-started server uses XDG state and loses Tailscale.
export REX_AUTOSTART=false

# Here, not .zshrc: worktree pickers and hooks run `zoxide add` outside .zshrc and would ignore the excludes.
export _ZO_DATA_DIR="$ZDOTDIR"
export _ZO_EXCLUDE_DIRS="$HOME/.git:*/.git:*/.git/*:$HOME/.claude:$HOME/.claude/*:*/.claude:*/.claude/*:$HOME/.local/share/chezmoi:$HOME/.local/share/chezmoi/*:$HOME/.treehouse/chezmoi-*"

# tuxedo/todo.txt-cli paths. Here, not .zshrc: the Reminders bridge runs from launchd, which never reads .zshrc.
export TODO_DIR="$XDG_DATA_HOME/tasks"
export TODO_FILE="$TODO_DIR/todo.txt"
export DONE_FILE="$TODO_DIR/done.txt"
# Where uncontexted tasks land; a task with a context naming another list (@areas, @groceries) goes there instead.
export TASKS_REMINDERS_LIST="Projects (Personal)"
# Reminders made in Apple apps are captured from every list except these.
export TASKS_CAPTURE_SKIP="Groceries"
# Events from these calendars, and recurring reminders, are captured into the inbox once they fall within TASKS_EVENT_DAYS.
export TASKS_EVENT_CALENDARS="gnohj,Calendar,hongsautoinc@gmail.com,jdms8911"
export TASKS_EVENT_DAYS=14

# Trees mise trusts without prompting (repos, review worktrees, chezmoi, no-mistakes runs, Infinitary); an env var because config.toml warns inside chezmoi.
export MISE_TRUSTED_CONFIG_PATHS="$HOME/Developer:$HOME/.treehouse:$HOME/.local/share/chezmoi:$HOME/.no-mistakes:$HOME/.config/infinitary/work"

# Headless xdg-open is a no-op, so urls route to the attached workstation. Here not .zshrc: non-interactive chains skip it.
export BROWSER="desktop-open"
# Read before BROWSER by cli/go-gh, so gh-dash and gh CLI reach the wrapper without touching xdg-open.
export GH_BROWSER="desktop-open"

# Read-only status/diff refreshes skip index.lock, so prompts, gitsigns, lazygit and agents stop colliding in the web monorepo.
export GIT_OPTIONAL_LOCKS=0

# A fake Wayland display so tools that copy through `wl-copy` reach the desktop clipboard via the `~/.local/bin/wl-copy` shim and `to-desktop clip`.
{{- if ne .chezmoi.os "darwin" }}
if [[ -o interactive ]]; then
  export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-to-desktop-shim}"
fi

# Lavish reads its allowlist once at server start and outlives its starter, so every shell sets it; cached because `tailscale status` is too slow per-shell.
export LAVISH_AXI_ALLOWED_HOSTS="${LAVISH_AXI_ALLOWED_HOSTS:-$(cat "$HOME/.cache/tailnet-host" 2>/dev/null)}"

# Omarchy exports OMARCHY_PATH only to bash and the Hyprland session; `omarchy update` dies under set -u without it.
if [[ -z "$OMARCHY_PATH" && -r /usr/share/omarchy/default/bash/env-bootstrap ]]; then
  emulate sh -c '. /usr/share/omarchy/default/bash/env-bootstrap'
fi
{{- end }}
