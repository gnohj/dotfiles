#!/usr/bin/env bash
# Show firstmate's closing status block as a rexpad list in a Todo pane beside the firstmate Rex pane.
set -euo pipefail

LIST=firstmate
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/rexpad
VIEWER_FILE=$STATE_DIR/$LIST.viewer
RAW_FILE=$STATE_DIR/$LIST.status
TASKS_FILE=$STATE_DIR/$LIST.tasks
ANCHOR_FILE=$STATE_DIR/$LIST.anchor
NUDGE_FILE=$STATE_DIR/$LIST.nudged
REXPAD=rexpad
RATIO=20
TABS_DIR=$STATE_DIR/$LIST.tabs
HUNK_DIR=$STATE_DIR/hunk
TAB_NAMES="work tickets outputs"
TABS="Inbox=$LIST,Work=$LIST.work,Tickets=$LIST.tickets,Outputs=$LIST.outputs"

LIBRARY=$HOME/.local/state/lavish-library

lavish_index() {
  local base
  base=$(cat "$LIBRARY/public-url" 2>/dev/null) || return 0
  [ -n "$base" ] && [ -f "$LIBRARY/catalog.json" ] || return 0
  jq -r --arg base "$base" '.artifacts | sort_by(.updated)[] | select(.exists) | .id as $id | "\($base)/open/\($id | @uri)" as $url | .title | if test("[A-Z][A-Z]+-[0-9][0-9]+") then scan("[A-Z][A-Z]+-[0-9][0-9]+") | "\(.)\t\($url)" elif length >= 10 then "title:\(ascii_downcase)\t\($url)" else empty end' "$LIBRARY/catalog.json" 2>/dev/null || true
}

# Piped to sh -s on every host, including over ssh, so it must stay POSIX sh.
task_list_script() {
  cat <<'SH'
for f in "$HOME"/.local/share/firstmate*/state/*.meta; do
  [ -f "$f" ] || continue
  kind=$(sed -n 's/^kind=//p' "$f")
  case $kind in ship|scout|secondmate) ;; *) continue ;; esac
  home=$(basename "$(dirname "$(dirname "$f")")")
  home=${home#firstmate}; home=${home#-}
  case $home in sm-*) ;; *) home=fm ;; esac
  srv=$(sed -n 's/^rex_server=//p' "$f"); ses=$(sed -n 's/^rex_session_id=//p' "$f"); win=$(sed -n 's/^rex_window_id=//p' "$f")
  tab=""
  if [ -n "$srv" ] && [ -n "$ses" ] && [ -n "$win" ] && command -v rex >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    tab=$(rex --autostart=false --timeout 2s -S "$srv" window ls -s "$ses" --json 2>/dev/null | jq -r --arg w "$win" '.windows[]? | select(.window_id == $w) | .label' | sed -n 's/^\([0-9][0-9]*\)\. .*/\1/p')
  fi
  wt=$(sed -n 's/^worktree=//p' "$f"); dirty=""; unpushed=""; branch=""
  if [ -n "$wt" ] && [ -e "$wt/.git" ]; then
    dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    unpushed=$(git -C "$wt" rev-list --count HEAD --not --remotes 2>/dev/null)
    branch=$(git -C "$wt" branch --show-current 2>/dev/null)
  else
    wt=""
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(basename "$f" .meta)" "$kind" "$(sed -n 's/^pr=//p' "$f")" "$home" "$tab" "$(sed -n 's/^model=//p' "$f")" "$(sed -n 's/^effort=//p' "$f")" "$srv" "$ses" "$(sed -n 's/^rex_block_id=//p' "$f")" "$wt" "$dirty" "$unpushed" "$branch"
done
SH
}

task_kinds() {
  local h
  {
    task_list_script | sh -s
    for h in $(cat "$HOME"/.local/share/firstmate*/state/*.meta 2>/dev/null | sed -n 's/^remote_host=//p' | sort -u); do
      task_list_script | ssh -o ConnectTimeout=2 -o BatchMode=yes "$h" sh -s 2>/dev/null | awk -v h="$h" '{ print $0 "\t" h }' || true
    done
  } | awk -F'\t' '
  function model_effort(model, effort,   n, p, i, name, all, ver) {
    sub(/.*\//, "", model)
    n = split(model, p, "-")
    for (i = 1; i <= n; i++) {
      if (p[i] == "") continue
      if (p[i] ~ /^[0-9]/) { if (length(p[i]) < 8) ver = ver (ver == "" ? "" : ".") p[i]; continue }
      all = all p[i]
      if (tolower(p[i]) != "claude" && tolower(p[i]) != "gpt") name = name p[i]
    }
    model = (name != "" ? name : all) ver
    effort = tolower(effort)
    if (model == "" || effort == "" || effort == "off" || effort == "none" || effort == "default") return model
    if (effort == "minimal") effort = "min"
    else if (effort == "medium") effort = "med"
    else if (effort == "high") effort = "hi"
    else if (effort == "xhigh") effort = "xhi"
    return model "/" effort
  }
  $2 == "secondmate" { print "mate:" $1 "\t" model_effort($6, $7); next }
  {
    me = model_effort($6, $7)
    pane = "\t" $8 "\t" $9 "\t" $10 "\t" $15 "\t" $11 "\t" $12 "\t" $13 "\t" $14
    slug = $1; tail = "\t" $2 "\t"
    if (match(toupper($1), /[A-Z][A-Z]+-[0-9][0-9]+/)) {
      key = substr(toupper($1), RSTART, RLENGTH)
      slug = substr($1, 1, RSTART - 1) "-" substr($1, RSTART + RLENGTH)
      gsub(/-+/, "-", slug); gsub(/^-|-$/, "", slug)
      print key tail slug "\t" $4 "\t" $5 "\t" me pane
    } else print "task:" $1 tail slug "\t" $4 "\t" $5 "\t" me pane
    if (match($3, /github\.com\/[^\/]+\/[^\/]+\/pull\/[0-9]+/)) { u = substr($3, RSTART + 11, RLENGTH - 11); sub(/\/pull\//, "#", u); print u tail slug "\t" $4 "\t" $5 "\t" me pane }
  }'
}

# A remote host that can't be reached would drop its tasks from a rebuilt list, so a rebuild waits for all of them.
remotes_reachable() {
  local h
  for h in $(cat "$HOME"/.local/share/firstmate*/state/*.meta 2>/dev/null | sed -n 's/^remote_host=//p' | sort -u); do
    ssh -o ConnectTimeout=2 -o BatchMode=yes "$h" true </dev/null >/dev/null 2>&1 || return 1
  done
}

fm_mate_row() {
  local v="" sid
  v=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/fm/primary-model-effort" 2>/dev/null) || true
  if [ -z "$v" ] && command -v rex >/dev/null 2>&1; then
    sid=$(rex --autostart=false ls --json 2>/dev/null | jq -r '.sessions[] | select(.label | test("(^| )fm$")) | .session_id' | head -1)
    [ -n "$sid" ] && v=$(rex --autostart=false window ls -s "$sid" --json 2>/dev/null | jq -r '.windows[].label' | sed -n 's/^.*🚢 fm · //p' | head -1)
  fi
  [ -n "$v" ] && printf 'mate:fm\t%s\n' "$v"
  return 0
}

# The Rex host label for an ssh host, matched by hostname against the stored endpoints.
rex_host_label() {
  local hostname
  hostname=$(ssh -G "$1" 2>/dev/null | awk '/^hostname /{print $2}')
  [ -n "$hostname" ] || return 1
  rex --autostart=false hosts --json 2>/dev/null | jq -r --arg h "${hostname%%.*}" '.hosts[].host | select(.endpoints[] | test("^https?://" + $h + "[.:/]")) | .label' | head -1 | grep .
}

pane_state() {
  rex --autostart=false --timeout 3s ${1:+-S "$1"} block call -s "$2" -b "$3" program_status 2>/dev/null | jq -r '(first(.records[]? | select(.id == null)) // .records[0] // {}) | [.state // "", .kind // ""] | @tsv'
}

mate_states() {
  local sid block f name host target label
  read -r sid block <<<"$(REX_BLOCK= fm_pane)"
  [ -n "${block:-}" ] && printf 'state:fm\t%s\n' "$(pane_state "" "$sid" "$block")"
  for f in "$HOME"/.local/share/firstmate/state/sm-*.meta; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .meta)
    host=$(sed -n 's/^remote_host=//p' "$f")
    target=$(sed -n 's/^remote_target=//p' "$f")
    [ -n "$host" ] && [ -n "$target" ] || continue
    label=$(rex_host_label "$host") || continue
    printf 'state:%s\t%s\n' "$name" "$(pane_state "$label" "${target%%:*}" "${target#*:}")"
  done
  crew_states "$1"
  return 0
}

# Task rows carry srv ses block host in columns 7-10.
crew_states() {
  local host label srv ses block
  for host in $(printf '%s\n' "$1" | awk -F'\t' '$9 != "" { print ($10 == "" ? "-" : $10) }' | sort -u); do
    label=""
    if [ "$host" != - ]; then label=$(rex_host_label "$host") || continue; fi
    printf '%s\n' "$1" | awk -F'\t' -v h="$host" '$9 != "" && ($10 == "" ? "-" : $10) == h && !seen[$9]++ { print $7 "\t" $8 "\t" $9 }' | {
      while IFS=$'\t' read -r srv ses block; do
        printf 'state:%s\t%s\n' "$block" "$(pane_state "${label:-$srv}" "$ses" "$block")" &
      done
      wait
    }
  done
  return 0
}

# Lines like "🟡 3. **web** - text"; "> " lines become details. fm-todo-board does the layout.
to_checklist() {
  LAVISH=$(lavish_index) TASKS=${TASKS:-$(task_kinds; fm_mate_row)} FM_TODO_STAMPS="$STATE_DIR/$LIST.stamps.json" "$HOME/.local/bin/fm-todo-board" --tabs-dir "$TABS_DIR"
}

set_tabs() {
  local t
  for t in $TAB_NAMES; do
    [ -f "$TABS_DIR/$t.md" ] && "$REXPAD" --list "$LIST.$t" set <"$TABS_DIR/$t.md" >/dev/null
  done
  return 0
}

viewer_block() {
  local sid id
  read -r sid id 2>/dev/null <"$VIEWER_FILE" || return 1
  [ -n "$id" ] && rex block inspect -s "$sid" "$id" >/dev/null 2>&1
}

# Rex restores the Todo pane after a server restart as a bare shell, so the block alone doesn't mean rexpad is running.
viewer_open() {
  local sid id
  viewer_block || return 1
  read -r sid id <"$VIEWER_FILE"
  [ "$(rex block call -s "$sid" -b "$id" process 2>/dev/null | jq -r '.child.name // empty')" = rexpad ]
}

status() {
  local raw list
  raw=$(cat)
  mkdir -p "$STATE_DIR"
  TASKS=$(task_kinds; fm_mate_row)
  printf '%s\n' "$TASKS" >"$TASKS_FILE"
  list=$(printf '%s\n' "$raw" | TASKS="$TASKS"$'\n'"$(mate_states "$TASKS")" to_checklist)
  [ -n "$list" ] || { echo "fm-todo: no status lines on stdin" >&2; exit 2; }
  printf '%s\n' "$raw" >"$RAW_FILE"
  viewer_open || exit 3
  printf '%s\n' "$list" | "$REXPAD" --list "$LIST" set >/dev/null
  set_tabs
}

# Redraws from firstmate's last block, its saved tasks and the Library's current files; launchd runs it each minute.
# Asks an idle firstmate to repost the board when its last status is 4h old: weekdays 9-19, at most once per 4h.
nudge_status() {
  local sid block
  [ "$(date +%u)" -le 5 ] && [ "$(date +%H)" -ge 9 ] && [ "$(date +%H)" -lt 19 ] || return 0
  [ -n "$(find "$RAW_FILE" -mmin -240 2>/dev/null)" ] && return 0
  [ -n "$(find "$NUDGE_FILE" -mmin -240 2>/dev/null)" ] && return 0
  read -r sid block 2>/dev/null <"$ANCHOR_FILE" || true
  [ -n "${block:-}" ] || read -r sid block <<<"$(REX_BLOCK= fm_pane)"
  [ -n "${block:-}" ] || return 0
  case "$(pane_state "" "$sid" "$block" | cut -f1)" in idle | done) ;; *) return 0 ;; esac
  touch "$NUDGE_FILE"
  send "Captain: the Todo pane's status is over 4 hours old. Repost the board, nothing else." >/dev/null 2>&1 || true
}

refresh() {
  hunk_refresh
  pr_lease_sweep
  viewer_open || return 0
  local list tasks
  # Worktree change counts and new tasks come from task_kinds; rerun it when firstmate hasn't posted a status for 5 minutes.
  if [ -z "$(find "$TASKS_FILE" -mmin -5 2>/dev/null)" ] && remotes_reachable; then
    tasks=$(task_kinds; fm_mate_row)
    [ -n "$tasks" ] && printf '%s\n' "$tasks" >"$TASKS_FILE"
  fi
  tasks=$(cat "$TASKS_FILE" 2>/dev/null) || tasks=$(fm_mate_row)
  list=$( { cat "$RAW_FILE" 2>/dev/null || true; } | TASKS="$tasks"$'\n'"$(mate_states "$tasks")" to_checklist)
  [ -n "$list" ] && printf '%s\n' "$list" | "$REXPAD" --list "$LIST" set >/dev/null
  set_tabs
  nudge_status
}

fm_pane() {
  local sid
  sid=$(rex ls --json | jq -r '.sessions[] | select(.label | test("(^| )fm$")) | .session_id' | head -1)
  [ -n "$sid" ] || return 0
  if [ "${REX_SESSION:-}" = "$sid" ] && [ -n "${REX_BLOCK:-}" ]; then
    echo "$sid $REX_BLOCK"
    return
  fi
  echo "$sid $(rex session inspect "$sid" --json | jq -r '.windows[0].layers[0].blocks[0].block_id')"
}

# Rex sometimes rebalances a fresh split to 50/50 after it opens, so hold the ratio and keep focus on the anchor for its first seconds.
hold_ratio() {
  local sid=$1 anchor=$2 id=$3 want ratio t view
  want=$(awk -v r="$RATIO" 'BEGIN { printf "%.2f", 1 - r / 100 }')
  for t in 0.3 0.7 1 1; do
    sleep "$t"
    view=$(rex session inspect "$sid" --json 2>/dev/null) || return 0
    [ "$(jq -r --arg id "$id" 'first(.windows[] | select(any(.layers[].blocks[]; .block_id == $id)) | .focused_block_id) // empty' <<<"$view")" = "$id" ] && { rex focus -s "$sid" "$anchor" >/dev/null 2>&1 || true; }
    ratio=$(jq -r --arg id "$id" '[.. | objects | select(.split?) | .split | select(.after.block_id == $id) | .ratio][0] // empty' <<<"$view")
    [ -n "$ratio" ] || return 0
    awk -v a="$ratio" -v b="$want" 'BEGIN { exit (a - b < 0.02 && b - a < 0.02) }' || continue
    rex api call session.resize_pane "$(jq -cn --arg s "$sid" --arg b "$anchor" --arg a "$id" --argjson r "$want" '{session_id: $s, before_block_id: $b, after_block_id: $a, direction: "horizontal", ratio: $r}')" >/dev/null 2>&1 || true
  done
}

show() {
  local sid=${1%% *} anchor=${1#* } id
  if viewer_open; then cat "$VIEWER_FILE"; return; fi
  hide
  if [ -z "$anchor" ] || [ "$anchor" = "$1" ]; then read -r sid anchor <<<"$(fm_pane)"; fi
  [ -n "$anchor" ] || { echo "fm-todo: no firstmate Rex pane found; pass -b SESSION BLOCK" >&2; exit 1; }
  local opener=$HOME/.local/bin/fm-todo-open
  id=$(rex split -s "$sid" -b "$anchor" --focus=false --split right --ratio "$RATIO" --shell=none --label Firstmate -- env REXPAD_OPEN="$opener" "$(command -v "$REXPAD")" --list "$LIST" view --top --tabs "$TABS" | awk 'END { print $NF }')
  mkdir -p "$STATE_DIR"
  echo "$sid $id" >"$VIEWER_FILE"
  echo "$sid $anchor" >"$ANCHOR_FILE"
  hold_ratio "$sid" "$anchor" "$id" </dev/null >/dev/null 2>&1 &
  echo "$sid $id"
}

hide() {
  local sid id
  if viewer_block; then
    read -r sid id <"$VIEWER_FILE"
    rex block close -s "$sid" "$id" >/dev/null 2>&1 || true
  fi
  rm -f "$VIEWER_FILE"
}

# The pane is a shell under the agent; typed at a bare prompt, backticks in the text would run.
agent_in() {
  rex --autostart=false --timeout 3s block call -s "$1" -b "$2" process 2>/dev/null |
    jq -e '.foreground // empty | (.argv0 // .name // "") | sub(".*/"; "") | test("^(claude|codex|pi|opencode)$")' >/dev/null 2>&1
}

send() {
  local text=$1 sid block
  read -r sid block 2>/dev/null <"$ANCHOR_FILE" || true
  if [ -z "${block:-}" ] || ! rex block inspect -s "$sid" "$block" >/dev/null 2>&1; then
    read -r sid block <<<"$(REX_BLOCK= fm_pane)"
  fi
  [ -n "$block" ] || { echo "fm-todo: no firstmate Rex pane found" >&2; exit 1; }
  agent_in "$sid" "$block" || { echo "fm-todo: firstmate is not running in its pane, so nothing was sent" >&2; exit 1; }
  rex send -s "$sid" -b "$block" "$text"
  rex send -s "$sid" -b "$block" $'\r'
}

pr_diff() {
  local repo=$1 number=$2 key=${3:-} sid label window client
  case "$number" in '' | *[!0-9]*) echo "fm-todo: PR must be numeric" >&2; exit 2 ;; esac
  [[ "$repo" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || { echo "fm-todo: invalid repository" >&2; exit 2; }
  read -r sid _ <<<"$(REX_BLOCK= fm_pane)"
  [ -n "$sid" ] || { echo "fm-todo: no firstmate Rex session found" >&2; exit 1; }
  label="🔍 #$number${key:+ · $key}"
  window=$(window_by_label "$sid" "$label")
  if [ -z "$window" ]; then
    window=$(rex window new -s "$sid" "$label" --json -- "$HOME/.local/bin/fm-todo" hunk-pr "$repo" "$number" "$key" | jq -r '.window_id // empty')
  fi
  [ -n "$window" ] || { echo "fm-todo: could not open the diff tab" >&2; exit 1; }
  show_window "$sid" "$window"
}

# Server-side focus never moves the app's selected tab, so ask the app to show it; HOST is a Rex host label for a remote session.
show_window() {
  local sid=$1 window=$2 host=${3:-} client
  client=$(rex --autostart=false ${host:+-S "$host"} client ls --json 2>/dev/null | jq -r '[.clients[]? | select(.info.kind == "app" and .info.platform != "ios" and .connection_state == "connected")] | max_by(.connected_at).client_id // empty')
  if [ -n "$client" ]; then
    rex --autostart=false ${host:+-S "$host"} -C "$client" do session.select "session_id=$sid" "window_id=$window" >/dev/null
  else
    rex --autostart=false ${host:+-S "$host"} window focus -s "$sid" "$window" >/dev/null
  fi
}

window_by_label() {
  rex --autostart=false ${3:+-S "$3"} window ls -s "$1" --json | jq -r --arg l "$2" '.windows[] | select((.label | sub("^[0-9]+\\. "; "")) == $l) | .window_id' | head -1
}

# The board's Pane, Edit and Diff buttons: a firstmate task's agent pane, or nvim or Hunk in its worktree, as a tab in the task's own session.
task_open() {
  local what=$1 key=$2 row slug ses block host wt label="" window name cmd
  # Tab is whitespace to read, so empty columns would collapse; split on a unit separator instead.
  row=$(awk -F'\t' -v k="$key" '$1 == k { print $3 "\037" $8 "\037" $9 "\037" $10 "\037" $11; exit }' "$TASKS_FILE" 2>/dev/null)
  [ -n "$row" ] || { echo "fm-todo: $key is not on the board" >&2; exit 1; }
  IFS=$'\037' read -r slug ses block host wt <<<"$row"
  if [ -n "$host" ]; then label=$(rex_host_label "$host") || { echo "fm-todo: no Rex host for $host" >&2; exit 1; }; fi
  [ -n "$ses" ] || read -r ses _ <<<"$(REX_BLOCK= fm_pane)"
  [ -n "$ses" ] || { echo "fm-todo: no Rex session for $slug" >&2; exit 1; }
  if [ "$what" = pane ]; then
    [ -n "$block" ] || { echo "fm-todo: $slug has no Rex pane" >&2; exit 1; }
    window=$(rex --autostart=false ${label:+-S "$label"} session inspect "$ses" --json | jq -r --arg b "$block" 'first(.windows[] | select(any(.layers[].blocks[]; .block_id == $b)) | .window_id) // empty')
    [ -n "$window" ] || { echo "fm-todo: the pane of $slug is gone" >&2; exit 1; }
    rex --autostart=false ${label:+-S "$label"} focus -s "$ses" "$block" >/dev/null 2>&1 || true
    show_window "$ses" "$window" "$label"
    return
  fi
  [ -n "$wt" ] || { echo "fm-todo: $slug has no worktree" >&2; exit 1; }
  if [ "$what" = edit ]; then
    name="📝 $slug" cmd='nvim .'
  else
    name="± $slug" cmd='b=$(git rev-list --topo-order HEAD --not --remotes | tail -1); exec hunk diff --watch "${b:+$b^}${b:-HEAD}"'
  fi
  window=$(window_by_label "$ses" "$name" "$label")
  if [ -z "$window" ]; then
    # -i loads .zshrc so nvim and hunk resolve through mise.
    window=$(rex --autostart=false ${label:+-S "$label"} window new -s "$ses" "$name" -c "$wt" --shell=none --json -- zsh -lic "$cmd" | jq -r '.window_id // empty')
  fi
  [ -n "$window" ] || { echo "fm-todo: could not open $name" >&2; exit 1; }
  show_window "$ses" "$window" "$label"
}

# nvim on a local file in a tab of the firstmate session, reused while it stays open.
open_file() {
  local file=$1 sid name window
  [ -f "$file" ] || { echo "fm-todo: no file $file" >&2; exit 1; }
  read -r sid _ <<<"$(REX_BLOCK= fm_pane)"
  [ -n "$sid" ] || { echo "fm-todo: no firstmate Rex session found" >&2; exit 1; }
  name="📝 $(basename "$file")"
  window=$(window_by_label "$sid" "$name")
  [ -n "$window" ] || window=$(rex window new -s "$sid" "$name" -c "$(dirname "$file")" --shell=none --json -- "${SHELL:-/bin/zsh}" -lic "$(printf '%q ' nvim "$file")" | jq -r '.window_id // empty')
  [ -n "$window" ] || { echo "fm-todo: could not open $name" >&2; exit 1; }
  show_window "$sid" "$window"
}

origin_is() {
  local url
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 1
  url=${url%.git}
  case "$url" in */"$2" | *:"$2") return 0 ;; esac
  return 1
}

repo_clone() {
  local dir
  for dir in "$HOME"/Developer/*/; do
    origin_is "$dir" "$1" && { printf '%s\n' "${dir%/}"; return 0; }
  done
  return 1
}

# A gh-dash review lease at SHA already has the PR's own dependencies installed.
review_lease() {
  local repo=$1 number=$2 sha=$3 wt
  while IFS= read -r wt; do
    [ -d "$wt" ] && [ "$(git -C "$wt" rev-parse HEAD 2>/dev/null)" = "$sha" ] && origin_is "$wt" "$repo" || continue
    printf '%s\n' "$wt"
    return 0
  done < <("$HOME/.config/gh-dash/review-worktree.sh" path "$number" 2>/dev/null)
  return 1
}

PR_OPEN_DIR=$STATE_DIR/pr-open

pr_leases() {
  local f
  for f in "$HOME"/.treehouse/*/treehouse-state.json; do
    [ -f "$f" ] && jq -r '.worktrees[]? | select(.leased and ((.lease_holder // "") | startswith("fm-open-"))) | "\(.lease_holder)\t\(.path)"' "$f" 2>/dev/null
  done
  return 0
}

pr_lease() {
  local clone=$1 holder=$2 sha=$3 wt pool=$1
  wt=$(pr_leases | awk -F'\t' -v h="$holder" '$1 == h { print $2; exit }')
  if [ -z "$wt" ] || [ ! -d "$wt" ]; then
    [ -d "$clone/review" ] && pool=$clone/review
    wt=$(cd "$pool" && TREEHOUSE_LEASE_HOLDER=$holder treehouse get --lease --lease-holder "$holder" 2>/dev/null) && [ -n "$wt" ] || return 1
  fi
  if [ "$(git -C "$wt" rev-parse HEAD)" != "$sha" ]; then
    git -C "$wt" checkout -q --detach "$sha" || return 1
    "$HOME/.config/treehouse/install-deps.sh" "$wt" >/dev/null 2>&1 || true
  fi
  touch "$wt"
  printf '%s\n' "$wt"
}

pr_nvim_sock() {
  printf '%s/.nvim-%s-%s-%s.sock\n' "$PR_OPEN_DIR" "$1" "$2" "$(printf '%s' "$3" | cksum | cut -d' ' -f1)"
}

# lsof can't see unix sockets on macOS, but each pr_open nvim carries its socket in argv.
pr_nvim_live() {
  case "$(ps -eo args=)" in *"--listen $PR_OPEN_DIR/.nvim-$1-$2-"*) return 0 ;; esac
  return 1
}

# Returns a lease once its Hunk and nvim tabs are closed, or after 3 idle days if Hunk crashed.
pr_lease_sweep() {
  local holder wt rest number repo sock
  pr_leases | while IFS=$'\t' read -r holder wt; do
    rest=${holder#fm-open-}
    rest=${rest%-*}
    number=${rest##*-}
    repo=${rest%-*}
    pr_nvim_live "$repo" "$number" && continue
    [ -n "$(find "$wt" -maxdepth 0 -mmin -2 2>/dev/null)" ] && continue
    if [ -f "$HUNK_DIR/$number.json" ] && [ "$(jq -r '.repo // empty' "$HUNK_DIR/$number.json" | sed 's|.*/||')" = "$repo" ] && [ -z "$(find "$wt" -maxdepth 0 -mtime +3 2>/dev/null)" ]; then
      continue
    fi
    # Detached from / since a return can hang and --force reaps processes by cwd.
    (cd / && treehouse return "$wt" --force --if-lease-holder "$holder") </dev/null >/dev/null 2>&1 &
  done
  for sock in "$PR_OPEN_DIR"/.nvim-*.sock; do
    [ -S "$sock" ] || continue
    case "$(ps -eo args=)" in *"--listen $sock"*) ;; *) rm -f "$sock" ;; esac
  done
  return 0
}

pr_open() {
  local repo=$1 number=$2 side=$3 line=$4 path=$5 key=${6:-} clone head base merge_base sha wt file sock sid label window nvim_cmd diff_base vim_file
  [[ "$repo" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ && "$number" =~ ^[0-9]+$ && "$line" =~ ^[0-9]+$ && "$side" =~ ^(old|new)$ ]] || { echo "fm-todo: invalid pr-open arguments" >&2; exit 2; }
  case "/$path/" in */../* | //*) echo "fm-todo: path escapes the repo: $path" >&2; exit 2 ;; esac
  clone=$(repo_clone "$repo") || { echo "fm-todo: no clone of $repo under ~/Developer" >&2; exit 1; }
  IFS=$'\t' read -r head base < <(jq -r '[.head // "", .base // ""] | @tsv' "$HUNK_DIR/$number.json" 2>/dev/null) || true
  [ -n "${head:-}" ] && [ -n "${base:-}" ] || IFS=$'\t' read -r head base < <(gh_keyring pr view "$number" --repo "$repo" --json headRefOid,baseRefOid -q '[.headRefOid, .baseRefOid] | @tsv')
  [ -n "${head:-}" ] && [ -n "${base:-}" ] || { echo "fm-todo: no commits for PR #$number" >&2; exit 1; }
  for sha in "$head" "$base"; do
    git -C "$clone" cat-file -e "$sha^{commit}" 2>/dev/null || git -C "$clone" fetch -q origin "$sha" "refs/pull/$number/head" || { echo "fm-todo: could not fetch $sha" >&2; exit 1; }
  done
  merge_base=$(git -C "$clone" merge-base "$base" "$head") || { echo "fm-todo: no merge base for PR #$number" >&2; exit 1; }
  if [ "$side" = old ]; then sha=$base; else sha=$head; fi
  if [ "$side" = old ] || ! wt=$(review_lease "$repo" "$number" "$sha"); then
    wt=$(pr_lease "$clone" "fm-open-${repo##*/}-$number-$([ "$side" = old ] && echo base || echo head)" "$sha") || { echo "fm-todo: no treehouse worktree for ${sha:0:7}" >&2; exit 1; }
  fi
  file=$wt/$path
  [ -f "$file" ] || { echo "fm-todo: $path is not in ${sha:0:7}" >&2; exit 1; }
  sid=${REX_SESSION:-}
  [ -n "$sid" ] || read -r sid _ <<<"$(REX_BLOCK= fm_pane)"
  label="📝 #$number${key:+ · $key}"
  mkdir -p "$PR_OPEN_DIR"
  sock=$(pr_nvim_sock "${repo##*/}" "$number" "$sid")
  window=$(window_by_label "$sid" "$label")
  diff_base="PrDiffBase $merge_base $wt"
  [ "$side" = old ] && diff_base=""
  if [ -n "$window" ] && [ -S "$sock" ] && nvim --server "$sock" --remote-expr 1 >/dev/null 2>&1; then
    # PR file names are untrusted, so double their quotes for the Vimscript string.
    vim_file=${file//\'/\'\'}
    nvim --server "$sock" --remote-expr "execute(['tabedit +$line ' .. fnameescape('$vim_file'), '$diff_base'])" >/dev/null
  else
    rm -f "$sock"
    # -i loads .zshrc for THEME_TRANSPARENT.
    nvim_cmd=$(printf '%q ' nvim --listen "$sock" -R "+$line" ${diff_base:+-c "$diff_base"} "$file")
    window=$(rex window new -s "$sid" "$label" -c "$wt" --shell=none --json -- env SKIP_FETCH=1 "${SHELL:-/bin/zsh}" -lic "$nvim_cmd" | jq -r '.window_id // empty')
  fi
  [ -n "$window" ] || { echo "fm-todo: could not open the nvim tab" >&2; exit 1; }
  show_window "$sid" "$window"
}

# The keyring gh login, never the scope-less GH_TOKEN from the environment.
gh_keyring() {
  GH_TOKEN=$(env -u GH_TOKEN -u GITHUB_TOKEN gh auth token 2>/dev/null) gh "$@"
}

# The Hunk review itself: the PR diff as a watched patch file, registered so hunk_refresh can rewrite it when the head moves.
hunk_pr() {
  local repo=$1 number=$2 key=${3:-} dir patch record head base
  mkdir -p "$HUNK_DIR"
  dir=$(mktemp -d "${TMPDIR:-/tmp}/fm-hunk-$number.XXXXXX")
  patch="$dir/${repo##*/}-pr-$number.diff"
  record="$HUNK_DIR/$number.json"
  gh_keyring pr diff "$number" --repo "$repo" >"$patch" || { echo "fm-todo: could not fetch PR #$number from $repo" >&2; rm -rf "$dir"; read -rsn1 -p "Press any key to close" || true; return 1; }
  IFS=$'\t' read -r head base < <(gh_keyring pr view "$number" --repo "$repo" --json headRefOid,baseRefOid -q '[.headRefOid, .baseRefOid] | @tsv' 2>/dev/null) || true
  jq -cn --arg repo "$repo" --arg number "$number" --arg head "${head:-}" --arg base "${base:-}" --arg patch "$patch" '{repo: $repo, number: $number, head: $head, base: $base, patch: $patch}' >"$record"
  trap "rm -f $(printf %q "$record"); rm -rf $(printf %q "$dir")" EXIT HUP INT TERM
  FM_HUNK_PR="$repo#$number" FM_HUNK_TICKET="$key" hunk patch "$patch" --watch
}

# Re-fetches the patch of every open Hunk tab whose PR head moved, read from the Library's pr-status.json.
hunk_refresh() {
  local record repo number head patch new
  for record in "$HUNK_DIR"/*.json; do
    [ -f "$record" ] || continue
    IFS=$'\t' read -r repo number head patch < <(jq -r '[.repo, .number, .head, .patch] | @tsv' "$record" 2>/dev/null) || continue
    [ -f "$patch" ] || { rm -f "$record"; continue; }
    new=$(jq -r --arg k "$repo#$number" '.items[$k].head // empty' "$LIBRARY/pr-status.json" 2>/dev/null)
    [ -n "$new" ] && [ "$new" != "$head" ] || continue
    gh_keyring pr diff "$number" --repo "$repo" >"$patch.new" 2>/dev/null && mv "$patch.new" "$patch" || { rm -f "$patch.new"; continue; }
    jq -c --arg head "$new" '.head = $head' "$record" >"$record.new" && mv "$record.new" "$record"
  done
  return 0
}

note_file() {
  printf '%s/notes/%s.progress' "$HUNK_DIR" "$(printf '%s' "$1" | tr '/#' '__')"
}

# Firstmate records each hop of a Hunk note batch; the fm-notes Hunk extension shows it.
note_stage() {
  local pr=$1 stage=$2 mate=${3:-} f
  f=$(note_file "$pr")
  mkdir -p "${f%/*}"
  jq -cn --arg s "$stage" --arg m "$mate" --argjson at "$(date +%s)" '{stage: $s, mate: $m, at: $at}' >"$f.new" && mv "$f.new" "$f"
}

# Prints mate, recorded stage and the crewmate pane's Rex state for a PR, tab separated.
note_progress() {
  local pr=$1 row home srv ses block host label="" stage="" state=""
  row=$(awk -F'\t' -v k="$pr" '$1 == k { print $4 "\037" $7 "\037" $8 "\037" $9 "\037" $10; exit }' "$TASKS_FILE" 2>/dev/null)
  IFS=$'\037' read -r home srv ses block host <<<"$row" || true
  stage=$(jq -r '.stage // empty' "$(note_file "$pr")" 2>/dev/null || true)
  if [ -n "${block:-}" ]; then
    [ -n "${host:-}" ] && { label=$(rex_host_label "$host") || label=""; }
    state=$(pane_state "${label:-$srv}" "$ses" "$block" | cut -f1)
  fi
  printf '%s\t%s\t%s\n' "${home:-}" "$stage" "$state"
}

cmd=${1:-show}
shift || true
[ "$cmd" = note-stage ] && { note_stage "${1:?usage: fm-todo note-stage OWNER/REPO#N STAGE [MATE]}" "${2?usage: fm-todo note-stage OWNER/REPO#N STAGE [MATE]}" "${3:-}"; exit; }
[ "$cmd" = note-progress ] && { note_progress "${1:?usage: fm-todo note-progress OWNER/REPO#N}"; exit; }
[ "$cmd" = send ] && { send "${1:?usage: fm-todo send TEXT}"; exit; }
[ "$cmd" = open-file ] && { open_file "${1:?usage: fm-todo open-file PATH}"; exit; }
case "$cmd" in pane | edit | wtdiff) task_open "$cmd" "${1:?usage: fm-todo $cmd TASK}"; exit ;; esac
[ "$cmd" = diff ] && { pr_diff "${1:?usage: fm-todo diff REPO NUMBER [TICKET]}" "${2:?usage: fm-todo diff REPO NUMBER [TICKET]}" "${3:-}"; exit; }
[ "$cmd" = pr-open ] && { pr_open "${1:?usage: fm-todo pr-open REPO NUMBER old|new LINE PATH [TICKET]}" "${2:?}" "${3:?}" "${4:?}" "${5:?}" "${6:-}"; exit; }
[ "$cmd" = hunk-pr ] &&{ hunk_pr "${1:?}" "${2:?}" "${3:-}"; exit; }
block=""
while [ $# -gt 0 ]; do
  case "$1" in
    -b) block="$2 $3"; shift 3 ;;
    *) echo "fm-todo: unknown argument $1" >&2; exit 2 ;;
  esac
done

case "$cmd" in
  show) show "$block" ;;
  hide) hide ;;
  status) status ;;
  refresh) refresh ;;
  print) "$REXPAD" --list "$LIST" get ;;
  *) echo "usage: fm-todo [show|hide|print|refresh|send TEXT|diff REPO NUMBER [TICKET]|pane|edit|wtdiff TASK] [-b SESSION BLOCK] | fm-todo status < block" >&2; exit 2 ;;
esac
