#!/usr/bin/env python3
# 🧠 when /i-have-adhd is active in this session, 🐴 when /ponytail is; the transcript is the only truthful source.
import json
import mmap
import sys
from pathlib import Path

ADHD_ON = (
    b'"name":"Skill","input":{"skill":"i-have-adhd"}',
    b'"content":"<command-message>i-have-adhd</command-message>',
)
PONY_ON = (b'"content":"<command-message>ponytail</command-message>',)
CONTENT = b'"content":"'


def last_of(data, patterns):
    return max(data.rfind(pattern) for pattern in patterns)


def last_structural_phrase(data, phrase):
    end = len(data)
    while True:
        position = data.rfind(phrase, 0, end)
        if position < 0:
            return -1
        start = data.rfind(CONTENT, max(0, position - len(CONTENT) - 40), position + 1)
        if start >= 0 and b'"' not in data[start + len(CONTENT) : position]:
            return position
        end = position


def main():
    try:
        transcript = Path(json.load(sys.stdin)["transcript_path"]).expanduser()
        handle = transcript.open("rb")
        if transcript.stat().st_size == 0:
            handle.close()
            return
    except (OSError, ValueError, TypeError, KeyError):
        return

    with handle, mmap.mmap(handle.fileno(), 0, access=mmap.ACCESS_READ) as data:
        normal_off = last_structural_phrase(data, b"normal mode")
        adhd = last_of(data, ADHD_ON) > max(
            normal_off, last_structural_phrase(data, b"stop adhd mode")
        )
        pony = last_of(data, PONY_ON) > max(
            normal_off, last_structural_phrase(data, b"stop ponytail")
        )

    output = ("🧠" if adhd else "") + ("🐴" if pony else "")
    if output:
        print(output)


if __name__ == "__main__":
    main()
