#!/usr/bin/env python3
"""Todo pane opener: fm-todo.invalid links act through the Lavish Library's own routes, other links open as work URLs."""
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from urllib.parse import quote

import fm_todo_ask
from fm_todo_action import ACT, act, parse

LIBRARY = os.path.expanduser("~/.local/state/lavish-library")
PORT = os.environ.get("LAVISH_LIBRARY_PORT", "4390")


def library(method, route, body=None, headers=None):
    with open(os.path.join(LIBRARY, "session-token")) as f:
        token = f.read().strip()
    request = urllib.request.Request(
        f"http://127.0.0.1:{PORT}{route}", method=method, data=json.dumps(body).encode() if body is not None else None,
        headers={"Host": f"localhost:{PORT}", "Origin": f"http://localhost:{PORT}", "Authorization": f"Bearer {token}",
                 "Content-Type": "application/json", **(headers or {})})
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return json.loads(response.read() or b"{}")
    except urllib.error.HTTPError as error:
        try:
            message = json.loads(error.read() or b"{}").get("error")
        except ValueError:
            message = None
        raise SystemExit(message or f"Library answered {error.code} for {route}")
    except urllib.error.URLError as error:
        raise SystemExit(f"Lavish Library is not reachable on port {PORT}: {error.reason}")


def menu(path, q):
    if path == "ask":
        chat_url = act("chat", title=q.get("title", ""), ref=q.get("ref", ""), qid=q["qid"])
        for label, url, star, tag in fm_todo_ask.menu_rows(q["qid"], q["fp"], chat_url):
            print("\t".join((label, url, star, tag)))
        return
    key, cur = q.get("key", ""), q.get("cur", "")
    rows = []
    if path == "jira/status":
        for t in library("GET", f"/api/jira/transitions?key={quote(key)}").get("transitions", []):
            name = t.get("to") or t.get("name")
            rows.append((name, act("jira/transition", key=key, id=t["id"]), name == cur))
    elif path == "jira/assign":
        result = library("GET", f"/api/jira/assignable?key={quote(key)}&query=")
        me = result.get("me") or {}
        users = ([me] if me else []) + [u for u in result.get("users", []) if u.get("account_id") != me.get("account_id")]
        for u in users:
            label = u["name"] + (" (you)" if u is me else "")
            rows.append((label, act("jira/assign-to", key=key, account=u["account_id"]), u["name"] == cur))
        rows.append(("Unassigned", act("jira/assign-to", key=key, account=""), cur == ""))
    elif path == "jira/version":
        for v in library("GET", f"/api/jira/versions?key={quote(key)}").get("versions", []):
            rows.append((v["name"], act("jira/set-version", key=key, id=v["id"]), v["name"] == cur))
        rows.append(("No version", act("jira/set-version", key=key, id=""), cur == ""))
    else:
        raise SystemExit(f"no menu for {path}")
    for label, url, current in rows:
        print(f"{label}\t{url}" + ("\t*" if current else ""))


def chat(q):
    args = json.dumps({"title": q.get("title", ""), "ref": q.get("ref", ""), "qid": q.get("qid", "")})
    session, block = os.environ.get("REX_SESSION", ""), os.environ.get("REX_BLOCK", "")
    where = ["-s", session, "-b", block] if session and block else []
    result = subprocess.run(["rex", "--autostart=false", "do", *where, "fm_chat", "--args", args], capture_output=True, text=True)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "could not open the chat popup")


def diff(q):
    result = subprocess.run([os.path.expanduser("~/.local/bin/fm-todo"), "diff", q["repo"], q["number"], q.get("key", "")],
                            capture_output=True, text=True)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or "could not open the PR diff")


def task(path, q):
    result = subprocess.run([os.path.expanduser("~/.local/bin/fm-todo"), path, q["key"]], capture_output=True, text=True)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"could not open {path} for {q['key']}")


INBOX = os.path.expanduser("~/.local/state/fm-inbox")
FM_INBOX = os.path.expanduser("~/.local/bin/fm-inbox")


def inbox(*args, background=False):
    if background:
        subprocess.Popen([FM_INBOX, *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return
    result = subprocess.run([FM_INBOX, *args], capture_output=True, text=True)
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"fm-inbox {args[0]} failed")


def slack_hand(link):
    with open(os.path.join(INBOX, "slack.json")) as f:
        item = next((x for x in json.load(f).get("items", []) if x.get("permalink") == link), None)
    if item is None:
        raise SystemExit("That Slack item is no longer on the board.")
    fm_todo_ask.send(f"Captain, Slack ask from {item['from']} in {item['channel']}: \"{item['text']}\" {link} - dispatch a scout to read "
                     "the thread, research it in the code, Jira and Slack, and draft a reply I can paste. Read only: post nothing in Slack.")
    inbox("slack-act", "hand", link)


def run(path, q):
    if path == "chat":
        return chat(q)
    if path == "diff":
        return diff(q)
    if path in ("pane", "edit", "wtdiff"):
        return task(path, q)
    if path == "answer":
        return fm_todo_ask.answer(q["qid"], q["fp"], q.get("letter", ""))
    if path == "start":
        library("POST", "/api/start-ticket", {"key": q["key"]})
    elif path == "merge":
        target = f"{q['repo']}#{q['number']}"
        nonce = library("POST", "/api/confirm", {"action": "pr-merge", "target": target})["confirmation"]
        library("POST", "/api/pr-merge", {"repo": q["repo"], "number": q["number"], "sha": q.get("sha", "")},
                {"X-Lavish-Confirmation": nonce})
    elif path == "review":
        library("POST", "/api/start-review", {"repo": q["repo"], "number": q["number"], "mode": "full"})
    elif path in ("fixci", "resolve"):
        library("POST", "/api/start-review", {"repo": q["repo"], "number": q["number"], "mode": path})
    elif path == "review-diff":
        library("POST", "/api/start-review", {"repo": q["repo"], "number": q["number"], "mode": "diff"})
    elif path == "slack/hand":
        return slack_hand(q["link"])
    elif path == "slack/act":
        inbox("slack-act", q["op"], q["link"])
    elif path == "slack/check":
        inbox("slack", "--force", background=True)
    elif path == "retire":
        fm_todo_ask.send(f"Captain: the Todo pane shows {q['home']} task {q['slug']} idle with a clean worktree and its work merged, "
                         "closed or no longer on your status. Retire it if nothing is unpushed and no open PR still needs it, "
                         "otherwise tell me what it is waiting on.")
    elif path == "reviews/copy":
        prs = [n.partition("#") for n in q["prs"].split(",") if "#" in n]
        text = "\n".join(["Can I please get reviews:", *(f"• https://github.com/{r}/pull/{n}" for r, _, n in prs)])
        subprocess.run(["pbcopy"] if sys.platform == "darwin" else ["wl-copy"], input=text, text=True, check=True)
    elif path == "standup/copy":
        return inbox("standup-copy")
    elif path == "standup/write":
        inbox("standup", "--force", background=True)
    elif path == "standup/edit":
        return task("open-file", {"key": os.path.join(INBOX, "standup.md")})
    elif path == "seen":
        fm_todo_ask.mark_seen(q["id"], q["fp"])
    elif path == "jira/transition":
        library("POST", "/api/jira/transition", {"key": q["key"], "id": q["id"]})
    elif path == "jira/assign-to":
        library("POST", "/api/jira/assign", {"key": q["key"], "account_id": q.get("account", "")})
    elif path == "jira/set-version":
        library("POST", "/api/jira/fix-version", {"key": q["key"], "id": q.get("id", "")})
    else:
        raise SystemExit(f"unknown action {path}")
    subprocess.Popen([os.path.expanduser("~/.local/bin/fm-todo"), "refresh"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def notify(message):
    print(message, file=sys.stderr)
    if sys.platform == "darwin":
        subprocess.run(["osascript", "-e", f"display notification {json.dumps(message)} with title \"Todo pane\""], check=False)
    elif shutil.which("notify-send"):
        subprocess.run(["notify-send", "Todo pane", message], check=False)


def open_url(url):
    opener = os.path.expanduser("~/.local/bin/open-work-url")
    if os.access(opener, os.X_OK):
        os.execv(opener, [opener, url])
    os.execvp("open" if sys.platform == "darwin" else "xdg-open", ["open" if sys.platform == "darwin" else "xdg-open", url])


def main(argv):
    as_menu = argv[:1] == ["--menu"]
    url = argv[1] if as_menu else (argv[0] if argv else "")
    if not url:
        raise SystemExit("usage: fm-todo-open [--menu] URL")
    if not url.startswith(ACT + "/"):
        return open_url(url)
    try:
        path, query = parse(url)
        return menu(path, query) if as_menu else run(path, query)
    except SystemExit as error:
        notify(str(error))
        raise
    except Exception as error:
        notify(f"{type(error).__name__}: {error}")
        raise SystemExit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
