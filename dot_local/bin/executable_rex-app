#!/bin/bash
# rex-app [--cli] - the installed Rex app bundle; --cli prints its server CLI.
app="/Applications/Rex.app"
[ -d "$app" ] || { echo "rex-app: no Rex app in /Applications" >&2; exit 1; }
if [ "${1:-}" = --cli ]; then
  printf '%s\n' "$app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex"
else
  printf '%s\n' "$app"
fi
