#!/usr/bin/env bash
# rex-update - install the Rex build the Mac app ships so the dev-box matches it; on the Mac it runs on the dev-box.
set -uo pipefail

if [ "$(uname)" = Darwin ]; then
  host="${UPDATE_VPS_HOST:-dev-box}"
  case "$host" in '' | -*) echo "rex-update: invalid host: $host" >&2; exit 2 ;; esac
  exec ssh -o BatchMode=yes -o ConnectTimeout=5 -o ClearAllForwardings=yes "$host" '"$HOME/.local/bin/rex-update" && "$HOME/.local/bin/rex-restart-idle"'
fi

appcast=https://blob.superlogical.com/public/rex-app/snapshot-arm64/appcast.xml
have=$(pacman -Q rex | awk '{ print $2 }')

# Rex.app reports only its Sparkle build, as `0.1.0-snapshot.<build>` (older apps `0.1.0 (<build>)`); the appcast maps it to a Rex version.
builds=$(rex --autostart=false client ls --json </dev/null 2>/dev/null |
  jq -r '.clients[].info | select(.kind == "app" and .platform == "macos") | .version | capture("(?:snapshot\\.|\\()(?<b>[0-9]+)\\)?$").b' | sort -un)
case $(grep -c . <<<"$builds") in
0) echo "rex-update: no Mac app is connected to this server, so rex stays at $have"; exit 0 ;;
1) ;;
*)
  # A just-updated Mac app reconnects before its old connection drops, so follow the newest build.
  echo "rex-update: connected Mac apps report builds $(echo $builds), following the newest"
  builds=$(tail -n 1 <<<"$builds")
  ;;
esac

cast=$(curl -fsS --max-time 15 "$appcast") || { echo "rex-update: could not fetch $appcast" >&2; exit 1; }
version_of() { awk -v b="$1" '/<sparkle:version>/ { gsub(/[^0-9]/, ""); build = $0 } /^Rex [0-9]/ && (b == "" || build == b) { print $2; exit }' <<<"$cast"; }
version=$(version_of "$builds")
[[ "$version" =~ ^[0-9]+(\.[0-9]+)*-(preview|alpha)\.[0-9]+$ ]] || { echo "rex-update: Mac app build $builds names no packaged Rex in the appcast (${version:-none}), rex stays at $have" >&2; exit 1; }
[ "$(version_of "")" != "$version" ] && echo "rex-update: a newer Rex is out; Install Update in the Mac app and the next update brings the dev-box along"
# Arch packages spell 0.1.0-preview.25 as 0.1.0preview25 (preview repo) and snapshots as 0.1.0alphaN (snapshot repo).
pkg="$(sed -E 's/-(preview|alpha)\.([0-9]+)$/\1\2/' <<<"$version")-1"
[ "$have" = "$pkg" ] && exit 0
upgrade=/usr/local/sbin/rex-upgrade
if ! sudo -n "$upgrade" "$pkg"; then
  echo "rex-update: $upgrade $pkg failed or needs a password - run chezmoi apply in a terminal on this box to install it" >&2
  exit 1
fi
echo "rex-update: rex $have -> $pkg to match the Mac app (build $builds)"
