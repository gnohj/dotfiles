Host github.com
  AddKeysToAgent yes
{{- if eq .chezmoi.os "darwin" }}
  # macOS: sign with the keychain-held identity key. On the VPS this block is
  # omitted — no private key on the box, git rides the forwarded agent instead.
  IgnoreUnknown UseKeychain
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# RemoteForward exposes this mac's Chrome CDP port on dev-box for chrome-devtools-mcp.
Host dev-box tailscale
  ForwardAgent yes
  HostName dev-box
  IdentityFile ~/.ssh/id_ed25519
  RemoteForward 9222 127.0.0.1:9222
  User gnohj
{{- end }}