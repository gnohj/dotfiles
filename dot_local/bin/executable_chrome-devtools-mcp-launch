#!/usr/bin/env bash
set -euo pipefail

args=("$@")
# A background Chrome is already up (chrome-headed-bg), so attach rather than launch, which would activate the app and steal focus. Attaching wins over --headless.
if [ -n "${AGENT_BROWSER_CDP_URL:-}" ]; then
  args+=(--browserUrl "$AGENT_BROWSER_CDP_URL")
elif [ "${AGENT_BROWSER_HEADLESS:-0}" = 1 ]; then
  args+=(--headless --chrome-arg=--mute-audio)
fi
exec npx -y chrome-devtools-mcp@1.8.0 "${args[@]}"
