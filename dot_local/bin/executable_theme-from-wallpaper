#!/usr/bin/env python3
"""Generate a colorscheme list file from a wallpaper image.

  theme-from-wallpaper <image>   write ~/.config/colorscheme/list/<name>-colors.sh, print its file name
  theme-from-wallpaper --unused  list wallpapers in ~/Pictures/wallpapers and ~/Documents/Pictures/wallpapers that no scheme uses yet
  theme-from-wallpaper --regenerate  rewrite every generated scheme from its wallpaper, after a change to this generator
  theme-from-wallpaper --online  suggest three 5K wallpapers from Unsplash as "label<TAB>preview image" rows; passing a preview image as <image> downloads the full one into ~/Pictures/wallpapers first

--online needs UNSPLASH_ACCESS_KEY, from the environment or ~/.zsh_gnohj_env.secrets.

The background comes from the image's dark tones. Red, orange, yellow and green stay classic hues so status keeps its meaning; blue is the image's main hue, body text is a soft tint of it in a slot of its own, and cyan and magenta start at their classic hues and move until they sit 30 degrees clear of every other role. Every text color is pushed until it clears 4.5:1 on the background.
"""
import json
import math
import os
import random
import re
import subprocess
import sys
import tempfile
import urllib.parse

HOME = os.path.expanduser("~")
LIST = os.path.join(HOME, ".config/colorscheme/list")
WALLPAPERS = (os.path.join(HOME, "Pictures/wallpapers"), os.path.join(HOME, "Documents/Pictures/wallpapers"))
IMAGES = (".jpg", ".jpeg", ".png", ".webp", ".avif")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "theme-from-wallpaper")
SUGGESTIONS = os.path.join(CACHE, "suggestions")
POOL = os.path.join(CACHE, "pool.json")
UNSPLASH = os.environ.get("UNSPLASH_API", "https://api.unsplash.com")
# Each term was checked against real results; ones that came back bright, toy-like or full of portraits were dropped.
QUERIES = (
    "cyberpunk city", "neon city night", "tokyo night neon", "night skyline", "dark abstract render",
    "nebula", "galaxy", "milky way", "planet space", "earth from space", "aurora borealis",
)
PEOPLE = {"boy", "child", "children", "couple", "face", "girl", "guy", "lady", "man", "men", "model", "people", "person", "portrait", "selfie", "woman", "women"}
FILLER = {
    "a", "an", "and", "are", "as", "at", "between", "by", "during", "for", "from", "has", "in", "into", "is", "it", "its", "lot", "lots", "near", "of", "on", "out", "over",
    "says", "some", "that", "the", "there", "this", "through", "to", "under", "up", "very", "while", "with",
}
WIDTH = 5120
# Mean brightness, 0 to 1; the wallpapers already in use run from 0.12 to 0.43.
BRIGHTEST = 0.40


def lin(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def gam(c):
    return 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055


def to_lab(r, g, b):
    r, g, b = lin(r / 255), lin(g / 255), lin(b / 255)
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    return (
        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
    )


def lch(L, C, h):
    """OKLCH to #rrggbb, dropping chroma until the color fits sRGB."""
    while True:
        a, b = C * math.cos(math.radians(h)), C * math.sin(math.radians(h))
        l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
        m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
        s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
        rgb = (
            4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
        )
        if C <= 0.001 or all(-0.0005 <= v <= 1.0005 for v in rgb):
            return "#%02x%02x%02x" % tuple(round(255 * gam(min(1, max(0, v)))) for v in rgb)
        C -= 0.004


def contrast(a, b):
    lum = [0.2126 * lin(int(x[1:3], 16) / 255) + 0.7152 * lin(int(x[3:5], 16) / 255) + 0.0722 * lin(int(x[5:7], 16) / 255) for x in (a, b)]
    return (max(lum) + 0.05) / (min(lum) + 0.05)


def scheme_wallpapers():
    """File names of every wallpaper an existing scheme points at; names, so a copy of one in another folder counts as used too."""
    used = set()
    for name in os.listdir(LIST) if os.path.isdir(LIST) else []:
        with open(os.path.join(LIST, name), errors="replace") as f:
            m = re.search(r'^wallpaper="?([^"\n]+)"?', f.read(), re.M)
        if m:
            used.add(os.path.basename(m.group(1)))
    return used


def access_key():
    key = os.environ.get("UNSPLASH_ACCESS_KEY", "")
    # The picker also runs from the launcher, which never sourced the shell's secrets.
    for name in (".zsh_gnohj_env.secrets", ".zsh_gnohj_env.local"):
        if key:
            break
        try:
            with open(os.path.join(HOME, name), errors="replace") as f:
                m = re.search(r"""^(?:export\s+)?UNSPLASH_ACCESS_KEY=["']?([^"'\s]+)""", f.read(), re.M)
        except OSError:
            continue
        key = m.group(1) if m else ""
    return key


def curl(*args, key="", seconds=10):
    """Return (HTTP status, body); status 0 means no answer."""
    # The key goes in on stdin, never argv, and only to the API itself, whatever URL an answer names.
    if key and not args[-1].startswith(UNSPLASH + "/"):
        return 0, b""
    auth = ["-H", "@-"] if key else []
    try:
        r = subprocess.run(
            ["curl", "-gfsSL", "--connect-timeout", "4", "--max-time", str(seconds), "-w", "\n%{http_code}", *auth, *args],
            input=f"Authorization: Client-ID {key}\nAccept-Version: v1\n".encode() if key else None, capture_output=True,
        )
    except FileNotFoundError:
        return 0, b""
    body, _, status = r.stdout.rpartition(b"\n")
    return (int(status) if status.isdigit() else 0), body


def fits(photo):
    return photo["query"] in QUERIES and not set(re.findall(r"[a-z]+", photo["alt"].lower())) & PEOPLE


def refill(pool, key):
    """Top up the pool from three searches; returns the reason when one fails."""
    known = set(pool["seen"]) | {p["id"] for p in pool["photos"]}
    problem, fresh = "", []
    for query in random.sample(QUERIES, 3):
        params = {"query": query, "orientation": "landscape", "content_filter": "high", "per_page": 30, "page": random.randint(1, 4)}
        status, body = curl(f"{UNSPLASH}/search/photos?{urllib.parse.urlencode(params)}", key=key)
        if status != 200:
            problem = {0: "could not reach Unsplash", 401: "Unsplash rejected UNSPLASH_ACCESS_KEY", 403: "Unsplash hourly limit reached, try again later"}.get(status, f"Unsplash answered HTTP {status}")
            break
        try:
            results = json.loads(body)["results"]
        except (ValueError, KeyError, TypeError):
            problem = "Unsplash sent an answer this script cannot read"
            break
        for photo in results:
            try:
                w, h = int(photo["width"]), int(photo["height"])
                entry = {
                    "id": photo["id"], "width": w, "height": h, "raw": photo["urls"]["raw"], "ping": photo["links"]["download_location"],
                    "alt": photo.get("alt_description") or photo.get("description") or "", "query": query,
                    # Shown in the picker, so nothing that could drive the terminal.
                    "by": re.sub(r"[^ -~\u00a1-\uffff]", "", photo["user"]["name"]),
                }
            except (KeyError, TypeError, ValueError):
                continue
            if not (entry["raw"].startswith("https://") and entry["ping"].startswith(UNSPLASH + "/")):
                continue
            if w >= WIDTH and 1.4 <= w / h <= 2.2 and not photo.get("premium") and entry["id"] not in known and fits(entry):
                known.add(entry["id"])
                fresh.append(entry)
    # palette=json is an imgix extra Unsplash does not promise, so a photo with no answer stays in.
    with tempfile.TemporaryDirectory() as tmp:
        fetch = []
        for n, entry in enumerate(fresh):
            fetch += ["-o", os.path.join(tmp, str(n)), entry["raw"] + "&w=200&palette=json"]
        if fetch:
            curl("--parallel", *fetch, seconds=15)
        for n, entry in enumerate(fresh):
            try:
                with open(os.path.join(tmp, str(n))) as f:
                    bright = float(json.load(f)["average_luminance"]) > BRIGHTEST
            except (OSError, ValueError, KeyError, TypeError):
                bright = False
            if not bright:
                pool["photos"].append(entry)
    random.shuffle(pool["photos"])
    return problem


def suggest(count=3):
    key = access_key()
    if not key:
        sys.exit("set UNSPLASH_ACCESS_KEY for Unsplash suggestions")
    os.makedirs(SUGGESTIONS, exist_ok=True)
    for name in os.listdir(SUGGESTIONS):
        os.remove(os.path.join(SUGGESTIONS, name))
    try:
        with open(POOL) as f:
            pool = json.load(f)
        pool = {"photos": [p for p in pool["photos"] if fits(p)], "seen": list(pool["seen"])}
    except (OSError, ValueError, KeyError, TypeError):
        pool = {"photos": [], "seen": []}
    problem = refill(pool, key) if len({p["query"] for p in pool["photos"]}) < count else ""
    # One per search first, so a single open shows three different kinds of picture.
    picks = []
    for distinct in (True, False):
        for photo in pool["photos"]:
            if len(picks) < count and photo not in picks and not (distinct and photo["query"] in {p["query"] for p in picks}):
                picks.append(photo)
    if not picks:
        sys.exit(problem or "Unsplash had no 5K wallpapers this time")

    taken = {os.path.splitext(n)[0].lower() for folder in WALLPAPERS if os.path.isdir(folder) for n in os.listdir(folder)}
    taken |= {n[: -len("-colors.sh")] for n in os.listdir(LIST) if n.endswith("-colors.sh")} if os.path.isdir(LIST) else set()
    fetch = []
    for photo in picks:
        words = [w for w in re.findall(r"[a-z0-9]+", photo["alt"].lower()) if w not in FILLER][:4]
        base = "-".join(words or re.findall(r"[a-z0-9]+", photo["query"]))
        name, n = base, 2
        while name in taken:
            name, n = f"{base}-{n}", n + 1
        taken.add(name)
        photo["name"], photo["size"] = name, f"{WIDTH}x{round(WIDTH * photo['height'] / photo['width'])}"
        photo["preview"] = os.path.join(SUGGESTIONS, name + ".jpg")
        fetch += ["-o", photo["preview"], photo["raw"] + "&w=1600&q=80&fm=jpg&fit=max"]
    curl("--parallel", *fetch, seconds=15)

    for photo in picks:
        if not (os.path.isfile(photo["preview"]) and os.path.getsize(photo["preview"]) > 1024):
            problem = problem or "could not load previews from Unsplash"
            continue
        with open(os.path.splitext(photo["preview"])[0] + ".json", "w") as f:
            json.dump(photo, f)
        with open(photo["preview"] + ".caption", "w") as f:
            f.write(f"Not downloaded yet. Enter saves it at {photo['size']} to ~/Pictures/wallpapers.\nPhoto by {photo['by']} on Unsplash.\n")
        pool["photos"].remove(photo)
        pool["seen"] = (pool["seen"] + [photo["id"]])[-2000:]
        print(f"\033[33m\u2193 download\033[m  {photo['name']}  {photo['size']}  Unsplash\t{photo['preview']}")
    with open(POOL, "w") as f:
        json.dump(pool, f)
    if problem:
        sys.exit(problem)


def download(preview):
    try:
        with open(os.path.splitext(preview)[0] + ".json") as f:
            photo = json.load(f)
    except (OSError, ValueError):
        sys.exit(f"{preview} is not a suggestion from --online.")
    os.makedirs(WALLPAPERS[0], exist_ok=True)
    target = os.path.join(WALLPAPERS[0], photo["name"] + ".jpg")
    print(f"Downloading {photo['name']}.jpg ({photo['size']}) from Unsplash...", file=sys.stderr)
    status, _ = curl("-o", target + ".part", f"{photo['raw']}&w={WIDTH}&q=90&fm=jpg&fit=max", seconds=180)
    if status != 200 or not os.path.isfile(target + ".part") or os.path.getsize(target + ".part") < 1024:
        if os.path.exists(target + ".part"):
            os.remove(target + ".part")
        sys.exit(f"Could not download {photo['name']}.jpg from Unsplash.")
    os.replace(target + ".part", target)
    # Unsplash asks every app to report a download; the theme does not depend on the answer.
    curl(photo["ping"], key=access_key())
    return target


def palette(image):
    raw = subprocess.run(["magick", image + "[0]", "-resize", "96x54!", "-depth", "8", "rgb:-"], capture_output=True, check=True).stdout
    px = sorted(to_lab(raw[i], raw[i + 1], raw[i + 2]) for i in range(0, len(raw), 3))
    dark = px[: len(px) * 35 // 100]
    ba, bb = sum(p[1] for p in dark) / len(dark), sum(p[2] for p in dark) / len(dark)
    bh, bc = math.degrees(math.atan2(bb, ba)) % 360, min(math.hypot(ba, bb), 0.035)
    vivid = sorted(px, key=lambda p: -math.hypot(p[1], p[2]))[: len(px) * 30 // 100]
    # The image's main color: the mean of its most saturated third. A grey image falls back to the background hue's opposite.
    va, vb = sum(p[1] for p in vivid) / len(vivid), sum(p[2] for p in vivid) / len(vivid)
    vc = sum(math.hypot(p[1], p[2]) for p in vivid) / len(vivid)
    ah = math.degrees(math.atan2(vb, va)) % 360 if math.hypot(va, vb) > 0.02 else (bh + 180) % 360
    c = min(max(vc * 1.1, 0.07), 0.14)

    bg = lch(0.17, bc, bh)

    def text(L, C, h, target=4.5):
        while contrast(lch(L, C, h), bg) < target and L < 0.95:
            L += 0.01
        return lch(L, C, h)

    def hue(h):
        return (h + ((ah - h + 180) % 360 - 180) * 0.2) % 360

    R, O, Y, G = (hue(h) for h in (25, 55, 100, 145))
    # The primary follows the image, but keeps 40 degrees clear of red so plain text never reads as an error.
    away = (ah - R + 180) % 360 - 180
    B = ah if abs(away) >= 40 else R + (40 if away >= 0 else -40)

    def accent(anchor, taken):
        for step in range(0, 181, 5):
            for h in (anchor - step, anchor + step):
                if all(abs((h - t + 180) % 360 - 180) >= 30 for t in taken):
                    return h % 360
        return anchor

    CY = accent(hue(200), (R, O, Y, G, B))
    M = accent(hue(300), (R, O, Y, G, B, CY))
    # 03 is the accent that borders, the bar and the prompt wear, so it stays on the image's hue; body text is its own slot with only a hint of it.
    p = {
        "text": text(0.81, 0.03, B),
        "01": text(0.70, c, M), "02": text(0.82, c, G), "03": text(0.87, c * 0.55, B), "04": text(0.76, c, B), "05": text(0.85, c, Y),
        "06": text(0.80, c, O), "07": lch(0.215, bc, bh), "08": lch(0.52, 0.03, bh), "09": text(0.64, 0.035, bh), "10": bg,
        "11": text(0.78, c, R), "12": text(0.88, c, Y), "13": lch(0.46, 0.03, bh), "14": text(0.88, 0.02, bh, 7), "15": text(0.80, c, O),
        "16": lch(0.34, 0.06, ah), "17": lch(0.30, 0.03, bh),
        "18": lch(0.55, c, B), "19": lch(0.55, c, G), "20": lch(0.55, c, CY), "21": lch(0.55, c, M), "22": lch(0.55, c, Y), "23": lch(0.42, 0.04, bh),
        "24": text(0.86, c, ah), "26": bg,
        "27": lch(0.93, 0.02, bh), "28": lch(0.20, bc, bh), "29": text(0.82, c, G), "30": lch(0.27, 0.05, G), "31": text(0.78, c, R), "32": lch(0.26, 0.05, R),
        "33": text(0.80, c, O), "34": lch(0.20, bc, bh), "35": text(0.82, c, CY), "36": text(0.86, c, G), "37": text(0.90, c, Y), "38": text(0.78, c, M),
        "39": lch(0.60, c, (B + 20) % 360), "40": text(0.82, c, G), "41": text(0.85, c, Y), "42": text(0.80, c, B + 18), "43": text(0.75, c, CY),
        "44": text(0.85, c * 0.7, B + 18), "45": text(0.90, c * 0.6, CY), "46": text(0.62, 0.05, B), "47": text(0.70, 0.06, G), "48": text(0.75, 0.08, G),
        "49": text(0.80, 0.06, CY), "50": text(0.72, c, M), "51": text(0.74, c, O), "52": text(0.72, c, (R - 25) % 360), "53": lch(0.33, 0.04, bh),
        "54": lch(0.50, 0.04, bh), "55": text(0.68, c, (M - 25) % 360), "56": lch(0.24, 0.02, bh), "57": lch(0.60, 0.06, B), "58": lch(0.92, 0.03, CY),
        "59": lch(0.56, 0.07, CY), "60": lch(0.56, 0.07, G), "61": lch(0.56, 0.07, B), "62": lch(0.56, 0.07, M), "63": lch(0.56, 0.07, Y),
    }
    for slot in ("text", "01", "02", "03", "04", "05", "06", "09", "11", "12", "14", "15", "24"):
        assert contrast(p[slot], bg) >= 4.5, f"{slot} {p[slot]} is under 4.5:1 on {bg}"
    return p


def write(image, target):
    # The path lands inside double quotes in a file every theme consumer sources, and in an AppleScript string, so these would run as code.
    if re.search(r'["$`\\\n\r]', image):
        sys.exit(f"Rename {image!r} first: its name has a quote, dollar sign, backtick or backslash.")
    try:
        colors = palette(image)
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        sys.exit(f"Could not read {image} with ImageMagick: {e}")
    shown = "$HOME" + image[len(HOME):] if image.startswith(HOME + os.sep) else image
    lines = ["#!/usr/bin/env bash", "#shellcheck disable=SC2034", f"# Generated from {os.path.basename(image)} by theme-from-wallpaper.", f'wallpaper="{shown}"']
    lines += [f"gnohj_text={colors.pop('text')}"]
    lines += [f"gnohj_color{slot}={value}" for slot, value in sorted(colors.items())]
    os.makedirs(LIST, exist_ok=True)
    with open(target, "w") as f:
        f.write("\n".join(lines) + "\n")


def main():
    if sys.argv[1:] == ["--regenerate"]:
        for name in sorted(os.listdir(LIST)):
            with open(os.path.join(LIST, name), errors="replace") as f:
                m = re.search(r'^# Generated from .* by theme-from-wallpaper\.\nwallpaper="([^"\n]+)"', f.read(), re.M)
            image = m.group(1).replace("$HOME", HOME) if m else ""
            if os.path.isfile(image):
                write(image, os.path.join(LIST, name))
                print(name)
            elif m:
                print(f"skipped {name}: {image} is missing", file=sys.stderr)
        return
    if sys.argv[1:] == ["--unused"]:
        seen = scheme_wallpapers()
        for folder in WALLPAPERS:
            for name in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
                if name.lower().endswith(IMAGES) and name not in seen:
                    seen.add(name)
                    print(os.path.join(folder, name))
        return
    if sys.argv[1:] == ["--online"]:
        suggest()
        return
    if len(sys.argv) != 2 or not os.path.isfile(sys.argv[1]):
        sys.exit(__doc__)
    image = os.path.abspath(sys.argv[1])
    if os.path.dirname(image) == SUGGESTIONS:
        image = download(image)
    if os.path.basename(image) in scheme_wallpapers():
        sys.exit(f"A scheme already uses {image}; pick it from the theme list instead.")
    slug = re.sub(r"[^a-z0-9]+", "-", os.path.splitext(os.path.basename(image))[0].lower()).strip("-") or "wallpaper"
    target = os.path.join(LIST, slug + "-colors.sh")
    if os.path.exists(target):
        sys.exit(f"{target} already exists.")
    write(image, target)
    print(os.path.basename(target))

if __name__ == "__main__":
    main()
