#!/usr/bin/env bash
# Single source of Claude Code account auth: every launcher (zsh `claude`, cs, cr, herdr, systemd) goes through here, so a non-interactive spawn authenticates exactly like an interactive one.
set -euo pipefail

# Resolve the REAL binary, never this wrapper: mise owns the install and only .zshrc adds its bin dir, so a bare PATH lookup fails outside an interactive zsh.
_self="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"

_real_claude() {
  local c d
  if command -v mise >/dev/null 2>&1; then
    c="$(mise which claude 2>/dev/null || true)"
    [ -n "$c" ] && [ -x "$c" ] && {
      printf '%s' "$c"
      return
    }
  fi
  c="$HOME/.local/share/mise/shims/claude"
  [ -x "$c" ] && {
    printf '%s' "$c"
    return
  }
  local IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    c="$d/claude"
    [ -x "$c" ] || continue
    [ "$(cd "$d" && pwd -P)/claude" = "$_self" ] && continue
    printf '%s' "$c"
    return
  done
}

_bin="$(_real_claude)"
if [ -z "$_bin" ]; then
  echo "claude: no Claude Code binary found (tried mise, mise shims, PATH)" >&2
  exit 127
fi

# claude-account-state-v1
case "${CLAUDE_ACCOUNT:-}" in
"" | work | personal) ;;
*) echo "claude: unknown account choice" >&2; exit 1 ;;
esac
_account="$(claude-account resolve)"
case "$_account" in
work | personal) ;;
*) echo "claude: cannot resolve the selected account" >&2; exit 1 ;;
esac

if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -z "${CLAUDE_ACCOUNT:-}" ]; then
  _matched=""
  for _candidate in work personal; do
    _candidate_token="$(CLAUDE_ACCOUNT="$_candidate" claude-account token)"
    if [ -n "$_candidate_token" ] && [ "$CLAUDE_CODE_OAUTH_TOKEN" = "$_candidate_token" ]; then
      [ -z "$_matched" ] || { echo "claude: account token is ambiguous" >&2; exit 1; }
      _matched="$_candidate"
    fi
  done
  [ -n "$_matched" ] || { echo "claude: supplied OAuth token is not a known account" >&2; exit 1; }
  _account="$_matched"
fi

export CLAUDE_ACCOUNT="$_account"
_expected="$(claude-account dir)"
_tok="$(claude-account token)"
[ -n "$_tok" ] || { echo "claude: no OAuth token for the selected account" >&2; exit 1; }
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ "$CLAUDE_CODE_OAUTH_TOKEN" != "$_tok" ]; then
  echo "claude: supplied OAuth token does not match the selected account" >&2
  exit 1
fi

if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ "$CLAUDE_CONFIG_DIR" != "$_expected" ]; then
  echo "claude: explicit state store does not match $_account token; migrate its conversation before changing the launch" >&2
  exit 1
fi

if [ -n "${FM_TASK_ID:-}" ]; then
  _worker_pin="${FM_HOME:-$HOME/.local/share/firstmate}/config/claude-account"
  if [ -e "$_worker_pin" ] || [ -L "$_worker_pin" ]; then
    [ -f "$_worker_pin" ] && [ ! -L "$_worker_pin" ] || { echo "claude: invalid worker state-store override" >&2; exit 1; }
    IFS= read -r _worker_store <"$_worker_pin" || true
    [ "$_worker_store" = ordinary ] && _worker_store=""
    [ "$_worker_store" = "$_expected" ] || { echo "claude: worker state store does not match $_account token; migrate its conversation before removing the override" >&2; exit 1; }
  fi
fi

# claude-session-resume-v1: a pending migration marker for this path resumes its conversation instead of starting fresh.
_resume=()
if [ -s "$HOME/.local/state/claude/resume-by-path" ]; then
  _resume_id="$(claude-session-migrate launch "$PWD")" || exit 1
  if [ -n "$_resume_id" ]; then
    for _arg in "$@"; do
      case "$_arg" in
      -c | -r | --continue | --resume | --resume=* | --session-id | --session-id=* | --fork-session)
        echo "claude: a pending conversation migration conflicts with $_arg" >&2
        exit 1
        ;;
      esac
    done
    _resume=(--resume "$_resume_id" --system-prompt-snapshot off)
  fi
fi

_declared_store="$(claude-account store-pin "$PWD")"
_store_pin="$_declared_store"
case "$_store_pin" in
ordinary) _store_pin="" ;;
"" | /*) ;;
*) echo "claude: invalid state-store override" >&2; exit 1 ;;
esac
if [ -n "$_declared_store" ]; then
  [ "$_store_pin" = "$_expected" ] || { echo "claude: pinned state store does not match $_account token; migrate its conversation before removing the override" >&2; exit 1; }
fi
unset CLAUDE_CONFIG_DIR
[ -z "$_expected" ] || export CLAUDE_CONFIG_DIR="$_expected"
export CLAUDE_CODE_OAUTH_TOKEN="$_tok"
claude-account seed-config --dir "${_expected:-ordinary}"

exec "$_bin" ${_resume[@]+"${_resume[@]}"} "$@"
