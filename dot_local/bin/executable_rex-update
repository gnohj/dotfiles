#!/usr/bin/env bash
# rex-update - install the Rex build the Mac app ships so the dev-box matches it; on the Mac it runs on the dev-box.
set -uo pipefail

if [ "$(uname)" = Darwin ]; then
  host="${UPDATE_VPS_HOST:-dev-box}"
  case "$host" in '' | -*) echo "rex-update: invalid host: $host" >&2; exit 2 ;; esac
  exec ssh -o BatchMode=yes -o ConnectTimeout=5 -o ClearAllForwardings=yes "$host" '"$HOME/.local/bin/rex-update" && "$HOME/.local/bin/rex-restart-idle"'
fi

appcast=https://blob.superlogical.com/public/rex-app/snapshot-arm64/appcast.xml
have=$(pacman -Q rex | awk '{ print $2 }')

# Rex.app reports only its Sparkle build; the appcast maps it to a Rex version.
builds=$(rex --autostart=false client ls --json </dev/null 2>/dev/null |
  jq -r '.clients[].info | select(.kind == "app" and .platform == "macos") | .version | capture("\\((?<b>[0-9]+)\\)").b' | sort -un)
case $(grep -c . <<<"$builds") in
0) echo "rex-update: no Mac app is connected to this server, so rex stays at $have"; exit 0 ;;
1) ;;
*)
  # A just-updated Mac app reconnects before its old connection drops, so follow the newest build.
  echo "rex-update: connected Mac apps report builds $(echo $builds), following the newest"
  builds=$(tail -n 1 <<<"$builds")
  ;;
esac

cast=$(curl -fsS --max-time 15 "$appcast") || { echo "rex-update: could not fetch $appcast" >&2; exit 1; }
commit_of() { awk -F'`' -v b="$1" '/<sparkle:version>/ { gsub(/[^0-9]/, ""); build = $0 } /^Rex [0-9]/ && (b == "" || build == b) { print $2; exit }' <<<"$cast"; }
commit=$(commit_of "$builds")
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || { echo "rex-update: Mac app build $builds is not in the appcast, rex stays at $have" >&2; exit 1; }
[ "$(commit_of "")" != "$commit" ] && echo "rex-update: a newer Rex is out; Install Update in the Mac app and the next update brings the dev-box along"
# The repo db lists only the newest build, so an installed match must not depend on finding its package.
[[ "$have" == *"_g${commit:0:6}-"* ]] && exit 0

# Preview releases rename the Mac version (0.1.0-preview.N), but arch packages keep 0.0.<ts>_g<sha>, so match by commit.
want=$(awk -v c="$commit" '$1 == "Rex" && $2 ~ /^0\.0\.[0-9]+-g[0-9a-f]+$/ && index($0, "`" c "`") { print $2; exit }' <<<"$cast")
if [ -z "$want" ]; then
  server=$(sed -n 's/^Server *= *//p' /etc/pacman.d/rex.conf | head -n 1)
  want=$(curl -fsSL --max-time 15 "${server//\$arch/$(uname -m)}/rex.db" | bsdtar -tf - 2>/dev/null |
    sed -n "s|^rex-\(0\.0\.[0-9]*_g${commit:0:6}\)-[0-9]*/\$|\1|p" | head -n 1)
fi
[ -n "$want" ] || { echo "rex-update: no arch package found for Mac app commit ${commit:0:7} (build $builds), rex stays at $have" >&2; exit 1; }

pkg="${want/-g/_g}-1"
[ "${have%-*}" = "${pkg%-*}" ] && exit 0
upgrade=/usr/local/sbin/rex-upgrade
if ! sudo -n "$upgrade" "$pkg"; then
  echo "rex-update: $upgrade $pkg failed or needs a password - run chezmoi apply in a terminal on this box to install it" >&2
  exit 1
fi
echo "rex-update: rex $have -> $pkg to match the Mac app (build $builds)"
