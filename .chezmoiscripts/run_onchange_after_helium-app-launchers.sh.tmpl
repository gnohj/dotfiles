#!/usr/bin/env bash
# helium-app hash: {{ include "dot_local/bin/executable_helium-app" | sha256sum }}
set -euo pipefail

echo "
🔧 Run OnChange [After] Helium app launchers........"

if [ "$(uname -s)" != "Darwin" ]; then
  echo "🚧 Skipping Helium app launchers (not macOS)"
  exit 0
fi

lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
apps_dir="$HOME/Applications"

# Prints the icon of the installed Helium PWA whose start URL begins with $1, so a reinstall never strands a hard-coded app id.
pwa_icon() {
  local a p
  for a in "$apps_dir/Chromium Apps.localized"/*.app; do
    p="$a/Contents/Info.plist"
    case "$(/usr/libexec/PlistBuddy -c 'Print :CrAppModeUserDataDir' "$p" 2>/dev/null)" in "$HOME/Library/Application Support/net.imput.helium/"*) ;; *) continue ;; esac
    case "$(/usr/libexec/PlistBuddy -c 'Print :CrAppModeShortcutURL' "$p" 2>/dev/null)" in "$1"*) echo "$a/Contents/Resources/app.icns"; return ;; esac
  done
}

build_app() {
  local name="$1" bundle_id="$2" profile="$3" url="$4" title_regex="$5" icon_prefix="$6"
  local app="$apps_dir/$name.app" icon
  rm -rf "$app"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"

  cat >"$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>$bundle_id</string>
  <key>CFBundleName</key>
  <string>$name</string>
  <key>CFBundleDisplayName</key>
  <string>$name</string>
  <key>CFBundleExecutable</key>
  <string>launch</string>
  <key>CFBundleIconFile</key>
  <string>icon</string>
  <key>CFBundleVersion</key>
  <string>1.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
PLIST

  printf '#!/usr/bin/env bash\nexec "$HOME/.local/bin/helium-app" %q %q %q\n' "$profile" "$url" "$title_regex" >"$app/Contents/MacOS/launch"
  chmod +x "$app/Contents/MacOS/launch"

  icon="$(pwa_icon "$icon_prefix")"
  if [ -n "$icon" ]; then cp "$icon" "$app/Contents/Resources/icon.icns"; else echo "!! no Helium PWA icon for $icon_prefix"; fi
  printf 'APPL????' >"$app/Contents/PkgInfo"
  codesign --force --sign - "$app" 2>/dev/null || echo "!! could not sign $app"
  [ -x "$lsregister" ] && "$lsregister" -f "$app" 2>/dev/null || true
  echo "✅ built $app"
}

for old in "Slack Personal"; do
  [ -d "$apps_dir/$old.app" ] || continue
  [ -x "$lsregister" ] && "$lsregister" -u "$apps_dir/$old.app" 2>/dev/null || true
  rm -rf "${apps_dir:?}/$old.app"
  echo "🗑️ removed renamed $apps_dir/$old.app"
done

build_app "Slack iHeart Alumni" com.gnohj.slack-iheart-alumni Default "https://app.slack.com/client/{{ .slack_iheart_alumni_team }}" "Slack - personal$" "https://app.slack.com/"
