#!/usr/bin/env python3
# rex-pluck SOURCE_BLOCK SOURCE_WINDOW - pluck for Rex, run by init.lua's twin block: a label copies and opens its token, shift+label only copies.
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import termios
import time
import tty
import unicodedata

REX = str(Path(os.environ["REX_BIN_DIR"]) / "rex") if os.environ.get("REX_BIN_DIR") else "rex"
SESSION = os.environ.get("REX_SESSION") or os.environ["REX_BLOCK"]
SELF = os.environ["REX_BLOCK"]
LABELS = "asdfghjklqwertyuiopzxcvbnm"
TOKEN = re.compile(
    r"https?://[^\s<>\"'`(){}\[\]|]+"
    r"|(?:~|\.{1,2})?/?[\w.@+-]+(?:/[\w.@+-]+)+(?::\d+){0,2}"
    r"|[\w-]+\.[A-Za-z]{1,5}:\d+(?::\d+)?"
    r"|\b[0-9a-f]{7,40}\b"
    r"|\b\d{4,}\b"
)
CONTROL = re.compile(r"[\x00-\x1f\x7f]")
DIM, TEXT, LABEL, RESET = "\x1b[0;90m", "\x1b[0;33m", "\x1b[0;1;30;46m", "\x1b[0m"


def rex(*args):
    return subprocess.run([REX, *args], capture_output=True, text=True, timeout=10)


def call(method, params):
    result = rex("api", "call", "-s", SESSION, method, json.dumps(params))
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"{method} failed")
    return json.loads(result.stdout or "{}")


def terminal(block, method):
    return call(f"com.superlogical.terminal.{method}", {"block_id": block, "args": {}})


def window_of(block):
    for window in call("session.view", {})["windows"]:
        for layer in window.get("layers") or []:
            if any(b["block_id"] == block for b in layer.get("blocks") or []):
                return window["window_id"]
    return None


def screen(block, rows):
    text = rex("capture", "-s", SESSION, "-b", block).stdout
    lines = text[:-1].split("\n") if text.endswith("\n") else text.split("\n")
    return ([CONTROL.sub("", line) for line in lines[-rows:]] + [""] * rows)[:rows]


def tokens(lines):
    found = []
    for row, line in enumerate(lines):
        for match in TOKEN.finditer(line):
            value = match.group().rstrip(".,;:")
            if value:
                found.append((row, match.start(), value))
    order = list(dict.fromkeys(value for _, _, value in found))
    if len(order) <= len(LABELS):
        names = list(LABELS)
    else:
        names = [a + b for a in LABELS for b in LABELS]
    labels = dict(zip(order, names))
    return [(row, col, value, labels[value]) for row, col, value in found if value in labels], labels


def width(char):
    return 2 if unicodedata.east_asian_width(char) in "WF" else 1


def render(lines, hits, typed):
    out = ["\x1b[?25l\x1b[?7l\x1b[2J"]
    for row, line in enumerate(lines):
        spans = sorted((col, value, label) for r, col, value, label in hits if r == row)
        parts, cursor = [], 0
        for col, value, label in spans:
            if col < cursor:
                continue
            parts.append(DIM + line[cursor:col])
            if label.startswith(typed):
                shown = label[len(typed):]
                pad = sum(width(c) for c in value[:len(shown)]) - len(shown)
                parts.append(LABEL + shown + " " * max(pad, 0) + TEXT + value[len(shown):])
            else:
                parts.append(DIM + value)
            cursor = col + len(value)
        parts.append(DIM + line[cursor:])
        out.append(f"\x1b[{row + 1};1H" + "".join(parts) + RESET)
    sys.stdout.write("".join(out))
    sys.stdout.flush()


def pick(lines, hits, labels):
    typed = ""
    longest = max((len(label) for label in labels.values()), default=1)
    signal.signal(signal.SIGWINCH, lambda *_: render(lines, hits, typed))
    while True:
        render(lines, hits, typed)
        key = os.read(0, 1).decode(errors="ignore")
        if key in ("\x1b", "\x03", "\x07") or not key:
            return None, False
        copy_only = key.isupper()
        typed += key.lower()
        matches = [value for value, label in labels.items() if label.startswith(typed)]
        if not matches:
            return None, False
        exact = [value for value, label in labels.items() if label == typed]
        if exact or len(typed) >= longest:
            return (exact[0] if exact else None), copy_only


def copy(token):
    if shutil.which("pbcopy"):
        subprocess.run(["pbcopy"], input=token, text=True, check=False)
        return
    encoded = subprocess.run(["base64"], input=token, capture_output=True, text=True).stdout.replace("\n", "")
    sys.stdout.write(f"\x1b]52;c;{encoded}\x07")
    sys.stdout.flush()


def resolve_file(path, cwd):
    path = os.path.expanduser(path)
    if os.path.isabs(path):
        return path if os.path.isfile(path) else None
    root = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
    for base in (cwd, root):
        if base and os.path.isfile(os.path.join(base, path)):
            return os.path.join(base, path)
    return None


def open_token(token, cwd):
    if token.startswith(("http://", "https://")):
        opener = ["open"] if sys.platform == "darwin" else ["to-desktop", "open"]
        subprocess.Popen(opener + [token], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return
    line = None
    path = resolve_file(token, cwd)
    numbered = re.fullmatch(r"(.+?):(\d+)(?::\d+)?:?", token)
    if path is None and numbered:
        path, line = resolve_file(numbered.group(1), cwd), numbered.group(2)
    if path is None:
        return
    clients = json.loads(rex("client", "ls", "--json").stdout or "{}").get("clients", [])
    apps = [c for c in clients if c.get("info", {}).get("kind") == "app" and c.get("connection_state") == "connected"]
    target = ["-C", max(apps, key=lambda c: c.get("connected_at", ""))["client_id"]] if apps else []
    rex(*target, "do", "-s", SESSION, "open_file_tab", f"path={path}", *([f"line={line}"] if line else []))


def await_size(source):
    # A twin block starts at 80x24 and the app resizes it only once it is shown in a split.
    size = terminal(source, "size")
    want = (size.get("columns"), size.get("rows"))
    deadline = time.monotonic() + 2
    while tuple(os.get_terminal_size()) != want and time.monotonic() < deadline:
        time.sleep(0.02)
    return want[1] or os.get_terminal_size().lines


def overlay(source):
    title = CONTROL.sub("", terminal(source, "title").get("title") or "")
    if title:
        sys.stdout.write(f"\x1b]2;{title}\x07")
    lines = screen(source, await_size(source))
    hits, labels = tokens(lines)
    if not hits:
        return None, False
    saved = termios.tcgetattr(0)
    tty.setraw(0)
    try:
        return pick(lines, hits, labels)
    finally:
        termios.tcsetattr(0, termios.TCSAFLUSH, saved)


def log(error):
    path = Path.home() / ".logs" / "rex-pluck.log"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as stream:
        stream.write(f"{time.strftime('%F %T')} {error}\n")


def main():
    source, home = sys.argv[1], sys.argv[2]
    deadline = time.monotonic() + 3
    while window_of(SELF) != home:
        if time.monotonic() > deadline:
            if window_of(source) == home:
                call("session.close_window", {"window_id": window_of(SELF)})
            raise TimeoutError("the pluck overlay never reached the source pane")
        time.sleep(0.02)
    scratch = window_of(source)
    token, copy_only = None, False
    cwd = (terminal(source, "process").get("foreground") or {}).get("cwd") or str(Path.home())
    try:
        token, copy_only = overlay(source)
        if token:
            copy(token)
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
        log(error)
    finally:
        call("session.swap_blocks", {"block_id": source, "other_block_id": SELF})
        call("session.focus_block", {"block_id": source})
    if token and not copy_only:
        open_token(token, cwd)
    # The scratch tab holds the source pane until the swap back lands; closing it before then would kill that pane.
    if window_of(source) == home:
        call("session.close_window", {"window_id": scratch})


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
        log(error)
        print(f"rex-pluck: {error}", file=sys.stderr)
        time.sleep(2)
        sys.exit(1)
