#!/bin/bash
# Switch the active workspace to a layout mode, or flip its orientation if already there.
set -u

target="${1:?usage: rift-layout bsp|traditional|stack|scrolling|floating}"
cli=/opt/homebrew/bin/rift-cli
jq=/usr/bin/jq

display="$("$cli" query displays 2>/dev/null | "$jq" -r 'first(.[] | select(.is_active_context)) | .uuid // empty' 2>/dev/null)"
active="$("$cli" query workspace-layout ${display:+--display "$display"} 2>/dev/null | "$jq" -r 'first(.[] | select(.is_active)) | "\(.index) \(.layout_mode)"' 2>/dev/null)"
index="${active%% *}"
current="${active#* }"

if [ "$current" = "$target" ]; then
  # Scrolling and floating have no orientation to flip.
  case "$target" in scrolling | floating) exit 0 ;; esac
  exec "$cli" execute layout toggle-orientation
fi
exec "$cli" execute workspace set-layout "$target" ${index:+--workspace-id "$index"}
