#!/usr/bin/env bash
# pi launchers: pis/pio/pig/pic and their -r twins are symlinks here, picked by name; luna always runs at xhigh on openai-codex.
name=${0##*/}
flags=()
case "$name" in pior | pigr | picr) flags+=(-r) ;; esac
case "${name%r}" in
pio) flags+=(--provider openai-codex --model openai-codex/gpt-6.1-sol:high) ;;
pig) flags+=(--provider openai-codex --model openai-codex/gpt-6-luna:xhigh) ;;
pic) flags+=(--provider claude-code --model claude-code/claude-opus-5-5:high) ;;
pis) ;;
*) echo "pi-start: run it as pis, pio, pig, pic, pior, pigr or picr" >&2; exit 2 ;;
esac

if [ -n "${REX_RECOVER_LAUNCH_DIR:-}" ]; then # rex-recover restores pi only in the dotfiles session, resuming this pane's session
  label=$(rex --autostart=false session inspect "${REX_SESSION:-}" --json 2>/dev/null | jq -r '.label // empty')
  case "$label" in *dotfiles) ;; *) exit 0 ;; esac
  [ "${flags[0]:-}" = -r ] && flags=("${flags[@]:1}")
  record="${XDG_STATE_HOME:-$HOME/.local/state}/pi-rex-sessions/${REX_BLOCK#block:}"
  if [ -r "$record" ]; then
    file=$(cat "$record")
    if [ -f "$file" ]; then set -- --session "$file"; else set --; fi
  else
    set -- --continue
  fi
fi
unset REX_RECOVER_LAUNCH_DIR

sp="$HOME/Developer/agents/shared/system-prompt.md"
[ -f "$sp" ] && flags+=(--append-system-prompt "$sp")
exec pi ${flags[@]+"${flags[@]}"} "$@"
