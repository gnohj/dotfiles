{
  "rules": [
    {
      "when": {
        "maxLines": 60,
        "maxFiles": 3
      },
      "use": {
        "mode": "full",
        "claude": {
          "model": "claude-sonnet-5-5",
          "effort": "medium"
        },
        "gpt": {
          "model": "gpt-6-luna",
          "effort": "xhigh"
        },
        "rungTimeout": 600
      },
      "why": "A handful of lines across a few files has no architecture to reason about - the whole diff fits in one read, and depth buys nothing but spend. The cheaper class on both sides finds the same typo, and quota exhaustion is the real failure mode of this flow, not a missed nit."
    },
    {
      "when": {
        "maxLines": 800,
        "maxFiles": 25
      },
      "use": {
        "mode": "fan",
        "claude": {
          "model": "claude-opus-5-5",
          "effort": "high"
        },
        "gpt": {
          "model": "gpt-6.1-sol",
          "effort": "high"
        },
        "rungTimeout": 600
      },
      "why": "The ordinary PR. Both finders think as hard as each other, which is the condition review-finder-pi.sh states for a bid being worth merging at all."
    },
    {
      "when": {},
      "use": {
        "mode": "fan",
        "claude": {
          "model": "claude-opus-5-5",
          "effort": "high"
        },
        "gpt": {
          "model": "gpt-6.1-sol",
          "effort": "high"
        },
        "rungTimeout": 1500
      },
      "why": "Large or high-risk PRs keep both finders at high effort, with a longer timeout for cross-file review."
    }
  ],
  "default": {
    "mode": "fan",
    "claude": {
      "model": "claude-opus-5-5",
      "effort": "high"
    },
    "gpt": {
      "model": "gpt-6.1-sol",
      "effort": "high"
    },
    "rungTimeout": 600
  },
  "riskPaths": [
    "(^|/)(auth|authn|authz|session|login|oauth|token|credential)s?(/|\\.|$)",
    "(^|/)(payment|billing|checkout|subscription|purchase)s?(/|\\.|$)",
    "(^|/)(migrations?|schema)(/|\\.)",
    "(^|/)(middleware|interceptor)s?(/|\\.)",
    "(^|/)\\.github/workflows/",
    "(^|/)(Dockerfile|docker-compose\\.ya?ml|fastly\\.toml|pulumi\\.[^/]+|terraform/)",
    "(^|/)(feature[-_]?flags?|flags?\\.config)(/|\\.)",
    "(^|/)(csp|cors|cookie|crypto|secrets?)(/|\\.)"
  ],
  "lowRiskPaths": [
    "(^|/)__tests__/",
    "(^|/)(test|tests|e2e|spec|fixtures?|mocks?)/",
    "\\.(test|spec)\\.[a-z]+$",
    "\\.stories\\.[a-z]+$",
    "\\.(md|mdx|txt|rst)$",
    "(^|/)docs?/"
  ],
  "singleAgent": {
    "why": "Mechanical PRs a second agent cannot add to: bots, backports, dependency, translation, timing and publish chores.",
    "authors": [
      "^app/(renovate|dependabot|github-actions)$",
      "\\[bot\\]$",
      "^iheart-web-bot$"
    ],
    "titles": [
      "^\\[Backport #[0-9]+\\]",
      "^\\[chore\\] (Refresh CI test timings|Translation Updates|Publish Packages)",
      "^(chore|fix)\\(deps\\):",
      "^Update (dependency|.+ packages)\\b",
      "^Pin dependencies"
    ]
  }
}
