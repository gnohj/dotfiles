#!/usr/bin/env bash
# Enable the herdr system-info feeder via PATH ACTIVATION: herdr-sysinfo.path starts the
# .service whenever the herdr socket exists, and the daemon exits when it's gone - so it
# runs only while herdr is up, never against a dead socket. (Keyed off the socket, not
# herdr-server.service, since the real server is usually lazy-spawned.)
#
# run_onchange: the hashes below re-run this whenever a unit or the daemon changes, so
# daemon-reload and the restart pick up edits. Linux/systemd only - the uname check makes
# it a clean no-op on macOS, which starts the same daemon via `--kick` from
# herdr-sesh-layout.sh instead (flock-guarded single instance, no launchd job needed).
#
# service sha256: {{ include "dot_config/systemd/user/herdr-sysinfo.service" | sha256sum }}
# path    sha256: {{ include "dot_config/systemd/user/herdr-sysinfo.path" | sha256sum }}
# daemon  sha256: {{ include "dot_local/bin/herdr-scripts/executable_herdr-sysinfo.py" | sha256sum }}
set -eu

[ "$(uname)" = "Linux" ] || exit 0
command -v systemctl >/dev/null 2>&1 || exit 0

systemctl --user daemon-reload
systemctl --user enable --now herdr-sysinfo.path
# Pick up an ExecStart/format/script change on an already-running instance.
systemctl --user try-restart herdr-sysinfo.service 2>/dev/null || true
