#!/usr/bin/env bash
# Account glyph for the Claude Code status line: 🏢 work, 🏠 personal.
# Rendered by prompt-path as row 2's leader (~/.config/ccstatusline/settings.json), which passes the session dir - ccstatusline never sets a widget's cwd, so $PWD alone is whatever directory Claude Code launched from.
#
# Mirrors claude-account's precedence (env > pin > path) rather than shelling out to it: a personal session leaves CLAUDE_ACCOUNT unset by design, so the path rule alone would mislabel a pinned-personal pane in a work repo.
dir="${1:-$PWD}"
acct="${CLAUDE_ACCOUNT:-}"
pin="$HOME/.local/state/claude/account-override"
[ -z "$acct" ] && [ -r "$pin" ] && acct="$(tr -d '[:space:]' <"$pin")"
case "$acct" in
personal | work) ;;
*) case "$dir" in */Developer/web* | */Developer/inferno* | */Developer/actions* | */.treehouse/*) acct=work ;; *) acct=personal ;; esac ;;
esac

# No trailing space: ccstatusline trims widget output (NBSP included), so the gap must come from its own `defaultPadding`.
case "$acct" in
work) printf '🏢' ;;
*) printf '🏠' ;;
esac

# Trailing "!" when this account's stored OAuth token nears its assumed expiry, so a token dies between sessions instead of mid-task. Reads the epoch claude-account precomputes: one file read, no fork per render.
exp=""
expfile="$HOME/.local/state/claude/oauth-$acct.expires"
[ -r "$expfile" ] && read -r exp <"$expfile"
case "$exp" in '' | *[!0-9]*) exit 0 ;; esac

now="$(printf '%(%s)T' -1 2>/dev/null || true)"
case "$now" in '' | *[!0-9]*) now="$(date +%s)" ;; esac

left=$(((exp - now) / 86400))
[ "$left" -le 30 ] || exit 0

# Same palette source and severity split as claude-usage-pct, loaded only when something is actually wrong.
warn="#c0aed2"
red="#da858e"
active="$HOME/.config/colorscheme/active/active-colorscheme.sh"
if [ -r "$active" ]; then
  # shellcheck disable=SC1090
  . "$active" >/dev/null 2>&1
  warn="${gnohj_color01:-$warn}"
  red="${gnohj_color11:-$red}"
fi
[ "$left" -le 7 ] && hex="$red" || hex="$warn"

printf '\033[38;2;%d;%d;%dm!\033[0m' \
  "$((16#${hex:1:2}))" "$((16#${hex:3:2}))" "$((16#${hex:5:2}))"
