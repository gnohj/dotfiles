# herdr server for a named session (%i, e.g. fm-remote, firstmate's remote fleet); herdr-server.service explains each line.
[Unit]
Description=herdr terminal workspace server (session %i)
Documentation=https://herdr.dev/docs/configuration/
After=default.target

[Service]
Type=simple
Environment=HERDR_SESSION=%i
Environment=SHELL=/usr/bin/zsh
# A live server outside the unit (live-handoff, autodetect) holds the socket; skip instead of failing into a restart loop.
ExecCondition=/usr/bin/python3 -c "import socket,sys; sys.exit(1 if socket.socket(socket.AF_UNIX).connect_ex(sys.argv[1]) == 0 else 0)" %h/.config/herdr/sessions/%i/herdr.sock
ExecStart=/usr/bin/zsh -l -c 'exec "$(mise which herdr)" server --session "$HERDR_SESSION"'
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
