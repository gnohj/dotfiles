#!/usr/bin/env python3
# rex-fleet-sync - mirror each second mate on herdr's fm-remote session into a Rex session, one window per mate or task pane; run by rex-fleet-sync.timer.
import json
import os
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.expanduser("~/.local/bin/mux/herdr"))
from herdr_fleet import agent_model_effort, model_label, task_badge, task_metas

HERDR_SESSION = "fm-remote"
STATE = os.path.expanduser("~/.local/state/rex-fleet-sync.json")
MATE_GLYPH = "\U0001f6a2 "
SEP = " · "


def run(*args):
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


def herdr(*args):
    return json.loads(run("herdr", "--session", HERDR_SESSION, *args))["result"]


def rex_json(*args, command=()):
    return json.loads(run("rex", *args, "--json", *(("--", *command) if command else ())))


def follow(pane):
    loop = f"while :; do printf '\\033[H\\033[2J'; herdr --session {HERDR_SESSION} pane read {pane} 2>&1 | tail -n 45; sleep 3; done"
    return ["bash", "-lc", loop]


def load_state():
    try:
        with open(STATE) as f:
            state = json.load(f)
        return state.get("sessions", {}), state.get("windows", {})
    except (OSError, ValueError, AttributeError):
        return {}, {}


def save_state(sessions, windows):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump({"sessions": sessions, "windows": windows}, f)


def mate_windows(mate, panes, agents):
    """[(pane, label)] for one second mate: its own pane first, then every live task it recorded, in herdr order."""
    name = mate["label"][len(MATE_GLYPH):]
    home = os.path.expanduser("~/.local/share/firstmate-" + name)
    order = {p["pane_id"]: i for i, p in enumerate(panes)}
    windows = []
    own = next((p["pane_id"] for p in panes
                if p["workspace_id"] == mate["workspace_id"] and (p.get("cwd") or "").rstrip("/") == home), None)
    if own:
        model = model_label(*agent_model_effort(agents[own])) if own in agents else ""
        windows.append((own, mate["label"] + (SEP + model if model else "")))
    tasks = []
    for task, meta in task_metas(home):
        pane = meta.get("herdr_pane_id")
        if meta.get("herdr_session") != HERDR_SESSION or meta.get("kind") == "secondmate" or pane not in order:
            continue
        tasks.append((order[pane], pane, task_badge(meta, task) or task))
    return windows + [(pane, label) for _, pane, label in sorted(tasks)]


def sync_mate(label, wanted, sid, live_sessions, known):
    """Bring one Rex session in line with `wanted`; returns (session id, {pane: window id})."""
    if sid not in live_sessions:
        sid = next((s for s, l in live_sessions.items() if l == label), None)
    placed = {}
    if sid is None:
        pane, window_label = wanted[0]
        created = rex_json("new", label, "--window", window_label, "--shell", "none", command=follow(pane))
        sid = created["session_id"]
        placed[pane] = created["initial_windows"][0]["window_id"]
    elif live_sessions[sid] != label:
        run("rex", "session", "rename", sid, label)
    current = {w["window_id"]: w["label"] for w in rex_json("window", "list", "-s", sid)["windows"]}
    for pane, window_label in wanted:
        if pane in placed:
            continue
        wid = known.get(pane)
        if wid in current:
            if current[wid] != window_label:
                run("rex", "window", "rename", "-s", sid, wid, window_label)
        else:
            wid = rex_json("window", "new", window_label, "-s", sid, "--focus=false", command=follow(pane))["window_id"]
        placed[pane] = wid
    strays = [wid for wid in current if wid not in placed.values()]
    if strays:
        run("rex", "window", "close", "-s", sid, *strays)
    return sid, placed


def main():
    workspaces = herdr("workspace", "list")["workspaces"]
    panes = herdr("pane", "list")["panes"]
    agents = {a["pane_id"]: a for a in herdr("agent", "list")["agents"]}
    live_sessions = {s["session_id"]: s["label"] for s in rex_json("session", "list")["sessions"]}
    old_sessions, old_windows = load_state()
    sessions, windows = {}, {}
    for mate in (w for w in workspaces if w["label"].startswith(MATE_GLYPH)):
        wanted = mate_windows(mate, panes, agents)
        if not wanted:
            continue
        label = mate["label"]
        sid, placed = sync_mate(label, wanted, old_sessions.get(label), live_sessions, old_windows)
        sessions[label] = sid
        windows.update(placed)
    gone = [sid for label, sid in old_sessions.items() if label not in sessions and sid in live_sessions]
    if gone:
        run("rex", "session", "kill", *gone)
    save_state(sessions, windows)
    print("synced", len(windows), "windows in", len(sessions), "sessions")


if __name__ == "__main__":
    main()
