#!/usr/bin/env bash
# herdr is retired: stop and disable both server units so the next boot does not bring a herdr server back. Linux only.
set -eu

[ "$(uname)" = "Linux" ] || exit 0
command -v systemctl >/dev/null 2>&1 || exit 0

for unit in herdr-server.service herdr-server@fm-remote.service; do
  systemctl --user disable --now "$unit" 2>/dev/null || true
done
# A server started outside the units (autodetect, live-handoff) holds the socket too.
if command -v herdr >/dev/null 2>&1; then
  for sock in "$HOME/.config/herdr/herdr.sock" "$HOME"/.config/herdr/sessions/*/herdr.sock; do
    [ -S "$sock" ] && HERDR_SOCKET_PATH="$sock" herdr server stop 2>/dev/null || true
  done
fi
systemctl --user daemon-reload
echo "herdr-server: retired"
