#!/usr/bin/env python3
"""rift-focus-keeper - refocuses the nearest tile after a close, and places and follows a new window to its rule's workspace."""

import ctypes
import ctypes.util
import fcntl
import json
import os
import re
import select
import signal
import subprocess
import sys
import time
from collections import defaultdict

RIFT = "/opt/homebrew/bin/rift-cli"
# The app's own refocus can reach Rift up to ~50ms before the close event, so newer focus is churn.
CHURN = 0.15
# Rift's wrong raise lands within ~130ms of the close; focus changes after this window are the user's.
ARM_WINDOW = 0.35
# The launching app can win macOS activation back ~30-250ms after a new window appears.
CLAIM_WINDOW = 0.6
# Chrome/Helium web apps hand activation back to their browser ~2-4s after opening.
BROWSER_CLAIM_WINDOW = 6.0
# Login items launch after Rift; following each would throw the desktop around.
LAUNCH_GRACE = 20.0
HISTORY_LIMIT = 50
# Chromium can title a new window after Rift reports it, so title rules stay live this long.
PLACE_WINDOW = 3.0
# A web app's focus bounces repeat, so it is reclaimed once they have been quiet this long.
SETTLE = 0.8
# A focus change this soon after a key or click is the user's, never a bounce.
INPUT_WINDOW = 0.4
# kCGEventLeftMouseDown, RightMouseDown, KeyDown, OtherMouseDown.
INPUT_EVENTS = (1, 3, 10, 25)
ID_RE = re.compile(r"pid: (-?\d+), idx: (\d+)")
# An app on Rift's auto_focus_blacklist is followed here once its focus has held this long.
FOLLOW_SETTLE = 0.25
BLACKLIST_RE = re.compile(r"^auto_focus_blacklist = \[([^\]]*)\]", re.M)
RULE_RE = re.compile(r'\{ app_id = "([^"]+)",(?: title_regex = "([^"]*)",)? (?:workspace = "([A-Z])"|floating = false) \}')
CONFIG = os.path.expanduser("~/.config/rift/config.toml")
# to-desktop touches this around a background open; the age limit covers an opener that died holding it.
HOLD = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "rift", "follow-hold")
HOLD_LIMIT = 10.0

VERBOSE = os.environ.get("RIFT_FOCUS_KEEPER_VERBOSE") == "1"
history = defaultdict(list)
members = {}
centers = {}
focused_before = set()
known_windows = set()
known_pids = set()
placing = {}
started = time.monotonic()
armed = None
claimed = None
last_focused = None
current_focus = None
pending = None
settling = None


def log(message):
    if VERBOSE:
        print(f"{time.monotonic():.3f} {message}", flush=True)


def workspace_key(event):
    return (event["space_id"], event["workspace_id"]["idx"])


def parse_ids(strings):
    return {(int(pid), int(idx)) for pid, idx in ID_RE.findall(" ".join(strings))}


def focus(key, wid, now):
    # The churn Rift caused must not count as user focus, or the next close picks it as "previous".
    history[key][:] = [(t, w) for t, w in history[key] if now - t > ARM_WINDOW]
    subprocess.run(
        [RIFT, "execute", "window", "focus", "--window-id", json.dumps({"pid": wid[0], "idx": wid[1]})],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=2,
    )
    print(f"rift-focus-keeper: refocused {wid[0]}:{wid[1]}", flush=True)


def rift_json(*args):
    out = subprocess.run([RIFT, *args], capture_output=True, text=True, timeout=5).stdout
    return json.loads(out)


def refresh_centers(workspaces=None):
    # Positions must be read before a close: once the window is gone Rift no longer reports its frame.
    try:
        workspaces = workspaces or rift_json("query", "workspaces")
    except (subprocess.SubprocessError, ValueError):
        return
    for ws in workspaces:
        for w in ws.get("windows", []):
            frame = w.get("frame")
            if frame:
                centers[(w["id"]["pid"], w["id"]["idx"])] = (
                    frame["origin"]["x"] + frame["size"]["width"] / 2,
                    frame["origin"]["y"] + frame["size"]["height"] / 2,
                )


def nearest(closed, candidates):
    origin = centers.get(closed)
    known = [w for w in candidates if w in centers]
    if origin is None or not known:
        return None
    return min(known, key=lambda w: (centers[w][0] - origin[0]) ** 2 + (centers[w][1] - origin[1]) ** 2)


def seed():
    # Without a baseline the first close after startup would go unnoticed.
    global last_focused
    try:
        space = next(d["space"] for d in rift_json("query", "displays") if d.get("is_active_space"))
        workspaces = rift_json("query", "workspaces")
    except (subprocess.SubprocessError, ValueError, StopIteration, KeyError):
        return
    refresh_centers(workspaces)
    settled = time.monotonic() - ARM_WINDOW * 2
    for ws in workspaces:
        match = re.search(r"\((\d+)v", ws.get("id", ""))
        if not match:
            continue
        key = (space, int(match.group(1)))
        members[key] = {(w["id"]["pid"], w["id"]["idx"]) for w in ws.get("windows", [])}
        focused_before.update(members[key])
        for w in ws.get("windows", []):
            if w.get("is_focused"):
                history[key].append((settled, (w["id"]["pid"], w["id"]["idx"])))
                last_focused = (w["id"]["pid"], w["id"]["idx"])


def on_windows_changed(event, now):
    global armed
    key = workspace_key(event)
    current = parse_ids(event["windows"])
    before = members.get(key)
    members[key] = current
    hist = history[key]
    gone = (before or set()) - current
    if armed is not None and armed[0] == key and current - (before or set()):
        # A window just opened, so the focus that follows is the user's, not Rift's fallback.
        armed = None
    log(f"windows {key} gone={sorted(w[1] for w in gone)} now={len(current)} history={[(round(now - t, 2), w[1]) for t, w in hist[-4:]]}")
    if not before or not hist or not gone:
        return
    # Only a close of the window that was focused before the post-close focus churn needs fixing.
    settled = [(t, w) for t, w in hist if now - t > CHURN]
    target = None
    if settled and settled[-1][1] in gone:
        closed = settled[-1][1]
        # Fall back to the previously focused window when Rift never reported a frame for it.
        target = nearest(closed, current) or next((w for _, w in reversed(settled[:-1]) if w in current), None)
    hist[:] = [(t, w) for t, w in hist if w not in gone]
    for w in gone:
        centers.pop(w, None)
    log(f"  settled_last={settled[-1][1][1] if settled else None} target={target[1] if target else None}")
    if target is None:
        return
    armed = (key, target, now + ARM_WINDOW)
    if hist and hist[-1][1] != target and now - hist[-1][0] <= CHURN:
        focus(key, target, now)
        armed = None


def window_ids(ws):
    return {(w["id"]["pid"], w["id"]["idx"]) for w in ws.get("windows", [])}


def rift_run(*args):
    subprocess.run([RIFT, "execute", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)


def follow_new_window(wid):
    # Rift focuses a fresh window on its rule's hidden workspace but never switches there.
    try:
        displays = rift_json("query", "displays")
        layouts = {d["uuid"]: rift_json("query", "workspaces", "--display", d["uuid"]) for d in displays}
    except (subprocess.SubprocessError, ValueError, KeyError):
        return False
    home = next(((uuid, ws) for uuid, wss in layouts.items() for ws in wss if wid in window_ids(ws)), None)
    if home is None:
        return False
    uuid, ws = home
    index = ws["index"]
    on_active_display = next(d for d in displays if d["uuid"] == uuid).get("is_active_context")
    if not ws.get("is_active") or not on_active_display:
        # Focusing the display that is already active re-raises its current window, which pulls Rift straight back.
        if not on_active_display:
            rift_run("display", "focus", "--uuid", uuid)
        rift_run("workspace", "switch", str(index))
        print(f"rift-focus-keeper: followed {wid[0]}:{wid[1]} to {ws.get('name')}", flush=True)
        return True
    return False


def rule_workspace(bundle, title):
    # Rift can leave a new window on the spawning display's active workspace instead of its rule's.
    try:
        with open(CONFIG) as f:
            rules = [(app.lower(), regex, ws) for app, regex, ws in RULE_RE.findall(f.read())]
    except OSError:
        return None
    rules = [rule for rule in rules if rule[0] == bundle.lower()]
    matches = [(bool(regex), -i, ws) for i, (_, regex, ws) in enumerate(rules) if not regex or re.search(regex, title, re.I)]
    return (max(matches)[2] or None) if matches else None


def auto_switch_disabled(bundle):
    try:
        with open(CONFIG) as f:
            listed = BLACKLIST_RE.search(f.read())
    except OSError:
        return False
    return bool(listed) and bundle in re.findall(r'"([^"]+)"', listed.group(1))


def follow_held():
    try:
        return time.time() - os.path.getmtime(HOLD) < HOLD_LIMIT
    except OSError:
        return False


def place_window(wid):
    try:
        workspaces = rift_json("query", "workspaces")
    except (subprocess.SubprocessError, ValueError):
        return
    home = next(((ws, w) for ws in workspaces for w in ws.get("windows", []) if (w["id"]["pid"], w["id"]["idx"]) == wid), None)
    if home is None or not home[1].get("title"):
        return
    ws, window = home
    target = rule_workspace(window.get("bundle_id") or "", window["title"])
    index = next((w["index"] for w in workspaces if w.get("name") == target), None)
    if index is None or target == ws.get("name"):
        return
    rift_run("workspace", "move-window", str(index), str(wid[1]))
    print(f"rift-focus-keeper: placed {wid[0]}:{wid[1]} on {target}", flush=True)


def track_new_window(wid, now):
    known_windows.add(wid)
    placing[wid] = now + PLACE_WINDOW
    place_window(wid)


def on_title_changed(event, now):
    wid = (event["window_id"]["pid"], event["window_id"]["idx"])
    if wid in placing and now <= placing[wid]:
        place_window(wid)


def all_window_ids():
    ids = set()
    for display in rift_json("query", "displays"):
        for ws in rift_json("query", "workspaces", "--display", display["uuid"]):
            ids |= window_ids(ws)
    return ids


def remember_windows():
    try:
        known_windows.update(all_window_ids())
        known_pids.update(app["pid"] for app in rift_json("query", "applications"))
    except (subprocess.SubprocessError, ValueError, KeyError):
        pass


def adopt_new_windows(now):
    # A window opening on a hidden workspace often gets no focus event from Rift.
    global claimed
    try:
        fresh = all_window_ids() - known_windows
        if not fresh:
            return
        apps = rift_json("query", "applications")
    except (subprocess.SubprocessError, ValueError, KeyError):
        return
    for wid in [w for w, deadline in placing.items() if now > deadline]:
        del placing[wid]
    for wid in fresh:
        track_new_window(wid, now)
    frontmost = {app["pid"] for app in apps if app.get("is_frontmost")}
    for wid in fresh:
        launched = wid[0] not in known_pids and now - started > LAUNCH_GRACE
        if wid in focused_before or not (wid[0] in frontmost or launched):
            continue
        focused_before.add(wid)
        follow_new_window(wid)
        rift_run("window", "focus", "--window-id", json.dumps({"pid": wid[0], "idx": wid[1]}))
        claimed = (wid, now + CLAIM_WINDOW, now + BROWSER_CLAIM_WINDOW, last_focused)
    known_pids.update(app["pid"] for app in apps)


def app_bundles():
    try:
        return {app["pid"]: app.get("bundle_id") or "" for app in rift_json("query", "applications")}
    except (subprocess.SubprocessError, ValueError, KeyError):
        return {}


def is_browser_reclaim(claim, other, web_bundle):
    # A web app loses focus to its browser, or back to the window it was launched from, a few seconds in.
    browser = app_bundles().get(other[0])
    if browser and web_bundle.startswith(browser + ".app."):
        return True
    return other == claim[3] and ".app." in web_bundle


def seconds_since_input():
    # Mouse movement is not a choice to leave, so only keys and clicks count.
    try:
        since = ctypes.CDLL(ctypes.util.find_library("CoreGraphics")).CGEventSourceSecondsSinceLastEventType
    except (OSError, TypeError, AttributeError):
        return float("inf")
    since.restype = ctypes.c_double
    since.argtypes = [ctypes.c_int32, ctypes.c_uint32]
    return min(since(1, kind) for kind in INPUT_EVENTS)


def reclaim(key, wid, now):
    # Focus by id leaves a hidden workspace hidden, so switch to it first.
    follow_new_window(wid)
    focus(key, wid, now)


def on_tick(now):
    # Once the bounces have settled and the web app holds focus, leaving it is the user's choice.
    global pending, claimed
    if pending is None or now < pending[2]:
        return
    key, wid, deadline = pending
    pending = None
    claimed = None
    if seconds_since_input() <= now - (deadline - SETTLE):
        return
    # Rift can snap back to the old workspace while the web app keeps focus on its hidden one.
    if current_focus == wid:
        follow_new_window(wid)
    else:
        reclaim(key, wid, now)


def follow_settled(now):
    # Rift's own auto-switch flips without end between two windows of one app, so only a settled focus is followed.
    global settling, claimed
    if settling is None or now < settling[1]:
        return
    wid, _, previous = settling
    settling = None
    if claimed is None and current_focus == wid and not follow_held() and follow_new_window(wid):
        rift_run("window", "focus", "--window-id", json.dumps({"pid": wid[0], "idx": wid[1]}))
        claimed = (wid, now + CLAIM_WINDOW, now + BROWSER_CLAIM_WINDOW, previous)


def on_focused_window_changed(event, now):
    global armed, claimed, last_focused, current_focus, pending, settling
    key = workspace_key(event)
    wid = (event["window_id"]["pid"], event["window_id"]["idx"])
    current_focus = wid
    settling = None
    if claimed is not None and now > claimed[2]:
        if wid != claimed[3]:
            pending = None
        claimed = None
    bundle = app_bundles().get(wid[0], "") if claimed is None else ""
    if wid not in focused_before:
        focused_before.add(wid)
        if wid not in known_windows:
            track_new_window(wid, now)
        follow_new_window(wid)
        claimed = (wid, now + CLAIM_WINDOW, now + BROWSER_CLAIM_WINDOW, last_focused)
    elif claimed is None and ".app." in bundle and follow_new_window(wid):
        # A relaunched web app activates its window on a hidden workspace, then bounces back like a new one.
        claimed = (wid, now + CLAIM_WINDOW, now + BROWSER_CLAIM_WINDOW, last_focused)
    elif claimed is not None and wid == claimed[0]:
        pending = (key, wid, now + SETTLE)
    elif claimed is not None and wid != claimed[0] and seconds_since_input() < INPUT_WINDOW:
        pending = None
        claimed = None
    elif claimed is not None and wid != claimed[0]:
        web_bundle = app_bundles().get(claimed[0][0], "")
        if ".app." in web_bundle and (now <= claimed[1] or is_browser_reclaim(claimed, wid, web_bundle)):
            pending = (key, claimed[0], now + SETTLE)
            return
        pending = None
        if now <= claimed[1]:
            reclaim(key, claimed[0], now)
            return
        if ".app." not in web_bundle:
            # Only a web app bounces after the short window, so any other claim ends here.
            claimed = None
    if claimed is None and auto_switch_disabled(bundle or app_bundles().get(wid[0], "")):
        settling = (wid, now + FOLLOW_SETTLE, last_focused)
    last_focused = wid
    log(f"focus {key} {wid[1]} armed={(armed[1][1], round(armed[2] - now, 2)) if armed else None}")
    hist = history[key]
    hist.append((now, wid))
    del hist[:-HISTORY_LIMIT]
    if armed is None:
        return
    armed_key, target, deadline = armed
    if now > deadline:
        armed = None
    elif armed_key == key and wid != target:
        focus(key, target, now)
        armed = None


def acquire_lock():
    root = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "rift")
    os.makedirs(root, exist_ok=True)
    lock = open(os.path.join(root, "focus-keeper.lock"), "a")
    for _ in range(20):
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock
        except BlockingIOError:
            time.sleep(0.1)
    lock.close()
    return None


def stop(signum, frame):
    raise SystemExit(0)


def rift_server_pid():
    found = subprocess.run(["/usr/bin/pgrep", "-nx", "rift"], capture_output=True, text=True).stdout.strip()
    return int(found) if found else None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def events(proc, parent, server):
    pending = b""
    while parent == 1 or os.getppid() == parent:
        wait = 0.2 if settling is None else max(0.0, min(0.2, settling[1] - time.monotonic()))
        if not select.select([proc.stdout], [], [], wait)[0]:
            # The subscription never closes when Rift restarts, so watch the server pid.
            if proc.poll() is not None or (server is not None and not alive(server)):
                return
            yield {"type": "tick"}
            continue
        chunk = os.read(proc.stdout.fileno(), 65536)
        if not chunk:
            return
        pending += chunk
        while b"\n" in pending:
            line, pending = pending.split(b"\n", 1)
            try:
                yield json.loads(line)
            except ValueError:
                continue


def main():
    parent = os.getppid()
    lock = acquire_lock()
    if lock is None:
        return
    proc = None
    status = 0
    try:
        if parent != 1 and os.getppid() != parent:
            return
        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        server = rift_server_pid()
        seed()
        remember_windows()
        proc = subprocess.Popen([RIFT, "subscribe", "mach", "*"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        for event in events(proc, parent, server):
            now = time.monotonic()
            kind = event.get("type")
            if kind == "windows_changed":
                on_windows_changed(event, now)
                adopt_new_windows(now)
                refresh_centers()
            elif kind == "layout_changed":
                refresh_centers()
            elif kind == "focused_window_changed":
                on_focused_window_changed(event, now)
            elif kind == "window_title_changed":
                on_title_changed(event, now)
            elif kind == "tick":
                on_tick(now)
            follow_settled(now)
        if parent == 1 or os.getppid() == parent:
            status = proc.poll() or 1
    finally:
        if proc is not None:
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
            proc.stdout.close()
        lock.close()
    if status:
        sys.exit(status)


if __name__ == "__main__":
    main()
