#!/usr/bin/env bash
# Switch Infinitary's Claude account: a path pin on its data dir plus a matching default login, here and on the dev box.
set -euo pipefail

SELF=infinitary-account
REMOTE_HOST="${INFINITARY_REMOTE_HOST:-dev-box}"
STATE_DIR="$HOME/.local/state/claude"
CURRENT_FILE="$STATE_DIR/infinitary-login"
ACCOUNT_BIN="$HOME/.local/bin/claude-account"
LIVE_SERVICE="Claude Code-credentials"

usage() {
  cat >&2 <<'EOF'
usage: infinitary-account [status] [--local]          account per machine, and each saved login
       infinitary-account <work|personal> [--local]   switch Infinitary here and on the dev box
       infinitary-account auto [--local]              drop the pin: per-repo rule (work orgs -> work) again
       infinitary-account login <work|personal>       browser sign-in for that account on THIS machine
       infinitary-account adopt <work|personal>       record whose login the default login already holds
EOF
}

die() {
  echo "$SELF: $*" >&2
  exit 1
}

data_dir() {
  if [ "$(uname)" = Darwin ]; then
    printf '%s' "$HOME/Library/Application Support/infinitary"
  else
    printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/infinitary"
  fi
}

is_mac() { [ "$(uname)" = Darwin ]; }

check_account() {
  case "${1:-}" in
  work | personal) ;;
  *) die "account must be work or personal" ;;
  esac
}

# The real client, never the wrapper: a sign-in must land in the native store, not the wrapper's token.
real_claude() {
  local c=""
  command -v mise >/dev/null 2>&1 && c="$(mise which claude 2>/dev/null || true)"
  [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return; }
  c="$HOME/.local/share/mise/shims/claude"
  [ -x "$c" ] && { printf '%s' "$c"; return; }
  die "no Claude Code binary found (tried mise and its shims)"
}

hex() { od -An -v -tx1 | tr -d ' \n'; }

keychain_read() {
  security find-generic-password -a "$USER" -s "$1" -w 2>/dev/null || true
}

# `security -i` keeps the credential off the command line but truncates past one 4096-byte line, so a longer item goes on argv.
keychain_write() {
  local value cmd
  value="$(printf '%s' "$2" | hex)"
  cmd="$(printf 'add-generic-password -U -a "%s" -s "%s" -X %s' "$USER" "$1" "$value")"
  if [ "${#cmd}" -lt 4000 ]; then
    printf '%s\n' "$cmd" | security -i >/dev/null
  else
    security add-generic-password -U -a "$USER" -s "$1" -X "$value"
  fi
  [ "$(keychain_read "$1")" = "$2" ] || die "the write to the '$1' keychain item did not read back intact"
}

file_write() {
  local tmp
  mkdir -p "$(dirname "$1")"
  tmp="$(mktemp "$1.XXXXXX")"
  chmod 600 "$tmp"
  printf '%s' "$2" >"$tmp"
  mv -f "$tmp" "$1"
}

live_json() {
  if is_mac; then keychain_read "$LIVE_SERVICE"; else cat "$HOME/.claude/.credentials.json" 2>/dev/null || true; fi
}

live_login() {
  live_json | jq -c '.claudeAiOauth // empty' 2>/dev/null || true
}

write_store() {
  if is_mac; then keychain_write "$LIVE_SERVICE" "$1"; else file_write "$HOME/.claude/.credentials.json" "$1"; fi
}

set_live_login() {
  local merged base="${2:-$(live_json)}"
  merged="$(printf '%s' "$base" | jq -c --argjson login "$1" '(. // {}) + {claudeAiOauth: $login}' 2>/dev/null)" ||
    merged="$(jq -cn --argjson login "$1" '{claudeAiOauth: $login}')"
  write_store "$merged"
}

slot_read() {
  if is_mac; then keychain_read "infinitary-login-$1"; else cat "$STATE_DIR/infinitary-login-$1.json" 2>/dev/null || true; fi
}

slot_write() {
  if is_mac; then keychain_write "infinitary-login-$1" "$2"; else file_write "$STATE_DIR/infinitary-login-$1.json" "$2"; fi
}

current() {
  local v=""
  [ -r "$CURRENT_FILE" ] && v="$(tr -d '[:space:]' <"$CURRENT_FILE")"
  case "$v" in work | personal) printf '%s' "$v" ;; esac
}

set_current() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" >"$CURRENT_FILE"
}

expiry() {
  printf '%s' "$1" | jq -r 'if .expiresAt then (.expiresAt / 1000 | floor | strftime("%Y-%m-%d %H:%M UTC")) else "no expiry" end' 2>/dev/null || printf 'unreadable'
}

# This date survives every renewal, so it identifies the sign-in and dates its end.
sign_in() {
  printf '%s' "$1" | jq -r '.refreshTokenExpiresAt // empty' 2>/dev/null || true
}

sign_in_end() {
  printf '%s' "$1" | jq -r 'select(.refreshTokenExpiresAt) | "\(.refreshTokenExpiresAt / 1000 | floor | strftime("%Y-%m-%d")) \((.refreshTokenExpiresAt / 1000 - now) / 86400 | floor)"' 2>/dev/null || true
}

plan() {
  printf '%s' "$1" | jq -r '.subscriptionType // empty' 2>/dev/null || true
}

ended() {
  local end
  end="$(sign_in_end "$1")"
  [ -n "$end" ] && [ "${end#* }" -lt 0 ]
}

login_state() {
  local end
  end="$(sign_in_end "$1")"
  if [ -z "$end" ]; then
    printf 'access token expires %s' "$(expiry "$1")"
  elif [ "${end#* }" -lt 0 ]; then
    printf 'sign-in ended %s' "${end% *}"
  else
    printf 'sign-in good until %s (%s days)' "${end% *}" "${end#* }"
  fi
}

# A renewal rewrites the date within about a second of itself, so two dates this close are one sign-in.
near() {
  local d
  case "$1$2" in '' | *[!0-9]*) return 1 ;; esac
  [ -n "$1" ] && [ -n "$2" ] || return 1
  d=$(($1 - $2))
  [ "$d" -ge 0 ] || d=$((-d))
  [ "$d" -lt "$3" ]
}

live_owner() {
  local id acct
  id="$(sign_in "$(live_login)")"
  # Two saved logins too close to tell apart: the label decides.
  if [ -z "$id" ] || near "$(sign_in "$(slot_read work)")" "$(sign_in "$(slot_read personal)")" 120000; then
    current
    return 0
  fi
  for acct in "$(current)" work personal; do
    [ -n "$acct" ] || continue
    if near "$(sign_in "$(slot_read "$acct")")" "$id" 60000; then
      printf '%s' "$acct"
      return 0
    fi
  done
  return 0
}

recognise() {
  local owner
  [ -n "$(live_login)" ] || return 0
  owner="$(live_owner)"
  if [ -z "$owner" ]; then
    echo "$SELF: the default login is not one this tool installed; run '$SELF adopt <work|personal>' to say whose it is" >&2
    return 1
  fi
  if [ "$owner" != "$(current)" ]; then
    set_current "$owner"
    echo "$SELF: the default login is the saved $owner one; label corrected"
  fi
}

pinned_account() {
  local dir
  dir="$(data_dir)"
  "$ACCOUNT_BIN" path-pin | awk -F'\t' -v p="$dir" '$1 == p { print $2 }'
}

# Saves the outgoing login first: a renewal replaces its refresh token, so an older saved copy goes stale.
stash_live() {
  local cur login
  cur="$(current)"
  login="$(live_login)"
  [ -n "$login" ] || return 0
  [ -n "$cur" ] || die "the default login belongs to an unrecorded account; run '$SELF adopt <work|personal>' first"
  slot_write "$cur" "$login"
}

switch_login() {
  local want="$1" login end
  recognise || return 1
  login="$(live_login)"
  if [ "$(current)" = "$want" ] && [ -n "$login" ]; then
    if ended "$login"; then
      echo "$SELF: default login is already $want, but its $(login_state "$login"); run '$SELF login $want' here" >&2
      return 1
    fi
    echo "$SELF: default login is already $want, $(login_state "$login")"
    return 0
  fi
  login="$(slot_read "$want")"
  [ -n "$login" ] || { echo "$SELF: no saved $want login on this machine; run '$SELF login $want' here" >&2; return 1; }
  if ended "$login"; then
    echo "$SELF: the saved $want login's $(login_state "$login"); run '$SELF login $want' here" >&2
    return 1
  fi
  stash_live
  set_live_login "$login"
  set_current "$want"
  echo "$SELF: default login is now $want, $(login_state "$login")"
  end="$(sign_in_end "$login")"
  if [ -n "$end" ] && [ "${end#* }" -lt 3 ]; then
    echo "$SELF: that sign-in ends in ${end#* } days; '$SELF login $want' renews it" >&2
  fi
}

set_pin() {
  local dir
  dir="$(data_dir)"
  "$ACCOUNT_BIN" path-pin "$dir" "$1" >/dev/null
  if [ "$1" = auto ]; then
    echo "$SELF: Infinitary follows the per-repo rule again"
  else
    echo "$SELF: Infinitary's crewmates now bill $1"
  fi
}

status_here() {
  local pin cur owner who acct login
  pin="$(pinned_account)"
  cur="$(current)"
  owner="$(live_owner)"
  who="${cur:-unrecorded}"
  if [ -n "$(live_login)" ] && [ -z "$owner" ]; then
    who="not one this tool installed (label says ${cur:-nothing}; $SELF adopt <work|personal>)"
  elif [ -n "$owner" ] && [ "$owner" != "$cur" ]; then
    who="$owner (label says ${cur:-nothing}; the next switch corrects it)"
  fi
  echo "$(hostname -s): crewmates bill ${pin:-per repo (no pin)}; default login $who"
  for acct in personal work; do
    login="$(slot_read "$acct")"
    [ "$acct" = "$owner" ] && login="$(live_login)"
    if [ -n "$login" ] && ended "$login"; then
      echo "  $acct login: saved, but its $(login_state "$login") ($SELF login $acct)"
    elif [ -n "$login" ]; then
      echo "  $acct login: saved, $(login_state "$login")"
    else
      echo "  $acct login: none on this machine ($SELF login $acct)"
    fi
  done
}

remote() {
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$REMOTE_HOST" "\$HOME/.local/bin/$SELF $* --local" ||
    echo "$SELF: $REMOTE_HOST did not finish '$*'; run it there by hand" >&2
}

local_only=0
args=()
for a in "$@"; do
  case "$a" in
  --local) local_only=1 ;;
  *) args+=("$a") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

command -v jq >/dev/null 2>&1 || die "jq required"
[ -x "$ACCOUNT_BIN" ] || die "$ACCOUNT_BIN missing"

case "${1:-status}" in
status)
  status_here
  [ "$local_only" = 1 ] || remote status
  ;;
work | personal)
  set_pin "$1"
  rc=0
  switch_login "$1" || rc=1
  [ "$local_only" = 1 ] || remote "$1"
  exit "$rc"
  ;;
auto)
  set_pin auto
  [ "$local_only" = 1 ] || remote auto
  ;;
adopt)
  check_account "${2:-}"
  [ -n "$(live_login)" ] || die "there is no default login to adopt; run '$SELF login $2'"
  set_current "$2"
  slot_write "$2" "$(live_login)"
  echo "$SELF: recorded the default login as $2"
  ;;
login)
  check_account "${2:-}"
  recognise || exit 1
  stash_live
  before="$(live_json)"
  other=work
  [ "$2" = work ] && other=personal
  was="$(plan "$(slot_read "$2")")"
  theirs="$(plan "$(slot_read "$other")")"
  # A sign-in rewrites the shared ~/.claude.json oauthAccount, so the terminal's copy is restored after.
  saved_account="$(jq -c '.oauthAccount // empty' "$HOME/.claude.json" 2>/dev/null || true)"
  # A failed sign-in can leave the store rewritten without its MCP sign-ins, so the saved copy goes back.
  if ! env -u CLAUDE_CONFIG_DIR -u CLAUDE_CODE_OAUTH_TOKEN -u CLAUDE_ACCOUNT -u ANTHROPIC_API_KEY "$(real_claude)" auth login --claudeai; then
    [ -n "$before" ] && write_store "$before"
    die "the sign-in failed; the previous default login and MCP sign-ins were put back"
  fi
  login="$(live_login)"
  [ -n "$login" ] || die "the sign-in did not leave a login in the default store"
  if [ -n "$saved_account" ]; then
    tmp="$(mktemp "$HOME/.claude.json.XXXXXX")"
    jq --argjson a "$saved_account" '.oauthAccount = $a' "$HOME/.claude.json" >"$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$HOME/.claude.json" || rm -f "$tmp"
  fi
  # A browser still signed into the other account approves as that account without asking.
  now="$(plan "$login")"
  if [ -n "$was" ] && [ "$now" != "$was" ] && [ "$now" = "$theirs" ]; then
    [ -n "$before" ] && write_store "$before"
    die "that sign-in is a '$now' account like the saved $other login, not '$was' like $2; nothing was saved. Switch the browser to the $2 account and run this again"
  fi
  [ -n "$before" ] && set_live_login "$login" "$before"
  slot_write "$2" "$login"
  set_current "$2"
  echo "$SELF: saved the $2 login, $(login_state "$login"); '$SELF $2' now switches Infinitary to it"
  ;;
*)
  usage
  exit 2
  ;;
esac
