{{- $pal := includeTemplate "palette.json" . | fromJson -}}
{
  "version": 4,
  "lines": [
    [
      {
        "id": "cwd",
        "type": "custom-command",
        "commandPath": "$HOME/.local/bin/prompt-path --stdin-json --glyph --align 22 --trailing-sep --color",
        "timeout": 400,
        "preserveColors": true
      },
      {
        "id": "model",
        "type": "model",
        "rawValue": true,
        "color": "hex:{{ $pal.color04 | trimPrefix "#" }}"
      },
      {
        "id": "effort",
        "type": "custom-command",
        "commandPath": "$HOME/.local/bin/claude-effort",
        "timeout": 400,
        "preserveColors": true
      },
      {
        "id": "modes",
        "type": "custom-command",
        "commandPath": "$HOME/.local/bin/agent-mode-glyphs",
        "timeout": 400
      },
      {
        "id": "ctxdot",
        "type": "custom-text",
        "customText": "·",
        "color": "hex:{{ $pal.color13 | trimPrefix "#" }}"
      },
      {
        "id": "ctx",
        "type": "context-percentage",
        "rawValue": true,
        "color": "hex:{{ $pal.color14 | trimPrefix "#" }}"
      },
      {
        "id": "sep1",
        "type": "separator"
      },
      {
        "id": "sesscost",
        "type": "session-cost",
        "rawValue": true,
        "color": "hex:{{ $pal.color02 | trimPrefix "#" }}"
      },
      {
        "id": "mocost",
        "type": "custom-command",
        "commandPath": "$HOME/.local/bin/claude-cost-summary paren",
        "timeout": 2000,
        "color": "hex:{{ $pal.color13 | trimPrefix "#" }}"
      }
    ],
    [
      {
        "id": "branch",
        "type": "custom-command",
        "commandPath": "$HOME/.local/bin/prompt-path --stdin-json --git-ref --account-glyph --align 22 --trailing-sep --color",
        "timeout": 400,
        "preserveColors": true
      },
      {
        "id": "harness",
        "type": "custom-text",
        "customText": "claude",
        "color": "hex:{{ $pal.color13 | trimPrefix "#" }}"
      },
      {
        "id": "harnessDot",
        "type": "custom-text",
        "customText": "·",
        "color": "hex:{{ $pal.color13 | trimPrefix "#" }}"
      },
      {
        "id": "l5h",
        "type": "custom-text",
        "customText": "5h:",
        "color": "hex:{{ $pal.color03 | trimPrefix "#" }}"
      },
      {
        "id": "sess",
        "type": "custom-command",
        "commandPath": "$HOME/.local/bin/claude-usage-pct five_hour",
        "timeout": 400,
        "preserveColors": true
      },
      {
        "id": "sessreset",
        "type": "custom-command",
        "commandPath": "$HOME/.local/bin/claude-usage-reset five_hour",
        "timeout": 400,
        "color": "hex:{{ $pal.color13 | trimPrefix "#" }}"
      },
      {
        "id": "sepB",
        "type": "separator"
      },
      {
        "id": "l7d",
        "type": "custom-text",
        "customText": "7d:",
        "color": "hex:{{ $pal.color03 | trimPrefix "#" }}"
      },
      {
        "id": "week",
        "type": "custom-command",
        "commandPath": "$HOME/.local/bin/claude-usage-pct seven_day",
        "timeout": 400,
        "preserveColors": true
      },
      {
        "id": "weekreset",
        "type": "custom-command",
        "commandPath": "$HOME/.local/bin/claude-usage-reset seven_day",
        "timeout": 400,
        "color": "hex:{{ $pal.color13 | trimPrefix "#" }}"
      }
    ],
    []
  ],
  "flexMode": "full",
  "compactThreshold": 60,
  "colorLevel": 3,
  "defaultPaddingSide": "right",
  "inheritSeparatorColors": false,
  "globalBold": false,
  "gitCacheTtlSeconds": 5,
  "minimalistMode": false,
  "powerline": {
    "enabled": false,
    "separators": [
      ""
    ],
    "separatorInvertBackground": [
      false
    ],
    "startCaps": [],
    "endCaps": [],
    "autoAlign": false,
    "continueThemeAcrossLines": false
  },
  "defaultPadding": " "
}
