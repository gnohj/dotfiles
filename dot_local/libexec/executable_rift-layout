#!/bin/bash
# Switch the active workspace to a layout mode, or flip its orientation if already there.
set -u

target="${1:?usage: rift-layout bsp|traditional|stack|scrolling|floating}"
cli=/opt/homebrew/bin/rift-cli
jq=/usr/bin/jq

current="$("$cli" query workspace-layout 2>/dev/null | "$jq" -r 'first(.[] | select(.is_active)) | .layout_mode // empty' 2>/dev/null)"

if [ "$current" = "$target" ]; then
  # Scrolling and floating have no orientation to flip.
  case "$target" in scrolling | floating) exit 0 ;; esac
  exec "$cli" execute layout toggle-orientation
fi
exec "$cli" execute workspace set-layout "$target"
