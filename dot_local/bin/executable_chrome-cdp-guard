#!/usr/bin/env node
// chrome-cdp-guard <listen-port> <chrome-port> [park-cmd...] - a CDP proxy that never lets a driver raise the review Chrome.
const http = require("node:http");
const net = require("node:net");
const crypto = require("node:crypto");
const { spawn } = require("node:child_process");

const HOST = "127.0.0.1";
// Chrome falls back to [::1] when IPv4 loopback is taken at launch, so follow whichever family answers.
const UPSTREAMS = ["127.0.0.1", "::1"];
let upstreamHost = UPSTREAMS[0];
const listenPort = Number(process.argv[2]);
const chromePort = Number(process.argv[3]);
const parkCmd = process.argv.slice(4);
if (!listenPort || !chromePort) {
  console.error("usage: chrome-cdp-guard <listen-port> <chrome-port> [park-cmd...]");
  process.exit(2);
}

// Each of these activates Chrome, and macOS then drags Rift to its workspace.
const RAISING = new Set(["Page.bringToFront", "Target.activateTarget"]);

let parkTimers = [];
function schedulePark() {
  if (!parkCmd.length) return;
  parkTimers.forEach(clearTimeout);
  // Rift sees a new window a beat after Chrome creates it, so park twice.
  parkTimers = [500, 2000].map((ms) =>
    setTimeout(() => spawn(parkCmd[0], parkCmd.slice(1), { detached: true, stdio: "ignore" }).unref(), ms),
  );
}

class FrameReader {
  constructor(onFrame) {
    this.chunks = [];
    this.length = 0;
    this.onFrame = onFrame;
  }

  push(chunk) {
    this.chunks.push(chunk);
    this.length += chunk.length;
    for (;;) {
      const size = this.frameSize();
      if (size === null || this.length < size) return;
      this.onFrame(this.take(size));
    }
  }

  frameSize() {
    if (this.length < 2) return null;
    if (this.chunks[0].length < 14 && this.chunks.length > 1) this.chunks = [Buffer.concat(this.chunks)];
    const head = this.chunks[0];
    let len = head[1] & 0x7f;
    let off = 2;
    if (len === 126) {
      if (head.length < 4) return null;
      len = head.readUInt16BE(2);
      off = 4;
    } else if (len === 127) {
      if (head.length < 10) return null;
      len = Number(head.readBigUInt64BE(2));
      off = 10;
    }
    if (head[1] & 0x80) off += 4;
    return off + len;
  }

  take(size) {
    if (this.chunks[0].length < size) this.chunks = [Buffer.concat(this.chunks)];
    const first = this.chunks[0];
    const frame = first.subarray(0, size);
    if (first.length === size) this.chunks.shift();
    else this.chunks[0] = first.subarray(size);
    this.length -= size;
    return frame;
  }
}

function decode(frame) {
  const fin = (frame[0] & 0x80) !== 0;
  const opcode = frame[0] & 0x0f;
  let len = frame[1] & 0x7f;
  let off = 2;
  if (len === 126) off = 4;
  else if (len === 127) off = 10;
  const masked = (frame[1] & 0x80) !== 0;
  if (!masked) return { fin, opcode, payload: frame.subarray(off) };
  const mask = frame.subarray(off, off + 4);
  const payload = Buffer.from(frame.subarray(off + 4));
  for (let i = 0; i < payload.length; i++) payload[i] ^= mask[i & 3];
  return { fin, opcode, payload };
}

function encodeText(text, masked) {
  const payload = Buffer.from(text, "utf8");
  const len = payload.length;
  const lenBytes = len < 126 ? 0 : len < 65536 ? 2 : 8;
  const header = Buffer.alloc(2 + lenBytes + (masked ? 4 : 0));
  header[0] = 0x81;
  header[1] = (masked ? 0x80 : 0) | (lenBytes === 0 ? len : lenBytes === 2 ? 126 : 127);
  if (lenBytes === 2) header.writeUInt16BE(len, 2);
  if (lenBytes === 8) header.writeBigUInt64BE(BigInt(len), 2);
  if (!masked) return Buffer.concat([header, payload]);
  const mask = crypto.randomBytes(4);
  mask.copy(header, 2 + lenBytes);
  for (let i = 0; i < len; i++) payload[i] ^= mask[i & 3];
  return Buffer.concat([header, payload]);
}

function parseCommand(frame) {
  const { fin, opcode, payload } = decode(frame);
  if (!fin || opcode !== 1) return null;
  const text = payload.toString("utf8");
  if (!/bringToFront|activateTarget|createTarget/.test(text)) return null;
  try {
    return JSON.parse(text);
  } catch {
    return null;
  }
}

function bridge(req, client, head) {
  const upstream = net.connect(chromePort, upstreamHost);
  const close = () => {
    client.destroy();
    upstream.destroy();
  };
  client.on("error", close).on("close", close);
  upstream.on("error", close).on("close", close);

  const fromClient = new FrameReader((frame) => {
    const msg = parseCommand(frame);
    if (msg && RAISING.has(msg.method)) {
      const reply = { id: msg.id, result: {} };
      if (msg.sessionId) reply.sessionId = msg.sessionId;
      client.write(encodeText(JSON.stringify(reply), false));
      return;
    }
    if (msg && msg.method === "Target.createTarget") {
      // Its own window keeps each page the active tab, so screenshots still paint with activation refused.
      msg.params = { ...msg.params, background: true, newWindow: true };
      schedulePark();
      upstream.write(encodeText(JSON.stringify(msg), true));
      return;
    }
    upstream.write(frame);
  });

  const fromChrome = new FrameReader((frame) => {
    if ((frame[0] & 0x0f) === 1 && frame.includes('"Target.targetCreated"') && frame.includes('"type":"page"')) schedulePark();
    client.write(frame);
  });

  // No permessage-deflate, or the frames above would be compressed and unreadable.
  const lines = [`${req.method} ${req.url} HTTP/1.1`];
  for (let i = 0; i < req.rawHeaders.length; i += 2) {
    if (req.rawHeaders[i].toLowerCase() !== "sec-websocket-extensions") lines.push(`${req.rawHeaders[i]}: ${req.rawHeaders[i + 1]}`);
  }
  upstream.write(lines.join("\r\n") + "\r\n\r\n");
  if (head.length) fromClient.push(head);

  let handshake = Buffer.alloc(0);
  upstream.on("data", (chunk) => {
    if (handshake === null) return fromChrome.push(chunk);
    handshake = Buffer.concat([handshake, chunk]);
    const end = handshake.indexOf("\r\n\r\n");
    if (end < 0) return;
    client.write(handshake.subarray(0, end + 4));
    const rest = handshake.subarray(end + 4);
    handshake = null;
    if (rest.length) fromChrome.push(rest);
  });
  client.on("data", (chunk) => fromClient.push(chunk));
}

const server = http.createServer((req, res) => {
  if (req.url.startsWith("/json/activate/")) {
    res.writeHead(200, { "Content-Type": "text/plain" });
    res.end("Target activated");
    return;
  }
  if (req.url.startsWith("/json/new")) schedulePark();
  // The Host header passes through untouched, so Chrome writes this proxy's port into every webSocketDebuggerUrl.
  const upstream = http.request({ host: upstreamHost, port: chromePort, method: req.method, path: req.url, headers: req.headers }, (up) => {
    res.writeHead(up.statusCode, up.headers);
    up.pipe(res);
  });
  upstream.on("error", () => {
    res.writeHead(502);
    res.end();
  });
  req.pipe(upstream);
});
server.on("upgrade", bridge);
server.listen(listenPort, HOST);

function reachable(host) {
  return new Promise((resolve) => {
    const probe = net.connect(chromePort, host);
    probe.setTimeout(1000, () => probe.destroy());
    probe.on("connect", () => {
      probe.destroy();
      resolve(true);
    });
    probe.on("error", () => {});
    probe.on("close", () => resolve(false));
  });
}

let misses = 0;
async function followUpstream() {
  for (const host of [upstreamHost, ...UPSTREAMS.filter((h) => h !== upstreamHost)]) {
    if (await reachable(host)) {
      upstreamHost = host;
      misses = 0;
      return;
    }
  }
  if (++misses >= 2) process.exit(0);
}
followUpstream();
setInterval(followUpstream, 3000).unref();
