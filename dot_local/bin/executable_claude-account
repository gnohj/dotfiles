#!/usr/bin/env bash
# Resolves which Claude Code account a session should use, based on the current
# directory's git remote — and provides the config dir + OAuth token the
# launchers (claude / cs / cr, incl. the nvim dashboard) inject.
#
# WHY tokens: on macOS the OAuth login lives in ONE shared Keychain entry, so
# CLAUDE_CONFIG_DIR alone can't switch accounts. Each account gets a long-lived
# token (`claude setup-token`) in its own Keychain slot ("claude-oauth-<acct>"),
# injected as CLAUDE_CODE_OAUTH_TOKEN. Token decides WHO; CLAUDE_CONFIG_DIR
# decides WHERE that session's state (history/settings/.claude.json) lives.
#
# SELECTION: a repo whose remote is a configured work org (see work-orgs, kept
# in local state — NOT in dotfiles) → work; everything else (personal repos,
# non-git dirs) → personal. Precedence, highest first: CLAUDE_ACCOUNT env
# (per-shell) > pin file (sticky global) > the cwd rule.
#
#   claude-account                 effective account for the current dir
#   claude-account resolve         same (explicit name; used by `cw`)
#   claude-account dir             its CLAUDE_CONFIG_DIR        (used by launchers)
#   claude-account token           its OAuth token, if stored   (used by launchers)
#   claude-account cwd [path]      account a directory maps to (ignores override)
#   claude-account whoami [--all]  the ORG a token authenticates as (--all: both, warns if identical)
#   claude-account set-org-label <personal|work|uuid> <label>   name an org so whoami prints it
#   claude-account org-labels      list the org -> label map
#   claude-account set-billing-day <personal|work> <1-28>       renewal day (absent = calendar month)
#   claude-account billing-day [a] print it, or "calendar" when unset
#   claude-account pin             print the sticky pin (work|personal|auto)
#   claude-account pin <a>         pin work|personal globally; auto clears it
#   claude-account set-token <a>   store a token for <a> from stdin (Keychain)
#                                  e.g. `claude setup-token | claude-account set-token work`
#   claude-account add-work-org <o>     add a GitHub org that counts as work
#   claude-account work-orgs            list configured work orgs
#   claude-account set-work-email <e>   which email counts as "work" (for row coloring)
#   claude-account work-email           print the configured work email
#   claude-account label-for-email <e>  classify an email -> personal|work
set -euo pipefail

WORK_EMAIL_FILE="$HOME/.local/state/claude/work-email"
WORK_ORGS_FILE="$HOME/.local/state/claude/work-orgs"
# Sticky global account pin. Single source
# of truth for a deliberate account choice: when it holds work|personal it beats
# the cwd rule for EVERY new session (cs / cr / dashboard spawns). Absent/empty
# = auto (fall back to the per-dir git-remote rule). CLAUDE_ACCOUNT still wins.
PIN_FILE="$HOME/.local/state/claude/account-override"

# Account a directory maps to, by its git remote org. iHeart (or any configured
# work org) → work; personal repos / non-git dirs → personal.
account_for_cwd() {
  local dir="${1:-$PWD}" url line
  url="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
  if [ -n "$url" ] && [ -f "$WORK_ORGS_FILE" ]; then
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      case "$line" in \#*) continue ;; esac
      # Matches both ssh (git@host:org/repo) and https (host/org/repo) forms.
      case "$url" in *"$line"/*) echo "work" && return ;; esac
    done <"$WORK_ORGS_FILE"
  fi
  echo "personal"
}

# The sticky pin's value: work|personal when set, else "auto".
read_pin() {
  local v=""
  [ -f "$PIN_FILE" ] && v="$(tr -d '[:space:]' <"$PIN_FILE" 2>/dev/null || true)"
  case "$v" in
  personal | work) echo "$v" ;;
  *) echo "auto" ;;
  esac
}

# Set (work|personal) or clear (auto) the sticky pin. Atomic tmp+mv.
set_pin() {
  case "$1" in
  auto) rm -f "$PIN_FILE" ;;
  personal | work)
    mkdir -p "$(dirname "$PIN_FILE")"
    printf '%s\n' "$1" >"$PIN_FILE.tmp" && mv -f "$PIN_FILE.tmp" "$PIN_FILE"
    ;;
  *)
    echo "usage: claude-account pin <work|personal|auto>" >&2
    return 1
    ;;
  esac
}

# Effective account, highest precedence first: per-shell CLAUDE_ACCOUNT env >
# sticky pin file > the cwd git-remote rule.
resolve_account() {
  local pin
  case "${CLAUDE_ACCOUNT:-}" in
  personal | work)
    echo "$CLAUDE_ACCOUNT"
    return
    ;;
  esac
  pin="$(read_pin)"
  case "$pin" in
  personal | work)
    echo "$pin"
    return
    ;;
  esac
  account_for_cwd "$PWD"
}

account_dir() {
  case "$(resolve_account)" in
  work) echo "$HOME/.claude-work" ;;
  # Personal = Claude's NATIVE default config (~/.claude.json + ~/.claude). We
  # deliberately print nothing so launchers leave CLAUDE_CONFIG_DIR unset —
  # otherwise personal points at ~/.claude/.claude.json, a near-empty config
  # that loses your existing trust/history (re-prompts "trust this folder").
  *) echo "" ;;
  esac
}

# 0600 mirror path: sole token store on Linux, reboot/resume-proof fallback on macOS.
token_file() { printf '%s' "$HOME/.local/state/claude/oauth-$1"; }

# macOS: Keychain primary, 0600-mirror fallback when it reads empty transiently (post-reboot / detached spawn) so we don't drop to the expired shared login. Linux: mirror only.
account_token() {
  local acct t; acct="${1:-$(resolve_account)}"
  if [ "$(uname)" = "Darwin" ]; then
    t="$(security find-generic-password -a "$USER" -s "claude-oauth-$acct" -w 2>/dev/null || true)"
    if [ -n "$t" ]; then printf '%s' "$t"; else cat "$(token_file "$acct")" 2>/dev/null || true; fi
  else
    cat "$(token_file "$acct")" 2>/dev/null || true
  fi
}

# Only the server can answer this (two tokens from the SAME account still differ as strings), and Haiku on purpose since premium models 429 on a bare OAuth request regardless of account.
org_for_account() {
  local tok
  tok="$(account_token "$1")"
  [ -n "$tok" ] || { printf 'no token stored'; return; }
  curl -s --max-time 15 -o /dev/null -D - -X POST \
    -H "Authorization: Bearer $tok" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "anthropic-version: 2023-06-01" \
    -H "content-type: application/json" \
    -d '{"model":"claude-haiku-4-5-20251001","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}' \
    https://api.anthropic.com/v1/messages 2>/dev/null |
    grep -i '^anthropic-organization-id:' | tr -d '\r' | cut -d' ' -f2- |
    grep . || printf 'unresolved (token rejected or offline)'
}

# Hand-set locally since no email is available at a setup-token's scope; an unmapped org prints bare on purpose, so a swapped token shows up as an unfamiliar UUID instead of a stale name.
ORG_LABELS_FILE="$HOME/.local/state/claude/org-labels"

org_label() {
  [ -r "$ORG_LABELS_FILE" ] || return 0
  awk -F'\t' -v o="$1" '$1 == o { print $2; exit }' "$ORG_LABELS_FILE" 2>/dev/null
}

set_org_label() {
  local key="$1" label="$2" org tmp
  case "$key" in
  personal | work) org="$(org_for_account "$key")" ;;
  *) org="$key" ;;
  esac
  case "$org" in
  *-*-*-*-*) ;;
  *)
    echo "✗ Could not resolve an org id from '$key' (got: $org)" >&2
    return 1
    ;;
  esac
  mkdir -p "$(dirname "$ORG_LABELS_FILE")"
  touch "$ORG_LABELS_FILE"
  tmp="$(mktemp)"
  grep -v -F "$org	" "$ORG_LABELS_FILE" >"$tmp" 2>/dev/null || true
  printf '%s\t%s\n' "$org" "$label" >>"$tmp"
  mv -f "$tmp" "$ORG_LABELS_FILE"
  echo "Labeled $org → $label"
}

# Tab-separated so it stays cut/awk-friendly; the label column is omitted when unmapped.
print_whoami_row() {
  local acct="$1" org="$2" label
  label="$(org_label "$org")"
  if [ -n "$label" ]; then
    printf '%s\t%s\t%s\n' "$acct" "$org" "$label"
  else
    printf '%s\t%s\n' "$acct" "$org"
  fi
}

whoami_cmd() {
  local a orgs="" org
  if [ "${1:-}" != "--all" ]; then
    a="$(resolve_account)"
    print_whoami_row "$a" "$(org_for_account "$a")"
    return
  fi
  for a in personal work; do
    org="$(org_for_account "$a")"
    print_whoami_row "$a" "$org"
    case "$org" in *-*-*-*-*) orgs="$orgs$org
" ;; esac
  done
  # Same org in both slots means switching accounts is a silent no-op - the whole point of the check.
  if [ "$(printf '%s' "$orgs" | grep -c .)" -gt 1 ] && [ "$(printf '%s' "$orgs" | sort -u | grep -c .)" -eq 1 ]; then
    echo "warning: personal and work resolve to the SAME org - account switching is a no-op" >&2
    return 1
  fi
}

# Per-account billing anniversary consumed by claude-billing-window; capped at 28 (no February counterpart above that), absent = calendar month.
billing_day_file() { printf '%s' "$HOME/.local/state/claude/billing-day-$1"; }

set_billing_day() {
  local account="$1" day="$2" f
  case "$day" in
  '' | *[!0-9]*)
    echo "✗ Billing day must be a number 1-28 (got '$day')." >&2
    return 1
    ;;
  esac
  if [ "$day" -lt 1 ] || [ "$day" -gt 28 ]; then
    echo "✗ Billing day must be 1-28 (got '$day'); later days have no February counterpart." >&2
    return 1
  fi
  f="$(billing_day_file "$account")"
  mkdir -p "$(dirname "$f")"
  printf '%s\n' "$day" >"$f.tmp" && mv -f "$f.tmp" "$f"
  echo "Billing day for $account → $day"
}

store_token() {
  local account="$1" raw token f
  raw="$(cat)"
  # Extract ONLY the token, even if stdin has surrounding text/ANSI noise.
  # (Don't pipe `claude setup-token` here — it's interactive; its raw TUI output
  # is ~57KB of escape codes, not a token. Run it, copy the token, paste it.)
  token="$(printf '%s' "$raw" | LC_ALL=C grep -aoE 'sk-ant-oat[0-9]+-[A-Za-z0-9_-]+' | head -1)"
  if [ -z "$token" ]; then
    echo "✗ No valid token found on input (expected sk-ant-oat…)." >&2
    echo "  Run \`claude setup-token\` on its own, copy the printed token, then:" >&2
    echo "    claude-account set-token $account   (paste the token, then Ctrl-D)" >&2
    return 1
  fi
  [ "$(uname)" = "Darwin" ] && security add-generic-password -U -a "$USER" -s "claude-oauth-$account" -w "$token"
  # Always write the 0600 mirror: Linux's only store, and macOS's reboot/resume-proof fallback.
  f="$(token_file "$account")"
  mkdir -p "$(dirname "$f")"
  (umask 077; printf '%s' "$token" >"$f")
  echo "Stored OAuth token for → $account (sha=$(printf '%s' "$token" | shasum | cut -c1-12))"
}

add_work_org() {
  mkdir -p "$(dirname "$WORK_ORGS_FILE")"
  touch "$WORK_ORGS_FILE"
  if grep -qxF "$1" "$WORK_ORGS_FILE" 2>/dev/null; then
    echo "Already a work org → $1"
  else
    printf '%s\n' "$1" >>"$WORK_ORGS_FILE"
    echo "Added work org → $1"
  fi
}

# Classify an email -> personal|work using the configured work email. Single
# source of the work/personal POLICY for email; the dashboards mirror the same
# compare in Rust (reading the same work-email file) to color rows by account.
label_for_email() {
  local email="$1" work=""
  [ -f "$WORK_EMAIL_FILE" ] && work="$(cat "$WORK_EMAIL_FILE" 2>/dev/null)"
  if [ -n "$email" ] && [ -n "$work" ] && [ "$email" = "$work" ]; then
    echo "work"
  else
    echo "personal"
  fi
}

case "${1:-get}" in
get | resolve) resolve_account ;;
dir) account_dir ;;
token) account_token ;;
cwd) account_for_cwd "${2:-$PWD}" ;;
whoami) whoami_cmd "${2:-}" ;;
set-org-label)
  [ -n "${2:-}" ] && [ -n "${3:-}" ] || {
    echo "usage: claude-account set-org-label <personal|work|org-uuid> <label>" >&2
    exit 1
  }
  set_org_label "$2" "$3"
  ;;
org-labels) cat "$ORG_LABELS_FILE" 2>/dev/null || true ;;
set-billing-day)
  case "${2:-}" in
  personal | work) set_billing_day "$2" "${3:-}" ;;
  *)
    echo "usage: claude-account set-billing-day <personal|work> <1-28>" >&2
    exit 1
    ;;
  esac
  ;;
billing-day) cat "$(billing_day_file "${2:-$(resolve_account)}")" 2>/dev/null || echo "calendar" ;;
pin)
  if [ $# -ge 2 ]; then set_pin "$2"; else read_pin; fi
  ;;
# Print shell `export` lines for the current dir's account, for launchers that
# can't use cs/cr (e.g. gh-dash): `eval "$(claude-account env)" && claude …`.
# Emits nothing for personal-with-no-token (native config), so eval is a no-op.
env)
  _d="$(account_dir)"
  _t="$(account_token)"
  [ -n "$_d" ] && printf 'export CLAUDE_CONFIG_DIR=%q\n' "$_d"
  [ -n "$_t" ] && printf 'export CLAUDE_CODE_OAUTH_TOKEN=%q\n' "$_t"
  ;;
# Seed onboarding-done + per-cwd folder-trust into the resolved account's .claude.json (only when a token exists), so a headless/fresh box skips claude's login + "trust this folder" prompts. Idempotent + read-guarded so a large .claude.json isn't rewritten each launch; no-op without jq/token.
seed-config)
  _t="$(account_token)"; [ -n "$_t" ] || exit 0
  command -v jq >/dev/null 2>&1 || exit 0
  _d="$(account_dir)"; _cj="${_d:-$HOME}/.claude.json"
  if [ -f "$_cj" ] && [ "$(jq -r --arg p "$PWD" '(.hasCompletedOnboarding == true) and (.projects[$p].hasTrustDialogAccepted == true)' "$_cj" 2>/dev/null)" = "true" ]; then exit 0; fi
  [ -f "$_cj" ] || { mkdir -p "$(dirname "$_cj")"; printf '{}' >"$_cj"; }
  _tmp="$(mktemp)"
  jq --arg p "$PWD" '.hasCompletedOnboarding = true | .projects[$p].hasTrustDialogAccepted = true' "$_cj" >"$_tmp" 2>/dev/null && mv "$_tmp" "$_cj" || rm -f "$_tmp"
  ;;
set-token)
  case "${2:-}" in
  personal | work) store_token "$2" ;;
  *)
    echo "usage: claude-account set-token <personal|work>   (token on stdin)" >&2
    exit 1
    ;;
  esac
  ;;
add-work-org)
  [ -n "${2:-}" ] || {
    echo "usage: claude-account add-work-org <org>" >&2
    exit 1
  }
  add_work_org "$2"
  ;;
work-orgs) cat "$WORK_ORGS_FILE" 2>/dev/null || true ;;
work-email) cat "$WORK_EMAIL_FILE" 2>/dev/null || true ;;
set-work-email)
  [ -n "${2:-}" ] || {
    echo "usage: claude-account set-work-email <email>" >&2
    exit 1
  }
  mkdir -p "$(dirname "$WORK_EMAIL_FILE")"
  printf '%s\n' "$2" >"$WORK_EMAIL_FILE"
  echo "Work email → $2"
  ;;
label-for-email) label_for_email "${2:-}" ;;
*)
  echo "usage: claude-account [get|resolve|dir|token|cwd|whoami [--all]|set-org-label <a> <l>|org-labels|set-billing-day <a> <d>|billing-day [a]|pin [<a>]|seed-config|set-token <a>|add-work-org <o>|work-orgs|set-work-email <e>|work-email|label-for-email <e>]" >&2
  exit 1
  ;;
esac
