#!/usr/bin/env bash
# Converge live second mates onto the account pin through firstmate's own restart path; a credential is fixed at launch, so only a replacement moves one.
set -euo pipefail

# BSD ps carries the environment, procfs does elsewhere; this repo runs on both.
proc_env() { # <pid> -> its environment, one VAR=value per line
  if [ "$(uname)" = Darwin ]; then
    ps -Eww -p "$1" -o command= 2>/dev/null | tr ' ' '\n'
  else
    tr '\0' '\n' <"/proc/$1/environ" 2>/dev/null
  fi
}

sha256_digest() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; }

MODE=${1:-check}
FM_HOME=${FM_HOME:-$HOME/.local/share/firstmate}
ROOT=${FIRSTMATE_DIR:-$HOME/Developer/firstmate}
SELF=$(basename "$0")

pin=$(claude-account pin 2>/dev/null || echo auto)
if [ "$pin" = auto ]; then
  echo "$SELF: pin is auto, so there is no fleet-wide intended account; nothing to converge"
  exit 0
fi

want=$(CLAUDE_ACCOUNT="$pin" claude-account token 2>/dev/null || true)
if [ -z "$want" ]; then
  echo "$SELF: no token is stored for pinned account '$pin'; refusing rather than relaunching blind" >&2
  exit 1
fi

fp() { printf '%s' "${1:-}" | sha256_digest | cut -c1-12; }
want_fp=$(fp "$want")
want_dir=$(CLAUDE_ACCOUNT="$pin" claude-account dir 2>/dev/null || true)

live_pid() { # <herdr-pane-id>
  herdr pane process-info --pane "$1" 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for p in d.get("result",{}).get("process_info",{}).get("foreground_processes",[]):
    if p.get("argv0")=="claude":
        print(p["pid"]); break
' 2>/dev/null || true
}

drift=""
unattributed=""
for meta in "$FM_HOME"/state/*.meta; do
  [ -f "$meta" ] || continue
  grep -q '^kind=secondmate$' "$meta" 2>/dev/null || continue
  id=$(basename "$meta" .meta)
  pane=$(grep -m1 '^herdr_pane_id=' "$meta" 2>/dev/null | cut -d= -f2- || true)
  if [ -z "$pane" ]; then
    echo "$SELF: $id records no herdr pane; skipped"
    continue
  fi
  pid=$(live_pid "$pane")
  if [ -z "$pid" ]; then
    echo "$SELF: $id has no live agent; skipped because firstmate recovery owns a dead mate"
    continue
  fi
  tok=$(proc_env "$pid" | sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' | head -1 || true)
  if [ -z "$tok" ]; then
    echo "$SELF: $id injects no token, so its pane bypasses the claude wrapper and a relaunch could not resume it; left alone. Report to the captain."
    unattributed="$unattributed $id"
  elif [ "$(fp "$tok")" = "$want_fp" ] && [ "$(proc_env "$pid" | sed -n 's/^CLAUDE_CONFIG_DIR=//p' | head -1)" = "$want_dir" ]; then
    echo "$SELF: $id already on '$pin' and its paired store; left alone"
  elif [ "$(fp "$tok")" = "$want_fp" ]; then
    echo "$SELF: $id bills '$pin' but reads another state store; needs relaunch"
    drift="$drift $id"
  else
    echo "$SELF: $id drifted from '$pin'; needs relaunch"
    drift="$drift $id"
  fi
done

drift=${drift# }
unattributed=${unattributed# }
[ -n "$unattributed" ] && echo "$SELF: unattributable (no injected token): $unattributed"
if [ -z "$drift" ]; then
  if [ -n "$unattributed" ]; then
    echo "$SELF: no mate needs a relaunch, but the account of $unattributed could not be confirmed"
  else
    echo "$SELF: every live second mate already runs the '$pin' account"
  fi
  exit 0
fi
if [ "$MODE" != apply ]; then
  echo "$SELF: would restart: $drift"
  echo "$SELF: each restart resumes the mate's live conversation under the same id"
  exit 0
fi
# fm-fleet-converge owns the exact-resume relaunch, so a second path here could never drift from it.
exec "$HOME/.local/bin/fm-fleet-converge" secondmate-account apply
