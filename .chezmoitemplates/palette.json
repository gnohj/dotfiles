{{- /* The gnohj_color* palette as JSON, resolved at apply time so a config chezmoi renders matches byte-for-byte what colorscheme-set.sh writes - otherwise chezmoi reads the generated file as drift and reverts it on the next apply. */ -}}
{{- $seed := printf `. "%s/dot_config/colorscheme/list/executable_evergarden-winter-mute-colors.sh" 2>/dev/null
. "%s/dot_config/colorscheme/executable_palette.sh" 2>/dev/null` .chezmoi.sourceDir .chezmoi.sourceDir -}}
{{- $script := print $seed `
printf '{'
sep=
for v in $(compgen -v | grep '^gnohj_color[0-9]*$'); do
  eval "val=\$$v"
  case "$val" in "#"??????) ;; *) continue ;; esac
  printf '%s"%s":"%s"' "$sep" "${v#gnohj_}" "$val"
  sep=,
done
printf '%s"text":"%s","text_muted":"%s","selection":"%s","accent":"%s"}' "$sep" "$gnohj_text" "$gnohj_text_muted" "$gnohj_selection" "$gnohj_accent"` -}}
{{- output "bash" "-c" $script -}}
