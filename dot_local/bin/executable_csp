#!/usr/bin/env bash
# Claude start on the personal account; the claude wrapper derives its config dir and token from CLAUDE_ACCOUNT.
if [ -n "${REX_RECOVER_LAUNCH_DIR:-}" ]; then # rex-recover restores csp only in the dotfiles session, continuing
  label=$(rex --autostart=false session inspect "${REX_SESSION:-}" --json 2>/dev/null | jq -r '.label // empty')
  case "$label" in *dotfiles) set -- --continue ;; *) exit 0 ;; esac
fi
unset REX_RECOVER_LAUNCH_DIR
CLAUDE_ACCOUNT=personal exec "$HOME/.local/bin/cs" "$@"
