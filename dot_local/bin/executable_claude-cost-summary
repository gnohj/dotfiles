#!/usr/bin/env bash
# Cost summary for the status line: "$130.49 today / $1241.13 mo".
# Wired in as a ccstatusline `custom-command` widget, which pipes it the session JSON.
#
# Rendering is cat-only: ccusage's ~1.9s full-corpus parse straddled this widget's 2000ms timeout, and each kill orphaned it onto launchd at 100% CPU and leaked a mktemp file, so the claude-cost-refresh LaunchAgent owns that call now via `--refresh`.
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/claude-cost"

money() { awk -v v="$1" 'BEGIN { printf "$%.2f", v }'; }

ccusage_bin=""
for candidate in "$HOME"/.bun/install/global/node_modules/@ccusage/ccusage-*/bin/ccusage; do
  [ -x "$candidate" ] && ccusage_bin="$candidate" && break
done

# Deliberately global: the EXIT trap has to see it, and a `local tmp` in the function would shadow it away.
tmp=""
cleanup() { [ -n "$tmp" ] && rm -f "$tmp"; }
trap cleanup EXIT INT TERM HUP

# Pinned rather than inherited: a personal pane leaves CLAUDE_CONFIG_DIR unset and a work pane inherits only ~/.claude-work, so naming it makes each total reproducible from any pane.
config_dir_for() { case "$1" in work) printf '%s' "$HOME/.claude-work" ;; *) printf '%s' "$HOME/.claude" ;; esac; }

# ccusage stays a plain child of this script and is never detached: a ppid-1 ccusage at 100% of a core is exactly what the orphan monitor's CPU bucket banners.
refresh_account() {
  cost_dirs="$(config_dir_for "$1")"
  [ -d "$cost_dirs" ] || return 0
  cache="$cache_dir/totals-$1"
  tmp="$(mktemp "$cache_dir/totals.XXXXXX")" || return 0
  # Month sums from the billing anchor, not the 1st, so it matches the "mo:" countdown exactly.
  anchor="$("$HOME/.local/bin/claude-billing-window" "$1" 2>/dev/null | cut -d' ' -f1)"
  [ -n "$anchor" ] || anchor="$(date +%Y-%m)-01"
  if CLAUDE_CONFIG_DIR="$cost_dirs" "$ccusage_bin" daily --json 2>/dev/null |
    jq -r --arg d "$(date +%Y-%m-%d)" --arg a "$anchor" '
      ([.daily[] | select(.period == $d) | .totalCost] | add // 0) as $today
      | ([.daily[] | select(.period >= $a) | .totalCost] | add // 0) as $month
      | "\($today)\t\($month)"' >"$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv -f "$tmp" "$cache"
  fi
  rm -f "$tmp"
  tmp=""
}

# Both accounts, because the agent runs with no session context and either pane may render next. launchd never overlaps two copies of one job, so no lock is needed.
if [ "${1:-}" = "--refresh" ]; then
  command -v jq >/dev/null 2>&1 || exit 0
  [ -n "$ccusage_bin" ] || exit 0
  mkdir -p "$cache_dir" || exit 0
  refresh_account personal
  refresh_account work
  exit 0
fi

# Drained but unused - ccstatusline writes the session payload here and would see EPIPE if nothing read it.
cat >/dev/null

# Mirrors claude-account-glyph's precedence (env > pin > path); duplicated because claude-account resolves the cwd rule with `git remote get-url`, too slow on the render path. Keep the two in step.
acct="${CLAUDE_ACCOUNT:-}"
pin="$HOME/.local/state/claude/account-override"
[ -z "$acct" ] && [ -r "$pin" ] && acct="$(tr -d '[:space:]' <"$pin")"
case "$acct" in
personal | work) ;;
*) case "$PWD" in */Developer/web* | */Developer/inferno* | */Developer/actions* | */.treehouse/*) acct=work ;; *) acct=personal ;; esac ;;
esac

# Per account, not shared: a single cache let the daily total flip between accounts depending on which pane rendered last and won the write.
cache="$cache_dir/totals-$acct"
[ -r "$cache" ] || exit 0
IFS=$'\t' read -r today month <"$cache"

case "${1:-paren}" in
paren) [ -n "$today" ] && [ -n "$month" ] && printf '(%s/%s)' "$(money "$today")" "$(money "$month")" ;;
month) [ -n "$month" ] && printf '(%s mo)' "$(money "$month")" ;;
today) [ -n "$today" ] && printf '%s today' "$(money "$today")" ;;
esac
