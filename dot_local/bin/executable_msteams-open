#!/usr/bin/env bash
# Map an msteams: or https Teams link onto the PWA's teams.cloud.microsoft origin and let Teams Link load it.
set -euo pipefail

LOG="$HOME/.logs/msteams-open.log"

url="${1:-}"
[ -n "$url" ] || exit 0

# Seen in the wild: msteams:/l/…, msteams://teams.microsoft.com/l/…, and https links on either Teams host.
path="$url"
path="${path#msteams-enterprise:}"
path="${path#msteams:}"
path="${path#https:}"
path="${path#http:}"
path="${path#//teams.microsoft.com}"
path="${path#//teams.cloud.microsoft}"
case "$path" in /*) ;; *) path="/$path" ;; esac

# A bare /l/ path hits the "open in app" launcher until the web app is running, so it rides in the /v2/ fragment.
origin="https://teams.cloud.microsoft"
case "$path" in
  /v2/* | /v2) target="$origin$path" ;;
  /l/meetup-join/*) target="$origin/v2/?meetingjoin=true#$path" ;;
  *) target="$origin/v2/#$path" ;;
esac

mkdir -p "$(dirname "$LOG")"
printf '[%s] %s -> %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$url" "$target" >>"$LOG"

exec open -b com.gnohj.teams-link "$target"
