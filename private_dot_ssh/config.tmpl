Host github.com
  AddKeysToAgent yes
  # Without these a wifi blip leaves ssh hung ~2h until TCP keepalive finally reaps it.
  ConnectTimeout 10
  ServerAliveInterval 15
  ServerAliveCountMax 3
{{- if eq .chezmoi.os "darwin" }}
  # macOS: sign with the keychain-held identity key. On the VPS this block is
  # omitted — no private key on the box, git rides the forwarded agent instead.
  IgnoreUnknown UseKeychain
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
Host tailscale
  HostName {{ .devbox_host }}

# Name comes from devbox_host in .chezmoidata.toml; no HostName below, so any future {{ .devbox_host }}-N resolves by its own MagicDNS name.
# RemoteForward exposes this mac's Chrome CDP port on the box for chrome-devtools-mcp.
# LocalForward points this mac's 8085 at the box's, so radioctl's OAuth callback
# (redirect_uri is hardcoded 127.0.0.1:8085) reaches the listener waiting on the box.
# herdr --remote includes this file, so the forward rides the session you already have.
Host {{ .devbox_host }} {{ .devbox_host }}-* tailscale
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519
  RemoteForward 9222 127.0.0.1:9222
  LocalForward 8085 127.0.0.1:8085
  User gnohj
{{- end }}