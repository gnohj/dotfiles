#!/usr/bin/env bash
# Single source of Claude Code account auth: every launcher (zsh `claude`, cs, cr, Rex, systemd) goes through here, so a non-interactive spawn authenticates exactly like an interactive one.
set -euo pipefail

# Resolve the REAL binary, never this wrapper: mise owns the install and only .zshrc adds its bin dir, so a bare PATH lookup fails outside an interactive zsh.
_self="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"

_real_claude() {
  local c d
  if command -v mise >/dev/null 2>&1; then
    c="$(mise which claude 2>/dev/null || true)"
    [ -n "$c" ] && [ -x "$c" ] && {
      printf '%s' "$c"
      return
    }
  fi
  c="$HOME/.local/share/mise/shims/claude"
  [ -x "$c" ] && {
    printf '%s' "$c"
    return
  }
  local IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    c="$d/claude"
    [ -x "$c" ] || continue
    [ "$(cd "$d" && pwd -P)/claude" = "$_self" ] && continue
    printf '%s' "$c"
    return
  done
}

_bin="$(_real_claude)"
if [ -z "$_bin" ]; then
  echo "claude: no Claude Code binary found (tried mise, mise shims, PATH)" >&2
  exit 127
fi

# Infinitary renews its default login through these, so they must reach the native store.
case "${1:-}" in
auth | doctor)
  case "$(ps -o comm= -p "$PPID" 2>/dev/null || true)" in
  */Infinitary | infinitary | */infinitary)
    exec env -u CLAUDE_CODE_OAUTH_TOKEN -u CLAUDE_CONFIG_DIR -u CLAUDE_ACCOUNT "$_bin" "$@"
    ;;
  esac
  ;;
esac

# claude-account-state-v1
if [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
  # set only inside a running session, so these were inherited and must not outrank the pin
  unset CLAUDE_ACCOUNT
  case "${CLAUDE_CONFIG_DIR:-}" in "$HOME/.claude-work" | "$HOME/.claude") unset CLAUDE_CONFIG_DIR ;; esac
fi

_resume_target() {
  local prev="" arg
  for arg in "$@"; do
    case "$arg" in --resume=*) printf '%s' "${arg#--resume=}"; return ;; esac
    case "$prev" in -r | --resume) printf '%s' "$arg"; return ;; esac
    prev="$arg"
  done
}

_account_owning_session() {
  local id="$1" acct dir found=""
  for acct in personal work; do
    dir="$(CLAUDE_ACCOUNT="$acct" claude-account dir)"
    [ -n "$(find "${dir:-$HOME/.claude}/projects" -mindepth 2 -maxdepth 2 -name "$id.jsonl" -print -quit 2>/dev/null)" ] || continue
    [ -z "$found" ] || return 0
    found="$acct"
  done
  printf '%s' "$found"
}

# Resuming a conversation from the other account's store would report "No conversation found".
if [ -z "${CLAUDE_ACCOUNT:-}${CLAUDE_CODE_OAUTH_TOKEN:-}${CLAUDE_CONFIG_DIR:-}${FM_TASK_ID:-}" ] && [ -z "$(claude-account store-pin "$PWD")" ]; then
  _resume_arg="$(_resume_target "$@")"
  if [[ "$_resume_arg" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    _owner="$(_account_owning_session "$_resume_arg")"
    [ -z "$_owner" ] || export CLAUDE_ACCOUNT="$_owner"
  fi
fi

case "${CLAUDE_ACCOUNT:-}" in
"" | work | personal) ;;
*) echo "claude: unknown account choice" >&2; exit 1 ;;
esac
_account="$(claude-account resolve)"
case "$_account" in
work | personal) ;;
*) echo "claude: cannot resolve the selected account" >&2; exit 1 ;;
esac

if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ -z "${CLAUDE_ACCOUNT:-}" ]; then
  _matched=""
  for _candidate in work personal; do
    _candidate_token="$(CLAUDE_ACCOUNT="$_candidate" claude-account token)"
    if [ -n "$_candidate_token" ] && [ "$CLAUDE_CODE_OAUTH_TOKEN" = "$_candidate_token" ]; then
      [ -z "$_matched" ] || { echo "claude: account token is ambiguous" >&2; exit 1; }
      _matched="$_candidate"
    fi
  done
  [ -n "$_matched" ] || { echo "claude: supplied OAuth token is not a known account" >&2; exit 1; }
  _account="$_matched"
fi

export CLAUDE_ACCOUNT="$_account"
_expected="$(claude-account dir)"
_tok="$(claude-account token)"
[ -n "$_tok" ] || { echo "claude: no OAuth token for the selected account" >&2; exit 1; }
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && [ "$CLAUDE_CODE_OAUTH_TOKEN" != "$_tok" ]; then
  echo "claude: supplied OAuth token does not match the selected account" >&2
  exit 1
fi

if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ "$CLAUDE_CONFIG_DIR" != "$_expected" ]; then
  echo "claude: explicit state store does not match $_account token; migrate its conversation before changing the launch" >&2
  exit 1
fi

if [ -n "${FM_TASK_ID:-}" ]; then
  _worker_pin="${FM_HOME:-$HOME/.local/share/firstmate}/config/claude-account"
  if [ -e "$_worker_pin" ] || [ -L "$_worker_pin" ]; then
    [ -f "$_worker_pin" ] && [ ! -L "$_worker_pin" ] || { echo "claude: invalid worker state-store override" >&2; exit 1; }
    IFS= read -r _worker_store <"$_worker_pin" || true
    [ "$_worker_store" = ordinary ] && _worker_store=""
    [ "$_worker_store" = "$_expected" ] || { echo "claude: worker state store does not match $_account token; migrate its conversation before removing the override" >&2; exit 1; }
  fi
fi

# claude-session-resume-v1: a pending migration marker for this path resumes its conversation instead of starting fresh.
_resume=()
if [ -s "$HOME/.local/state/claude/resume-by-path" ]; then
  _resume_id="$(claude-session-migrate launch "$PWD")" || exit 1
  if [ -n "$_resume_id" ]; then
    for _arg in "$@"; do
      case "$_arg" in
      -c | -r | --continue | --resume | --resume=* | --session-id | --session-id=* | --fork-session)
        echo "claude: a pending conversation migration conflicts with $_arg" >&2
        exit 1
        ;;
      esac
    done
    _resume=(--resume "$_resume_id" --system-prompt-snapshot off)
  fi
fi

_declared_store="$(claude-account store-pin "$PWD")"
_store_pin="$_declared_store"
case "$_store_pin" in
ordinary) _store_pin="" ;;
"" | /*) ;;
*) echo "claude: invalid state-store override" >&2; exit 1 ;;
esac
if [ -n "$_declared_store" ]; then
  [ "$_store_pin" = "$_expected" ] || { echo "claude: pinned state store does not match $_account token; migrate its conversation before removing the override" >&2; exit 1; }
fi
unset CLAUDE_CONFIG_DIR
[ -z "$_expected" ] || export CLAUDE_CONFIG_DIR="$_expected"
export CLAUDE_CODE_OAUTH_TOKEN="$_tok"
claude-account seed-config --dir "${_expected:-ordinary}"

# Claude Code trusts kitty graphics only from terminals it names; Rex passes them through unnamed.
if [ "${TERM_PROGRAM:-}" = rex ]; then
  export CLAUDE_CODE_FORCE_TERMINAL_IMAGES="${CLAUDE_CODE_FORCE_TERMINAL_IMAGES:-1}"
fi

# Rex 0.1.0-preview.23 stopped exporting REX_SESSION, which firstmate's Rex backend still requires to detect Rex.
if [ "${TERM_PROGRAM:-}" = rex ] && [ -z "${REX_SESSION:-}" ] && [ -n "${REX_BLOCK:-}" ]; then
  _rex_sid="$("${REX_BIN_DIR:+$REX_BIN_DIR/}rex" --autostart=false session inspect "$REX_BLOCK" --json 2>/dev/null | jq -r '.session_id // empty' 2>/dev/null || true)"
  [ -z "$_rex_sid" ] || export REX_SESSION="$_rex_sid"
fi

# A firstmate home can be resumed as a bare `claude --resume`; scoped here so nothing else started there inherits medium.
_fm_home_model() {
  case "$PWD" in
    "$HOME/Developer/firstmate") echo claude-sonnet-5-5 ;;
    "$HOME"/.local/share/firstmate-sm-*/*) ;;
    "$HOME"/.local/share/firstmate-sm-*) echo claude-opus-5-5 ;;
  esac
}
_fm_model="$(_fm_home_model)"
if [ -n "$_fm_model" ]; then
  export ANTHROPIC_MODEL="$_fm_model" CLAUDE_CODE_EFFORT_LEVEL=medium
fi

# fm exports FM_HOME, but a Rex program resume starts `claude --resume` with a fresh terminal's environment.
if [ "$PWD" = "$HOME/Developer/firstmate" ] && [ -z "${FM_HOME:-}" ]; then
  export FM_HOME="$HOME/.local/share/firstmate"
fi

exec "$_bin" ${_resume[@]+"${_resume[@]}"} "$@"
