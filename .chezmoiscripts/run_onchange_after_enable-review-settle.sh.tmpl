#!/usr/bin/env bash
# service sha256: {{ include "dot_config/systemd/user/review-settle.service" | sha256sum }}
# timer sha256: {{ include "dot_config/systemd/user/review-settle.timer" | sha256sum }}
set -eu

[ "$(uname)" = "Linux" ] || exit 0
command -v systemctl >/dev/null 2>&1 || exit 0

systemctl --user daemon-reload
systemctl --user enable --now review-settle.timer

echo "review-settle.timer enabled (every 15 minutes)."
