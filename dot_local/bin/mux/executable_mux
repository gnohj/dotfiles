#!/usr/bin/env bash
# mux — one entry point for "where is the user looking, and put this there".
# Verb-dispatched; run `mux help` for the list. config/mux.lua is a thin shim over
# it, mirroring only kind() to stay off a subprocess on dashboard render.
set -uo pipefail

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/run/current-system/sw/bin:$HOME/.local/share/mise/shims:$PATH"
herdr="${HERDR_BIN_PATH:-herdr}"

# mux_kind() — shared with launcher.sh so there is one definition of "which mux is live".
# shellcheck source=/dev/null
. "$HOME/.local/bin/mux/shared/mux-detect.sh"

die() { printf 'mux: %s\n' "$1" >&2; exit "${2:-1}"; }
need_jq() { command -v jq >/dev/null 2>&1 || die "jq required for herdr or Rex"; }

cmd_help() {
  cat <<'EOF'
mux - multiplexer operations against whichever of herdr/Rex/tmux is live.

  mux kind                                 herdr | rex | tmux | none
  mux session-label                        workspace/session name, emoji stripped
  mux window [OPTS] <name> <cwd> <cmd>     open a command in the invoking workspace
  mux split  <cwd> <cmd>                   run a command beside the current pane
  mux focus  <pane-id>                     focus a pane by recorded id
  mux send-keys <pane-id> <key>...         send key presses to a pane
  mux pane-pids <pane-id>                  pids in the pane's foreground
  mux pane-width <pane-id>                 columns the pane currently occupies
  mux session [--label NAME] [--no-focus] [<cwd>]
                                           focus a session/workspace, building
                                           one at <cwd> if none exists
  mux tabs [--all-muxes]                  "<id><TAB><label>" per open window/tab
  mux pane-cwds [--all-muxes]              cwd of every open pane, one per line
                                           --all-muxes is read-only; errors fail
  mux close  <id>                          close a window/tab by `mux tabs` id
  mux notify [OPTS] <message>              transient message
  mux popup  [OPTS] <script-path>          run a script modally
  mux help

window options:
  --print-pane        print the new pane id (for HUNK_PANE capture)
  --keep-open         leave the window at a prompt when <cmd> exits
                      (default: the window closes, mirroring tmux new-window)
  --no-focus          create the window without switching to it, for work that
                      runs on your behalf (the macOS counterpart is `open -g`)
  --focus             switch to it even when it lands in another workspace, for
                      a window the user explicitly asked to look at
  --env KEY=VALUE     set an env var in the new window (repeatable)
  --workspace ID      override the target herdr workspace / Rex or tmux session;
                      defaults to the one this process was invoked from
  --popup             prefer a modal popup; herdr and Rex
                      fall back to a normal focused tab
  --popup-size WxH    popup size, tmux only (default 80%x90%)
Detection: pane env herdr, Rex (TERM_PROGRAM=rex and REX_BLOCK), then tmux;
otherwise live servers herdr, Rex, then tmux. MUX_FORCE_KIND overrides this.
notify options:
  --title TEXT        herdr toast / Rex desktop banner title (default "notice")
  --duration MS       tmux status-line duration, tmux only (default 5000)
popup options:
  --width W  --height H    tmux popup size (default 70% x 30%)
EOF
}

cmd_kind() { mux_kind; }

# herdr numbers its tmux sessions, so `#S` is meaningless there; read the label.
cmd_session_label() {
  case "$(cmd_kind)" in
    herdr)
      command -v jq >/dev/null 2>&1 || return 0
      [ -n "${HERDR_WORKSPACE_ID:-}" ] || return 0
      "$herdr" workspace get "$HERDR_WORKSPACE_ID" 2>/dev/null |
        jq -r '.result.workspace.label // empty' 2>/dev/null |
        sed 's/^[^[:alnum:]]*//'
      ;;
    rex)
      need_jq
      [ -n "${REX_SESSION:-}" ] || return 0
      local rex
      rex="$(rex_bin)" || return 1
      "$rex" --autostart=false session inspect "$REX_SESSION" --json 2>/dev/null |
        jq -r '.label // empty' 2>/dev/null |
        sed 's/^[^[:alnum:]]*//'
      ;;
    tmux) tmux display-message -p '#S' 2>/dev/null || true ;;
  esac
}

# Where this process was SPAWNED, from the pane env: frozen, so it survives a detached delay.
origin_workspace() {
  case "$(cmd_kind)" in
    herdr) printf '%s' "${HERDR_WORKSPACE_ID:-}" ;;
    rex) printf '%s' "${REX_SESSION:-}" ;;
    tmux)
      [ -n "${TMUX_PANE:-}" ] || return 0
      tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true
      ;;
  esac
}

# herdr only; empty under tmux, where focus never crosses sessions.
focused_workspace() {
  command -v jq >/dev/null 2>&1 || return 0
  "$herdr" workspace list 2>/dev/null |
    jq -r 'first(.result.workspaces[]? | select(.focused == true) | .workspace_id) // empty' 2>/dev/null
}

rex_app_client() {
  "$1" --autostart=false client ls --json 2>/dev/null | jq -r \
    '[.clients[]? | select(.info.kind == "app" and .info.platform != "ios" and .connection_state == "connected")] | max_by(.connected_at).client_id // empty'
}

# tmux runs the command AS the window process so it closes on exit; herdr spawns a
# persistent shell, so "; exit" is appended to match that close-on-exit contract.
cmd_window() {
  local print_pane="" popup="" popup_size="80%x90%" ws="" keep="" no_focus="" force_focus="" envs=() e
  while [ $# -gt 0 ]; do
    case "$1" in
      --print-pane) print_pane=1; shift ;;
      --keep-open)  keep=1; shift ;;
      --no-focus)   no_focus=1; shift ;;
      --focus)      force_focus=1; shift ;;
      --popup)      popup=1; shift ;;
      --popup-size) popup_size="$2"; shift 2 ;;
      --workspace)  ws="$2"; shift 2 ;;
      --env)        envs+=("$2"); shift 2 ;;
      --)           shift; break ;;
      -*)           die "window: unknown option $1" 2 ;;
      *)            break ;;
    esac
  done
  # `?` not `:?` — empty is legal and means "leave the backend's default".
  local name="${1?mux window: missing <name>}"
  local cwd="${2?mux window: missing <cwd>}"
  local command="${3:?mux window: missing <command>}"
  cwd="${cwd/#\~/$HOME}"
  # Pinned to the spawning workspace, so a switch during a detached caller's setup cannot misplace the tab.
  [ -n "$ws" ] || ws="$(origin_workspace)"

  case "$(cmd_kind)" in
    herdr)
      need_jq
      # An empty --label BLANKS the tab, costing it herdr's number badge.
      local args=(tab create)
      [ -n "$name" ] && args+=(--label "$name")
      [ -n "$cwd" ] && args+=(--cwd "$cwd")
      # An unresolvable origin (daemon, quake, stripped env) falls back to the active workspace.
      if [ -n "$ws" ]; then
        args+=(--workspace "$ws")
        # Crossing workspaces is silent by default; only an explicit --focus moves the desktop.
        if [ -n "$force_focus" ] && [ -z "$no_focus" ]; then
          [ "$ws" != "$(focused_workspace)" ] && "$herdr" workspace focus "$ws" >/dev/null 2>&1
          args+=(--focus)
        elif [ -n "$no_focus" ] || [ "$ws" != "$(focused_workspace)" ]; then
          args+=(--no-focus)
        else
          args+=(--focus)
        fi
      elif [ -n "$no_focus" ]; then
        args+=(--no-focus)
      else
        args+=(--focus)
      fi
      for e in "${envs[@]:-}"; do [ -n "$e" ] && args+=(--env "$e"); done
      local out pane tab_id num
      out="$("$herdr" "${args[@]}" 2>/dev/null)"
      pane="$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id // empty' 2>/dev/null)"
      [ -n "$pane" ] || die "herdr tab create failed"
      # A custom label replaces herdr's number badge, so re-add "<number>." to
      # match the numbered sesh-layout tabs.
      tab_id="$(printf '%s' "$out" | jq -r '.result.tab.tab_id // empty' 2>/dev/null)"
      num="$(printf '%s' "$out" | jq -r '.result.tab.number // empty' 2>/dev/null)"
      [ -n "$name" ] && [ -n "$tab_id" ] && [ -n "$num" ] &&
        "$herdr" tab rename "$tab_id" "$num.$name" >/dev/null 2>&1
      if [ -n "$keep" ]; then
        herdr_pane_run "$pane" "$command"
      else
        herdr_pane_run "$pane" "$command; exit"
      fi
      [ -n "$print_pane" ] && printf '%s\n' "$pane"
      return 0
      ;;
    rex)
      need_jq
      local rex out pane window client size_args=() rargs=(window new)
      rex="$(rex_bin)" || die "Rex CLI unavailable"
      [ -n "$ws" ] && rargs+=(-s "$ws")
      [ -n "$name" ] && rargs+=("$name")
      [ -n "$cwd" ] && rargs+=(-c "$cwd")
      [ -n "$keep" ] && rargs+=(--keep-open)
      [ -n "$no_focus" ] && rargs+=(--focus=false)
      rargs+=(--shell=none --json -- env)
      for e in "${envs[@]:-}"; do [ -n "$e" ] && rargs+=("$e"); done
      rargs+=("${SHELL:-/bin/sh}" -lc "$command")
      out="$("$rex" --autostart=false "${rargs[@]}")" || die "Rex window new failed"
      pane="$(printf '%s' "$out" | jq -r '.block_ids[0] // empty')"
      [ -n "$pane" ] || die "Rex window new returned no block id"
      [ -n "$ws" ] || ws="$(printf '%s' "$out" | jq -r '.session_id // empty')"
      [ -n "$ws" ] && size_args+=(-s "$ws")
      "$rex" --autostart=false block call ${size_args[@]+"${size_args[@]}"} -b "$pane" resize \
        '{"columns":200,"rows":50}' >/dev/null 2>&1 || printf 'mux: could not resize Rex block %s\n' "$pane" >&2
      # Server focus repaints the app but not its selected tab, so ctrl+N/ctrl+tab would no-op.
      if [ -z "$no_focus" ] && { [ -n "$force_focus" ] || [ "$ws" = "${REX_SESSION:-}" ]; }; then
        window="$(printf '%s' "$out" | jq -r '.window_id // empty')"
        client="$(rex_app_client "$rex")"
        [ -n "$client" ] || die "Rex window created but no connected app is available to focus it"
        [ -n "$ws" ] && [ -n "$window" ] || die "Rex window created but missing focus target"
        "$rex" --autostart=false -C "$client" do session.select "session_id=$ws" "window_id=$window" >/dev/null ||
          die "Rex window created but app focus failed"
      fi
      [ -n "$print_pane" ] && printf '%s\n' "$pane"
      return 0
      ;;
    tmux)
      # Modal popup: only meaningful without pane capture.
      if [ -n "$popup" ] && [ -z "$print_pane" ]; then
        tmux display-popup ${cwd:+-d "$cwd"} -w "${popup_size%x*}" -h "${popup_size#*x}" -E "$command"
        return 0
      fi
      # Session-scoped: appends at the next free index, and only yanks a client already attached there.
      local targs=(new-window -n "$name")
      # -d is tmux's `open -g`: the window is built but the client stays where it is.
      [ -n "$no_focus" ] && targs+=(-d)
      [ -n "$cwd" ] && targs+=(-c "$cwd")
      [ -n "$ws" ] && targs+=(-t "$ws:")
      [ -n "$print_pane" ] && targs+=(-P -F '#{pane_id}')
      for e in "${envs[@]:-}"; do [ -n "$e" ] && targs+=(-e "$e"); done
      # Separate argv, not one string, so a quote in $command can't break out.
      if [ -n "$keep" ]; then
        local sh="${SHELL:-/bin/zsh}"
        targs+=("$sh" -l -c "$command; exec $sh -l")
      else
        targs+=("$command")
      fi
      tmux "${targs[@]}"
      # `new-window -t other-session` leaves the client put, so --focus must move it explicitly.
      [ -n "$force_focus" ] && [ -z "$no_focus" ] && [ -n "$ws" ] && tmux switch-client -t "$ws:" 2>/dev/null
      ;;
    none) die "no herdr, Rex or tmux session detected" ;;
  esac
}

# herdr pane run intermittently delivers the text without the committing newline, stranding the command at the prompt; an idle pane lists its own shell as the only foreground process.
herdr_pane_run() {
  local pane="${1:?herdr_pane_run: missing <pane-id>}" command="${2:?herdr_pane_run: missing <command>}"
  local waited=0 info n
  "$herdr" pane run "$pane" "$command" >/dev/null 2>&1
  while [ "$waited" -lt 15 ]; do
    info="$("$herdr" pane process-info --pane "$pane" 2>/dev/null)"
    # A vanished pane means the command already ran and `; exit` closed it.
    case "$info" in *pane_not_found*) return 0 ;; esac
    n="$(printf '%s' "$info" | jq -r '.result.process_info as $p |
      [$p.foreground_processes[]? | select(.pid != $p.shell_pid)] | length' 2>/dev/null)"
    case "$n" in ''|null|0) ;; *) return 0 ;; esac
    sleep 0.2
    waited=$((waited + 1))
  done
  # Nothing is running, so the shell is idle at a prompt and this commits the stranded line.
  "$herdr" pane send-keys "$pane" enter >/dev/null 2>&1
}

# Panes sharing the caller's herdr tab; 1 on failure, so the split isn't mis-sized.
herdr_tab_pane_count() {
  local tab n
  tab="$("$herdr" pane current --current 2>/dev/null | jq -r '.result.tab_id // empty' 2>/dev/null)"
  [ -n "$tab" ] || { printf '1'; return; }
  n="$("$herdr" pane list 2>/dev/null |
    jq -r --arg t "$tab" '[.result.panes[]? | select(.tab_id == $t)] | length' 2>/dev/null)"
  case "$n" in
    ''|*[!0-9]*|0) printf '1' ;;
    *)             printf '%s' "$n" ;;
  esac
}

# Run <cmd> beside the current pane; the caller stays dominant at ~75%.
cmd_split() {
  [ "${1:-}" = "--" ] && shift
  local cwd="${1:?mux split: missing <cwd>}"
  local command="${2:?mux split: missing <command>}"
  cwd="${cwd/#\~/$HOME}"

  case "$(cmd_kind)" in
    herdr)
      need_jq
      local ratio=0.75 pane
      [ "$(herdr_tab_pane_count)" -gt 1 ] && ratio=0.66
      pane="$("$herdr" pane split --current --direction right --ratio "$ratio" \
        --cwd "$cwd" --focus 2>/dev/null | jq -r '.result.pane.pane_id // empty' 2>/dev/null)"
      [ -n "$pane" ] || die "herdr pane split failed"
      herdr_pane_run "$pane" "$command; exit"
      ;;
    rex)
      need_jq
      [ -n "${REX_SESSION:-}" ] && [ -n "${REX_BLOCK:-}" ] || die "split: not inside a Rex block"
      local rex ratio=25 n
      rex="$(rex_bin)" || die "Rex CLI unavailable"
      # --ratio is the NEW block's share, so 25/34 mirror herdr's 0.75/0.66 for the caller.
      n="$("$rex" --autostart=false block ls -s "$REX_SESSION" --json 2>/dev/null | jq -r --arg b "$REX_BLOCK" \
        '(.blocks // []) as $all | (first($all[] | select(.block_id == $b) | .window_id) // "") as $w
        | [$all[] | select(.window_id == $w)] | length' 2>/dev/null)"
      case "$n" in ''|*[!0-9]*|0|1) ;; *) ratio=34 ;; esac
      "$rex" --autostart=false split -s "$REX_SESSION" -b "$REX_BLOCK" --split=right --ratio "$ratio" \
        -c "$cwd" --shell=none -- "${SHELL:-/bin/sh}" -lc "$command" >/dev/null || die "Rex split failed"
      ;;
    tmux)
      if [ "$(tmux list-panes 2>/dev/null | wc -l | tr -d ' ')" = 1 ]; then
        tmux split-window -h -l 25% -c "$cwd" "$command"
      else
        tmux split-window -h -c "$cwd" "$command"
        tmux select-layout even-horizontal >/dev/null 2>&1
      fi
      ;;
    none) die "no herdr, Rex or tmux session detected" ;;
  esac
}

# Focus a pane by id; its SHAPE picks the backend. 0 focused · 1 gone · 2 not a pane id.
cmd_focus() {
  local pane="${1:?mux focus: missing <pane-id>}" session
  case "$pane" in
    *:p*)
      "$HOME/.local/bin/mux/herdr/herdr-focus-pane.sh" "$pane" >/dev/null 2>&1
      ;;
    %*)
      session="$(tmux display-message -t "$pane" -p '#{session_name}' 2>/dev/null)" || return 1
      [ -n "$session" ] || return 1
      # select-pane alone won't change the current window, so both are needed.
      tmux select-window -t "$pane" 2>/dev/null || true
      tmux select-pane -t "$pane" 2>/dev/null || true
      tmux switch-client -t "$session" 2>/dev/null ||
        tmux attach-session -t "$session" 2>/dev/null || true
      ;;
    *) return 2 ;;
  esac
}

# Drive a TUI in another pane; dispatch on the id SHAPE, exit 2 when neither backend owns it.
cmd_send_keys() {
  local pane="${1:?mux send-keys: missing <pane-id>}"
  shift
  [ $# -gt 0 ] || die "send-keys: missing <key>" 2
  case "$pane" in
    *:p*) "$herdr" pane send-keys "$pane" "$@" >/dev/null 2>&1 ;;
    %*)   tmux send-keys -t "$pane" "$@" 2>/dev/null ;;
    *)    return 2 ;;
  esac
}

# Correlates a pane with a process-keyed API; children cover a wrapper shell.
cmd_pane_pids() {
  local pane="${1:?mux pane-pids: missing <pane-id>}" pid
  case "$pane" in
    *:p*)
      need_jq
      "$herdr" pane process-info --pane "$pane" 2>/dev/null |
        jq -r '.result.process_info.foreground_processes[]?.pid // empty' 2>/dev/null
      ;;
    %*)
      pid="$(tmux display-message -pt "$pane" '#{pane_pid}' 2>/dev/null)" || return 0
      [ -n "$pid" ] || return 0
      printf '%s\n' "$pid"
      pgrep -P "$pid" 2>/dev/null || true
      ;;
    *) return 2 ;;
  esac
}

# Columns the pane occupies now; empty when it is gone, so "unknown" reads apart from a number.
cmd_pane_width() {
  local pane="${1:?mux pane-width: missing <pane-id>}"
  case "$pane" in
    *:p*)
      need_jq
      "$herdr" pane layout --pane "$pane" 2>/dev/null |
        jq -r --arg p "$pane" 'first(.result.layout.panes[]? | select(.pane_id == $p) | .rect.width) // empty' 2>/dev/null
      ;;
    %*) tmux display-message -pt "$pane" '#{pane_width}' 2>/dev/null || true ;;
    *)  return 2 ;;
  esac
}

# The herdr workspace labelled $1, comparing on the emoji-stripped tail.
herdr_workspace_named() {
  "$herdr" workspace list 2>/dev/null |
    jq -r --arg w "$1" '.result.workspaces[]?
      | select(((.label // "") | sub("^[^[:alnum:]]*";"")) == $w)
      | .workspace_id' 2>/dev/null | head -1
}

# "Attach if it exists, else build it". Without <cwd> it only focuses; --no-focus builds it in the background.
cmd_session() {
  local label="" no_focus=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --label) label="$2"; shift 2 ;;
      --no-focus) no_focus=1; shift ;;
      --)      shift; break ;;
      -*)      die "session: unknown option $1" 2 ;;
      *)       break ;;
    esac
  done
  local cwd="${1:-}"
  cwd="${cwd/#\~/$HOME}"
  [ -n "$label" ] || [ -n "$cwd" ] || die "session: need --label or <cwd>" 2

  case "$(cmd_kind)" in
    herdr)
      need_jq
      local ws=""
      [ -n "$label" ] && ws="$(herdr_workspace_named "$label")"
      if [ -n "$ws" ]; then
        [ -n "$no_focus" ] || "$herdr" workspace focus "$ws" >/dev/null 2>&1
        return 0
      fi
      [ -n "$cwd" ] || return 1
      # herdr-sesh-layout.sh is the herdr counterpart of `sesh connect`.
      local layout=("$cwd")
      [ -n "$label" ] && layout+=("$label")
      HERDR_SESH_NO_FOCUS="$no_focus" "$HOME/.local/bin/mux/herdr/herdr-sesh-layout.sh" "${layout[@]}" >/dev/null 2>&1
      ;;
    rex)
      need_jq
      local rex sid client
      rex="$(rex_bin)" || die "Rex CLI unavailable"
      # herdr-sesh-layout.sh's label, so either mux finds the same session again.
      [ -n "$label" ] || label="$("$HOME/.local/bin/mux/herdr/herdr-sesh-layout.sh" --print-label "$cwd")" || return 1
      sid="$("$rex" --autostart=false ls --json 2>/dev/null | jq -r --arg w "$label" \
        'first(.sessions[]? | select(((.label // "") | sub("^[^[:alnum:]]*";"")) == $w) | .session_id) // empty')"
      [ -n "$sid" ] && [ -n "$no_focus" ] && return 0
      [ -n "$sid" ] || [ -n "$cwd" ] || return 1
      client="$(rex_app_client "$rex")"
      [ -n "$client" ] || die "no connected Rex app"
      if [ -n "$sid" ]; then
        "$rex" --autostart=false -C "$client" do session.select "session_id=$sid" >/dev/null
      else
        "$rex" --autostart=false -C "$client" do sesh_open --args "$(jq -cn --arg l "$label" --arg d "$cwd" \
          --arg b "$no_focus" '{label: $l, dir: $d} + (if $b == "" then {} else {background: "1"} end)')" >/dev/null
      fi
      ;;
    tmux)
      [ -n "$label" ] || label="$(basename "$cwd")"
      if ! tmux has-session -t "$label" 2>/dev/null; then
        [ -n "$cwd" ] || return 1
        tmux new-session -d -s "$label" -c "$cwd" 2>/dev/null || return 1
      fi
      [ -n "$no_focus" ] && return 0
      tmux switch-client -t "$label" 2>/dev/null ||
        tmux attach-session -t "$label" 2>/dev/null || true
      ;;
    none) die "no herdr, Rex or tmux session detected" ;;
  esac
}

mux_json_list() {
  jq -es --arg path "$1" '
    if length == 1 then .[0] | getpath($path | split(".")) else null end
    | if type == "array" then . else error("invalid multiplexer listing") end'
}

# Every Rex session's tabs or pane cwds; a tab id is "<session>/<window>" because Rex closes a window only within its session.
rex_list() {
  local query="$1" rex sessions sid blocks bid
  rex="$(rex_bin)" || return 1
  need_jq
  sessions="$("$rex" --autostart=false ls --json 2>/dev/null |
    mux_json_list sessions | jq -r '.[].session_id')" || return 1
  while IFS= read -r sid; do
    [ -n "$sid" ] || continue
    if [ "$query" = tabs ]; then
      "$rex" --autostart=false window ls -s "$sid" --json 2>/dev/null |
        mux_json_list windows | jq -r --arg sid "$sid" '.[] | "\($sid)/\(.window_id)\t\(.label // "")"' || return 1
    else
      blocks="$("$rex" --autostart=false block ls -s "$sid" --json 2>/dev/null |
        mux_json_list blocks | jq -r '.[].block_id')" || return 1
      while IFS= read -r bid; do
        [ -n "$bid" ] || continue
        "$rex" --autostart=false block call -s "$sid" -b "$bid" process 2>/dev/null |
          jq -ers 'if length == 1 and (.[0] | type) == "object" then
            [.[0].foreground.cwd, .[0].child.cwd] | map(select(. != null))
            else error("invalid Rex process response") end' | jq -r '.[]' || return 1
      done <<<"$blocks"
    fi
  done <<<"$sessions"
}

cmd_all_muxes() {
  local query="$1" sessions sockets socket workspaces ws rex
  if command -v "$herdr" >/dev/null 2>&1; then
    local status
    status="$("$herdr" status server 2>/dev/null || true)"
    if sessions="$("$herdr" session list 2>/dev/null)"; then
      sockets="$(printf '%s\n' "$sessions" | awk 'NR > 1 && $2 == "running" { print $NF }' | sort -u)"
      if [ -z "$sockets" ] && [[ "$status" == *'status: running'* ]]; then return 1; fi
      while IFS= read -r socket; do
        [ -n "$socket" ] || continue
        need_jq
        if [ "$query" = tabs ]; then
          workspaces="$(HERDR_SOCKET_PATH="$socket" "$herdr" workspace list 2>/dev/null |
            mux_json_list result.workspaces | jq -r '.[].workspace_id')" || return 1
          while IFS= read -r ws; do
            [ -n "$ws" ] || continue
            HERDR_SOCKET_PATH="$socket" "$herdr" tab list --workspace "$ws" 2>/dev/null |
              mux_json_list result.tabs | jq -r '.[] | "\(.tab_id)\t\(.label // "")"' || return 1
          done <<<"$workspaces"
        else
          HERDR_SOCKET_PATH="$socket" "$herdr" pane list 2>/dev/null |
            mux_json_list result.panes | jq -r '.[] | (.foreground_cwd // .cwd // empty)' || return 1
        fi
      done <<<"$sockets"
    elif [[ "$status" == *'status: running'* ]]; then
      return 1
    fi
  fi
  if rex="$(rex_bin)" && "$rex" --autostart=false server status >/dev/null 2>&1; then
    rex_list "$query" || return 1
  fi
  if command -v tmux >/dev/null 2>&1 && tmux ls >/dev/null 2>&1; then
    if [ "$query" = tabs ]; then
      tmux list-windows -a -F "#{window_id}"$'\t'"#{window_name}" 2>/dev/null || return 1
    else
      tmux list-panes -a -F '#{pane_current_path}' 2>/dev/null || return 1
    fi
  fi
}

# Every open window/tab as "<id><TAB><label>".
cmd_tabs() {
  if [ "${1:-}" = --all-muxes ]; then cmd_all_muxes tabs; return; fi
  case "$(cmd_kind)" in
    herdr)
      need_jq
      "$herdr" workspace list 2>/dev/null |
        jq -r '.result.workspaces[]?.workspace_id // empty' 2>/dev/null |
        while IFS= read -r ws; do
          [ -n "$ws" ] || continue
          "$herdr" tab list --workspace "$ws" 2>/dev/null |
            jq -r '.result.tabs[]? | "\(.tab_id)\t\(.label // "")"' 2>/dev/null
        done || true
      ;;
    rex) rex_list tabs || true ;;
    tmux) tmux list-windows -a -F "#{window_id}"$'\t'"#{window_name}" 2>/dev/null || true ;;
  esac
}

# Current cwd of every open pane.
cmd_pane_cwds() {
  if [ "${1:-}" = --all-muxes ]; then cmd_all_muxes pane-cwds; return; fi
  case "$(cmd_kind)" in
    herdr)
      need_jq
      "$herdr" pane list 2>/dev/null |
        jq -r '.result.panes[]? | (.foreground_cwd // .cwd // empty)' 2>/dev/null || true
      ;;
    rex) rex_list pane-cwds || true ;;
    tmux) tmux list-panes -a -F '#{pane_current_path}' 2>/dev/null || true ;;
  esac
}

# Close the window/tab with the id `mux tabs` printed.
cmd_close() {
  local id="${1:?mux close: missing <id>}"
  case "$(cmd_kind)" in
    herdr)
      need_jq
      # herdr 0.8.0 closes the workspace when its LAST tab closes; `mux close` means the tab only.
      local ws n
      ws="${id%%:*}"
      n="$("$herdr" tab list --workspace "$ws" 2>/dev/null | jq -r '(.result.tabs? // []) | length' 2>/dev/null)"
      if [ "${n:-0}" -gt 1 ]; then
        "$herdr" tab close "$id" >/dev/null 2>&1 || true
      fi
      ;;
    rex)
      need_jq
      # Same rule as herdr: an emptied Rex session lingers in the sidebar until killed.
      local rex sid="${id%%/*}" n
      rex="$(rex_bin)" || return 0
      n="$("$rex" --autostart=false window ls -s "$sid" --json 2>/dev/null | jq -r '(.windows? // []) | length' 2>/dev/null)"
      if [ "${n:-0}" -gt 1 ]; then
        "$rex" --autostart=false window close -s "$sid" "${id#*/}" >/dev/null 2>&1 || true
      fi
      ;;
    tmux)  tmux kill-window -t "$id" 2>/dev/null || true ;;
  esac
}

cmd_notify() {
  local title="notice" duration=5000
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) title="$2"; shift 2 ;;
      --duration) duration="$2"; shift 2 ;;
      --) shift; break ;;
      -*) die "notify: unknown option $1" 2 ;;
      *) break ;;
    esac
  done
  local msg="${1:?mux notify: missing <message>}"
  case "$(cmd_kind)" in
    # herdr has no status line, so --duration is tmux-only.
    herdr) "$herdr" notification show "$title" --body "$msg" >/dev/null 2>&1 || printf '%s\n' "$msg" >&2 ;;
    tmux)  tmux display-message -d "$duration" "$msg" 2>/dev/null || printf '%s\n' "$msg" >&2 ;;
    # Rex has no toast CLI; the guard stops to-desktop's own `mux notify` fallback looping back here.
    rex)
      if [ -z "${MUX_NOTIFY_VIA_DESKTOP:-}" ] && printf '%s\n%s' "${title//$'\n'/ }" "$msg" |
        MUX_NOTIFY_VIA_DESKTOP=1 "$HOME/.local/bin/to-desktop" notify - >/dev/null 2>&1; then
        return 0
      fi
      printf '%s\n' "$msg" >&2
      ;;
    *)     printf '%s\n' "$msg" >&2 ;;
  esac
}

# Exit status is the inner script's, so a cancel is distinguishable from a failure.
cmd_popup() {
  local width="70%" height="30%"
  while [ $# -gt 0 ]; do
    case "$1" in
      --width) width="$2"; shift 2 ;;
      --height) height="$2"; shift 2 ;;
      --) shift; break ;;
      -*) die "popup: unknown option $1" 2 ;;
      *) break ;;
    esac
  done
  local script="${1:?mux popup: missing <script-path>}"
  [ -x "$script" ] || chmod +x "$script" 2>/dev/null || true
  case "$(cmd_kind)" in
    tmux) tmux display-popup -E -w "$width" -h "$height" "$script" ;;
    # herdr has no popup CLI; in herdr mode these captures already run in the quake.
    *)    clear 2>/dev/null || true; "$script" ;;
  esac
}

verb="${1:-help}"
[ $# -gt 0 ] && shift
case "$verb" in
  kind)          cmd_kind "$@" ;;
  session-label) cmd_session_label "$@" ;;
  window)        cmd_window "$@" ;;
  split)         cmd_split "$@" ;;
  focus)         cmd_focus "$@" ;;
  send-keys)     cmd_send_keys "$@" ;;
  pane-pids)     cmd_pane_pids "$@" ;;
  pane-width)    cmd_pane_width "$@" ;;
  session)       cmd_session "$@" ;;
  tabs)          cmd_tabs "$@" ;;
  pane-cwds)     cmd_pane_cwds "$@" ;;
  close)         cmd_close "$@" ;;
  notify)        cmd_notify "$@" ;;
  popup)         cmd_popup "$@" ;;
  help|-h|--help) cmd_help ;;
  *)             die "unknown verb '$verb' (try: mux help)" 2 ;;
esac
