#!/usr/bin/env python3
# fm-rex-labels - label firstmate worker tabs "<glyph> <model>/<effort> · <task>" and second mates "🚢 <name> · <model>/<effort>".
import glob
import json
import os
import re
import shlex
import subprocess

KIND_MARK = {"scout": "\U0001f52d", "ship": "⛵"}
SECONDMATE_MARK = "\U0001f6a2"
CACHE_DIR = os.path.expanduser("~/.cache/fm-rex-labels")
EFFORT_SHORT = {"minimal": "min", "low": "low", "medium": "med", "high": "hi", "xhigh": "xhi", "max": "max"}
VENDOR_WORDS = {"claude", "gpt"}
TAB_NUMBER_RE = re.compile(r"^\d+\. ?")


def rex(server, *args):
    cmd = ["rex", "--autostart=false", "-S", server, *args]
    return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout


def short_model(model):
    """claude-opus-5-5 -> opus5.5, gpt-6-luna -> luna6; a dated snapshot suffix is dropped."""
    parts = [p for p in model.rsplit("/", 1)[-1].split("-") if p]
    words = [p for p in parts if not p[0].isdigit()]
    name = "".join(w for w in words if w.lower() not in VENDOR_WORDS) or "".join(words)
    return name + ".".join(p for p in parts if p[0].isdigit() and len(p) < 8)


def model_effort(meta):
    effort = meta.get("effort", "").strip().lower()
    model = short_model(meta["model"]) if meta.get("model") else ""
    if model and effort not in ("", "off", "none", "default"):
        model += "/" + EFFORT_SHORT.get(effort, effort)
    return model


def label_for(task, meta):
    glyph = KIND_MARK.get(meta.get("kind", ""))
    if glyph is None:
        return None
    return glyph + " " + " · ".join(filter(None, (model_effort(meta), task)))


def read_meta(path):
    with open(path) as f:
        return dict(line.rstrip("\n").split("=", 1) for line in f if "=" in line)


def relabel(task, meta, windows):
    server, session, block = meta.get("rex_server"), meta.get("rex_session_id"), meta.get("rex_block_id")
    want = label_for(task, meta)
    if not (server and session and block and want):
        return
    try:
        window = json.loads(rex(server, "block", "inspect", "-s", session, block, "--json"))["block"]["window_id"]
        if (server, session) not in windows:
            listing = json.loads(rex(server, "window", "ls", "-s", session, "--json"))["windows"]
            windows[(server, session)] = {w["window_id"]: w["label"] for w in listing}
        current = windows[(server, session)].get(window)
        if current is not None and TAB_NUMBER_RE.sub("", current) != want:
            rex(server, "window", "rename", "-s", session, window, want)
    except (subprocess.CalledProcessError, ValueError, KeyError, OSError):
        pass


REMOTE_RENAME = r'''set -eu
w=$(rex --autostart=false -S "$1" block inspect -s "$2" "$3" --json | jq -r .block.window_id)
rex --autostart=false -S "$1" window rename -s "$2" "$w" "$4"
'''


def relabel_secondmate(task, meta):
    """Second mates run on a remote Rex; only this host knows their model, so rename over ssh once per change."""
    host, server, session = meta.get("remote_host"), meta.get("remote_rex_server"), meta.get("remote_rex_session_id")
    target = meta.get("remote_target", "")
    if not (host and server and session and ":" in target):
        return
    want = " · ".join(filter(None, (SECONDMATE_MARK + " " + task, model_effort(meta))))
    stamp = target + "\t" + want
    cache = os.path.join(CACHE_DIR, task)
    try:
        with open(cache) as f:
            if f.read() == stamp:
                return
    except OSError:
        pass
    block = "block:" + target.split(":", 1)[1]
    try:
        subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", host, "bash", "-s", "--",
                        shlex.quote(server), shlex.quote(session), shlex.quote(block), shlex.quote(want)],
                       input=REMOTE_RENAME, capture_output=True, text=True, check=True, timeout=20)
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(cache, "w") as f:
            f.write(stamp)
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError):
        pass


def main():
    windows = {}
    for path in sorted(glob.glob(os.path.expanduser("~/.local/share/firstmate*/state/*.meta"))):
        try:
            meta = read_meta(path)
        except OSError:
            continue
        task = os.path.basename(path)[:-len(".meta")]
        if meta.get("kind") == "secondmate" and meta.get("remote_backend") == "rex":
            relabel_secondmate(task, meta)
        elif meta.get("backend") == "rex":
            relabel(task, meta, windows)


if __name__ == "__main__":
    main()
