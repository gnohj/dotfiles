#!/usr/bin/env bash
# Enable the Rex tab numberer; Linux/systemd only, macOS runs it from the nix-darwin launchd agent.
# service sha256: {{ include "dot_config/systemd/user/rex-tab-numbers.service" | sha256sum }}
# script sha256: {{ include "dot_local/bin/mux/rex/rex-tab-numbers.lua" | sha256sum }}
set -eu

[ "$(uname)" = "Linux" ] || exit 0
command -v systemctl >/dev/null 2>&1 || exit 0

systemctl --user daemon-reload
# reenable drops the old default.target.wants link that caused a boot ordering cycle.
systemctl --user reenable rex-tab-numbers.service
# restart, not --now: rex do holds the loaded script, so an edit only takes effect on restart.
systemctl --user restart rex-tab-numbers.service

echo "rex-tab-numbers.service enabled."
