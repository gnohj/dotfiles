#!/usr/bin/env bash
# sources: {{ include "dot_local/libexec/tasks-reminders.swift" | sha256sum }} {{ include "dot_local/libexec/tasks-reminders.Info.plist" | sha256sum }} {{ include "dot_local/libexec/cpu-temp.swift" | sha256sum }} {{ include "dot_local/libexec/work-sso-time.swift" | sha256sum }}
set -euo pipefail

[ "$(uname -s)" = Darwin ] || exit 0
command -v swiftc >/dev/null 2>&1 || { echo "libexec: no swiftc, skipping"; exit 0; }

cd "$HOME/.local/libexec" 2>/dev/null || exit 0
# Compiled, not `swift`-interpreted: interpreting costs ~1.3s per run and these get polled.
for src in *.swift; do
  [ -e "$src" ] || continue
  # An embedded Info.plist carries the TCC usage strings a CLI otherwise lacks.
  plist=()
  [ -e "${src%.swift}.Info.plist" ] && plist=(-Xlinker -sectcreate -Xlinker __TEXT -Xlinker __info_plist -Xlinker "${src%.swift}.Info.plist")
  # Built under its real name (the code identifier), then moved over the read-only signed binary.
  out=$(mktemp -d)
  swiftc -O -o "$out/${src%.swift}" "$src" ${plist[@]+"${plist[@]}"} && mv -f "$out/${src%.swift}" "${src%.swift}" && echo "libexec: built ${src%.swift}"
  rm -rf "$out"
done
# A stable signature keeps work-sso-time's Full Disk Access across rebuilds.
[ -x "$HOME/.local/bin/tcc-sign" ] && [ -x work-sso-time ] && "$HOME/.local/bin/tcc-sign" work-sso-time
