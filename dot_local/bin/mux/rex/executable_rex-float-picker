#!/usr/bin/env bash
# rex-float-picker WINDOW - fzf over the tab's floating panes, minimized or not; enter restores and focuses, ctrl-d closes.
set -uo pipefail

rex="${REX_BIN_DIR:+$REX_BIN_DIR/}rex"

terminal() {
  "$rex" api call -s "$REX_SESSION" "com.superlogical.terminal.$1" "{\"block_id\":\"$2\",\"args\":{}}" 2>/dev/null
}

list() {
  local floats layer state block name cwd title tilde="~" mark
  floats=$("$rex" api call session.view "{\"session_id\":\"$REX_SESSION\"}" | jq -r --arg w "$1" '
    .windows[] | select(.window_id == $w) | .layers[]
    | select(.kind != "tiled" and (.blocks[0].label | IN("popup", "lazygit", "sesh") | not))
    | [.layer_id, (.state // "normal"), .blocks[0].block_id] | @tsv')
  while IFS=$'\t' read -r layer state block; do
    [ -n "$layer" ] || continue
    IFS=$'\t' read -r name cwd < <(terminal process "$block" | jq -r '(.foreground // .child) | [.name // "", .cwd // ""] | @tsv')
    title=$(terminal title "$block" | jq -r '.title // empty')
    [ -n "$title" ] && [ "$title" != "$name" ] && name="$name: $title"
    mark=" "
    [ "$state" = minimized ] && mark="_"
    printf '%s\t%s %s  %s\n' "$layer" "$mark" "${name:-shell}" "${cwd/#$HOME/$tilde}"
  done <<<"$floats"
}

case "${1:-}" in
  --list) list "${2:?}"; exit 0 ;;
  --close) "$rex" api call session.close_layer "{\"session_id\":\"$REX_SESSION\",\"layer_id\":\"$(printf %s "${2:?}" | tr -d '[:space:]')\"}" >/dev/null; exit 0 ;;
esac

window=${1:?usage: rex-float-picker WINDOW}
layer=$(list "$window" | fzf --delimiter='\t' --with-nth=2 --prompt='float> ' --header='_ = minimized   ctrl-d = close' --reverse \
  --bind "ctrl-d:execute-silent('$0' --close {1})+reload('$0' --list '$window')" | cut -f1)
[ -n "$layer" ] || exit 0
"$rex" api call session.set_layer_state "{\"session_id\":\"$REX_SESSION\",\"layer_id\":\"$layer\",\"state\":\"normal\",\"focus\":true}" >/dev/null
