#!/usr/bin/env bash
# Lazygit custom command for `<C-o>`: open the selected file in the
# nvim in a sibling Rex block (RPC), or spawn one in a new window if
# none is running. Then auto-close the popup.

set -uo pipefail

# Close the popup by killing the lazygit pid from a process-tree walk, never a pane, which could hit the user's working pane.
find_lazygit_pid() {
  local pid=$$ name
  for _ in 1 2 3 4 5 6; do
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    [ -n "$pid" ] && [ "$pid" != "0" ] && [ "$pid" != "1" ] || return 1
    name=$(ps -o comm= -p "$pid" 2>/dev/null | xargs basename 2>/dev/null)
    if [ "$name" = "lazygit" ]; then
      printf '%s' "$pid"
      return 0
    fi
  done
  return 1
}

DEBUG_LOG="$HOME/.logs/lazygit-nvim-edit.log"
mkdir -p "$(dirname "$DEBUG_LOG")"
{
  printf '=== %s ===\n' "$(date)"
  printf 'arg1: %q\n' "${1:-}"
  printf 'PWD: %s\n' "$PWD"
  printf 'lazygit pid (process-tree walk): %s\n' "$(find_lazygit_pid || echo '(not found)')"
} >> "$DEBUG_LOG"

FILE="${1:-}"
[ -n "$FILE" ] || { echo "usage: lazygit-nvim-edit <file>" >&2; exit 1; }

# lazygit's {{.SelectedFile.Name}} is repo-relative; resolve against $PWD.
ABS_FILE="$FILE"
if [ "${FILE#/}" = "$FILE" ]; then
  ABS_FILE="$PWD/$FILE"
fi

# Spawn at the REPO ROOT, not the file's nested dir: nvim keys its pickers, LSP root and :Git off cwd.
OPEN_DIR=$(git -C "$(dirname "$ABS_FILE")" rev-parse --show-toplevel 2>/dev/null) ||
  OPEN_DIR=$(dirname "$ABS_FILE")
[ -n "$OPEN_DIR" ] || OPEN_DIR=$(dirname "$ABS_FILE")
echo "  open dir (git root): $OPEN_DIR" >> "$DEBUG_LOG"

# Interpolated into a string a shell will parse (mux window), so quote it for the shell rather than wrapping in literal quotes a filename could close.
Q_FILE=$(printf %q "$ABS_FILE")

# Deferred via double-fork because killing lazygit synchronously would
# SIGHUP this script (we're a customCommand subprocess of lazygit).
close_popup_deferred() {
  local lazygit_pid
  lazygit_pid=$(find_lazygit_pid)
  if [ -z "$lazygit_pid" ]; then
    echo "  → could not find lazygit pid; popup will not auto-close" >> "$DEBUG_LOG"
    return 0
  fi
  echo "  → scheduling lazygit SIGTERM: pid=$lazygit_pid (200ms deferred)" >> "$DEBUG_LOG"
  ( ( sleep 0.2; kill -TERM "$lazygit_pid" 2>/dev/null ) </dev/null >/dev/null 2>&1 & ) 2>/dev/null
}

new_window_and_exit() {
  echo "  → new window in $OPEN_DIR" >> "$DEBUG_LOG"
  "$HOME/.local/bin/mux/mux" window "🖋️" "$OPEN_DIR" "nvim $Q_FILE" >>"$DEBUG_LOG" 2>&1
  close_popup_deferred
  exit 0
}

# The ctrl+g popup floats over its window, so a sibling block's nvim (socket named by init.lua) is the editor to reuse.
rex_edit_and_exit() {
  local rex blocks b sock
  rex="$(. "$HOME/.local/bin/mux/shared/mux-detect.sh" && rex_bin)" || return 1
  blocks="$("$rex" --autostart=false block ls -s "$REX_BLOCK" --json 2>/dev/null | jq -r --arg me "$REX_BLOCK" \
    '(.blocks // []) as $all | (first($all[] | select(.block_id == $me) | .window_id) // "") as $w
     | $all[] | select(.window_id == $w and .block_id != $me) | .block_id' 2>/dev/null)"
  for b in $blocks; do
    sock="/tmp/nvim-rex-${b//[^[:alnum:]]/-}.sock"
    [ -S "$sock" ] || continue
    if nvim --server "$sock" --remote "$ABS_FILE" >>"$DEBUG_LOG" 2>&1; then
      echo "  rex: opened in $b via $sock" >> "$DEBUG_LOG"
      "$rex" --autostart=false focus -s "$REX_BLOCK" "$b" >/dev/null 2>&1
      close_popup_deferred
      exit 0
    fi
  done
  echo "  rex: no nvim beside the popup" >> "$DEBUG_LOG"
  new_window_and_exit
}

[ "${TERM_PROGRAM:-}" = rex ] && [ -n "${REX_BLOCK:-}" ] && rex_edit_and_exit
new_window_and_exit
