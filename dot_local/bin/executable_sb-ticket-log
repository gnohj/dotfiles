#!/usr/bin/env bash
# sb-ticket-log — append a timestamped entry to the current ticket's
# `## Work Log` section in its Obsidian vault note.
#
# Usage:
#   sb-ticket-log "<message>"          # append the message
#   echo "<message>" | sb-ticket-log   # read from stdin
#
# Which note gets the entry is `vault-note`'s call — the same resolver behind the 󰎞 badge and prefix+O.
#
# Silently no-ops when:
#   - The message is empty / whitespace only.
#   - vault-note finds nothing: no repo, no `[A-Z]+-\d+` ticket key, or no note yet.
#
# These are all expected when fired from the global post-commit hook —
# the hook runs on every commit machine-wide; the skill's job is to be
# the one place that decides whether the commit deserves a log entry.

set -euo pipefail

# ---------------------------------------------------------------------------
# 1. Message (argv or stdin)
# ---------------------------------------------------------------------------
if [ "$#" -gt 0 ]; then
  MSG="$*"
else
  MSG=$(cat)
fi
# Strip leading / trailing whitespace; bail on empty.
MSG=$(printf '%s' "$MSG" | awk '{$1=$1; print}')
[ -z "$MSG" ] && exit 0

# ---------------------------------------------------------------------------
# 2. Resolve the vault note path
# ---------------------------------------------------------------------------
# Its exit 1 is the ordinary "nothing to log into" case, not a failure for the post-commit hook.
NOTE=$("$HOME/.local/bin/vault-note" 2>/dev/null) || exit 0
[ -n "$NOTE" ] || exit 0

# ---------------------------------------------------------------------------
# 3. Append entry to ## Work Log (newest-first)
# ---------------------------------------------------------------------------
# A live session and the drain daemon both read-modify-write the whole note, so serialize them. mkdir, not flock: macOS ships no flock(1).
LOCK="$NOTE.lock.d"
LOCKED=0
for _ in $(seq 1 50); do
  if mkdir "$LOCK" 2>/dev/null; then LOCKED=1; break; fi
  # Reclaim a lock left by a crashed writer, or every later commit wedges behind it forever.
  [ -n "$(find "$LOCK" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$LOCK" 2>/dev/null
  sleep 0.1
done
# Best effort past the timeout: losing the entry is worse than the tiny remaining race window.
[ "$LOCKED" = 1 ] && trap 'rmdir "$LOCK" 2>/dev/null' EXIT

TS=$(date '+%Y-%m-%d %H:%M')
ENTRY="- $TS · $MSG"

TMP=$(mktemp)

if grep -q '^## Work Log' "$NOTE"; then
  # Insert the new entry immediately after the heading. awk prints every
  # line; on the first match it also prints our entry right after. Guards
  # against double-insert if the heading somehow appears twice.
  # ENVIRON, not -v: awk expands backslash escapes in a -v value, forging log lines.
  ENTRY="$ENTRY" awk '
    { print }
    /^## Work Log/ && !done { print ENVIRON["ENTRY"]; done = 1 }
  ' "$NOTE" > "$TMP"
else
  # No Work Log section yet — append it at EOF.
  cat "$NOTE" > "$TMP"
  {
    echo ""
    echo "## Work Log"
    echo ""
    echo "$ENTRY"
  } >> "$TMP"
fi

# Not `mv`: mktemp is 0600, and a rename would carry that onto the note, downgrading it from 0644.
cat "$TMP" > "$NOTE"
rm -f "$TMP"
