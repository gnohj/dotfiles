#!/usr/bin/env bash
# chrome-review-window [workspace] - raise the Chrome window named "review" (creating it when none exists) and keep it on [workspace].
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/bin:/bin:$PATH"

name=review
workspace="${1:-}"

osascript -l JavaScript - "$name" >/dev/null <<'JS'
function run([name]) {
  const chrome = Application("com.google.Chrome");
  let win = chrome.running() ? chrome.windows().find((w) => w.givenName() === name) : undefined;
  if (!win) {
    chrome.Window().make();
    win = chrome.windows[0];
    win.givenName = name;
  }
}
JS

activate_chrome() { osascript -e 'tell application id "com.google.Chrome" to activate' >/dev/null 2>&1 || true; }

# Chrome titles a named window "<name> - <tab>", which is the only handle Rift shares with AppleScript.
review_window() {
  rift-cli query workspaces 2>/dev/null | jq -c --arg re "^${name}( - |$)" '
    [.[] as $ws | $ws.windows[] | select(.bundle_id == "com.google.Chrome" and (.title | test($re))) | {id, ws: $ws.index}] | first // empty'
}

window=""
for _ in $(seq 30); do
  window=$(review_window) || window=""
  [ -n "$window" ] && break
  sleep 0.1
done
[ -n "$window" ] || { activate_chrome; exit 0; }

index=$(jq -r .ws <<<"$window")
# Moved by id before anything takes focus: Rift follows focus to Chrome's app-rule workspace and races a focus-based move.
if [ -n "$workspace" ]; then
  target=$(rift-cli query workspaces 2>/dev/null | jq -r --arg ws "$workspace" '.[] | select(.name == $ws) | .index') || target=""
  if [ -n "$target" ] && [ "$target" != "$index" ]; then
    rift-cli execute workspace move-window "$target" "$(jq -r .id.idx <<<"$window")" >/dev/null 2>&1 && index=$target
  fi
fi

osascript -l JavaScript - "$name" >/dev/null <<'JS'
function run([name]) {
  Application("com.google.Chrome").windows().find((w) => w.givenName() === name).index = 1;
}
JS
# Focus by id leaves a hidden workspace hidden, so switch to it first.
rift-cli execute workspace switch "$index" >/dev/null 2>&1 || true
rift-cli execute window focus --window-id "$(jq -c .id <<<"$window")" >/dev/null 2>&1 || activate_chrome
