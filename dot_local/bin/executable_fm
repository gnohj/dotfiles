#!/usr/bin/env bash
# firstmate has no binary - the clone IS the tool, so resolve its home and hand off to the claude wrapper (its AGENTS.md runs the crew).
set -eu

root="${FIRSTMATE_DIR:-$HOME/Developer/firstmate}"

account=personal
case "${1:-}" in
personal | work)
  account=$1
  shift
  ;;
esac

# Paired, never from the env: firstmate forwards its account to every crewmate, so a mismatch runs the whole fleet on the wrong subscription.
case "$account" in
work) export FM_HOME="$HOME/.local/share/firstmate-work" ;;
*) export FM_HOME="$HOME/.local/share/firstmate" ;;
esac
export CLAUDE_ACCOUNT="$account"
mkdir -p "$FM_HOME"

if [ ! -d "$root/.git" ]; then
  echo "fm: no firstmate clone at $root" >&2
  echo "fm: run \`update\` to clone it, or: git clone https://github.com/kunchenguid/firstmate $root" >&2
  exit 1
fi

cd "$root"
exec "$HOME/.local/bin/claude" --dangerously-skip-permissions "$@"
