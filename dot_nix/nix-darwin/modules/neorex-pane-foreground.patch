@@ -25,6 +25,7 @@ pub const Message = enum(u8) {
 pub fn run(io: std.Io, socket_path: []const u8, id: ?u32) !void {
     const tty = std.posix.STDIN_FILENO;
     if (std.c.isatty(tty) == 0) return error.NotATerminal;
+    becomeForeground(tty);
 
     // before the hello, so a resize in between isn't missed
     var signals = try Signals.init(&.{.WINCH});
@@ -56,6 +57,20 @@ pub fn run(io: std.Io, socket_path: []const u8, id: ?u32) !void {
     }
 }
 
+extern "c" fn setpgid(pid: c_int, pgid: c_int) c_int;
+extern "c" fn tcsetpgrp(fd: c_int, pgrp: c_int) c_int;
+extern "c" fn getpid() c_int;
+extern "c" fn signal(sig: c_int, handler: ?*const anyopaque) ?*const anyopaque;
+
+/// Lead the terminal's foreground group, so Rex names this pane by its program, not login.
+fn becomeForeground(tty: c_int) void {
+    const sigttou = 22;
+    if (setpgid(0, 0) != 0) return;
+    const old = signal(sigttou, @ptrFromInt(1));
+    _ = tcsetpgrp(tty, getpid());
+    _ = signal(sigttou, old);
+}
+
 /// The hello message: `p`, then the ID if there is one.
 pub fn helloBytes(buf: []u8, id: ?u32) ![]const u8 {
     if (id) |n| return std.fmt.bufPrint(buf, "{c}{d}", .{ @backingInt(Message.hello), n });
