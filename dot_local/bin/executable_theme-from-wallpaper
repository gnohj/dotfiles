#!/usr/bin/env python3
"""Generate a colorscheme list file from a wallpaper image.

  theme-from-wallpaper <image>   write ~/.config/colorscheme/list/<name>-colors.sh, print its file name
  theme-from-wallpaper --unused  list wallpapers in ~/Pictures/wallpapers and ~/Documents/Pictures/wallpapers that no scheme uses yet
  theme-from-wallpaper --regenerate  rewrite every generated scheme from its wallpaper, after a change to this generator

The background comes from the image's dark tones. Red, orange, yellow and green stay classic hues so status keeps its meaning; blue, cyan and magenta are one hue, the image's main one, in three tones. Every text color is pushed until it clears 4.5:1 on the background.
"""
import math
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
LIST = os.path.join(HOME, ".config/colorscheme/list")
WALLPAPERS = (os.path.join(HOME, "Pictures/wallpapers"), os.path.join(HOME, "Documents/Pictures/wallpapers"))
IMAGES = (".jpg", ".jpeg", ".png", ".webp", ".avif")


def lin(c):
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def gam(c):
    return 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055


def to_lab(r, g, b):
    r, g, b = lin(r / 255), lin(g / 255), lin(b / 255)
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    return (
        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
    )


def lch(L, C, h):
    """OKLCH to #rrggbb, dropping chroma until the color fits sRGB."""
    while True:
        a, b = C * math.cos(math.radians(h)), C * math.sin(math.radians(h))
        l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
        m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
        s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
        rgb = (
            4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
        )
        if C <= 0.001 or all(-0.0005 <= v <= 1.0005 for v in rgb):
            return "#%02x%02x%02x" % tuple(round(255 * gam(min(1, max(0, v)))) for v in rgb)
        C -= 0.004


def contrast(a, b):
    lum = [0.2126 * lin(int(x[1:3], 16) / 255) + 0.7152 * lin(int(x[3:5], 16) / 255) + 0.0722 * lin(int(x[5:7], 16) / 255) for x in (a, b)]
    return (max(lum) + 0.05) / (min(lum) + 0.05)


def scheme_wallpapers():
    """File names of every wallpaper an existing scheme points at; names, so a copy of one in another folder counts as used too."""
    used = set()
    for name in os.listdir(LIST) if os.path.isdir(LIST) else []:
        with open(os.path.join(LIST, name), errors="replace") as f:
            m = re.search(r'^wallpaper="?([^"\n]+)"?', f.read(), re.M)
        if m:
            used.add(os.path.basename(m.group(1)))
    return used


def palette(image):
    raw = subprocess.run(["magick", image + "[0]", "-resize", "96x54!", "-depth", "8", "rgb:-"], capture_output=True, check=True).stdout
    px = sorted(to_lab(raw[i], raw[i + 1], raw[i + 2]) for i in range(0, len(raw), 3))
    dark = px[: len(px) * 35 // 100]
    ba, bb = sum(p[1] for p in dark) / len(dark), sum(p[2] for p in dark) / len(dark)
    bh, bc = math.degrees(math.atan2(bb, ba)) % 360, min(math.hypot(ba, bb), 0.035)
    vivid = sorted(px, key=lambda p: -math.hypot(p[1], p[2]))[: len(px) * 30 // 100]
    # The image's main color: the mean of its most saturated third. A grey image falls back to the background hue's opposite.
    va, vb = sum(p[1] for p in vivid) / len(vivid), sum(p[2] for p in vivid) / len(vivid)
    vc = sum(math.hypot(p[1], p[2]) for p in vivid) / len(vivid)
    ah = math.degrees(math.atan2(vb, va)) % 360 if math.hypot(va, vb) > 0.02 else (bh + 180) % 360
    c = min(max(vc * 1.1, 0.07), 0.14)

    bg = lch(0.17, bc, bh)

    def text(L, C, h, target=4.5):
        while contrast(lch(L, C, h), bg) < target and L < 0.95:
            L += 0.01
        return lch(L, C, h)

    def hue(h):
        return (h + ((ah - h + 180) % 360 - 180) * 0.2) % 360

    R, O, Y, G = (hue(h) for h in (25, 55, 100, 145))
    # Identity colors follow the image, but the primary one keeps 40 degrees clear of red so plain text never reads as an error.
    away = (ah - R + 180) % 360 - 180
    B = ah if abs(away) >= 40 else R + (40 if away >= 0 else -40)
    # One hue, two tones: the cyan and magenta roles share the primary hue and differ only in lightness, so a bar or prompt reads as one color family.
    CY, M = B, B
    p = {
        "01": text(0.70, c, M), "02": text(0.82, c, G), "03": text(0.87, c * 0.55, CY), "04": text(0.76, c, B), "05": text(0.85, c, Y),
        "06": text(0.80, c, O), "07": lch(0.215, bc, bh), "08": lch(0.52, 0.03, bh), "09": text(0.64, 0.035, bh), "10": bg,
        "11": text(0.78, c, R), "12": text(0.88, c, Y), "13": lch(0.46, 0.03, bh), "14": text(0.88, 0.02, bh, 7), "15": text(0.80, c, O),
        "16": lch(0.34, 0.06, ah), "17": lch(0.30, 0.03, bh),
        "18": lch(0.55, c, B), "19": lch(0.55, c, G), "20": lch(0.55, c, CY), "21": lch(0.55, c, M), "22": lch(0.55, c, Y), "23": lch(0.42, 0.04, bh),
        "24": text(0.86, c, ah), "26": bg,
        "27": lch(0.93, 0.02, bh), "28": lch(0.20, bc, bh), "29": text(0.82, c, G), "30": lch(0.27, 0.05, G), "31": text(0.78, c, R), "32": lch(0.26, 0.05, R),
        "33": text(0.80, c, O), "34": lch(0.20, bc, bh), "35": text(0.82, c, CY), "36": text(0.86, c, G), "37": text(0.90, c, Y), "38": text(0.78, c, M),
        "39": lch(0.60, c, (B + 20) % 360), "40": text(0.82, c, G), "41": text(0.85, c, Y), "42": text(0.80, c, B + 18), "43": text(0.75, c, CY),
        "44": text(0.85, c * 0.7, B + 18), "45": text(0.90, c * 0.6, CY), "46": text(0.62, 0.05, B), "47": text(0.70, 0.06, G), "48": text(0.75, 0.08, G),
        "49": text(0.80, 0.06, CY), "50": text(0.72, c, M), "51": text(0.74, c, O), "52": text(0.72, c, (R - 25) % 360), "53": lch(0.33, 0.04, bh),
        "54": lch(0.50, 0.04, bh), "55": text(0.68, c, (M - 25) % 360), "56": lch(0.24, 0.02, bh), "57": lch(0.60, 0.06, B), "58": lch(0.92, 0.03, CY),
        "59": lch(0.56, 0.07, CY), "60": lch(0.56, 0.07, G), "61": lch(0.56, 0.07, B), "62": lch(0.56, 0.07, M), "63": lch(0.56, 0.07, Y),
    }
    for slot in ("01", "02", "03", "04", "05", "06", "09", "11", "12", "14", "15", "24"):
        assert contrast(p[slot], bg) >= 4.5, f"color{slot} {p[slot]} is under 4.5:1 on {bg}"
    return p


def write(image, target):
    # The path lands inside double quotes in a file every theme consumer sources, and in an AppleScript string, so these would run as code.
    if re.search(r'["$`\\\n\r]', image):
        sys.exit(f"Rename {image!r} first: its name has a quote, dollar sign, backtick or backslash.")
    try:
        colors = palette(image)
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        sys.exit(f"Could not read {image} with ImageMagick: {e}")
    shown = "$HOME" + image[len(HOME):] if image.startswith(HOME + os.sep) else image
    lines = ["#!/usr/bin/env bash", "#shellcheck disable=SC2034", f"# Generated from {os.path.basename(image)} by theme-from-wallpaper.", f'wallpaper="{shown}"']
    lines += [f"gnohj_color{slot}={value}" for slot, value in sorted(colors.items())]
    os.makedirs(LIST, exist_ok=True)
    with open(target, "w") as f:
        f.write("\n".join(lines) + "\n")


def main():
    if sys.argv[1:] == ["--regenerate"]:
        for name in sorted(os.listdir(LIST)):
            with open(os.path.join(LIST, name), errors="replace") as f:
                m = re.search(r'^# Generated from .* by theme-from-wallpaper\.\nwallpaper="([^"\n]+)"', f.read(), re.M)
            image = m.group(1).replace("$HOME", HOME) if m else ""
            if os.path.isfile(image):
                write(image, os.path.join(LIST, name))
                print(name)
            elif m:
                print(f"skipped {name}: {image} is missing", file=sys.stderr)
        return
    if sys.argv[1:] == ["--unused"]:
        seen = scheme_wallpapers()
        for folder in WALLPAPERS:
            for name in sorted(os.listdir(folder)) if os.path.isdir(folder) else []:
                if name.lower().endswith(IMAGES) and name not in seen:
                    seen.add(name)
                    print(os.path.join(folder, name))
        return
    if len(sys.argv) != 2 or not os.path.isfile(sys.argv[1]):
        sys.exit(__doc__)
    image = os.path.abspath(sys.argv[1])
    if os.path.basename(image) in scheme_wallpapers():
        sys.exit(f"A scheme already uses {image}; pick it from the theme list instead.")
    slug = re.sub(r"[^a-z0-9]+", "-", os.path.splitext(os.path.basename(image))[0].lower()).strip("-") or "wallpaper"
    target = os.path.join(LIST, slug + "-colors.sh")
    if os.path.exists(target):
        sys.exit(f"{target} already exists.")
    write(image, target)
    print(os.path.basename(target))

if __name__ == "__main__":
    main()
