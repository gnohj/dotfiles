#!/usr/bin/env bash
# review-window [workspace] [profile-dir] - raise the default browser's window named "review" (creating it in [profile-dir] when none exists) and keep it on [workspace].
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/bin:/bin:$PATH"

name=review
workspace="${1:-}"
profile="${2:-}"

# The same browser to-desktop opens review links in, so both always agree on which window is "review".
browser=$(osascript -l JavaScript -e 'ObjC.import("AppKit"); $.NSBundle.bundleWithURL($.NSWorkspace.sharedWorkspace.URLForApplicationToOpenURL($.NSURL.URLWithString("https://example.com"))).bundleIdentifier.js')
# Helium's work profile, which Rift's " - work" title rule keeps on B.
[ "$browser" = net.imput.helium ] && profile="${profile:-Profile 1}"

# AppleScript cannot pick a Chromium profile, so a profile window comes from the launch flag and is named once it appears.
osascript -l JavaScript - "$browser" "$name" "$profile" >/dev/null <<'JS'
function run([bundle, name, profile]) {
  const app = Application(bundle);
  if (app.running() && app.windows().some((w) => w.givenName() === name)) return;
  if (!profile) {
    app.Window().make();
    app.windows[0].givenName = name;
    return;
  }
  const before = app.running() ? app.windows.id() : [];
  const shell = Application.currentApplication();
  shell.includeStandardAdditions = true;
  shell.doShellScript(`open -nb ${bundle} --args --profile-directory='${profile.replace(/'/g, "'\\''")}'`);
  for (let i = 0; i < 50; i++) {
    const win = app.windows().find((w) => !before.includes(w.id()));
    if (win) {
      win.givenName = name;
      return;
    }
    delay(0.1);
  }
}
JS

activate_browser() { osascript -e "tell application id \"$browser\" to activate" >/dev/null 2>&1 || true; }

# Chromium titles a named window "<name> - <tab>", which is the only handle Rift shares with AppleScript.
review_window() {
  rift-cli query workspaces 2>/dev/null | jq -c --arg bundle "$browser" --arg re "^${name}( - |$)" '
    [.[] as $ws | $ws.windows[] | select(.bundle_id == $bundle and (.title | test($re))) | {id, ws: $ws.index}] | first // empty'
}

window=""
for _ in $(seq 30); do
  window=$(review_window) || window=""
  [ -n "$window" ] && break
  sleep 0.1
done
[ -n "$window" ] || { activate_browser; exit 0; }

index=$(jq -r .ws <<<"$window")
# Moved by id before anything takes focus: Rift follows focus to the browser's app-rule workspace and races a focus-based move.
if [ -n "$workspace" ]; then
  target=$(rift-cli query workspaces 2>/dev/null | jq -r --arg ws "$workspace" '.[] | select(.name == $ws) | .index') || target=""
  if [ -n "$target" ] && [ "$target" != "$index" ]; then
    rift-cli execute workspace move-window "$target" "$(jq -r .id.idx <<<"$window")" >/dev/null 2>&1 && index=$target
  fi
fi

osascript -l JavaScript - "$browser" "$name" >/dev/null <<'JS'
function run([bundle, name]) {
  Application(bundle).windows().find((w) => w.givenName() === name).index = 1;
}
JS
# Focus by id leaves a hidden workspace hidden, so switch to it first.
rift-cli execute workspace switch "$index" >/dev/null 2>&1 || true
rift-cli execute window focus --window-id "$(jq -c .id <<<"$window")" >/dev/null 2>&1 || activate_browser
