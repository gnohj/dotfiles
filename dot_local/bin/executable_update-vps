#!/usr/bin/env bash
# update-vps [--background] - run `update` (pulls, then mise upgrade) in a throwaway Rex session on the VPS, or inline when Rex is unavailable; the Mac's `update` fires it in the background.
set -uo pipefail

host="${UPDATE_VPS_HOST:-dev-box}"
case "$host" in '' | -*) echo "update-vps: invalid host: $host" >&2; exit 2 ;; esac
log_dir="$HOME/.logs/update-vps"
log="$log_dir/$(date +%Y-%m-%d_%H%M%S).log"
mkdir -p "$log_dir"

# Runs on the VPS; nothing from this side is interpolated into it.
read -r -d '' remote <<'REMOTE'
set -uo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
steps='update'
id="$(date +%s)-$$"
dir="$HOME/.logs/update-vps"
mkdir -p "$dir"
out="$dir/$id.log"
result="$dir/$id.result"
rc_file="${XDG_RUNTIME_DIR:-/tmp}/update-vps-$id.rc"
# The pane closes itself on success and stays open on failure so the output is there to read.
printf -v run '{ UPDATE_RESULT_FILE=%q %s; } 2>&1 | tee %q; rc=${pipestatus[1]}; print $rc > %q' "$result" "$steps" "$out" "$rc_file"
# A Rex session outlives its last block, so success kills it; SKIP_FETCH keeps the greeting from clearing a failure's output.
rex_cmd="$run; [ \$rc = 0 ] && exec rex --autostart=false kill \"\$REX_BLOCK\"; exec zsh -i"
if [ "${1:-}" = rex ] && rex --autostart=false new "🔄 update" --cwd "$HOME" --window update -- env SKIP_FETCH=1 zsh -ic "$rex_cmd" >/dev/null 2>&1; then
  echo "update-vps: running in Rex session '🔄 update'"
else
  echo "update-vps: no Rex session, running inline"
  zsh -ic "$run"
  shown=1
  [ -s "$rc_file" ] || echo 1 >"$rc_file"
fi
for _ in $(seq 1 1800); do
  [ -s "$rc_file" ] && break
  sleep 1
done
[ -s "$rc_file" ] || { echo "update-vps: gave up waiting after 30 minutes, the pane is still open"; exit 124; }
rc=$(cat "$rc_file")
rm -f "$rc_file"
[ -n "${shown:-}" ] || cat "$out"
# Outside Rex here, so the restart cannot cut off the update.
if [ -x "$HOME/.local/bin/rex-restart-idle" ] && command -v rex >/dev/null 2>&1; then
  "$HOME/.local/bin/rex-restart-idle"
  if [ $? = 2 ]; then
    rc=1
    grep -qx "$(printf 'failed\trex server restart')" "$result" 2>/dev/null || printf 'failed\trex server restart\n' >>"$result"
  fi
fi
# update's own record of the outcome; the Mac builds its notification from these lines, never from the prose above.
[ -f "$result" ] && awk '{ print "update-vps-result\t" $0 }' "$result"
rm -f "$result"
find "$dir" -name '*.log' -mtime +14 -delete 2>/dev/null
exit "$rc"
REMOTE

# Run from Rex, the update opens as a Rex session on the VPS so the Rex sidebar shows it; otherwise it runs inline.
mux=none
[ "${TERM_PROGRAM:-}" = rex ] && mux=rex

ssh_host() {
  # ClearAllForwardings: the host's LocalForward/RemoteForward would collide with an open interactive session.
  ssh -o BatchMode=yes -o ConnectTimeout=5 -o ClearAllForwardings=yes "$host" "$@"
}

# The tailscale-app upgrade that `update` runs just before this leaves MagicDNS unresolvable for a minute or more.
wait_for_host() {
  local _
  for _ in $(seq 1 36); do
    ssh_host true 2>/dev/null && return 0
    sleep 5
  done
  return 1
}

run() {
  wait_for_host
  ssh_host bash -s -- "$mux" <<<"$remote"
}

notify() {
  [ -x "$HOME/.local/bin/mac-notify" ] || return 0
  "$HOME/.local/bin/mac-notify" -t "$1" -m "$2" -g update-vps >/dev/null 2>&1 || true
}

result_lines() {
  awk -F'\t' -v kind="$1" '$1 == "update-vps-result" && $2 == kind { printf "%s%s", sep, $3; sep = "; " }' "$log"
}

finish() {
  local rc="$1" failed notices
  find "$log_dir" -name '*.log' -mtime +14 -delete 2>/dev/null
  failed=$(result_lines failed)
  notices=$(result_lines notice)
  if [ -n "$failed" ]; then
    notify "VPS update failed: $failed" "${notices:+also: $notices - }see $log"
  elif [ "$rc" -ne 0 ]; then
    notify "VPS update failed (exit $rc)" "see $log"
  elif [ -n "$notices" ]; then
    notify "VPS updated, with notices" "$notices"
  else
    notify "VPS updated" "update on $host finished"
  fi
  return "$rc"
}

if [ "${1:-}" = --background ]; then
  (
    run >"$log" 2>&1
    finish "$?"
  ) </dev/null >/dev/null 2>&1 &
  disown
  printf 'update-vps: running on %s in the background, log: %s\n' "$host" "$log"
  exit 0
fi

run 2>&1 | tee "$log"
finish "${PIPESTATUS[0]}"
