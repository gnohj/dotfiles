#!/usr/bin/env bash
# Restore the Launchpad grid; uname-guarded to no-op on Linux, and the hash below re-runs it when the layout changes.
# layout sha256: {{ include "dot_config/launchpad/layout.yaml" | sha256sum }}
set -eu

[ "$(uname)" = "Darwin" ] || exit 0

# macOS 26 deleted Launchpad, so there is no grid left to restore.
if [ "$(sw_vers -productVersion | cut -d. -f1)" -ge 26 ]; then
  echo "Launchpad does not exist on macOS $(sw_vers -productVersion); skipping lporg."
  exit 0
fi

LAYOUT="$HOME/.config/launchpad/layout.yaml"
[ -f "$LAYOUT" ] || exit 0

# On a fresh machine brew has not run yet, so there is nothing to organize and no binary to do it with.
if ! command -v lporg >/dev/null 2>&1; then
  echo "lporg not installed yet; run 'lporg load --config $LAYOUT' after darwin-rebuild."
  exit 0
fi

if lporg load --config "$LAYOUT"; then
  echo "Launchpad layout restored from $LAYOUT."
else
  echo "!! lporg load failed; Launchpad layout NOT restored. Retry: lporg load --config $LAYOUT"
fi
