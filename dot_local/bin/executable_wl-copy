#!/usr/bin/env bash
# wl-copy shim: herdr-pluck offers wl-copy only when WAYLAND_DISPLAY is set and has no OSC 52 path, so route the copy through `to-desktop clip`.
set -uo pipefail

# A real WAYLAND_DISPLAY belongs to the real tool: hand off rather than shadow it, and rather than loop back through to-desktop's own wl-copy tier.
if [ "${WAYLAND_DISPLAY:-}" != herdr-pluck-shim ]; then
  while read -r candidate; do
    [ "$candidate" -ef "$0" ] || exec "$candidate" "$@"
  done < <(type -aP wl-copy 2>/dev/null)
  echo "wl-copy shim: no real wl-copy on PATH and WAYLAND_DISPLAY is not the shim sentinel" >&2
  exit 1
fi

# Fail closed instead of forking: to-desktop's do_clip prefers wl-copy, so a wrong display check would route straight back here.
if [ -n "${WL_COPY_SHIM_ACTIVE:-}" ]; then
  echo "wl-copy shim: re-entered from to-desktop; clipboard write dropped" >&2
  exit 1
fi
export WL_COPY_SHIM_ACTIVE=1

# wl-copy's own flags are accepted and ignored - a future pluck passing --trim-newline must not make this fail closed on the caller.
for arg in "$@"; do
  case "$arg" in
    -h | --help)
      echo "wl-copy shim: reads stdin and copies to the desktop clipboard via to-desktop clip." >&2
      exit 0
      ;;
  esac
done

payload=$(cat)

if ! command -v to-desktop >/dev/null 2>&1; then
  echo "wl-copy shim: to-desktop not found; clipboard write dropped" >&2
  exit 1
fi

# Delete this shim and the WAYLAND_DISPLAY export once herdr-pluck grows an OSC 52 fallback or a configurable copy command.
printf '%s' "$payload" | to-desktop clip -
