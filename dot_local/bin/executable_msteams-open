#!/usr/bin/env bash
# Rewrite an msteams: deep link into the Teams PWA's in-scope /v2/ fragment form and open it there.
set -euo pipefail

BUNDLE_ID="${TEAMS_PWA_BUNDLE_ID:-net.imput.helium.app.nfecgfopkdiicnnmccikafaofaoffegm}"
LOG="$HOME/.logs/msteams-open.log"

url="${1:-}"
[ -n "$url" ] || exit 0

# Both spellings in the wild: `msteams:/l/meetup-join/…` and `msteams://teams.microsoft.com/l/…`.
path="$url"
path="${path#msteams-enterprise:}"
path="${path#msteams:}"
path="${path#//teams.microsoft.com}"
case "$path" in /*) ;; *) path="/$path" ;; esac

# The path rides in the FRAGMENT: a bare /l/... URL is outside the app's /v2/ scope and gets dropped.
case "$path" in
  /l/meetup-join/*) target="https://teams.microsoft.com/v2/?meetingjoin=true#$path" ;;
  *)                target="https://teams.microsoft.com/v2/#$path" ;;
esac

mkdir -p "$(dirname "$LOG")"
printf '[%s] %s -> %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$url" "$target" >>"$LOG"

# A running PWA only focuses on relaunch and drops the URL, so steer its open window to the target instead.
steered=$(osascript - "$target" <<'SCPT' 2>>"$LOG" || true
on run argv
	if application "Helium" is not running then return "no"
	tell application "Helium"
		repeat with w in windows
			if URL of active tab of w starts with "https://teams.microsoft.com/v2/" then
				set URL of active tab of w to item 1 of argv
				return "yes"
			end if
		end repeat
	end tell
	return "no"
end run
SCPT
)

if [ "$steered" = "yes" ]; then
  exec open -b "$BUNDLE_ID"
fi
exec open -b "$BUNDLE_ID" "$target"
