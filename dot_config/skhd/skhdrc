# Disable minimize/hide
cmd + shift - q : osascript -e 'tell application "System Events" to set frontApp to name of first application process whose frontmost is true' -e 'tell application frontApp to quit'
cmd - m : :
cmd - h : :
cmd - 0x27 : ~/.local/bin/baby-menu-toggle
# rctrl and not cmd+v: skhd's tap catches SYNTHETIC keystrokes too, so OpenSuperWhisper's post-dictation Cmd+V was rerouted through this ~140ms out-of-process hop and lost the race against its own clipboard restore (issue #153). Cmd+V stays Ghostty-native; lctrl+v still reaches the shell as 0x16.
rctrl - v [
  "Ghostty" : ~/.local/bin/terminal-smart-paste
  * ~
]

# Global Kitty Quake Terminal — the launcher, running locally.
# kitty and not ghostty: ghostty 1.3.1 rejects a right-ctrl chord outright (a
# global:cmd+right_ctrl+<key> bind returns InvalidFormat), has no CLI for skhd to
# toggle its quick terminal, and scopes `command` app-wide rather than per-quake.
# kitty's quick-access takes an instance group + its own config and command, so
# rctrl stays distinguishable.
# The ssh/yazi/plain quakes that used to sit on s/y/k are retired: the launcher
# resolves tmux-vs-herdr at runtime (active_mux in launcher.sh), so a separate key
# per mux was never the thing encoding it.
cmd + rctrl - r : ~/.config/skhd/kitty-ql-quake.sh
# Same launcher, but running ON the dev box, resolved live from the tailnet at press time. dev-context only overrides the target; a banner explains any no-op.
cmd + rctrl - t : ~/.config/skhd/kitty-remote-quake.sh

# Needs to work local / remote
   # MIGRATED to ghostty/kitty prefix-expansion → tmux server-side binds (work local + VPS):
   #   notify-switch  → ctrl+'  (C-a ')
   #   worktree abort → ctrl+/  (C-a /)
   # Only clear-notifications stays skhd-triggered (still calls the portable script):
rctrl - escape : ~/.local/bin/mux/shared/notify-idle-clear.sh # clear stuck banners + state (uname-branched: Darwin dismisses banners, Linux clears the marker)
   # Screenshot utilities - Hyper key bindings (Ctrl + Shift + Alt + Cmd)
hyper - x : ~/.config/skhd/screenshot-save-and-copy.sh  # Native screenshot - save to file AND copy filepath to clipboard

# Rift window manager. Workspace index = letter - A (see ~/.config/rift/config.toml).

# Rift - Focus commands
lalt - h : /opt/homebrew/bin/rift-cli execute window focus left
lalt - j : /opt/homebrew/bin/rift-cli execute window focus down
lalt - k : /opt/homebrew/bin/rift-cli execute window focus up
lalt - l : /opt/homebrew/bin/rift-cli execute window focus right

# Rift - Layout commands
lalt - 0x2C : ~/.local/libexec/rift-layout bsp          # your / key
lalt - 0x2B : ~/.local/libexec/rift-layout stack        # your , key
lalt - 0x2F : ~/.local/libexec/rift-layout scrolling    # your . key (niri-style columns; again: back to default)

# Rift - Move commands
lalt + shift - h : /opt/homebrew/bin/rift-cli execute layout move-node left
lalt + shift - j : /opt/homebrew/bin/rift-cli execute layout move-node down
lalt + shift - k : /opt/homebrew/bin/rift-cli execute layout move-node up
lalt + shift - l : /opt/homebrew/bin/rift-cli execute layout move-node right

# Rift - Resize commands
lalt + shift - 0x1B : /opt/homebrew/bin/rift-cli execute window resize-shrink --orientation smart # minus
lalt + shift - 0x18 : /opt/homebrew/bin/rift-cli execute window resize-grow --orientation smart # equal

