#!/usr/bin/env bash
# worktree — one entry point for "capture something, turn it into a git worktree"; run `worktree help` for the verbs.
set -euo pipefail

SELF="$HOME/.local/bin/worktree/worktree"
WT_DIR="$HOME/.local/bin/worktree"
MUX="$HOME/.local/bin/mux/mux"

# Callers (skhd, launcher popups, gh-dash) spawn with a minimal PATH, so pin one that resolves claude/git/treekanga/notifier/clipboard tools.
export PATH="$HOME/.local/bin:$HOME/.local/bin/mux:$WT_DIR:/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
[ "$(uname)" = Linux ] && PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"

die() { printf 'worktree: %s\n' "$1" >&2; exit "${2:-1}"; }

cmd_help() {
  cat <<'EOF'
worktree — capture something, turn it into a git worktree.

  worktree prompt            free-text popup → /worktree
  worktree jira              active browser tab (Jira URL) → /worktree
  worktree clipboard         clipboard text/image → /worktree
  worktree bug               clipboard → /worktree, Jira filing deferred
  worktree retry [<note>]    re-fire a captured bug note from the vault
  worktree jira-file         Stage B — file the pending Jira ticket for $PWD
  worktree abort             kill an in-flight runner (picker when ≥2)
  worktree help

Internal (invoked by the verbs above, not by hand):
  worktree runner            shared backend; reads WORKTREE_* env
  worktree capture <outcome> [reason]
                             write the vault inbox note for a run

Sibling scripts in this folder, not verbs: worktree-list (enumerate), wtsync
(seed zoxide). Kept standalone elsewhere: setup-worktrees (provisioning).
EOF
}

#-------------------------------------------------------------------------------
# Shared helpers
#-------------------------------------------------------------------------------

# terminal-notifier (a registered bundle id) reliably shows banners on Sequoia,
# unlike `osascript -e 'display notification'` which Apple drops for unregistered
# CLI tools. mac-notify owns that fallback plus icon resolution.
notify_error() {
  local tag="$1" msg="$2" icon="${3:-}"
  # mac-notify no-ops off darwin, so the devbox would fail silently; to-desktop owns the portable fallback chain.
  if [ "$(uname -s)" != Darwin ]; then
    to-desktop notify "$tag" "$msg" 2>/dev/null || printf '%s: %s\n' "$tag" "$msg" >&2
    return 0
  fi
  if [ -n "$icon" ] && [ -f "$icon" ]; then
    mac-notify -t "$tag" -m "$msg" -T 6 -g "${tag}-error" -i "$icon"
  else
    mac-notify -t "$tag" -m "$msg" -T 6 -g "${tag}-error"
  fi
}

# 12s / 2m30s / 1h05m
fmt_secs() {
  local s="$1"
  if [ "$s" -lt 60 ]; then
    printf '%ds' "$s"
  elif [ "$s" -lt 3600 ]; then
    printf '%dm%02ds' "$((s / 60))" "$((s % 60))"
  else
    printf '%dh%02dm' "$((s / 3600))" "$(((s % 3600) / 60))"
  fi
}

# Fired by skhd, these verbs run OUTSIDE any tmux client, so `tmux display-popup`
# has no client to host on and the script appears to "just close" (under set -e,
# before any banner fires). Re-enter the tmux server context so the popup renders.
# Only when tmux is the LIVE multiplexer: on the Mac a tmux server exists even
# while you're on herdr, where the capture runs inline in the quake instead.
respawn_into_tmux() {
  local verb="$1"
  [ -z "${TMUX:-}" ] || return 1
  [ -z "${WORKTREE_RESPAWNED:-}" ] || return 1
  [ "$("$MUX" kind)" = tmux ] || return 1
  tmux ls >/dev/null 2>&1 || return 1
  WORKTREE_RESPAWNED=1 tmux run-shell -b "$SELF $verb"
  return 0
}

# WARNING: under herdr's inline popup the staged script shares this process's stdio — so the header must stay a positional arg (stdin would leave `read` on a drained heredoc) and the answer must come back in a global (a command substitution would swallow the prompt).
popup_read() {
  local w="$1" h="$2" label="$3" header="$4" sh out hdr
  out=$(mktemp -t worktree-popup-input.XXXXXX)
  sh=$(mktemp -t worktree-popup.XXXXXX.sh)
  # SAFETY: the header carries clipboard text, so the script cats it from its own file — inlined as a heredoc, a payload line matching the delimiter would close it and run the rest as shell.
  hdr=$(mktemp -t worktree-popup-header.XXXXXX)
  printf '%s\n' "$header" > "$hdr"
  chmod +x "$sh"
  {
    echo '#!/usr/bin/env bash'
    # ANSI fallback: the dev box has no xterm-kitty terminfo, so `clear` fails there and the prompt draws over whatever was on screen.
    echo "clear 2>/dev/null || printf '\\033[2J\\033[H'"
    printf 'cat %q\n' "$hdr"
    # The quake starts the launcher under `stty -echo` because fzf draws its own input; `read -e` obeys that flag, so keystrokes land but stay invisible.
    echo '_tty_saved=$(stty -g 2>/dev/null || true)'
    echo 'stty echo 2>/dev/null || true'
    printf 'read -e -p %q ans\n' "$label"
    echo '[ -n "$_tty_saved" ] && stty "$_tty_saved" 2>/dev/null || true'
    printf 'printf %%s "$ans" > %q\n' "$out"
  } > "$sh"
  # A cancel exits non-zero and set -e would abort before the caller can check.
  "$MUX" popup --width "$w" --height "$h" "$sh" || true
  POPUP_ANSWER=$(cat "$out" 2>/dev/null || true)
  rm -f "$out" "$sh" "$hdr"
}

# Off the workstation (the dev box) the clipboard lives on the Mac, so to-desktop relays the read back.
at_workstation() { [ "$("$HOME/.local/bin/machine-identity" role 2>/dev/null || echo mac)" != devbox ]; }

# Detect what's on the clipboard. Sets CLIPBOARD_KIND (image|text), CLIP, TMP_IMG.
# Returns 1 on an empty clipboard. Image wins — pngpaste is authoritative.
#
# BSD mktemp only substitutes TRAILING X's, so `.png` can't be part of the
# template; make the temp file then rename to the extension claude's Read needs.
detect_clipboard() {
  local prefix="$1" base p resolved=""
  CLIPBOARD_KIND=""; CLIP=""; TMP_IMG=""
  base=$(mktemp "${TMPDIR:-/tmp}/${prefix}-image.XXXXXX")
  TMP_IMG="${base}.png"
  mv "$base" "$TMP_IMG"

  # No path-to-image fallback here: a copied path names a file on the workstation's disk, so it stays text.
  if ! at_workstation; then
    to-desktop paste-image 2>/dev/null | base64 -d > "$TMP_IMG" 2>/dev/null || true
    if [ -s "$TMP_IMG" ]; then
      CLIPBOARD_KIND="image"
      return 0
    fi
    rm -f "$TMP_IMG"
    TMP_IMG=""
    CLIP=$(to-desktop paste 2>/dev/null || true)
    [ -n "$CLIP" ] || return 1
    CLIP=$(printf '%s' "$CLIP" | clipboard-sanitize)
    CLIPBOARD_KIND="text"
    return 0
  fi

  # $TMP_IMG must survive past the exec — the spawned claude session reads it.
  # /tmp is auto-cleaned by the OS, so no manual cleanup.
  if pngpaste "$TMP_IMG" 2>/dev/null && [ -s "$TMP_IMG" ]; then
    CLIPBOARD_KIND="image"
    return 0
  fi

  rm -f "$TMP_IMG"
  TMP_IMG=""
  CLIP=$(pbpaste 2>/dev/null || wl-paste 2>/dev/null || true)
  [ -n "$CLIP" ] || return 1
  # claude's CLI panics on stray non-UTF-8 bytes (e.g. the \xCA MacRoman NBSP
  # Slack-on-macOS injects between display name and message).
  CLIP=$(printf '%s' "$CLIP" | clipboard-sanitize)

  # Path-to-image fallback: Cmd-C on a screenshot *file* in Finder/iCloud puts
  # the path on the clipboard as text, not raw image bytes, so pngpaste missed it.
  case "$CLIP" in
    *$'\n'*) ;;  # multiline → not a path
    *)
      p="${CLIP#"${CLIP%%[![:space:]]*}"}"
      p="${p%"${p##*[![:space:]]}"}"
      case "$p" in
        \"*\") p="${p#\"}"; p="${p%\"}" ;;
        \'*\') p="${p#\'}"; p="${p%\'}" ;;
      esac
      p="${p#file://}"
      p="${p/#\~/$HOME}"
      if [ -f "$p" ]; then
        case "$p" in
          *.png|*.PNG|*.jpg|*.JPG|*.jpeg|*.JPEG|*.gif|*.GIF|*.webp|*.WEBP|*.heic|*.HEIC|*.bmp|*.BMP)
            resolved="$p" ;;
        esac
      fi
      ;;
  esac
  if [ -n "$resolved" ]; then
    TMP_IMG="$resolved"
    CLIP=""
    CLIPBOARD_KIND="image"
  else
    CLIPBOARD_KIND="text"
  fi
}

# "📋 <first 200 chars, newlines collapsed>" for a popup header.
text_preview() {
  local text="$1" out
  out=$(printf '%s' "$text" | tr '\n' ' ' | head -c 200)
  [ "${#text}" -gt 200 ] && out="${out}…"
  printf '📋 %s' "$out"
}

# haiku for Mode A (Jira URL / bare ticket key) and Mode B (3-token input whose
# middle token carries digits — a structured branch like IHRWEB-1234); those are
# lookups, and haiku is ~50% faster. sonnet only for Mode C free-text inference.
#
# `loose` matches a payload that merely starts with a URL/ticket key; `strict` needs the whole payload to be one, since a paste opening with a key is usually still prose.
pick_model() {
  local text="$1" mode="${2:-loose}" toks
  case "$mode" in
    loose)
      [[ "$text" =~ ^[[:space:]]*(https://[^/]+\.atlassian\.net/|[A-Z]+-[0-9]+) ]] && { printf haiku; return 0; }
      ;;
    strict)
      [[ "$text" =~ ^[[:space:]]*[A-Z]+-[0-9]+[[:space:]]*$ ]] && { printf haiku; return 0; }
      ;;
  esac
  read -r -a toks <<< "$text"
  if [ "${#toks[@]}" -eq 3 ] && [[ "${toks[1]}" =~ [0-9] ]]; then
    printf haiku
    return 0
  fi
  printf sonnet
}

# Folder buckets a worktree may live under, shared by the Mode-B rewrite, the
# fast-path validator and the "did you mean?" suggester.
WT_BUCKETS="fix feat ui infra refactor perf test chore spike"
is_bucket() {
  local b
  for b in $WT_BUCKETS; do [ "$1" = "$b" ] && return 0; done
  return 1
}

# Canonical repo allowlist from repos.conf (gitignored, employer-specific).
# Falls back to "web inferno" so a fresh machine still works. Blank lines and
# `#` comments are stripped. Portable parsing (no mapfile): macOS system bash is
# 3.2 and skhd's minimal PATH resolves `env bash` to /bin/bash.
load_valid_repos() {
  local conf="$WT_DIR/repos.conf" line
  VALID_REPOS=()
  if [ -s "$conf" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%%#*}"
      line=$(echo "$line" | tr -d '[:space:]')
      [ -n "$line" ] && VALID_REPOS+=( "$line" )
    done < "$conf"
  fi
  [ "${#VALID_REPOS[@]}" -eq 0 ] && VALID_REPOS=( web inferno )
  return 0
}
is_valid_repo() {
  local r
  for r in "${VALID_REPOS[@]}"; do [ "$1" = "$r" ] && return 0; done
  return 1
}

# Strip non-alphanumerics so a label is safe across every interpolation site.
slugify() {
  echo "$1" | tr -c '[:alnum:]_-' '-' | sed 's/-\{2,\}/-/g; s/^-\|-$//g' | head -c 40
}

# The two prompt files worktree-bug / worktree-retry feed to claude: a committed
# generic scaffold plus the gitignored per-employer detail.
read_jira_conventions() {
  local scaffold="$WT_DIR/jira-prompt.md" detail="$WT_DIR/jira-prompt-company.md"
  if [ ! -s "$scaffold" ] || [ ! -s "$detail" ]; then
    return 1
  fi
  cat "$scaffold" "$detail"
}

#-------------------------------------------------------------------------------
# runner — shared backend for every capture verb.
#
# Capture verbs reduce user input to a single string, then exec into this with:
#
# Required env:
#   WORKTREE_GROUP         terminal-notifier banner group id, so the start banner
#                          is replaced by the final ready/failed banner.
#   WORKTREE_LOG_TAG       basename for the per-run log + tmpfiles.
#
# Required (one of, in precedence order):
#   WORKTREE_RAW_COMMAND   direct shell command, no claude. ~25-30s faster for
#                          canonical inputs that need no inference.
#   WORKTREE_RAW_PROMPT    full claude prompt, replacing the constructed
#                          "/worktree …". Use when the verb chains pre-steps
#                          (classify, hydrate a Slack thread, read an image).
#   WORKTREE_CLAUDE_INPUT  token(s) appended to "/worktree … --yes".
#
# Optional env:
#   WORKTREE_CLAUDE_ACCOUNT  "work"|"personal"; empty → claude-account's cwd rule.
#   WORKTREE_CLAUDE_MODEL    default sonnet.
#   WORKTREE_LOG_HEADER      multi-line block written into the log.
#   WORKTREE_START_TITLE     "creating…" banner title.
#   WORKTREE_START_MESSAGE   "creating…" banner message.
#   WORKTREE_FALLBACK_LABEL  banner message when SESSION couldn't be derived.
#   WORKTREE_OPEN_IN         where worktree_setup.sh should open the result.
#
# Vault capture (default: failures + NOT_BUG decisions get an inbox note):
#   WORKTREE_CAPTURE_PAYLOAD   original input; "image:<path>" for image payloads.
#   WORKTREE_CAPTURE_CONTEXT   user-typed context from the verb's popup.
#   WORKTREE_CAPTURE_ALWAYS    1 → capture successes too.
#   WORKTREE_DEFER_JIRA        1 → capture success as outcome=pending-jira, with
#                              a path-derived filename Stage B can look up.
#-------------------------------------------------------------------------------
cmd_runner() {
  : "${WORKTREE_GROUP:?WORKTREE_GROUP required}"
  : "${WORKTREE_LOG_TAG:?WORKTREE_LOG_TAG required}"
  if [ -z "${WORKTREE_CLAUDE_INPUT:-}" ] && [ -z "${WORKTREE_RAW_PROMPT:-}" ] && [ -z "${WORKTREE_RAW_COMMAND:-}" ]; then
    die "WORKTREE_CLAUDE_INPUT, WORKTREE_RAW_PROMPT, or WORKTREE_RAW_COMMAND required"
  fi

  EXEC_MODE="claude"
  [ -n "${WORKTREE_RAW_COMMAND:-}" ] && EXEC_MODE="bash"

  DEFAULT_LABEL="${WORKTREE_CLAUDE_INPUT:-Running custom prompt}"
  START_TITLE="${WORKTREE_START_TITLE:-Creating worktree…}"
  START_MESSAGE="${WORKTREE_START_MESSAGE:-$DEFAULT_LABEL}"
  FALLBACK_LABEL="${WORKTREE_FALLBACK_LABEL:-$START_MESSAGE}"
  CLAUDE_MODEL="${WORKTREE_CLAUDE_MODEL:-sonnet}"
  # Baked into the inner script, which resolves the token live via claude-account
  # so no secret hits disk.
  CLAUDE_ACCOUNT_NAME="${WORKTREE_CLAUDE_ACCOUNT:-}"

  # Heartbeat banner carries the trimmed input beside the elapsed timer, so with
  # several creations in flight you can tell which one is still running.
  HB_INPUT_TRIMMED=$(printf '%s' "$START_MESSAGE" | tr '\n' ' ' | head -c 50)
  [ "${#START_MESSAGE}" -gt 50 ] && HB_INPUT_TRIMMED="${HB_INPUT_TRIMMED}…"

  # Resolve the REAL user terminal BEFORE unsetting TERM_PROGRAM below: inside the
  # spawned Terminal.app it resolves to "Apple_Terminal", so auto-detected banner
  # icons would always show Terminal's. Bake the icon through to every banner site.
  USER_TERM_HINT="${TERM_PROGRAM:-}"
  if [ -z "$USER_TERM_HINT" ] && command -v tmux >/dev/null 2>&1; then
    USER_TERM_HINT=$(tmux display-message -p '#{client_termtype}' 2>/dev/null || true)
  fi
  ICON_PNG=$(resolve-term-icon "${USER_TERM_HINT:-terminal}" 2>/dev/null || true)

  # `open -na Terminal` propagates TERM_* and TMUX but filters custom vars. When
  # the caller is inside tmux + Ghostty, TERM_PROGRAM=ghostty propagates and
  # tricks Terminal's zshrc into firing ghosttyfetch, which spawns its own tmux
  # child and creates an unnamed numeric session. Unsetting it is the only fix.
  unset TERM_PROGRAM TERM_PROGRAM_VERSION
  export SKIP_FETCH=1

  TIMEOUT_SECONDS=12     # start banner — replaced by heartbeats / final
  FINAL_TIMEOUT=30       # outcome banner — sticks longer so it isn't missed

  mac-notify -t "$START_TITLE" -m "$START_MESSAGE" -g "$WORKTREE_GROUP" -T "$TIMEOUT_SECONDS"

  # Snapshot tmux sessions BEFORE Terminal.app opens — Terminal/shell init
  # occasionally spawns an unnamed numeric session as a side effect and we need to
  # know it wasn't ours. Snapshotting inside the inner script is too late.
  # `|| true` inside the pipeline: under pipefail a serverless `tmux ls` kills the runner right after the start banner.
  TMUX_SNAPSHOT=$(mktemp -t "${WORKTREE_LOG_TAG}-tmux.XXXXXX")
  { tmux ls -F '#{session_name}' 2>/dev/null || true; } | sort -u > "$TMUX_SNAPSHOT"

  # Snapshot all git worktrees under ~/Developer before claude runs; the new one is
  # the set difference afterward - an authoritative detector that doesn't depend on
  # claude printing the path. Sorted for `comm` in the diff below.
  # Same pipefail guard: a non-repo dir under ~/Developer would abort the runner.
  WT_SNAPSHOT=$(mktemp -t "${WORKTREE_LOG_TAG}-wt.XXXXXX")
  for _r in "$HOME"/Developer/*/; do
    { git -C "$_r" worktree list --porcelain 2>/dev/null || true; } | awk '/^worktree /{print $2}'
  done | sort -u > "$WT_SNAPSHOT"

  # Stage the log header + prompt as tmpfiles so multi-line content and special
  # chars don't have to survive an outer-shell expansion inside the heredoc below.
  LOG_HEADER_FILE=$(mktemp -t "${WORKTREE_LOG_TAG}-header.XXXXXX")
  if [ -n "${WORKTREE_LOG_HEADER:-}" ]; then
    printf '%s\n' "$WORKTREE_LOG_HEADER" > "$LOG_HEADER_FILE"
  fi

  PROMPT_FILE=$(mktemp -t "${WORKTREE_LOG_TAG}-prompt.XXXXXX")
  if [ -n "${WORKTREE_RAW_COMMAND:-}" ]; then
    printf '%s' "$WORKTREE_RAW_COMMAND" > "$PROMPT_FILE"
  elif [ -n "${WORKTREE_RAW_PROMPT:-}" ]; then
    printf '%s' "$WORKTREE_RAW_PROMPT" > "$PROMPT_FILE"
  else
    printf '/worktree %s --yes' "$WORKTREE_CLAUDE_INPUT" > "$PROMPT_FILE"
  fi

  # Always create the capture files (empty when capture isn't requested) so the
  # inner trap can clean a uniform set of paths.
  CAPTURE_PAYLOAD_FILE=$(mktemp -t "${WORKTREE_LOG_TAG}-payload.XXXXXX")
  CAPTURE_CONTEXT_FILE=$(mktemp -t "${WORKTREE_LOG_TAG}-context.XXXXXX")
  CAPTURE_IMAGE_SRC=""
  if [ -n "${WORKTREE_CAPTURE_PAYLOAD:-}" ]; then
    # "image:<path>" identifies a clipboard image: the capture helper copies it
    # into Notes-Assets and the payload file keeps a marker for slug derivation.
    if [[ "$WORKTREE_CAPTURE_PAYLOAD" =~ ^image:(.+)$ ]]; then
      CAPTURE_IMAGE_SRC="${BASH_REMATCH[1]}"
      printf 'image: %s\n' "$CAPTURE_IMAGE_SRC" > "$CAPTURE_PAYLOAD_FILE"
    else
      printf '%s' "$WORKTREE_CAPTURE_PAYLOAD" > "$CAPTURE_PAYLOAD_FILE"
    fi
    printf '%s' "${WORKTREE_CAPTURE_CONTEXT:-}" > "$CAPTURE_CONTEXT_FILE"
  fi

  # Per-run postScript log. treekanga's worktree_setup.sh honors
  # TREEKANGA_POSTSCRIPT_LOG, which the inner script exports before invoking
  # claude, so each runner reads its own file — no cross-contamination.
  #
  # Fallback: if the var fails to propagate from claude's Bash tool through to
  # treekanga's postScript subprocess (claude's tooling sometimes scrubs env), the
  # per-run log is empty and the inner script falls back to byte-offset accounting
  # against the global log. The single-runner case still detects success; the
  # concurrent case can mis-attribute under that fallback, but no detection at all
  # is worse than the rare race.
  PS_LOG_PER_RUN=$(mktemp -t "${WORKTREE_LOG_TAG}-ps.XXXXXX.log")
  PS_LOG_GLOBAL="$HOME/.logs/treekanga-postscript.log"
  # 2>/dev/null first: redirections apply left to right, so it must precede the input redirect.
  PS_LOG_GLOBAL_SIZE_BEFORE=$(wc -c 2>/dev/null < "$PS_LOG_GLOBAL" || echo 0)

  # SAFETY: these three carry clipboard/prompt text into the generated script below, so pre-quote them — an unquoted payload containing `"` or `$(…)` would otherwise execute there.
  HB_MSG_Q=$(printf '%q' "${WORKTREE_LOG_TAG}: $HB_INPUT_TRIMMED")
  FALLBACK_Q=$(printf '%q' "$FALLBACK_LABEL")
  IMAGE_SRC_Q=$(printf '%q' "$CAPTURE_IMAGE_SRC")

  # Stage the run-script in a tmp file so we don't have to wrestle with
  # `open --args` quoting. The trap inside cleans it up after claude exits.
  TMPSCRIPT=$(mktemp -t "${WORKTREE_LOG_TAG}.XXXXXX.sh")
  chmod +x "$TMPSCRIPT"
  LOGFILE="\$HOME/.logs/${WORKTREE_LOG_TAG}.log"
  cat > "$TMPSCRIPT" <<EOF
#!/usr/bin/env bash
# Cleanup runs on EVERY exit path — normal completion, abort SIGTERM, claude
# crash, error. Moving the Terminal-quit watcher in here (instead of at the end
# of the script) stops abandoned worktree windows piling up when the script
# doesn't reach its tail — most commonly because the abort hotkey sent SIGTERM
# mid-claude.
#
# Order matters:
#   1. pkill -P \$\$  — kill children (heartbeat). The watcher we're about to
#                       spawn isn't a child yet, so it's safe.
#   2. ( bash -c '…' & )  — double-fork the watcher: the outer subshell forks,
#                            backgrounds and exits, so the watcher's PPID becomes
#                            init. Immune to any later pkill -P on our PID, and
#                            survives even if we were killed by SIGTERM.
#   3. rm -f …  — clean tmpfiles + per-PID state file.
cleanup() {
  pkill -P \$\$ 2>/dev/null
  # Capture our tty BEFORE the watcher subshell — once we exit, /dev/tty is gone.
  # AppleScript matches the Terminal window owning this tty and closes it
  # explicitly, rather than relying on Terminal's "When shell exits" preference
  # (which varies, and shipped wrong on at least one machine — leaving piles of
  # orphan windows visible in workspace J).
  local our_tty
  our_tty=\$(tty 2>/dev/null)
  ( ( sleep 1; osascript -e 'on run argv
    set targetTTY to item 1 of argv
    tell application "Terminal"
      repeat with w in windows
        try
          if (tty of selected tab of w) is targetTTY then
            close w saving no
            exit repeat
          end if
        end try
      end repeat
      if (count of windows) is 0 then quit
    end tell
  end run' "\$our_tty" 2>/dev/null ) </dev/null >/dev/null 2>&1 & ) 2>/dev/null
  # Note: $PS_LOG_PER_RUN is NOT removed here. The bg subshell postScript spawns
  # keeps writing pnpm install + codegen + hook output to it AFTER this script
  # (and treekanga, and claude) has exited. Removing it would race with those
  # writes. /var/folders/…/T is auto-cleaned by macOS, so leaking the per-run log
  # is harmless and useful for debugging.
  rm -f "$TMPSCRIPT" "$TMUX_SNAPSHOT" "$WT_SNAPSHOT" "$LOG_HEADER_FILE" "$PROMPT_FILE" "$CAPTURE_PAYLOAD_FILE" "$CAPTURE_CONTEXT_FILE" "/tmp/worktree-runner-\$\$.state"
}
trap cleanup EXIT

# State file for the abort hotkey (→ \`worktree abort\`). One file per concurrent
# runner — the name includes \$\$ so two runners in flight don't clobber each
# other. The abort verb scans /tmp/worktree-runner-*.state and shows an fzf
# picker when ≥2 are alive.
cat > /tmp/worktree-runner-\$\$.state <<-STATE
PID=\$\$
GROUP=$WORKTREE_GROUP
TAG=$WORKTREE_LOG_TAG
STARTED=\$(date +%s)
STATE

# Strip TMUX env so the postScript's \`[ -n "\$TMUX" ]\` branch correctly reads this
# as a non-tmux (headless wrapper) flow. Without it, \`open -na Terminal\`
# propagates the launcher popup's tmux env and the postScript hijacks the user's
# tmux client via sesh connect.
unset TMUX TMUX_PANE TMUX_PLUGIN_MANAGER_PATH

# Terminal.app's spawn env lacks the user's full PATH. Restore enough for claude
# + git + treekanga + pnpm to resolve.
export PATH="\$HOME/.local/bin:\$HOME/.local/bin/mux:\$HOME/.local/bin/worktree:\$HOME/.local/share/mise/shims:\$HOME/.cargo/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export SKIP_FETCH=1
# Point treekanga's postScript at OUR per-run file instead of the global log:
# claude inherits this env → treekanga inherits from claude → postScript reads it.
export TREEKANGA_POSTSCRIPT_LOG="$PS_LOG_PER_RUN"
# Where worktree_setup.sh should open the new worktree (herdr workspace vs sesh vs
# clipboard). Rides the SAME env chain, set by the ql / herdr launcher actions and
# baked here so it survives the open→Terminal boundary. Empty (tmux) is a no-op.
export WORKTREE_OPEN_IN="${WORKTREE_OPEN_IN:-}"

# Inject account creds like the interactive claude() function does — raw
# \`claude -p\` skips it and would otherwise use the stale shared Keychain login
# ("Not logged in"). Exported so the backgrounded /sb-ticket-capture inherits it.
export CLAUDE_ACCOUNT="$CLAUDE_ACCOUNT_NAME"
_wt_cfg=\$(claude-account dir 2>/dev/null || true)
_wt_tok=\$(claude-account token 2>/dev/null || true)
[ -n "\$_wt_cfg" ] && export CLAUDE_CONFIG_DIR="\$_wt_cfg"
[ -n "\$_wt_tok" ] && export CLAUDE_CODE_OAUTH_TOKEN="\$_wt_tok"

START_TS=\$(date +%s)
fmt_duration() {
  local s=\$1
  if [ "\$s" -lt 60 ]; then
    printf '%ds' "\$s"
  elif [ "\$s" -lt 3600 ]; then
    printf '%dm%02ds' "\$((s/60))" "\$((s%60))"
  else
    printf '%dh%02dm' "\$((s/3600))" "\$(((s%3600)/60))"
  fi
}

mkdir -p "\$(dirname $LOGFILE)"
echo "=== \$(date) ===" >> $LOGFILE
[ -s "$LOG_HEADER_FILE" ] && cat "$LOG_HEADER_FILE" >> $LOGFILE
if [ "$EXEC_MODE" = "bash" ]; then
  echo "Running raw command (no claude)..." | tee -a $LOGFILE
else
  echo "Running claude -p ($CLAUDE_MODEL)..." | tee -a $LOGFILE
fi

# Heartbeat: replace the "Creating…" banner with "running… Xs elapsed" at growing
# intervals while claude works. Same notification group so each beat REPLACES the
# previous. The EXIT trap pkill's all children of \$\$ — that catches this subshell
# whether claude finishes naturally or the user fires the abort hotkey.
(
  HB_ELAPSED=0
  for HB_INTERVAL in 30 30 30 60 60 120; do
    sleep "\$HB_INTERVAL"
    HB_ELAPSED=\$((HB_ELAPSED + HB_INTERVAL))
    mac-notify \\
      -t "Worktree running… \${HB_ELAPSED}s" \\
      -m $HB_MSG_Q \\
      -g "$WORKTREE_GROUP" \\
      -T 60
  done
) &
HEARTBEAT_PID=\$!

# NOTE: RAW_COMMAND mode currently still goes through claude — the \`bash -c\`
# short-circuit the header above advertises was never wired up here. Carried over
# as-is from worktree-runner rather than changed during the consolidation.
claude --dangerously-skip-permissions --model $CLAUDE_MODEL -p "\$(< "$PROMPT_FILE")" 2>&1 | tee -a $LOGFILE

# Stop the heartbeat the moment the work returns. SIGKILL the subshell AND any
# \`terminal-notifier\` GRANDCHILD it may have spawned milliseconds earlier
# (heartbeat → mac-notify → terminal-notifier). pkill -P only reaches direct
# children, so an already-running terminal-notifier could still submit its banner
# AFTER our final one and clobber it via same-group replacement. Killing by
# command-line pattern reaps any in-flight attempt.
kill -9 "\$HEARTBEAT_PID" 2>/dev/null || true
pkill -9 -P "\$HEARTBEAT_PID" 2>/dev/null || true
pkill -9 -f "terminal-notifier.*${WORKTREE_GROUP}" 2>/dev/null || true
wait 2>/dev/null || true
sleep 0.5
echo

# treekanga -x discards the postScript's stdout/stderr, so claude can't see (and
# won't faithfully report) what actually happened. The postScript writes its own
# per-run log; print it here so the Terminal window shows authoritative ✓/✗ status.
PS_LOG="$PS_LOG_PER_RUN"
SESSION=""
WORKTREE_PATH=""
OUTCOME="failed"
REASON=""

# Slice $LOGFILE to JUST this run. The log is append-only across runs (each starts
# with "=== <date> ==="), so a naive grep would match prior runs and misclassify
# this one. awk resets buf on each "=== " header — END leaves the latest block.
#
# Concrete bug this prevents: a run whose log has no NOT_BUG line still matched a
# NOT_BUG from a much earlier run in the same logfile, tagging the new run as
# "not-a-bug" and writing the wrong vault note. Same hazard for the
# **Worktree:** path grep below — both read \$LATEST_RUN_LOG, not \$LOGFILE.
LATEST_RUN_LOG=\$(awk '/^=== / { buf = \$0 "\n"; next } { buf = buf \$0 "\n" } END { printf "%s", buf }' $LOGFILE 2>/dev/null)

# Step A — claude may carry an explicit NOT_BUG marker (a deliberate skip from
# \`worktree bug\` when the clipboard isn't a reproducible bug). Wins over the
# postScript check: if claude bailed before /worktree, postScript output wouldn't
# exist anyway.
if printf '%s' "\$LATEST_RUN_LOG" | grep -qE '^NOT_BUG:'; then
  OUTCOME="not-a-bug"
  REASON=\$(printf '%s' "\$LATEST_RUN_LOG" | grep -m1 -E '^NOT_BUG:' | sed 's/^NOT_BUG:[[:space:]]*//' | head -c 200)
fi

# Step B — read this run's postScript output. Per-run log first (concurrency-safe
# when TREEKANGA_POSTSCRIPT_LOG propagated); else a byte-offset slice of the
# global log. awk extracts the LATEST "=== START …" block, which works for both.
PS_LOG_NEW=""
if [ -s "\$PS_LOG" ]; then
  PS_LOG_NEW=\$(cat "\$PS_LOG")
elif [ -f "$PS_LOG_GLOBAL" ]; then
  CURRENT_SIZE=\$(wc -c < "$PS_LOG_GLOBAL" 2>/dev/null || echo 0)
  if [ "\$CURRENT_SIZE" -gt $PS_LOG_GLOBAL_SIZE_BEFORE ]; then
    PS_LOG_NEW=\$(tail -c \$((CURRENT_SIZE - $PS_LOG_GLOBAL_SIZE_BEFORE)) "$PS_LOG_GLOBAL")
  fi
fi
if [ -n "\$PS_LOG_NEW" ]; then
  echo "── postScript output (this run) ──"
  LATEST_RUN=\$(printf '%s' "\$PS_LOG_NEW" | awk '/=== START / { buf = \$0 "\n"; next } { buf = buf \$0 "\n" } END { printf "%s", buf }')
  printf '%s' "\$LATEST_RUN"
  echo "──"

  WORKTREE_PATH=\$(printf '%s' "\$LATEST_RUN" | head -1 | sed -E 's/.*=== START (.*) ===.*/\1/')
  REPO=\$(echo "\$WORKTREE_PATH" | sed -n 's|.*/Developer/\([^/]*\)/.*|\1|p')
  WORKTREE_NAME=\$(basename "\$WORKTREE_PATH")
  # Session name = path relative to ~/Developer/ so the folder bucket (infra/,
  # fix/, feat/, …) survives. basename() would drop it and yield "web/test-test"
  # for ~/Developer/web/infra/test-test; we want "web/infra/test-test" to match
  # sesh's zoxide-derived names.
  SESSION="\${WORKTREE_PATH#\$HOME/Developer/}"

  if printf '%s' "\$LATEST_RUN" | grep -q "worktree setup complete!"; then
    OUTCOME="success"
  fi
fi

# Step B-fallback — postScript marker absent BUT claude's natural-language output
# says it created a worktree: parse the path from the "**Worktree:**" line. A
# stepping stone to the rescue below — once we have the path and confirm it
# exists, we can run postScript manually if treekanga's invocation skipped it.
if [ -z "\$WORKTREE_PATH" ]; then
  CLAUDE_PATH=\$(printf '%s' "\$LATEST_RUN_LOG" | grep -E '\*\*Worktree( path)?:\*\*' \\
    | tail -1 \\
    | sed -E 's/.*\`([^\`]+)\`.*/\1/')
  # Secondary — any backtick-wrapped path under /Developer/. Covers claude
  # phrasings that skip the "**Worktree:**" marker entirely. The concrete miss
  # this fixes: when the worktree ALREADY EXISTS, haiku replies conversationally
  # ("Great news! The worktree already exists") and emits the path as
  # "**Path**: \`~/Developer/web/infra/…\`" with no Worktree: line — the primary
  # grep returns empty, the rescue + claude-only fallbacks never fire, and a
  # present, registered worktree is misreported as failed.
  CLAUDE_PATH="\${CLAUDE_PATH/#\~/\$HOME}"
  # Guard the /Developer/ fallback on "no existing dir yet" (not string-emptiness)
  # so a relative "**Worktree path:**" hit can't block the absolute one.
  if [ ! -d "\$CLAUDE_PATH" ]; then
    CLAUDE_PATH=\$(printf '%s' "\$LATEST_RUN_LOG" \\
      | grep -oE '\`[^\`]*/Developer/[^\`]+\`' \\
      | tail -1 | tr -d '\`')
    CLAUDE_PATH="\${CLAUDE_PATH/#\~/\$HOME}"
  fi
  if [ -n "\$CLAUDE_PATH" ]; then
    if [ -d "\$CLAUDE_PATH" ]; then
      WORKTREE_PATH="\$CLAUDE_PATH"
      REPO=\$(echo "\$WORKTREE_PATH" | sed -n 's|.*/Developer/\([^/]*\)/.*|\1|p')
      SESSION="\${WORKTREE_PATH#\$HOME/Developer/}"
    fi
  fi
fi

# Step B-diff — authoritative path detection: diff current git worktrees against
# the pre-claude snapshot; the new one is ours. Only trusts a UNIQUE new worktree
# so concurrent runners can't cross-attribute.
if [ -z "\$WORKTREE_PATH" ] && [ -f "$WT_SNAPSHOT" ]; then
  WT_NEW=\$(
    for _r in "\$HOME"/Developer/*/; do
      git -C "\$_r" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print \$2}'
    done | sort -u | comm -13 "$WT_SNAPSHOT" -
  )
  if [ "\$(printf '%s\n' "\$WT_NEW" | grep -c .)" = "1" ] && [ -d "\$WT_NEW" ]; then
    WORKTREE_PATH="\$WT_NEW"
    REPO=\$(echo "\$WORKTREE_PATH" | sed -n 's|.*/Developer/\([^/]*\)/.*|\1|p')
    SESSION="\${WORKTREE_PATH#\$HOME/Developer/}"
    echo "[\$(date +%H:%M:%S)] path via git-worktree-list diff: \$WORKTREE_PATH" >> $LOGFILE
  fi
fi

# Step B-rescue — postScript log empty AND we know the path AND the dir exists.
# Treekanga created the worktree but its postScript hook silently didn't fire
# (likely claude omitted -x). Run worktree_setup.sh manually so sesh/zoxide
# registration + pnpm install + .env copy + per-repo postcreate hooks still
# happen, then re-read the per-run log for the "complete!" marker.
if [ "\$OUTCOME" = "failed" ] \\
   && [ -z "\$PS_LOG_NEW" ] \\
   && [ -n "\$WORKTREE_PATH" ] \\
   && [ -d "\$WORKTREE_PATH" ]; then
  echo "[\$(date +%H:%M:%S)] postScript didn't fire via treekanga — running manually as rescue at \$WORKTREE_PATH" >> $LOGFILE
  (
    cd "\$WORKTREE_PATH"
    export TREEKANGA_POSTSCRIPT_LOG="$PS_LOG_PER_RUN"
    export WORKTREE_OPEN_IN="${WORKTREE_OPEN_IN:-}"
    bash "\$HOME/.config/treekanga/worktree_setup.sh"
  ) >> $LOGFILE 2>&1
  if [ -s "\$PS_LOG" ]; then
    PS_LOG_NEW=\$(cat "\$PS_LOG")
    if printf '%s' "\$PS_LOG_NEW" | grep -q "worktree setup complete!"; then
      OUTCOME="success"
      echo "[\$(date +%H:%M:%S)] rescue succeeded — postScript ran, marker found" >> $LOGFILE
    fi
  fi
fi

# Step B-claude-only-fallback — last resort. Even rescue couldn't get the marker
# (postScript itself errored), but the worktree dir exists. Treat it as success at
# the surface level so the switch hotkey takes you there. Setup is partial (no
# install / no codegen) but you can run those manually.
if [ "\$OUTCOME" = "failed" ] && [ -n "\$WORKTREE_PATH" ] && [ -d "\$WORKTREE_PATH" ]; then
  OUTCOME="success"
  echo "[\$(date +%H:%M:%S)] success via claude-output fallback (no postScript marker — partial setup): \$WORKTREE_PATH" >> $LOGFILE
fi

# Step C — one-line failure reason from THIS run's log (same per-run scoping
# rationale as Steps A/B: old errors shouldn't leak into the current banner).
if [ "\$OUTCOME" = "failed" ]; then
  REASON=\$(printf '%s' "\$LATEST_RUN_LOG" | grep -E '^(Error|error|✗|FAIL)' | tail -n 1 | head -c 200)
  [ -z "\$REASON" ] && REASON=\$(printf '%s' "\$LATEST_RUN_LOG" | tail -n 1 | head -c 200)
fi

END_TS=\$(date +%s)
DURATION_FMT=\$(fmt_duration \$((END_TS - START_TS)))

echo "[\$(date +%H:%M:%S)] outcome=\$OUTCOME duration=\$DURATION_FMT session=\${SESSION:-(none)} path=\${WORKTREE_PATH:-(none)}" >> $LOGFILE

# Step D — outcome-driven banner + state file.
case "\$OUTCOME" in
  success)
    TITLE="Worktree ready · \$DURATION_FMT"
    MSG=\${SESSION:-$FALLBACK_Q}
    # Defer session creation to switch time. Pre-creating here causes a brief
    # gitmux/status-bar flicker on the current session, because tmux new-session
    # -d fires the global session-created hook which briefly affects what tmux's
    # "current" pointer resolves to. Write "<name>|<path>" instead so
    # notify-idle-switch.sh can create-and-attach on demand.
    if [ -n "\$SESSION" ] && [ -d "\$WORKTREE_PATH" ]; then
      echo "\$SESSION|\$WORKTREE_PATH" > /tmp/notify-idle.latest 2>/dev/null || true
    fi
    ;;
  not-a-bug)
    TITLE="🤔 Skipped: not a bug · \$DURATION_FMT"
    MSG="\${REASON:-(no reason given)}"
    ;;
  failed)
    TITLE="❌ Worktree FAILED · \$DURATION_FMT"
    MSG="\${REASON:-(check ${WORKTREE_LOG_TAG}.log)}"
    ;;
esac

# Step E — vault capture.
#   Default: non-success outcomes only (failure / not-a-bug → inbox note so the
#   user can retry or audit later).
#   WORKTREE_CAPTURE_ALWAYS=1 → success ALSO captured (audit trail).
#   WORKTREE_DEFER_JIRA=1 → success captured as outcome=pending-jira with a
#   path-derived filename, so \`worktree jira-file\` (Stage B) can look it up by
#   \$PWD later. The capture helper writes the inbox note + copies any image
#   asset; on non-success it also stamps /tmp/notify-idle.latest with
#   "vault|<note-path>". On success the runner already pointed that state file at
#   the new worktree session, so capture must NOT clobber it → SKIP_STATE_FILE.
CAPTURE_SHOULD_RUN=0
CAPTURE_OUTCOME="\$OUTCOME"
if [ -s "$CAPTURE_PAYLOAD_FILE" ]; then
  if [ "\$OUTCOME" != "success" ]; then
    CAPTURE_SHOULD_RUN=1
  elif [ "${WORKTREE_DEFER_JIRA:-0}" = "1" ]; then
    CAPTURE_SHOULD_RUN=1
    CAPTURE_OUTCOME="pending-jira"
  elif [ "${WORKTREE_CAPTURE_ALWAYS:-0}" = "1" ]; then
    CAPTURE_SHOULD_RUN=1
  fi
fi
if [ "\$CAPTURE_SHOULD_RUN" = "1" ]; then
  CAPTURE_NOTE=\$(
    WORKTREE_LOG_TAG="${WORKTREE_LOG_TAG}" \\
    WORKTREE_CAPTURE_PAYLOAD_FILE="$CAPTURE_PAYLOAD_FILE" \\
    WORKTREE_CAPTURE_LOG="$LOGFILE" \\
    WORKTREE_CAPTURE_IMAGE_SRC=$IMAGE_SRC_Q \\
    WORKTREE_CAPTURE_CONTEXT="\$(cat $CAPTURE_CONTEXT_FILE 2>/dev/null)" \\
    WORKTREE_CAPTURE_WORKTREE_PATH="\$WORKTREE_PATH" \\
    WORKTREE_CAPTURE_SKIP_STATE_FILE="\$([ "\$OUTCOME" = "success" ] && echo 1 || echo 0)" \\
    \$HOME/.local/bin/worktree/worktree capture "\$CAPTURE_OUTCOME" "\$REASON" 2>/dev/null
  )
  if [ -n "\$CAPTURE_NOTE" ]; then
    if [ "\$CAPTURE_OUTCOME" = "pending-jira" ]; then
      MSG="\${MSG} · Jira pending"
    else
      MSG="\${MSG} · captured to \$(basename \"\$CAPTURE_NOTE\")"
    fi
  fi
fi

# Step E.5 — Jira ticket capture into the vault. On success + a branch carrying a
# JIRA-style key, queue a backgrounded \`/sb-ticket-capture\` from inside the new
# worktree. The skill auto-detects the ticket from the branch, fetches Jira (+
# linked Confluence) via Atlassian Rovo MCP, and writes
# \`Notes-Inbox/<TICKET>-<slug>.md\`. Double-forked so it outlives this
# Terminal.app window (the EXIT trap closes it ~5s after the final banner, while
# capture typically takes ~15-25s).
#
# The user still has to \`/sb-ingest-mine\` to move the note into \`Notes/work/\`;
# the 📝 badge glob looks in both, so it appears either way. For unticketed Mode-C
# worktrees (\`release-automation\` etc.) the regex fails and we skip.
if [ "\$OUTCOME" = "success" ] && [ -n "\$WORKTREE_PATH" ] && [ -d "\$WORKTREE_PATH" ]; then
  CAPTURE_BRANCH=\$(git -C "\$WORKTREE_PATH" branch --show-current 2>/dev/null || true)
  if [[ "\$CAPTURE_BRANCH" =~ [A-Z]+-[0-9]+ ]]; then
    (
      ( ( cd "\$WORKTREE_PATH" && \
          nohup claude --dangerously-skip-permissions --model haiku \
            -p '/sb-ticket-capture --yes' \
            >> "${LOGFILE}.ticket-capture" 2>&1 \
        ) </dev/null >/dev/null 2>&1 & \
      ) 2>/dev/null
    )
    echo "[\$(date +%H:%M:%S)] queued background /sb-ticket-capture for \$CAPTURE_BRANCH" >> $LOGFILE
  fi
fi

# Defensive sweep before the final banner: a heartbeat-spawned terminal-notifier
# can still be in flight even after we SIGKILLED the subshell. Reap any whose
# command line references our group — it would otherwise clobber our final banner
# via same-group replacement.
pkill -9 -f "terminal-notifier.*${WORKTREE_GROUP}" 2>/dev/null || true
sleep 0.2

# Final banner in the same group — replaces the start banner, with a longer
# timeout so the result isn't missed. Outcome-specific sound. The click handler
# runs notify-idle-switch.sh (success → switch to the worktree session,
# non-success → open the captured vault note).
#
# Build the args as a bash ARRAY, not \${SOUND:+-s "\$SOUND"} — that substitution
# leaves literal quote chars in the token after word-splitting, which
# terminal-notifier rejects silently, so the sound vanishes and the banner
# sometimes doesn't fire at all.
notify_args=(
  -t "\$TITLE"
  -m "\$MSG"
  -g "$WORKTREE_GROUP"
  -T $FINAL_TIMEOUT
  -e "\$HOME/.local/bin/mux/shared/notify-idle-switch.sh"
)
case "\$OUTCOME" in
  success)   notify_args+=( -s Glass ) ;;
  failed)    notify_args+=( -s Basso ) ;;
  not-a-bug) notify_args+=( -s Pop )   ;;
esac
mac-notify "\${notify_args[@]}"
echo "[\$(date +%H:%M:%S)] mac-notify exit: \$?" >> $LOGFILE

# Brief pause so the notification actually posts before the window closes.
sleep 1

# Kill any new unnamed (numeric) tmux session that appeared during our run.
TMUX_SESS_AFTER=\$(tmux ls -F '#{session_name}' 2>/dev/null | sort -u)
if [ -n "\$TMUX_SESS_AFTER" ] && [ -f "$TMUX_SNAPSHOT" ]; then
  comm -13 "$TMUX_SNAPSHOT" <(printf '%s\n' "\$TMUX_SESS_AFTER") \
    | grep -E '^[0-9]+\$' \
    | while read -r stale; do
        tmux kill-session -t "\$stale" 2>/dev/null || true
      done
fi

# The Terminal-quit watcher is spawned by the EXIT trap above, so one fires
# regardless of how we exit — completion, abort SIGTERM, claude crash, error.
exit 0
EOF

  # Spawn the staged session script. macOS: a background Terminal.app window.
  # Linux/VPS: a tab in the live multiplexer. A bare `tmux new-window` would spin
  # up an invisible tmux server on the herdr VPS, stranding the session where
  # herdr can't reach it.
  if [ "$(uname)" = Darwin ]; then
    open -g -n -a "Terminal" --env SKIP_FETCH=1 "$TMPSCRIPT"
  elif [ "$("$MUX" kind)" != none ]; then
    # --no-focus mirrors the Darwin `open -g` above: the capture must not yank you out of what you were doing.
    # $HOME, not $PWD: the origin worktree may be gone, and a bad --cwd fails tab create.
    "$MUX" window --no-focus --env SKIP_FETCH=1 "$WORKTREE_GROUP" "$HOME" "$TMPSCRIPT"
  else
    tmux new-session -d -s "$WORKTREE_GROUP" -e SKIP_FETCH=1 "$TMPSCRIPT"
  fi
}

#-------------------------------------------------------------------------------
# capture — vault-note helper, invoked by the runner.
#
# Writes a structured note into the second-brain inbox, copies any image payload
# into Notes-Assets, and stamps /tmp/notify-idle.latest with `vault|<note-path>`
# so the next switch hotkey opens the captured note instead of a (non-existent)
# worktree session.
#
# Privacy: the original clipboard content is written verbatim into the vault.
# Don't bind the parent hotkeys if your clipboard ever holds secrets.
#
# Args: $1 = outcome (not-a-bug | failed | pending-jira), $2 = one-line reason.
# Stdout: the path of the note written.
#-------------------------------------------------------------------------------
cmd_capture() {
  local OUTCOME="${1:?outcome arg required}" REASON="${2:-}"

  : "${WORKTREE_LOG_TAG:?WORKTREE_LOG_TAG required}"
  : "${WORKTREE_CAPTURE_PAYLOAD_FILE:?WORKTREE_CAPTURE_PAYLOAD_FILE required}"
  : "${WORKTREE_CAPTURE_LOG:?WORKTREE_CAPTURE_LOG required}"

  # A worktree capture belongs to the vault of the worktree's repo (work worktree
  # → work vault). Resolve from the worktree path, falling back to $PWD.
  local VAULT VAULT_INBOX VAULT_ASSETS TODAY TIMESTAMP
  VAULT="$("$HOME/.local/bin/vault-path" "${WORKTREE_CAPTURE_WORKTREE_PATH:-$PWD}")"
  VAULT_INBOX="$VAULT/Notes-Inbox"
  VAULT_ASSETS="$VAULT/Notes-Assets"
  mkdir -p "$VAULT_INBOX" "$VAULT_ASSETS"

  TODAY=$(date +%Y-%m-%d)
  TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')

  # Filename strategy depends on outcome:
  #   pending-jira  → path-derived slug, `jira-pending-<slug>.md` with no date or
  #                   log-tag prefix. Stage B looks the note up by deriving the
  #                   same slug from $PWD, so it must be reproducible from the
  #                   worktree path alone.
  #   anything else → payload-preview slug + date prefix, so captures stay
  #                   sortable by date and labeled by outcome.
  local WORKTREE_BRANCH="" SLUG NOTE_FILE REL PAYLOAD_PREVIEW
  if [ "$OUTCOME" = "pending-jira" ]; then
    : "${WORKTREE_CAPTURE_WORKTREE_PATH:?WORKTREE_CAPTURE_WORKTREE_PATH required for pending-jira}"
    REL="${WORKTREE_CAPTURE_WORKTREE_PATH#"$HOME"/Developer/}"
    SLUG="${REL//\//-}"
    NOTE_FILE="$VAULT_INBOX/jira-pending-${SLUG}.md"
    # Record the real branch for frontmatter — a cross-check signal for Stage B
    # even if the worktree dir gets renamed or moved.
    WORKTREE_BRANCH=$(git -C "$WORKTREE_CAPTURE_WORKTREE_PATH" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  else
    # LC_ALL=C — without it, tr -c errors with "Illegal byte sequence" on any
    # non-UTF-8 byte in the payload (e.g. Slack's MacRoman NBSP \xCA). The C
    # locale treats input as opaque bytes so the pipeline never fails, which
    # guarantees a capture note gets written even when sanitization missed
    # something upstream.
    PAYLOAD_PREVIEW=$(LC_ALL=C bash -c '
      head -c 200 "$1" 2>/dev/null \
        | tr "\n" " " \
        | tr -c "[:alnum:]_-" "-" \
        | sed "s/-\{2,\}/-/g; s/^-\|-\$//g" \
        | head -c 40
    ' _ "$WORKTREE_CAPTURE_PAYLOAD_FILE")
    SLUG="${PAYLOAD_PREVIEW:-payload}"
    NOTE_FILE="$VAULT_INBOX/${TODAY}_Worktree-${WORKTREE_LOG_TAG}-${OUTCOME}-${SLUG}.md"
  fi

  local IMAGE_REF="" ASSET_NAME
  if [ -n "${WORKTREE_CAPTURE_IMAGE_SRC:-}" ] && [ -f "$WORKTREE_CAPTURE_IMAGE_SRC" ]; then
    if [ "$OUTCOME" = "pending-jira" ]; then
      ASSET_NAME="jira-pending-${SLUG}.png"
    else
      ASSET_NAME="${TODAY}_${WORKTREE_LOG_TAG}-${OUTCOME}-${SLUG}.png"
    fi
    cp "$WORKTREE_CAPTURE_IMAGE_SRC" "$VAULT_ASSETS/$ASSET_NAME" 2>/dev/null || true
    IMAGE_REF="![[$ASSET_NAME]]"
  fi

  # pending-jira gets structured frontmatter so Stage B can yq-read worktree_path
  # / branch without parsing markdown. Other outcomes use the raw-capture layout.
  if [ "$OUTCOME" = "pending-jira" ]; then
    {
      cat <<FRONT
---
type: pending-jira
worktree_path: $WORKTREE_CAPTURE_WORKTREE_PATH
branch: ${WORKTREE_BRANCH:-(unknown)}
created: $TIMESTAMP
hubs:
  - work
tags:
  - pending-jira
---

# Pending Jira — \`${SLUG}\`

Worktree was created from clipboard payload below. Run the \`worktree jira-file\`
hotkey from inside the worktree to file the Jira ticket using these inputs.

**Worktree path:** \`$WORKTREE_CAPTURE_WORKTREE_PATH\`
**Branch:** \`${WORKTREE_BRANCH:-(unknown)}\`
**Captured:** $TIMESTAMP

## Clipboard payload

FRONT

      if [ -n "$IMAGE_REF" ]; then
        printf '%s\n' "$IMAGE_REF"
      else
        printf '```\n'
        cat "$WORKTREE_CAPTURE_PAYLOAD_FILE" 2>/dev/null || true
        printf '\n```\n'
      fi

      cat <<TAIL

## User-provided context

${WORKTREE_CAPTURE_CONTEXT:-(none)}
TAIL
    } > "$NOTE_FILE"
  else
    {
      cat <<FRONT
---
date:
  - $TODAY
hubs:
