{{- /* The gnohj_color* palette as JSON, resolved at apply time so a config chezmoi renders matches byte-for-byte what colorscheme-set.sh writes - otherwise chezmoi reads the generated file as drift and reverts it on the next apply. */ -}}
{{- $seed := printf `. "%s/dot_config/colorscheme/active/executable_active-colorscheme.sh" 2>/dev/null
. "%s/dot_config/colorscheme/executable_relight.sh" 2>/dev/null` .chezmoi.sourceDir .chezmoi.sourceDir -}}
{{- $script := print $seed `
. "$HOME/.config/colorscheme/active/active-colorscheme.sh" 2>/dev/null
. "$HOME/.config/colorscheme/omarchy-palette.sh" 2>/dev/null
printf '{'
sep=
for v in $(compgen -v | grep '^gnohj_color[0-9]*$'); do
  eval "val=\$$v"
  case "$val" in "#"??????) ;; *) continue ;; esac
  printf '%s"%s":"%s"' "$sep" "${v#gnohj_}" "$val"
  sep=,
done
# Omarchy hands over its own selection fill; off it this must reproduce generate_herdr_config's relight, or the key renders empty and herdr falls back to the terminal's own selection colours.
selection_bg="${omarchy_selection_bg:-}"
[ -n "$selection_bg" ] || selection_bg="$(gnohj_relight "$gnohj_color04" 0.20)"
printf '%s"selection_bg":"%s"}' "$sep" "$selection_bg"` -}}
{{- output "bash" "-c" $script -}}
