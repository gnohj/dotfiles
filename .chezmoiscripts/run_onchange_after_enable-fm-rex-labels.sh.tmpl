#!/usr/bin/env bash
# Enable the Rex worker-label timer; Linux/systemd only, a clean no-op on macOS.
# service sha256: {{ include "dot_config/systemd/user/fm-rex-labels.service" | sha256sum }}
# timer sha256: {{ include "dot_config/systemd/user/fm-rex-labels.timer" | sha256sum }}
set -eu

[ "$(uname)" = "Linux" ] || exit 0
command -v systemctl >/dev/null 2>&1 || exit 0

systemctl --user daemon-reload
systemctl --user enable --now fm-rex-labels.timer

echo "fm-rex-labels.timer enabled (every 30 seconds)."
