# Rift - Native fullscreen (Rift has no command for it, so send the macOS shortcut)
lalt + shift - f : osascript -e 'tell application "System Events" to keystroke "f" using {control down, command down}'

# Rift - toggle back and forth between workspaces
lalt - tab : /opt/homebrew/bin/rift-cli execute workspace last

# Rift - wrap around
lalt + shift - tab : /opt/homebrew/bin/rift-cli execute display move-workspace --direction right --wrap-around

# Rift - Service mode (bindings live in [binding_modes.service] of ~/.config/rift/config.toml)
lalt + shift - 0x29 : /opt/homebrew/bin/rift-cli execute binding-mode service

# Block unused lalt + shift letter combinations
