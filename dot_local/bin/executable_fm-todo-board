#!/usr/bin/env python3
"""Turn firstmate's status block (stdin) plus the Lavish Library's PR and ticket files into a rexpad board."""
import json
from datetime import datetime, timezone
import os
import re
import sys

from fm_todo_action import act

LIBRARY = os.path.expanduser(os.environ.get("FM_TODO_LIBRARY", "~/.local/state/lavish-library"))
JIRA = "https://jira.example.com/browse/"
TICKET = r"[A-Z][A-Z]+-[0-9][0-9]+"
JIRA_KEY = r"IHR[A-Z]*-[0-9]+"
REF = re.compile(rf"{TICKET}|PR #?[0-9]+")
LEVELS = [("🔴", "Blocked", "red", "red"), ("🟡", "Needs your call", "yellow", "yellow"),
          ("♻", "In progress", "cyan", "cyan"), ("🟢", "Waiting on others", "green", ""), ("✅", "Done", "green", "green")]
REPOS = {"inferno": "iheartradio/inferno-monorepo", "web": "iheartradio/web", "chezmoi": "gnohj/dotfiles", "dotfiles": "gnohj/dotfiles"}
COMPONENT_COLORS = {"inferno": "magenta"}


def load(name, default):
    try:
        with open(os.path.join(LIBRARY, name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def chat(title, ref=""):
    return link("{{💬:blue}}", act("chat", title=title, ref=ref), "[c]")


def pill(text):
    return f"{{{{{text}:magenta}}}}"


def tint(text):
    return f"{{{{{text}:magenta.}}}}"


PILL = re.compile(r"\{\{[^{}]*:[a-z]+\}\}")


def join_meta(parts):
    out, prev = "", ""
    for part in (x for x in parts if x):
        if out:
            out += " " if PILL.search(part) or PILL.search(prev) else " · "
        out, prev = out + part, part
    return out


def ticket_link(key):
    return link(pill(key), JIRA + key)


def pr_link(repo, number):
    return link(pill(f"#{number}"), f"https://github.com/{repo}/pull/{number}")


def link(label, url, title=""):
    label = label.replace("]", ")").replace("[", "(")
    return f'[{label}]({url} "{title}")' if title else f"[{label}]({url})"


class Board:
    def __init__(self, tasks_env, lavish_env):
        self.tasks, self.mates, self.claimed, self.claimed_prs = {}, {}, set(), set()
        self.ready = []
        for row in filter(None, tasks_env.split("\n")):
            f = row.split("\t")
            if f[0].startswith("mate:"):
                self.mates[f[0][5:]] = f[1] if len(f) > 1 else ""
            elif len(f) >= 4:
                self.tasks.setdefault(f[0], {"kind": f[1], "slug": f[2], "home": f[3],
                                             "tab": f[4] if len(f) > 4 else "", "me": f[5] if len(f) > 5 else ""})
                if f[3].startswith("sm-"):
                    self.mates.setdefault(f[3], "")
        self.lavish, self.lavish_titles = {}, {}
        for row in filter(None, lavish_env.split("\n")):
            k, _, url = row.partition("\t")
            (self.lavish_titles if k.startswith("title:") else self.lavish)[k.removeprefix("title:")] = url
        self.my_prs = {f"{r['repo']}#{r['number']}": r for r in load("my-prs.json", []) if isinstance(r, dict)}
        self.status = load("pr-status.json", {}).get("items", {})
        self.tickets = [t for t in load("my-tickets.json", []) if isinstance(t, dict)]
        catalog = load("catalog.json", {})
        self.queue = [q for q in catalog.get("queue", []) if isinstance(q, dict)]
        self.artifacts = [a for a in catalog.get("artifacts", []) if isinstance(a, dict)]
        self.hidden = set(load("hidden.json", []))
        self.merged = [r for r in load("my-merged-prs.json", []) if isinstance(r, dict)]
        self.required = {repo: (v or {}).get("count") or 1 for repo, v in load("required-approvals.json", {}).items()}
        self.me = {(t.get("assignee") or {}).get("name") for t in self.tickets} - {None}
        self.jira = {t["key"]: t for t in self.tickets if t.get("key")}
        for pr in self.my_prs.values():
            for t in pr.get("jira") or []:
                if isinstance(t, dict) and t.get("key"):
                    self.jira.setdefault(t["key"], t)

    def pr_for(self, key):
        for name, pr in self.my_prs.items():
            if any(isinstance(t, dict) and t.get("key") == key for t in pr.get("jira") or []):
                return name
        return ""

    def jira_meta(self, key):
        t = self.jira.get(key)
        parts = [ticket_link(key)]
        if not t:
            return parts
        name = t.get("name") or ""
        parts.append(link(tint(name), act("jira/status", key=key, cur=name), f"menu:Move {key} to"))
        who = (t.get("assignee") or {}).get("name")
        if not who:
            parts.append(link("+ assignee", act("jira/assign", key=key, cur=""), f"menu:Assign {key}"))
        else:
            label = "me" if who in self.me else who.split()[0]
            parts.append(link(tint(label), act("jira/assign", key=key, cur=who), f"menu:Assign {key}"))
        versions = [v.get("name", "") for v in t.get("fix_versions") or [] if isinstance(v, dict)]
        if versions:
            label = re.sub(r"\s*\(.*\)$", "", versions[0])
            parts.append(link(tint(label), act("jira/version", key=key, cur=versions[0]), f"menu:Fix version for {key}"))
        else:
            parts.append(link("+ version", act("jira/version", key=key, cur=""), f"menu:Fix version for {key}"))
        return parts

    def pr_bits(self, name):
        repo, _, number = name.partition("#")
        st, mine = self.status.get(name, {}), self.my_prs.get(name, {})
        parts = [pr_link(repo, number)]
        ci = (st.get("checks") or {}).get("state", "none")
        if ci == "passing":
            parts.append("{{CI ✓:green.}}")
        elif ci == "failing":
            parts.append("{{CI ✗:red.}}")
        elif ci == "running":
            parts.append("{{CI running:yellow.}}")
        approvals, needed = st.get("approvals") or 0, self.required.get(repo, 1)
        if st:
            marks = "✓" * min(approvals, 3) if approvals else f"0/{needed}"
            parts.append(f"{{{{Approvals {marks}:{'green' if approvals >= needed else 'yellow'}.}}}}")
        draft = st.get("is_draft") or mine.get("draft")
        threads = mine.get("threads_awaiting") or 0
        action = ""
        if st.get("state", "open") != "open" or draft:
            pass
        elif ci == "failing":
            action = link("{{Fix CI:red}}", act("fixci", repo=repo, number=number), f"Fix failing CI on #{number}?")
        elif threads:
            action = link("{{Resolve:yellow}}", act("resolve", repo=repo, number=number),
                          f"Resolve {threads} open thread{'s' if threads > 1 else ''} on #{number}?")
        elif approvals >= needed and ci in ("passing", "none"):
            action = link("{{▶:green}}", act("merge", repo=repo, number=number, sha=st.get("head", "")),
                          f"Merge #{number} into {st.get('base') or 'its base'}?")
        return parts, action

    def linkify(self, text, repo):
        text = defuse(text)
        text = re.sub(r"https://github\.com/([^/\s]+/[^/\s]+)/pull/(\d+)", lambda m: link(f"#{m[2]}", m[0]), text)
        text = re.sub(rf"(?<![\[/\w-])({JIRA_KEY})(?![\w-]*\])", lambda m: link(m[1], JIRA + m[1]), text)
        if repo:
            text = re.sub(r"(?<!\[)PR #?(\d+)", lambda m: link(f"PR #{m[1]}", f"https://github.com/{repo}/pull/{m[1]}"), text)
        return text

    def lavish_link(self, key):
        return link(tint("Lavish"), self.lavish[key]) if key in self.lavish else ""

    def block(self, head, tail, repo, level, lead=""):
        m = re.search(TICKET, head)
        key = m[0] if m else ""
        pr = re.search(r"PR #?(\d+)", head)
        pr_name = f"{repo}#{pr[1]}" if pr and repo else (self.pr_for(key) if key else "")
        task = self.tasks.get(key) or self.tasks.get(pr_name) or {}
        self.claimed.add(key)
        if pr_name:
            self.claimed_prs.add(pr_name)
        meta, action = [], ""
        if key:
            meta += self.jira_meta(key)
        if pr_name:
            bits, action = self.pr_bits(pr_name)
            meta[1:1] = bits[:1]
            meta += bits[1:]
        if key and self.lavish_link(key):
            meta.insert(min(2, len(meta)), self.lavish_link(key))
        if task:
            name = task["slug"]
        else:
            label = (lead + " " + REF.sub("", head)).strip(" /()-·")
            name = label or defuse((self.jira.get(key) or {}).get("summary") or "") or key or head
        refs = " · ".join(x for x in (key, f"PR #{pr_name.partition('#')[2]}" if pr_name else "") if x)
        right = " ".join(x for x in (chat(name, refs), action) if x)
        title = name
        if key:
            meta.pop(0)
            number = ticket_link(key)
            title = number if name == key else f"{number} {name}"
        if task.get("me"):
            title += f" · `{task['me']}`"
        lines = [f"* {title}\t{right}"]
        if meta:
            lines.append(": " + join_meta(meta))
        if task and lead:
            tail = (re.sub(r"\s+(for|on|of|to)$", "", lead) + " " + tail).strip()
        tail = re.sub(r"(then )?merge words?( for)?", "ready to merge", tail).strip()
        tail = re.sub(r"^answers?$", "needs your answers", tail)
        if tail:
            color = LEVELS[level][3]
            lines.append(f"| {{{{→ {tail}:{color}.}}}}" if color else f"| → {tail}")
        return task.get("home", ""), task.get("tab", ""), lines


def defuse(text):
    """Passed-through text never carries a pane action link: only the board's own links can act."""
    text = re.sub(r"\[([^\]]*)\]\(\s*<?https?://fm-todo\.invalid[^)]*\)", r"\1", text)
    return re.sub(r"https?://fm-todo\.invalid\S*", "", text)


def clean(s):
    s = re.sub(r"🔴|🟡|♻️|♻|🟢|✅|\*\*|`", "", s)
    s = re.sub(r" ?\(https?://[^)]*\)| https?://\S+", "", s)
    return defuse(re.sub(r"^\s*[0-9]+\.\s*", "", s)).strip()


def level_of(line):
    return next((i for i, lv in enumerate(LEVELS) if lv[0] in line), -1)


def split_refs(rest):
    """Split "A / PR 1, B and C" into (head, tail) chunks, keeping parentheses together."""
    chunks, depth, cur = [], 0, ""
    i = 0
    while i < len(rest):
        ch = rest[i]
        depth += ch == "("
        depth -= ch == ")" and depth > 0
        sep = next((s for s in (", and ", ", ", "; ", " and ") if not depth and rest.startswith(s, i)), None)
        if sep and REF.search(rest[i + len(sep):]):
            chunks.append(cur)
            cur, i = "", i + len(sep)
            continue
        cur += ch
        i += 1
    chunks.append(cur)
    out = []
    for c in filter(None, (c.strip() for c in chunks)):
        last = None
        for last in REF.finditer(c):
            pass
        if not last:
            out[-1:] = [(out[-1][0], (out[-1][1] + " " + c).strip())] if out else [("", c)]
            continue
        head, tail = c[:last.end()], c[last.end():]
        if head.count("(") > head.count(")") and ")" in tail:
            cut = tail.index(")") + 1
            head, tail = head + tail[:cut], tail[cut:]
        out.append((head.strip(), tail.strip(" :,-")))
    return out


def board(raw, b):
    groups = [dict() for _ in LEVELS]
    last = None
    for line in raw.split("\n"):
        if not line.strip():
            continue
        if line.lstrip().startswith(">"):
            if last is not None:
                last.append("> " + b.linkify(line.lstrip()[1:].strip(), last_repo))
            continue
        lv = level_of(line)
        if lv < 0 or not re.search(r"[0-9]+\.", line):
            if last is not None and line[:1] in " \t":
                last.append("| " + b.linkify(clean(line), last_repo))
            continue
        text = clean(line)
        project = text.split(" ", 1)[0]
        body = text.split(" - ", 1)[1] if " - " in text else text[len(project):].strip()
        repo = REPOS.get(project, "")
        last_repo = repo
        m = REF.search(body)
        mate = "sm-" + project if "sm-" + project in b.mates else "fm"
        if not m:
            blocks = [(mate, "", [f"* {body}\t{chat(body, project)}"])]
        else:
            lead = body[:m.start()].strip(" :,-(")
            blocks = []
            for head, tail in split_refs(body[m.start():]):
                hint = re.search(r" ?\((inferno|web|chezmoi|dotfiles)\)", head)
                r = REPOS.get(hint[1], repo) if hint else repo
                home, tab, lines = b.block(head, tail, r, lv, lead)
                blocks.append((home or mate, tab, lines))
        for owner, tab, lines in blocks:
            entries = groups[lv].setdefault(owner, [])
            same = next((e for e in entries if e[1][0].split("\t")[0] == lines[0].split("\t")[0]), None)
            if same:
                same[1].extend(ln for ln in lines[1:] if not ln.startswith(": "))
                lines[:] = same[1]
            else:
                entries.append((int(tab) if tab.isdigit() else 9999, lines))
        last = blocks[-1][2]
    return groups


def tickets_group(b):
    rows = []
    for t in b.tickets:
        key = t.get("key", "")
        if not key or key in b.tasks or key in b.claimed:
            continue
        summary = defuse(" ".join(str(t.get("summary") or key).split()))
        comps = []
        m = re.match(r"^\[([^\]]+)\]\s*", summary)
        if m:
            comps, summary = [c.strip() for c in m[1].split(",")], summary[m.end():]
        start = link("{{▶:green}}", act("start", key=key), f"Start {key}? Firstmate dispatches a crewmate.")
        meta = b.jira_meta(key)[1:]
        if comps:
            more = f" +{len(comps) - 1}" if len(comps) > 1 else ""
            meta.append(f"{{{{{comps[0]}{more}:{COMPONENT_COLORS.get(comps[0], 'blue')}.}}}}")
        head = f"{ticket_link(key)} {summary}"
        rows.append(f"- [ ] {head}\t{chat(summary, key)} {start}\n  : " + join_meta(meta))
    return rows


LEVEL_COLORS = {"easy": "green", "medium": "yellow", "hard": "red"}


def since(iso):
    try:
        then = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        return ""
    minutes = max(0, round((datetime.now(timezone.utc) - then).total_seconds() / 60))
    if minutes < 60:
        return f"{minutes}min"
    hours = minutes / 60
    unit = lambda n, suffix: f"{round(n * 2) / 2 if n < 10 else round(n):g}{suffix}"
    return unit(hours, "hr") if hours < 24 else unit(hours / 24, "day")


def reviews_group(b):
    rows = []
    for q in sorted(b.queue, key=lambda q: q.get("requested_at") or ""):
        repo, number = q.get("repo", ""), q.get("number")
        if not repo or not number or f"{repo}#{number}" in b.claimed_prs:
            continue
        b.claimed_prs.add(f"{repo}#{number}")
        title = defuse(" ".join(str(q.get("title") or "").split()))
        m = re.match(r"^\[([^\]]+)\]\s*", title)
        tag = m[1] if m else ""
        if m:
            title = title[m.end():]
        ticketed = re.fullmatch(JIRA_KEY, tag)
        head = f"{ticket_link(tag)} {title}" if ticketed else title
        meta = [pr_link(repo, number)] if ticketed else [tag or "unticketed", pr_link(repo, number)]
        if q.get("author"):
            meta.append(defuse(str(q["author"])))
        if ago := since(q.get("requested_at")):
            meta.append(f"{{{{{ago}:yellow.}}}}")
        level = (q.get("size") or {}).get("level")
        if level:
            meta.append(f"{{{{●:{LEVEL_COLORS.get(level, '')}.}}}} {level}")
        scopes = q.get("repo_scopes") or []
        label = (scopes[0] + (f" +{len(scopes) - 1}" if len(scopes) > 1 else "")) if scopes else q.get("repo_label", "")
        if label:
            meta.append(f"{{{{{label}:{COMPONENT_COLORS.get(label.split('.')[0], 'blue')}.}}}}")
        right = chat(title, f"{repo}#{number}")
        lines = [": " + join_meta(meta)]
        if q.get("running"):
            lines.append(f"| {{{{→ reviewing on {q.get('running_host') or 'this Mac'}:cyan.}}}}")
        else:
            right += " " + link("{{▶:yellow}}", act("review", repo=repo, number=number), f"[z] Review #{number} on the dev box?")
        rows.append(f"- [ ] {head}\t{right}\n" + "\n".join("  " + ln for ln in lines))
    return rows


def take_ready(groups, b):
    for owners in groups:
        for owner in list(owners):
            keep = []
            for tab, lines in owners[owner]:
                (b.ready if "/merge?" in lines[0].split("\t", 1)[-1] else keep).append((tab, lines))
            if keep:
                owners[owner] = keep
            else:
                del owners[owner]


def with_model(line, me):
    head, tab, rest = line.partition("\t")
    if not me or not line.startswith("* ") or "`" in head:
        return line
    return f"{head} · `{me}`{tab}{rest}"


def ready_tail(line):
    if not line.startswith("| "):
        return line
    left = re.sub(r"\s*(and )?(then )?ready to merge\s*", " ", line).replace("→  ", "→ ").replace(" :", ":")
    return "" if re.fullmatch(r"\| \{\{→\s*:[a-z]+\.\}\}|\| →\s*", left) else left


def board_tab(raw, b):
    out, groups = [], board(raw, b)
    take_ready(groups, b)
    for lv, owners in enumerate(groups):
        if not owners:
            continue
        count = sum(len(entries) for entries in owners.values())
        fold = " {folded}" if lv == len(LEVELS) - 1 else ""
        out.append(f"\n# {LEVELS[lv][1]} · {count} {{{LEVELS[lv][2]}}}{fold}")
        box = "[x]" if lv == len(LEVELS) - 1 else "[ ]"
        for owner in sorted(owners, key=lambda o: (o != "fm", o)):
            me = b.mates.get(owner, "")
            out.append(f"- {box} {owner}" + (f" · `{me}`" if me else ""))
            for _, lines in sorted(owners[owner], key=lambda x: x[0]):
                out += ["  " + with_model(ln, me) for ln in lines]
    return out


def reviews_tab(b):
    rows = reviews_group(b)
    return [f"# Requested of you · {len(rows)} {{yellow}}", *rows] if rows else []


def repo_chip(repo):
    label = next((k for k, v in REPOS.items() if v == repo), repo.split("/")[-1])
    return f"{{{{{label}:{COMPONENT_COLORS.get(label, 'blue')}.}}}}"


def pr_title(pr):
    return re.sub(rf"^\s*(\[[^\]]*\]\s*)?#?{pr.get('number')}\b\s*", "", defuse(" ".join(str(pr.get("title") or "").split())))


def pr_keys(pr):
    return [t["key"] for t in pr.get("jira") or [] if isinstance(t, dict) and t.get("key")]


def prs_tab(b):
    buckets = {"ready": [], "attention": [], "moving": [], "draft": []}
    for _, lines in sorted(b.ready, key=lambda x: x[0]):
        head = lines[0][2:]
        rest = [ready_tail(ln) for ln in lines[1:]]
        buckets["ready"].append("\n".join(["- [ ] " + head, *("  " + ln for ln in rest if ln)]))
    for name, pr in b.my_prs.items():
        keys = pr_keys(pr)
        if name in b.claimed_prs or any(k in b.claimed for k in keys):
            continue
        b.claimed_prs.add(name)
        b.claimed.update(keys)
        repo, number = name.partition("#")[::2]
        st = b.status.get(name, {})
        bits, action = b.pr_bits(name)
        title, key = pr_title(pr), (keys[0] if keys else "")
        head = f"{ticket_link(key)} {title}" if key else title
        right = " ".join(x for x in (chat(title, " · ".join(x for x in (key, f"PR #{number}") if x)), action) if x)
        meta = bits[:1] + (b.jira_meta(key)[1:] if key else []) + bits[1:] + [repo_chip(repo)]
        ci = (st.get("checks") or {}).get("state", "none")
        if st.get("is_draft") or pr.get("draft"):
            bucket = "draft"
        elif ci == "failing" or pr.get("threads_awaiting"):
            bucket = "attention"
        elif "/merge?" in action:
            bucket = "ready"
        else:
            bucket = "moving"
        buckets[bucket].append(f"- [ ] {head}\t{right}\n  : " + join_meta(meta))
    today = datetime.now().astimezone().date()
    merged = []
    for pr in b.merged:
        name = f"{pr.get('repo')}#{pr.get('number')}"
        try:
            when = datetime.fromisoformat(str(pr.get("merged_at")).replace("Z", "+00:00")).astimezone().date()
        except ValueError:
            continue
        keys = pr_keys(pr)
        if when != today or name in b.claimed_prs or any(k in b.claimed for k in keys):
            continue
        b.claimed_prs.add(name)
        b.claimed.update(keys)
        key = keys[0] if keys else ""
        head = f"{ticket_link(key)} {pr_title(pr)}" if key else pr_title(pr)
        merged.append(f"- [x] {head}\n  : " + join_meta([pr_link(pr['repo'], pr['number']), repo_chip(pr['repo'])]))
    out = []
    for title, rows, tag in (("Needs attention", buckets["attention"], "{red}"), ("Ready to merge", buckets["ready"], "{green}"),
                             ("Still moving", buckets["moving"], "{yellow}"), ("Drafts", buckets["draft"], "{folded}"),
                             ("Merged today", merged, "{green}")):
        if rows:
            out += ["", f"# {title} · {len(rows)} {tag}", *rows]
    return out


def tickets_tab(b):
    rows = tickets_group(b)
    return [f"# Assigned, not started · {len(rows)} {{blue}}", *rows] if rows else []


OUTPUT_SKIP = {"System Resource Report", "Claude Billing Watch"}
OUTPUT_OLDER = 40


def outputs_tab(b):
    now = datetime.now(timezone.utc)
    today = now.astimezone().date()
    live, day, week, older = [], [], [], []
    for a in sorted(b.artifacts, key=lambda a: str(a.get("updated") or ""), reverse=True):
        url = a.get("https_url") or ""
        project = (a.get("project") or {}).get("name") or ""
        if not url.startswith("https://") or not a.get("exists") or a.get("path") in b.hidden or project in OUTPUT_SKIP:
            continue
        try:
            when = datetime.fromisoformat(str(a.get("updated")).replace("Z", "+00:00"))
        except ValueError:
            continue
        title = defuse(" ".join(str(a.get("title") or "").split())) or "Untitled"
        m = re.match(rf"^\[?({TICKET})\]?\s*[-:·]?\s*", title)
        key = m[1] if m else ""
        if m:
            title = title[m.end():]
        pr = re.search(r"\s*#(\d+)$", title)
        repo = a.get("pr_repo") or {"Inferno": REPOS["inferno"], "Web": REPOS["web"]}.get(project, "")
        if pr:
            title = title[:pr.start()]
        head = (ticket_link(key) + " " if key else "") + link(title, url)
        is_live = a.get("status") == "open" and (now - when).total_seconds() < 86400
        right = ""
        if not is_live and a.get("lifecycle") == "reopenable" and str(a.get("action_url") or "").startswith("https://"):
            right = "\t" + link("{{▶:green}}", a["action_url"])
        meta = []
        if pr and repo:
            meta.append(pr_link(repo, pr[1]))
        if project:
            meta.append(f"{{{{{project}:{COMPONENT_COLORS.get(project.lower(), 'blue')}.}}}}")
        if ago := since(a.get("updated")):
            meta.append(ago)
        meta.append("{{Live:green.}}" if is_live else "Ended" if a.get("status") == "ended" else "")
        row = f"- [ ] {head}{right}\n  : " + join_meta(meta)
        if is_live:
            live.append(row)
        elif when.astimezone().date() == today:
            day.append(row)
        elif (now - when).days < 7:
            week.append(row)
        elif len(older) < OUTPUT_OLDER:
            older.append(row)
    out = []
    for title, rows, tag in (("Live", live, "{green}"), ("Today", day, "{cyan}"), ("This week", week, "{folded}"),
                             ("Older", older, "{folded}")):
        if rows:
            out += ["", f"# {title} · {len(rows)} {tag}", *rows]
    return out


def render_tabs(raw, b):
    """Board claims first, so each later tab skips what an earlier one shows: nothing appears twice."""
    tabs = {"board": board_tab(raw, b)}
    tabs["prs"] = prs_tab(b)
    tabs["tickets"] = tickets_tab(b)
    tabs["reviews"] = reviews_tab(b)
    tabs["outputs"] = outputs_tab(b)
    return {name: "\n".join(lines).strip() + "\n" if lines else "" for name, lines in tabs.items()}

if __name__ == "__main__":
    raw = sys.stdin.read() if not sys.stdin.isatty() else ""
    tabs = render_tabs(raw, Board(os.environ.get("TASKS", ""), os.environ.get("LAVISH", "")))
    if sys.argv[1:2] == ["--tabs-dir"]:
        os.makedirs(sys.argv[2], exist_ok=True)
        for name, text in tabs.items():
            if name != "board":
                with open(os.path.join(sys.argv[2], name + ".md"), "w") as f:
                    f.write(text)
    sys.stdout.write(tabs["board"])
