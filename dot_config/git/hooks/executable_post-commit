#!/usr/bin/env bash
# Global hook (core.hooksPath, every repo): only enqueue the sha for herdr-sb-drain to batch - a hook that blocks on a model call makes committing unusable. Every path exits 0.

set -u

SUBJECT=$(git log -1 --pretty=%s 2>/dev/null || true)
[ -z "$SUBJECT" ] && exit 0

# Skip non-content commits. Merges + reverts add noise without telling
# us anything we couldn't recover from `git log` directly.
case "$SUBJECT" in
  Merge*|Revert*) exit 0 ;;
esac

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)
[ -z "$BRANCH" ] && exit 0

# The queue file is named by ticket, so the key has to be resolved here rather than by the drain.
TICKET=$(printf '%s' "$BRANCH" | grep -oE '[A-Z]+-[0-9]+' | head -1)
[ -z "$TICKET" ] && exit 0

# Parity with the old direct-append behavior: no note means nothing to log into, so don't queue for one that may never exist.
[ -x "$HOME/.local/bin/vault-note" ] || exit 0
"$HOME/.local/bin/vault-note" >/dev/null 2>&1 || exit 0

SHA=$(git rev-parse HEAD 2>/dev/null || true)
[ -z "$SHA" ] && exit 0

# --show-toplevel, so the drain can cd somewhere `git show` and vault-path both resolve from.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
[ -z "$ROOT" ] && exit 0

QUEUE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/sb-queue/log"
mkdir -p "$QUEUE_DIR" 2>/dev/null || exit 0

# TSV not JSON: jq isn't reliably on a git hook's PATH, and both fields are tab-free by construction.
printf '%s\t%s\n' "$SHA" "$ROOT" >> "$QUEUE_DIR/$TICKET.tsv" 2>/dev/null || true
exit 0
