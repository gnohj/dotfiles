#
# Ghostty is a fast, feature-rich, and cross-platform terminal emulator that uses platform-native UI and GPU acceleration.
# https://ghostty.org/docs/config/reference

# refresh - command + shift + ,

# This will be used to set the `TERM` environment variable.
# HACK: We set this with an `xterm` prefix because vim uses that to enable key
# protocols (specifically this will enable `modifyOtherKeys`), among other
# features. An option exists in vim to modify this: `:set
# keyprotocol=ghostty:kitty`, however a bug in the implementation prevents it
# from working properly. https://github.com/vim/vim/pull/13211 fixes this.
term = xterm-ghostty

# color
{{ if eq (get .chezmoi.osRelease "id") "omarchy" -}}
# Omarchy owns theming on Arch: `omarchy theme set` repoints this file, so the
# terminal follows the desktop instead of colorscheme-set.sh (disabled there).
# The leading ? makes ghostty tolerate the file being absent.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"
{{- else -}}
config-file = ghostty-theme
{{- end }}
{{ if eq .chezmoi.hostname .devbox_host -}}
custom-shader =
custom-shader-animation = false
{{- else }}
# custom-shader = ./shaders/tesla_coil.glsl
# custom-shader = ./shaders/glow.glsl
custom-shader = ./shaders/bloom025.glsl
# custom-shader = ./shaders/cursor_blaze.gsl
custom-shader = ./shaders/cursor_smear_fade.glsl
# Animate cursor trails only while focused, including inside nvim/TUIs.
custom-shader-animation = true
# custom-shader = ./shaders/cursor_smear.gsl
# custom-shader = ./shaders/cineShader-Lava.glsl
# custom-shader = ./shaders/retro-terminal.glsl
# custom-shader = ./shaders/bettercrt.glsl
# custom-shader = ./shaders/drunkard.glsl
# custom-shader = ./shaders/tft.glsl
# custom-shader = ./shaders/inside-the-matrix.glsl
{{- end }}

# fonts
# Family name only - the face comes from font-style-*; all four pinned so kitty can't diverge.
font-family = "JetBrainsMono Nerd Font Mono"
# font-family = "Hasklug Nerd Font Mono Med"
# font-family = "RobotoMono Nerd Font"
font-family-bold = "JetBrainsMono Nerd Font Mono"
font-family-italic = "JetBrainsMono Nerd Font Mono"
font-family-bold-italic = "JetBrainsMono Nerd Font Mono"
font-style = "Regular"
font-style-bold = "Bold"
font-style-italic = "Italic"
font-style-bold-italic = "Bold Italic"
# Nerd Fonts patch U+26A1, so force the color emoji face to match kitty (new windows only).
font-codepoint-map = U+26A1=Apple Color Emoji
adjust-cell-width = -5%
adjust-cell-height = 10%
adjust-underline-thickness = 40%
adjust-cursor-thickness = 150%
font-size = 15
# mac only
# font-thicken = true

# cursor
shell-integration-features = no-cursor,no-sudo,no-title
cursor-style = block
cursor-style-blink = false

# quick terminal
# Ghostty quick terminal (quake) DISABLED — replaced by the single kitty quake
# driven from skhd (cmd+rctrl+r → ql launcher). Kitty is used because its
# quick-access supports per-instance Esc-to-hide and the graphics protocol for
# image previews; ghostty can't scope Esc to just the quick terminal.
# Re-enable by uncommenting the block below.
# keybind = global:cmd+s=toggle_quick_terminal
# keybind = cmd+s=toggle_quick_terminal
# quick-terminal-animation-duration = 0.08
# quick-terminal-size = 35%
# quick-terminal-position = top

# Ensure zsh runs as login shell to source Nix profile
# This is especially important when Ghostty starts at login
command = /bin/zsh --login

# window
gtk-titlebar = false
mouse-hide-while-typing = true
macos-titlebar-style = hidden
macos-titlebar-proxy-icon = hidden
macos-window-buttons = hidden
window-decoration = true
title = " "

# mac only
window-colorspace = display-p3

window-padding-balance = true
window-padding-x = 20,20
window-padding-y = 8,8
macos-window-shadow = false
macos-option-as-alt = right

# ghosty specific keybinds only
keybind = super+i=inspector:toggle
keybind = super+r=reload_config
keybind = super+shift+s=toggle_secure_input

# clipboard
clipboard-read = "allow"
clipboard-trim-trailing-spaces = true
clipboard-write = "allow"

# Copies land in CLIPBOARD over OSC 52, so Super+V's shift+insert must read it, not PRIMARY
keybind = shift+insert=paste_from_clipboard

# misc
confirm-close-surface = false
auto-update = off
quit-after-last-window-closed = true

# Auto secure keyboard entry on password prompts blinds skhd
macos-auto-secure-input = false
shell-integration = detect
# shell-integration-features merged into line 51

keybind = shift+enter=text:\n

# background - https://wallhaven.cc/
# background-blur-radius = 40
# background-blur = true

background-opacity = 0.875
background-opacity-cells = true
# background-opacity = 1.0
