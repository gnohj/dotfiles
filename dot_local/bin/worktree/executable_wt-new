#!/usr/bin/env bash
# wt-new [repo] - interactive wt-add: pick a repo and folder bucket, type a branch. Backs `wtn` and the launcher's 🌳 Add Worktree.
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/bin/worktree:/opt/homebrew/bin:/run/current-system/sw/bin:$HOME/.local/share/mise/shims:$PATH"
[ "$(uname)" = Linux ] && PATH="$HOME/.nix-profile/bin:$PATH"

if [ -f "$HOME/.config/colorscheme/active/active-colorscheme.sh" ]; then
  # shellcheck disable=SC1091
  source "$HOME/.config/colorscheme/active/active-colorscheme.sh"
fi
FZF_COLORS="--color=bg+:${gnohj_color13:-},border:${gnohj_color03:-},fg:${gnohj_color02:-},fg+:${gnohj_color02:-},hl+:${gnohj_color04:-},info:${gnohj_color09:-},prompt:${gnohj_color04:-},pointer:${gnohj_color04:-},marker:${gnohj_color04:-},header:${gnohj_color09:-}"

pick() {
  "$HOME/.local/bin/fzf-vim.sh" --no-border --ansi --no-sort --bind 'tab:down,btab:up' --prompt="$1" $FZF_COLORS
}

REPO="${1:-}"
if [ -z "$REPO" ]; then
  REPOS=$(for bare in "$HOME"/Developer/*/.bare; do [ -d "$bare" ] && basename "$(dirname "$bare")"; done)
  [ -n "$REPOS" ] || { echo "No bare-layout repos under ~/Developer" >&2; exit 1; }
  REPO=$(printf '%s\n' "$REPOS" | awk '{ print "📂 " $0 }' | pick '🌳 repo ') || exit 0
  REPO=${REPO#📂 }
fi

BUCKET=$(printf '%s\n' feat fix ui infra refactor perf test chore spike '(none)' | pick "🌳 $REPO/ ") || exit 0

printf '🌳 %s/%s branch: ' "$REPO" "$([ "$BUCKET" = '(none)' ] || printf '%s/' "$BUCKET")"
read -r BRANCH
[ -n "$BRANCH" ] || exit 0

REL="$BRANCH"
[ "$BUCKET" = '(none)' ] || REL="$BUCKET/$BRANCH"

[ "$("$HOME/.local/bin/mux/mux" kind 2>/dev/null)" = herdr ] && export WORKTREE_OPEN_IN=herdr

if ! wt-add "$REPO" "$BRANCH" "$REL"; then
  printf '\nwt-add failed. Press enter to close.'
  read -r _
  exit 1
fi
