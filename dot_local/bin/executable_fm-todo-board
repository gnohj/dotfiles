#!/usr/bin/env python3
"""Turn firstmate's status block (stdin) plus the Lavish Library's PR and ticket files into a rexpad board."""
import hashlib
import json
from datetime import datetime, timedelta, timezone
import os
import re
import subprocess
import sys

import fm_todo_ask
from fm_todo_action import act

LIBRARY = os.path.expanduser(os.environ.get("FM_TODO_LIBRARY", "~/.local/state/lavish-library"))
INBOX = os.path.expanduser(os.environ.get("FM_INBOX_STATE", "~/.local/state/fm-inbox"))
JIRA = "https://jira.example.com/browse/"
TICKET = r"[A-Z][A-Z]+-[0-9][0-9]+"
JIRA_KEY = r"IHR[A-Z]*-[0-9]+"
REF = re.compile(rf"{TICKET}|PR #?[0-9]+")
LEVELS = [("🔴", "Blocked", "red", "red"), ("🟡", "Needs your call", "yellow", "yellow"),
          ("♻", "In progress", "cyan", "cyan"), ("🟢", "Waiting on others", "green", ""), ("✅", "Done", "green", "green")]
REPOS = {"inferno": "iheartradio/inferno-monorepo", "web": "iheartradio/web", "chezmoi": "gnohj/dotfiles", "dotfiles": "gnohj/dotfiles"}
COMPONENT_COLORS = {"inferno": "magenta"}
KIND_MARK = {"scout": "\U0001f52d", "ship": "⛵"}


def crew_mark(task):
    glyph = KIND_MARK.get(task.get("kind", ""))
    return glyph + " " if glyph else ""


def load(name, default):
    try:
        with open(os.path.join(LIBRARY, name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


HANDOFF_WINDOW = 4 * 3600


def load_handoffs():
    out = {}
    try:
        for name in os.listdir(os.path.join(LIBRARY, "fix-briefs")):
            age = datetime.now().timestamp() - os.path.getmtime(os.path.join(LIBRARY, "fix-briefs", name))
            if name.endswith(".md") and age < HANDOFF_WINDOW:
                out[name[:-3]] = "sent"
    except OSError:
        pass
    for row in load("firstmate-outbox.json", []):
        if isinstance(row, dict) and row.get("key"):
            out[re.sub(r"[^A-Za-z0-9._-]", "_", row["key"])] = "queued"
    return out


def chat(title, ref="", qid=""):
    return link("{{chat:blue}}", act("chat", title=title, ref=ref, **({"qid": qid} if qid else {})), "[c]")


def diff_chip(repo, number, key=""):
    return link("{{review:blue}}", act("diff", repo=repo, number=number, key=key), f"[v] Open PR #{number} in Hunk")


def pill(text):
    return f"{{{{{text}:magenta}}}}"


def tint(text):
    return f"{{{{{text}:magenta.}}}}"


PILL = re.compile(r"\{\{[^{}]*:[a-z]+\}\}")


def join_meta(parts):
    out, prev = "", ""
    for part in (x for x in parts if x):
        if out:
            out += " " if PILL.search(part) or PILL.search(prev) else " · "
        out, prev = out + part, part
    return out


def ticket_link(key):
    return link(pill(key), JIRA + key)


def pr_link(repo, number):
    return link(pill(f"#{number}"), f"https://github.com/{repo}/pull/{number}")


def link(label, url, title=""):
    label = label.replace("]", ")").replace("[", "(")
    return f'[{label}]({url} "{title}")' if title else f"[{label}]({url})"


SECTIONS = [("needs", "Needs you", "yellow"), ("progress", "In progress", "cyan"), ("prs", "Your PRs", "blue"),
            ("requests", "Review requests", "magenta"), ("new", "New for you", "green"), ("done", "Done", "green")]
SEEN_SECTIONS = ("new", "done")
WORK_SECTIONS = ("prs", "progress")


def new_item(**kw):
    item = {"title": "", "glyph": "", "flag": "", "refs": [], "chips": [], "lines": [], "details": [], "action": "",
            "task": {}, "pr": "", "key": "", "owner": "", "qid": "", "call": None, "answered": False, "call_chip": "",
            "done": False, "draft": False, "chat": ("", ""), "extra": [], "badge": "", "cat": "", "at": 0, "custom": False}
    item.update(kw)
    return item


def problems(bits):
    """Only chips that ask for attention: failing or running CI, approvals still missing."""
    return [b for b in bits if ":red." in b or ":yellow." in b]


def summary_of(t):
    return re.sub(r"^\[[^\]]+\]\s*", "", defuse(" ".join(str((t or {}).get("summary") or "").split())))


class Board:
    def __init__(self, tasks_env, lavish_env):
        self.tasks, self.mates, self.states, self.kinds, self.claimed, self.claimed_prs = {}, {}, {}, {}, set(), set()
        self.cur_qid, self.answers, self.seen = "", fm_todo_ask.answers(), fm_todo_ask.seen()
        for row in filter(None, tasks_env.split("\n")):
            f = row.split("\t")
            col = lambda i: f[i] if len(f) > i else ""
            if f[0].startswith("mate:"):
                self.mates[f[0][5:]] = col(1)
            elif f[0].startswith("state:"):
                self.states[f[0][6:]] = col(1)
                self.kinds[f[0][6:]] = col(2)
            elif len(f) >= 4:
                self.tasks.setdefault(f[0], {"id": f[0], "kind": f[1], "slug": f[2], "home": f[3], "tab": col(4),
                                             "me": col(5), "ses": col(7), "block": col(8), "host": col(9), "wt": col(10), "dirty": col(11),
                                             "unpushed": col(12), "branch": col(13)})
                if f[3].startswith("sm-"):
                    self.mates.setdefault(f[3], "")
        self.lavish, self.lavish_titles = {}, {}
        for row in filter(None, lavish_env.split("\n")):
            k, _, url = row.partition("\t")
            (self.lavish_titles if k.startswith("title:") else self.lavish)[k.removeprefix("title:")] = url
        self.my_prs = {f"{r['repo']}#{r['number']}": r for r in load("my-prs.json", []) if isinstance(r, dict)}
        self.status = load("pr-status.json", {}).get("items", {})
        self.ci_since = ci_failing_since(self.status, self.my_prs)
        # Firstmate's task record can miss its PR; the worktree's branch is the PR's head branch, so join on that too.
        by_branch = {}
        for pr, st in self.status.items():
            if st.get("branch") and (pr in self.my_prs or st.get("state") in ("merged", "closed")):
                by_branch.setdefault(st["branch"], []).append(pr)
        for task in list(self.tasks.values()):
            for pr in by_branch.get(task.get("branch") or "", []):
                self.tasks.setdefault(pr, task)
        self.tickets = [t for t in load("my-tickets.json", []) if isinstance(t, dict)]
        catalog = load("catalog.json", {})
        self.queue = [q for q in catalog.get("queue", []) if isinstance(q, dict)]
        self.artifacts = [a for a in catalog.get("artifacts", []) if isinstance(a, dict)]
        self.hidden = set(load("hidden.json", []))
        self.merged = [r for r in load("my-merged-prs.json", []) if isinstance(r, dict)]
        self.required = {repo: (v or {}).get("count") or 1 for repo, v in load("required-approvals.json", {}).items()}
        self.me = {(t.get("assignee") or {}).get("name") for t in self.tickets} - {None}
        self.handoffs = load_handoffs()
        self.jira = {t["key"]: t for t in self.tickets if t.get("key")}
        sprint = load("sprint-tickets.json", None)
        self.sprint = {t["key"]: t for t in sprint if isinstance(t, dict) and t.get("key")} if isinstance(sprint, list) else None
        self.pr_titles = {f"{r.get('repo')}#{r.get('number')}": pr_title(r) for r in [*self.my_prs.values(), *self.merged]}
        for pr in self.my_prs.values():
            for t in pr.get("jira") or []:
                if isinstance(t, dict) and t.get("key"):
                    self.jira.setdefault(t["key"], t)

    def owner_of(self, key="", pr="", label=""):
        """The mate a thing belongs to: its task's home, else the mate whose domain its repo or project is, else fm."""
        task = self.tasks.get(pr) or self.tasks.get(key) or {}
        mate = "sm-" + label.lower()
        return task.get("home") or (mate if mate in self.mates else "fm")

    def pr_for(self, key, merged=False):
        """The ticket's open PR, and with merged its newest merged one: merging can leave the ticket in TE or stakeholder review."""
        merged_prs = ((f"{r.get('repo')}#{r.get('number')}", r) for r in self.merged) if merged else ()
        for name, pr in [*self.my_prs.items(), *merged_prs]:
            if any(isinstance(t, dict) and t.get("key") == key for t in pr.get("jira") or []):
                return name
        return ""

    def jira_meta(self, key):
        t = (self.sprint or {}).get(key) or self.jira.get(key)
        parts = [ticket_link(key)]
        if not t:
            return parts
        name = t.get("name") or ""
        parts.append(link(tint(name), act("jira/status", key=key, cur=name), f"menu:Move {key} to"))
        who = (t.get("assignee") or {}).get("name")
        if not who:
            parts.append(link("+ assignee", act("jira/assign", key=key, cur=""), f"menu:Assign {key}"))
        else:
            label = "me" if who in self.me else who.split()[0]
            parts.append(link(tint(label), act("jira/assign", key=key, cur=who), f"menu:Assign {key}"))
        versions = [v.get("name", "") for v in t.get("fix_versions") or [] if isinstance(v, dict)]
        if versions:
            label = re.sub(r"\s*\(.*\)$", "", versions[0])
            parts.append(link(tint(label), act("jira/version", key=key, cur=versions[0]), f"menu:Fix version for {key}"))
        else:
            parts.append(link("+ version", act("jira/version", key=key, cur=""), f"menu:Fix version for {key}"))
        return parts

    def pr_bits(self, name):
        repo, _, number = name.partition("#")
        st, mine = self.status.get(name, {}), self.my_prs.get(name, {})
        parts = [pr_link(repo, number)]
        ci = (st.get("checks") or {}).get("state", "none")
        if ci == "passing":
            parts.append("{{CI ✓:green.}}")
        elif ci == "failing":
            parts.append("{{CI ✗:red.}}")
        elif ci == "running":
            parts.append("{{CI running:yellow.}}")
        approvals, needed = st.get("approvals") or 0, self.required.get(repo, 1)
        if st:
            marks = "✓" * min(approvals, 3) if approvals >= needed else f"{approvals}/{needed}"
            parts.append(f"{{{{Approvals {marks}:{'green' if approvals >= needed else 'yellow'}.}}}}")
        draft = st.get("is_draft") or mine.get("draft")
        threads = mine.get("threads_awaiting") or 0
        handoff = self.handoffs.get(re.sub(r"[^A-Za-z0-9._-]", "_", name), "")
        action = ""
        if st.get("state", "open") != "open" or draft:
            pass
        elif handoff and (ci == "failing" or threads):
            action = f"{{{{{'Queued for fm' if handoff == 'queued' else 'CI fix sent' if ci == 'failing' else 'Resolve sent'}:yellow.}}}}"
        elif ci == "failing":
            action = link("{{Fix CI:red}}", act("fixci", repo=repo, number=number), f"Fix failing CI on #{number}?")
        elif threads:
            action = link("{{Resolve:yellow}}", act("resolve", repo=repo, number=number),
                          f"Resolve {threads} open thread{'s' if threads > 1 else ''} on #{number}?")
        elif approvals >= needed and ci in ("passing", "none") and name in self.my_prs:
            action = link("{{merge:green}}", act("merge", repo=repo, number=number, sha=st.get("head", "")),
                          f"Merge #{number} into {st.get('base') or 'its base'}?")
        return parts, action

    def linkify(self, text, repo):
        text = defuse(text)
        text = re.sub(r"https://github\.com/([^/\s]+/[^/\s]+)/pull/(\d+)", lambda m: link(f"#{m[2]}", m[0]), text)
        text = re.sub(rf"(?<![\[/\w-])({JIRA_KEY})(?![\w-]*\])", lambda m: link(m[1], JIRA + m[1]), text)
        if repo:
            text = re.sub(r"(?<!\[)PR #?(\d+)", lambda m: link(f"PR #{m[1]}", f"https://github.com/{repo}/pull/{m[1]}"), text)
        return text

    def lavish_link(self, key):
        return link(tint("Lavish"), self.lavish[key]) if key in self.lavish else ""

    def block(self, head, tail, repo, level, lead=""):
        m = re.search(TICKET, head)
        key = m[0] if m else ""
        pr = re.search(r"PR #?(\d+)", head)
        pr_name = f"{repo}#{pr[1]}" if pr and repo else (self.pr_for(key) if key else "")
        task = self.tasks.get(key) or self.tasks.get(pr_name) or self.tasks.get(head) or {}
        self.claimed.add(key or head)
        if pr_name:
            self.claimed_prs.add(pr_name)
        refs, chips, action = [], [], ""
        if key:
            refs.append(ticket_link(key))
        if pr_name:
            bits, action = self.pr_bits(pr_name)
            refs.append(bits[0])
            chips = problems(bits[1:])
        if key and self.lavish_link(key):
            refs.append(self.lavish_link(key))
        if task:
            name = task["slug"]
        else:
            name = re.sub(r"\b(no ticket|unticketed)\b", "", lead + " " + REF.sub("", head)).strip(" /()-·")
            if len(name.split()) < 3:
                name = summary_of(self.jira.get(key)) or self.pr_titles.get(pr_name, "")
            if not name:
                name, tail = " ".join(f"{lead} {head} {tail}".split()).strip(" /()-·"), ""
        ref_text = " · ".join(x for x in (key, f"PR #{pr_name.partition('#')[2]}" if pr_name else "") if x)
        if task and lead:
            tail = (re.sub(r"\s+(for|on|of|to)$", "", lead) + " " + tail).strip()
        tail = re.sub(r"(then )?merge words?( for)?", "ready to merge", tail).strip()
        tail = re.sub(r"^answers?$", "needs your answers", tail)
        st = self.status.get(pr_name, {}) if pr_name else {}
        if st and re.search(r"\breview", tail) and (st.get("approvals") or 0) >= self.required.get(repo, 1):
            green = (st.get("checks") or {}).get("state") in ("passing", "none")
            tail = ("approved and ready to merge" if pr_name in self.my_prs else "approved · not your PR, merge it on GitHub") if green else "approved"
        elif (short := approvals_short(pr_name, self)) and re.search(r"\breview|\bmerge", tail):
            tail = f"needs {short} teammate approval{'s' if short > 1 else ''}"
        lines = []
        if tail:
            color = LEVELS[level][3]
            lines.append(f"| {{{{→ {tail}:{color}.}}}}" if color else f"| → {tail}")
        return new_item(title=name, glyph=crew_mark(task), flag=state_flag(self, task.get("block", "")), refs=refs,
                        chips=chips, lines=lines, action=action, task=task, pr=pr_name, key=key,
                        owner=task.get("home", ""), qid=self.cur_qid, chat=(name, ref_text))


def outside(text):
    """Text from Slack or Jira: no links, chips or hotkeys of its own, only words."""
    return defuse(text).replace("[", "［").replace("]", "］").replace("{{", "{ {").replace("}}", "} }").replace("`", "'")


def defuse(text):
    """Passed-through text never carries a pane action link: only the board's own links can act."""
    text = re.sub(r"\[([^\]]*)\]\(\s*<?https?://fm-todo\.invalid[^)]*\)", r"\1", text)
    return re.sub(r"https?://fm-todo\.invalid\S*", "", text)


def clean(s):
    s = re.sub(r"🔴|🟡|♻️|♻|🟢|✅|\*\*|`", "", s)
    s = re.sub(r" ?\(https?://[^)]*\)| https?://\S+", "", s)
    return defuse(re.sub(r"^\s*[0-9]+\.\s*", "", s)).strip()


def level_of(line):
    return next((i for i, lv in enumerate(LEVELS) if lv[0] in line), -1)


def split_refs(rest):
    """Split "A / PR 1, B and C" into (head, tail) chunks, keeping parentheses together."""
    chunks, depth, cur = [], 0, ""
    i = 0
    while i < len(rest):
        ch = rest[i]
        depth += ch == "("
        depth -= ch == ")" and depth > 0
        sep = next((s for s in (", and ", ", ", "; ", " and ") if not depth and rest.startswith(s, i)), None)
        if sep and REF.search(rest[i + len(sep):]):
            chunks.append(cur)
            cur, i = "", i + len(sep)
            continue
        cur += ch
        i += 1
    chunks.append(cur)
    out = []
    for c in filter(None, (c.strip() for c in chunks)):
        last = None
        for last in REF.finditer(c):
            pass
        if not last:
            out[-1:] = [(out[-1][0], (out[-1][1] + " " + c).strip())] if out else [("", c)]
            continue
        head, tail = c[:last.end()], c[last.end():]
        if head.count("(") > head.count(")") and ")" in tail:
            cut = tail.index(")") + 1
            head, tail = head + tail[:cut], tail[cut:]
        out.append((head.strip(), tail.strip(" :,-")))
    return out


def ask_lines(it, item, b):
    sent = b.answers.get(item["qid"]) or {}
    done = sent.get("fp") == item["fp"]
    label = next((o["label"] for o in item["options"] if o["letter"] == item["recommend"]), "")
    call = f"| **Your call:** {defuse(item['question'])}" + (f" · recommends **({item['recommend']}) {defuse(label)}**" if label else "")
    if sent and not done:
        call += f" · you answered {'(' + sent['letter'] + ')' if sent.get('letter') else ''} before it changed".replace("  ", " ")
    shown = [call]
    if done:
        picked = f"({sent['letter']}) " if sent.get("letter") else ""
        shown.append(f"| {{{{answered {picked}· {{ago:{int(sent.get('at', 0))}}}:green.}}}}")
    elif item["options"]:
        title = re.sub(r"^\S+\s+-\s+", "", item["head"])
        it["call_chip"] = link("{{answer:yellow}}", act("ask", qid=item["qid"], fp=item["fp"], title=title, ref=item["ref"]), "[a] menu:Your call")
    it["details"][0:0] = ["> " + ln[2:] for ln in it["lines"]]
    it["lines"] = shown
    it["call"], it["answered"] = item, done


def board(raw, b):
    """firstmate's status lines as items, by level; "> " lines are an item's folded details."""
    levels = [[] for _ in LEVELS]
    last, last_repo = None, ""
    calls, asks = fm_todo_ask.parse(raw), []
    for line in raw.split("\n"):
        if not line.strip():
            continue
        if line.lstrip().startswith(">"):
            detail = line.lstrip()[1:].strip()
            if last is not None and not fm_todo_ask.QUESTION.match(detail):
                last["details"].append("> " + b.linkify(detail, last_repo))
            continue
        lv = level_of(line)
        if lv < 0 or not re.search(r"[0-9]+\.", line):
            if last is not None and line[:1] in " \t":
                last["lines"].append("| " + b.linkify(clean(line), last_repo))
            continue
        number = re.search(r"([0-9]+)\.", line)
        call = calls.get(int(number[1])) if number else None
        b.cur_qid = call["qid"] if call else ""
        text = clean(line)
        project = text.split(" ", 1)[0]
        body = text.split(" - ", 1)[1] if " - " in text else text[len(project):].strip()
        repo = REPOS.get(project, "")
        last_repo = repo
        m = REF.search(body)
        mate = "sm-" + project if "sm-" + project in b.mates else "fm"
        crew = next((k for k in b.tasks if k.startswith("task:") and k[5:] in body), "")
        if crew and not m:
            items = [b.block(crew, "", repo, lv, body.replace(crew[5:], "").strip(" :,-()"))]
        elif not m:
            items = [new_item(title=body, qid=b.cur_qid, chat=(body, project))]
        else:
            lead = body[:m.start()].strip(" :,-(")
            items = []
            for head, tail in split_refs(body[m.start():]):
                hint = re.search(r" ?\((inferno|web|chezmoi|dotfiles)\)", head)
                items.append(b.block(head, tail, REPOS.get(hint[1], repo) if hint else repo, lv, lead))
        target = None
        for it in items:
            it["owner"] = it["owner"] or mate
            same = next((e for e in levels[lv] if (e["title"], e["key"], e["pr"]) == (it["title"], it["key"], it["pr"])), None)
            if same:
                same["lines"] += [ln for ln in it["lines"] if ln not in same["lines"]]
                target = same
            else:
                levels[lv].append(it)
                target = it
        last = target
        if call and call["question"] and target is not None:
            asks.append((target, call))
    b.cur_qid = ""
    for it, call in asks:
        ask_lines(it, call, b)
    return levels


def asks_question(it):
    return it["title"].rstrip().endswith("?") or any(d.rstrip().endswith("?") for d in it["details"])


CI_FAIL_FILE = os.path.expanduser("~/.local/state/rexpad/firstmate.cifail.json")
CI_GRACE = 15 * 60


def ci_failing_since(status, mine):
    """When each of your open PRs' CI was first seen failing, kept across redraws; a PR leaves once it stops failing."""
    try:
        with open(CI_FAIL_FILE) as f:
            old = json.load(f)
    except (OSError, ValueError):
        old = {}
    now = int(datetime.now().timestamp())
    new = {pr: old.get(pr) or now for pr, st in status.items()
           if pr in mine and st.get("state") == "open" and (st.get("checks") or {}).get("state") == "failing"}
    if new != old:
        try:
            tmp = CI_FAIL_FILE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(new, f)
            os.replace(tmp, CI_FAIL_FILE)
        except OSError:
            pass
    return new


def stalled_fix(it, b):
    """Your own PR with CI failing past the grace period or review threads open, no fix sent, and nobody working on it."""
    if it["pr"] not in b.my_prs or b.states.get(it["task"].get("block", "")) == "working":
        return False
    if "/resolve?" in it["action"]:
        return True
    since = b.ci_since.get(it["pr"])
    return "/fixci?" in it["action"] and since is not None and datetime.now().timestamp() - since >= CI_GRACE


def approvals_short(pr, b):
    """How many more approvals your own open PR needs, else 0."""
    if pr not in b.my_prs:
        return 0
    st = b.status.get(pr, {})
    return max(0, b.required.get(pr.partition("#")[0], 1) - (st.get("approvals") or 0))


def place(it, lv, b):
    level = LEVELS[lv][1]
    pr_state = b.status.get(it["pr"], {}).get("state") if it["pr"] else ""
    if pr_state in ("merged", "closed"):
        it["done"], it["action"] = True, ""
        it["chips"] = [f"{{{{{pr_state}:{'green' if pr_state == 'merged' else 'red'}.}}}}"]
        return "done"
    if level == "Done":
        it["done"] = True
        return "done"
    if level == "Blocked" or b.states.get(it["task"].get("block", "")) == "blocked" or stalled_fix(it, b):
        return "needs"
    short = approvals_short(it["pr"], b)
    if it["call"] and not it["answered"] and short and re.search(r"merge", it["call"]["question"], re.I):
        it["details"][0:0] = ["> Your call: " + it["call"]["question"]]
        it["lines"] = [f"| {{{{needs {short} teammate approval{'s' if short > 1 else ''}:yellow.}}}}"]
        it["call"], it["call_chip"] = None, ""
        return "prs"
    if it["call"]:
        return "progress" if it["answered"] else "needs"
    if level == "Needs your call":
        return "needs" if asks_question(it) else "prs" if it["pr"] else "new"
    return "prs" if "/merge?" in it["action"] else "progress"


PROMPT_FILE = os.path.expanduser("~/.local/state/rexpad/firstmate.prompts.json")
BOX = re.compile(r"^[\s│┃|╭╮╰╯─━┌┐└┘╷╵]+|[\s│┃|╭╮╰╯─━┌┐└┘╷╵]+$")


def prompt_of(screen):
    """The question a blocked agent shows, with the line above it (often the command): box borders dropped."""
    lines = [BOX.sub("", ln) for ln in screen.splitlines()]
    lines = [ln for ln in lines if ln.strip() and not set(ln.strip()) <= set("─━-=·.>❯ ")][-14:]
    ask = max((i for i, ln in enumerate(lines) if "?" in ln), default=max(0, len(lines) - 4))
    return [" ".join(ln.split())[:160] for ln in lines[max(0, ask - 1):ask + 5]]


def blocked_prompts(b):
    """Each blocked pane's prompt, read from its screen once when it blocks and kept until it unblocks: one local Rex call per block."""
    try:
        with open(PROMPT_FILE) as f:
            old = json.load(f)
    except (OSError, ValueError):
        old = {}
    new = {}
    for task in b.tasks.values():
        block = task.get("block", "")
        if not block or b.states.get(block) != "blocked" or block in new:
            continue
        if block in old:
            new[block] = old[block]
            continue
        cmd = ["rex", "--autostart=false", "--timeout", "3s", *(["-S", task["host"]] if task.get("host") else []),
               "capture", *(["-s", task["ses"]] if task.get("ses") else []), "-b", block, "--trim", "--unwrap"]
        try:
            screen = subprocess.run(cmd, capture_output=True, text=True, timeout=6).stdout
        except (OSError, subprocess.TimeoutExpired):
            continue
        if screen.strip():
            new[block] = prompt_of(screen[-20000:])
    if new != old:
        try:
            with open(PROMPT_FILE + ".tmp", "w") as f:
                json.dump(new, f)
            os.replace(PROMPT_FILE + ".tmp", PROMPT_FILE)
        except OSError:
            pass
    return new


NOTIFIED_FILE = os.path.expanduser("~/.local/state/rexpad/firstmate.notified.json")


def notify_new(out):
    """A Rex notification from the Firstmate pane for each item new to Needs you or Jira mention; the first run only records."""
    now = {}
    for it in out["needs"]:
        now[seen_key(it)[0]] = (plain_text(it["title"]), plain_text(it["lines"][0]) if it["lines"] else "")
    for it in out["new"]:
        if it["qid"].startswith("jira:") and "@you" in "".join(it["chips"]):
            now[it["qid"]] = (plain_text(it["title"]), plain_text(it["lines"][0]) if it["lines"] else "")
    try:
        with open(NOTIFIED_FILE) as f:
            old = json.load(f)
    except (OSError, ValueError):
        old = None
    fresh = [] if old is None else [(k, v) for k, v in now.items() if k not in old][:3]
    if fresh:
        try:
            pid = subprocess.run(["pgrep", "-f", "rexpad --list firstmate view"], capture_output=True, text=True).stdout.split()[0]
            tty = subprocess.run(["ps", "-o", "tty=", "-p", pid], capture_output=True, text=True).stdout.strip()
            with open(f"/dev/{tty}", "w") as term:
                for _, (title, body) in fresh:
                    clean = lambda t: re.sub(r"[\x00-\x1f\x7f-\x9f;]+", " ", t).strip()[:180]
                    term.write(f"\033]777;notify;{clean(title)};{clean(body) or 'Needs you'}\007")
        except (OSError, IndexError):
            pass
    if old is None or set(now) != set(old):
        try:
            with open(NOTIFIED_FILE + ".tmp", "w") as f:
                json.dump(list(now), f)
            os.replace(NOTIFIED_FILE + ".tmp", NOTIFIED_FILE)
        except OSError:
            pass


def add_prompts(out, b):
    prompts = blocked_prompts(b)
    for it in out["needs"]:
        lines = prompts.get(it["task"].get("block", ""))
        if lines:
            code = [defuse(ln).replace("`", "'") for ln in lines]
            it["lines"] += [f"| {{{{waiting on:red.}}}} `{code[0]}`"] + [f"| `{ln}`" for ln in code[1:]]


def stuck_panes(out, b):
    """Blocked panes firstmate never mentioned still land under Needs you."""
    shown = {it["task"].get("block") for items in out.values() for it in items}
    for key, task in b.tasks.items():
        pane = task.get("block", "")
        if b.states.get(pane) != "blocked" or pane in shown:
            continue
        shown.add(pane)
        repo, _, number = key.partition("#")
        tail = f"waiting in tab {task['tab']}" if task.get("tab") else "waiting on a prompt"
        it = b.block(f"PR #{number}" if number else key, tail, repo if number else "", 1)
        it["owner"] = it["owner"] or "fm"
        out["needs"].append(it)
    listed = {it["owner"] for items in out.values() for it in items}
    for mate in b.mates:
        if mate != "fm" and mate not in listed and b.states.get(mate) == "blocked":
            out["needs"].append(new_item(title=f"{mate} is waiting on a prompt", owner=mate, chat=(f"{mate} is waiting", mate)))


STALE_AFTER = 6 * 3600


def flag_stale(out, ages, b):
    """A firstmate "in progress" item with no live agent behind it and no change for hours most likely finished or died unreported."""
    now = datetime.now().timestamp()
    for it in out["progress"]:
        block = it["task"].get("block", "")
        alive = block and b.states.get(block) in ("working", "blocked", "done", "idle")
        if it.get("level") == 2 and not alive and now - ages.get(id(it), now) > STALE_AFTER:
            it["lines"].append("| {{no agent running · likely finished or lost, ask firstmate:yellow.}}")


def unlisted_tasks(out, b):
    """Every live crew or scout pane no item covers still shows; one that looks finished asks to be retired under Needs you."""
    shown = {it["task"].get("block") for items in out.values() for it in items if not it["done"]}
    prs = {}
    for key, task in b.tasks.items():
        if "#" in key and task.get("block"):
            prs.setdefault(task["block"], []).append(key)
    for task in b.tasks.values():
        block = task.get("block", "")
        if task.get("kind") not in ("ship", "scout") or not block or block in shown:
            continue
        shown.add(block)
        state = b.states.get(block, "")
        closed = [pr for pr in prs.get(block, []) if b.status.get(pr, {}).get("state") in ("merged", "closed")]
        clean = task.get("dirty") == "0" and task.get("unpushed") == "0"
        finished = state not in ("working", "blocked") and clean and (not prs.get(block) or len(closed) == len(prs[block]))
        if state == "blocked":
            note = "waiting on a prompt"
        elif state == "working":
            note = "working"
        elif finished:
            why = f"{', '.join('#' + pr.partition('#')[2] for pr in closed)} merged or closed" if closed else "not on firstmate's status"
            note = f"looks finished: idle, worktree clean, {why}"
        else:
            note = "idle, not on firstmate's status"
        retire = [link("{{retire:red}}", act("retire", slug=task["slug"], home=task.get("home", "")),
                       f"[X] Ask firstmate to retire {task['slug']}? It checks nothing is unpushed first.")] if finished else []
        out["needs" if state == "blocked" or finished else "progress"].append(new_item(
            title=task["slug"], glyph=crew_mark(task), flag=state_flag(b, block), task=task, owner=task.get("home", ""),
            lines=[f"| → {note}"], qid=f"task:{task['slug']}", extra=retire, chat=(task["slug"], task["slug"])))


def repo_label(repo):
    return next((k for k, v in REPOS.items() if v == repo), repo.split("/")[-1])


def repo_chip(repo):
    label = repo_label(repo)
    return f"{{{{{label}:{COMPONENT_COLORS.get(label, 'blue')}.}}}}"


def pr_title(pr):
    title = re.sub(r"^\s*\[[^\]]*\]\s*", "", defuse(" ".join(str(pr.get("title") or "").split())))
    return re.sub(rf"^#?{pr.get('number')}\b\s*", "", title)


def pr_keys(pr):
    return [t["key"] for t in pr.get("jira") or [] if isinstance(t, dict) and t.get("key")]


def my_pr_items(out, b):
    """Open PRs of yours firstmate didn't mention, and the ones merged today."""
    for name, pr in b.my_prs.items():
        keys = pr_keys(pr)
        if name in b.claimed_prs or any(k in b.claimed for k in keys):
            continue
        b.claimed_prs.add(name)
        b.claimed.update(keys)
        repo, number = name.partition("#")[::2]
        st = b.status.get(name, {})
        bits, action = b.pr_bits(name)
        title, key = pr_title(pr), (keys[0] if keys else "")
        task = b.tasks.get(name) or b.tasks.get(key) or {}
        draft = bool(st.get("is_draft") or pr.get("draft"))
        it = new_item(
            title=title, glyph=crew_mark(task), flag=state_flag(b, task.get("block", "")),
            refs=([ticket_link(key)] if key else []) + bits[:1], chips=problems(bits[1:]) + (["{{draft:magenta.}}"] if draft else []),
            action=action, task=task, pr=name, key=key, owner=b.owner_of(key, name, repo_label(repo)), qid=f"pr:{name}",
            draft=draft, chat=(title, " · ".join(x for x in (key, f"PR #{number}") if x)))
        out["needs" if not draft and stalled_fix(it, b) else "prs"].append(it)
    today = datetime.now().astimezone().date()
    for pr in b.merged:
        name = f"{pr.get('repo')}#{pr.get('number')}"
        try:
            when = datetime.fromisoformat(str(pr.get("merged_at")).replace("Z", "+00:00")).astimezone().date()
        except ValueError:
            continue
        keys = pr_keys(pr)
        if when != today or name in b.claimed_prs or any(k in b.claimed for k in keys):
            continue
        b.claimed_prs.add(name)
        b.claimed.update(keys)
        key = keys[0] if keys else ""
        out["done"].append(new_item(
            title=pr_title(pr), refs=([ticket_link(key)] if key else []) + [pr_link(pr["repo"], pr["number"])],
            chips=["{{merged:green.}}"], key=key, done=True, qid=f"merged:{name}",
            owner=b.owner_of(key, name, repo_label(pr["repo"])), chat=(pr_title(pr), key or name)))


LEVEL_COLORS = {"easy": "green", "medium": "yellow", "hard": "red"}


def since(iso):
    try:
        then = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except (AttributeError, ValueError):
        return ""
    minutes = max(0, round((datetime.now(timezone.utc) - then).total_seconds() / 60))
    if minutes < 60:
        return f"{minutes}min"
    hours = minutes / 60
    unit = lambda n, suffix: f"{round(n * 2) / 2 if n < 10 else round(n):g}{suffix}"
    return unit(hours, "hr") if hours < 24 else unit(hours / 24, "day")


def review_items(b):
    """PRs teammates asked you to review."""
    items = []
    for q in sorted(b.queue, key=lambda q: q.get("requested_at") or ""):
        repo, number = q.get("repo", ""), q.get("number")
        if not repo or not number or f"{repo}#{number}" in b.claimed_prs:
            continue
        name = f"{repo}#{number}"
        b.claimed_prs.add(name)
        title = defuse(" ".join(str(q.get("title") or "").split()))
        m = re.match(r"^\[([^\]]+)\]\s*", title)
        tag = m[1] if m else ""
        if m:
            title = title[m.end():]
        ticketed = re.fullmatch(JIRA_KEY, tag)
        refs = ([ticket_link(tag)] if ticketed else [tag or "unticketed"]) + [pr_link(repo, number)]
        chips = [defuse(str(q["author"]))] if q.get("author") else []
        if ago := since(q.get("requested_at")):
            chips.append(f"{{{{waiting {ago}:yellow.}}}}")
        if level := (q.get("size") or {}).get("level"):
            chips.append(f"{{{{●:{LEVEL_COLORS.get(level, '')}.}}}} {level}")
        scopes = q.get("repo_scopes") or []
        label = (scopes[0] + (f" +{len(scopes) - 1}" if len(scopes) > 1 else "")) if scopes else q.get("repo_label", "")
        if label:
            chips.append(f"{{{{{label}:{COMPONENT_COLORS.get(label.split('.')[0], 'blue')}.}}}}")
        lines, extra = [], []
        if q.get("running"):
            lines.append(f"| {{{{→ reviewing on {q.get('running_host') or 'this Mac'}:cyan.}}}}")
        else:
            extra = [link("{{review:blue}}", act("review-diff", repo=repo, number=number), f"[v] Open #{number} in Hunk with an agent beside it on the dev box?"),
                     link("{{start review:yellow}}", act("review", repo=repo, number=number), f"[z] Review #{number} on the dev box?")]
        items.append(new_item(title=title, refs=refs, chips=chips, lines=lines, extra=extra, qid=f"review:{name}",
                              owner=b.owner_of(tag if ticketed else "", name, repo_label(repo)), chat=(title, name)))
    return items


def state_flag(b, pane):
    state = b.states.get(pane, "") if pane else ""
    if state == "blocked":
        kind = re.sub(r"[^a-z ]", "", (b.kinds.get(pane) or "").lower()).strip()[:24]
        return f"{{{{needs {kind or 'you'}:red.}}}}"
    return "{{error:red.}}" if state == "error" else ""


def plural(n, word):
    return f"{n} {word}{'' if n == '1' else 's'}"


def changes(task, has_pr):
    """What the task's worktree holds that no remote does: uncommitted files and unpushed commits."""
    parts = []
    if task.get("dirty", "") not in ("", "0"):
        parts.append(plural(task["dirty"], "file"))
    if task.get("unpushed", "") not in ("", "0"):
        parts.append(f"{task['unpushed']} unpushed" if has_pr else plural(task["unpushed"], "commit") + ", no PR")
    return " · ".join(parts)


LINK = re.compile(r"\[([^\]]*)\]\([^)]*\)")


def plain_text(text):
    return LINK.sub(r"\1", text)


def seen_key(it):
    ident = f"{it['qid'] or it['pr']}|{plain_text(it['title'])}"
    fp = hashlib.sha1(json.dumps([plain_text(it["title"]), [plain_text(x) for x in it["lines"] + it["details"]]]).encode()).hexdigest()[:10]
    return ident, fp


def actions(it, section, b):
    task, acts = it["task"], []
    if it["custom"]:
        return it["extra"]
    if section == "done":
        ident, fp = seen_key(it)
        return [link("{{seen:green}}", act("seen", id=ident, fp=fp), "[s]"), chat(*it["chat"], it["qid"])]
    if it["call_chip"]:
        acts.append(it["call_chip"])
    tid = task.get("id", "")
    if task.get("block"):
        acts.append(link("{{pane:blue}}", act("pane", key=tid), "[o]"))
    if task.get("wt"):
        acts.append(link("{{edit:blue}}", act("edit", key=tid), "[e]"))
        if changes(task, it["pr"]):
            acts.append(link("{{diff:blue}}", act("wtdiff", key=tid), "[D]"))
    if it["pr"]:
        acts.append(diff_chip(*it["pr"].partition("#")[::2], it["key"]))
    if it["action"]:
        acts.append(it["action"])
    acts += it["extra"]
    if section in SEEN_SECTIONS:
        ident, fp = seen_key(it)
        acts.append(link("{{seen:green}}", act("seen", id=ident, fp=fp), "[s]"))
    talk = chat(*it["chat"], it["qid"])
    if it["call"] and not it["answered"] and not it["call_chip"]:
        acts.insert(0, talk.replace("{{chat:blue}}", "{{answer:yellow}}", 1))
    else:
        acts.append(talk)
    return acts


BUTTON = re.compile(r'^\[\{\{([^:{}]+):([a-z]+)\}\}\](\(\S+ "\[(.)\])')


def buttons(acts):
    """Each button names its hotkey; the first is filled in its color as the main action, the rest are plain outlines."""
    out = []
    for i, a in enumerate(acts):
        m = BUTTON.match(a)
        if m:
            chip = f"{m[1]} {m[4]}:{m[2]}!" if i == 0 else f"{m[1]} {m[4]}"
            a = f"[{{{{{chip}}}}}]{m[3]}" + a[m.end():]
        out.append(a)
    return out


PILL_REF = re.compile(r"\{\{([^{}:]+):([a-z]+)\}\}")


def as_text(ref):
    return PILL_REF.sub(r"{{\1:\2.}}", ref)


def badge(it, section):
    if it["badge"]:
        return it["badge"]
    kind = it["task"].get("kind", "")
    if kind == "ship":
        return "{{⛵ fm:blue}}"
    if kind == "scout":
        return "{{🔭 fm:magenta}}"
    if section == "requests":
        return "{{review:magenta}}"
    if section == "tickets" and not it["pr"]:
        return "{{ticket:blue}}"
    return "{{PR:cyan}}" if it["pr"] else "{{🚢 fm:green}}"


def categories(it, section):
    """The Inbox filter chips an item counts under: a crew or scout task is Agents, anything with a PR is PRs, and one can be both."""
    if it["cat"]:
        return [it["cat"]]
    cats = ["agents"] if it["task"].get("kind") in ("ship", "scout") else []
    if it["pr"] or section == "requests":
        cats.append("PRs")
    return cats


def inbox_state(name):
    try:
        with open(os.path.join(INBOX, name)) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def clock(at):
    return datetime.fromtimestamp(at).strftime("%a %H:%M") if at else ""


def slack_items(out):
    """Open Slack asks under Needs you and FYIs under New for you, from fm-inbox's sweep."""
    for x in inbox_state("slack.json").get("items", []):
        if not str(x.get("permalink", "")).startswith("https://"):
            continue
        link_ = x["permalink"]
        title = f"{outside(str(x.get('from', '')))} in {outside(str(x.get('channel', '')))}" + (f" · due {outside(str(x['due']))}" if x.get("due") else "")
        if x.get("ticked"):
            # Ticked asks wait in Done for the week the sweep keeps them, so a wrong done or skip can be undone.
            by = {"you": "done by you", "skipped": "skipped", "sweep": "you replied"}.get(x.get("by") or "", "done")
            out["done"].append(new_item(
                title=title, badge="{{slack:red}}", cat="slack", refs=[link(tint("open in Slack"), link_)],
                chips=[f"{{{{{by}:green.}}}}"], lines=[f"| {outside(str(x.get('text', '')))}"], done=True, custom=True,
                extra=[link("{{undo:yellow}}", act("slack/act", op="undo", link=link_), "[U]")], at=int(x.get("ticked_at") or 0)))
            continue
        chips = (["{{urgent:red.}}"] if x.get("urgent") else []) + (["{{handed to fm:cyan.}}"] if x.get("handed") else [])
        if x.get("oncall"):
            chips.insert(0, f"{{{{on-call · {outside(str(x['oncall']))}:yellow.}}}}")
        extra = [link("{{hand to fm:magenta}}", act("slack/hand", link=link_), "[t] Hand this to firstmate to research and draft a reply?"),
                 link("{{done:green}}", act("slack/act", op="done", link=link_), "[x]"),
                 link("{{skip:blue}}", act("slack/act", op="skip", link=link_), "[z]")]
        out["needs" if x.get("kind") == "ask" else "new"].append(new_item(
            title=title, badge="{{slack:red}}", cat="slack", refs=[link(tint("open in Slack"), link_)], chips=chips,
            lines=[f"| {outside(str(x.get('text', '')))}"], extra=extra, custom=True, at=int(x.get("at") or 0)))


SCOUT_DAYS = 4
SCOUT_REPORTS = ["~/.local/share/firstmate*/data/*/report.md", "~/.local/share/firstmate/data/remote-secondmates/*/data/*/report.md"]
ANSWER = re.compile(r"^#+\s*(answer|bottom line|summary|tl;?dr|verdict|findings)\b", re.I)


def report_summary(path):
    """A report's title and its first line of answer, under its Answer or Bottom line heading when it has one."""
    try:
        with open(path, errors="replace") as f:
            lines = [ln.strip() for ln in f.read(40000).splitlines()]
    except OSError:
        return "", ""
    title = next((ln.lstrip("# ").strip() for ln in lines if ln.startswith("# ")), "")
    start = next((i + 1 for i, ln in enumerate(lines) if ANSWER.match(ln)), 0)
    body = ""
    for ln in lines[start:]:
        if ln.startswith("#") and body:
            break
        if not ln or ln.startswith(("#", ">", "Scope", "No PR", "|", "---")):
            continue
        bullet = re.sub(r"^([-*]|[0-9]+[.)])\s+", "", ln)
        body = f"{body} {bullet}".strip()
        if len(body) >= 70 and not body.endswith(":"):
            break
    return title, re.sub(r"[*`]", "", body)[:240]


REGISTERED_FILE = os.path.expanduser("~/.local/state/rexpad/firstmate.registered.json")


def preregister(art, host, b):
    """Register a scout's artifact with its Library in the background, once, so opening it later is instant."""
    item = (host + ":" if host else "") + hashlib.sha256(art.encode()).hexdigest()[:12]
    if any(a.get("id") == item for a in b.artifacts):
        return
    try:
        with open(REGISTERED_FILE) as f:
            tried = json.load(f)
    except (OSError, ValueError):
        tried = {}
    if tried.get(item, 0) > datetime.now().timestamp() - 86400:
        return
    tried[item] = int(datetime.now().timestamp())
    try:
        with open(REGISTERED_FILE + ".tmp", "w") as f:
            json.dump({k: v for k, v in tried.items() if v > datetime.now().timestamp() - 7 * 86400}, f)
        os.replace(REGISTERED_FILE + ".tmp", REGISTERED_FILE)
        subprocess.Popen([os.path.expanduser("~/.local/bin/fm-todo-open"), act("artifact/register", file=art, host=host)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def scout_items(out, b):
    """Reports a finished scout left behind, as New for you until seen: firstmate need not close its line for you to see them."""
    import glob
    newest = {}
    for pattern in SCOUT_REPORTS:
        for path in glob.glob(os.path.expanduser(pattern)):
            try:
                at = os.path.getmtime(path)
            except OSError:
                continue
            folder = os.path.basename(os.path.dirname(path))
            if at > datetime.now().timestamp() - SCOUT_DAYS * 86400 and at > newest.get(folder, (0, ""))[0]:
                newest[folder] = (at, path)
    live = [t["slug"] for t in b.tasks.values() if t.get("block") and t.get("slug")]
    for folder, (at, path) in newest.items():
        if any(folder == slug or folder.endswith("-" + slug) for slug in live):
            continue
        title, body = report_summary(path)
        home = re.search(r"remote-secondmates/([^/]+)/|firstmate-([^/]+)/data", path)
        home = (home[1] or home[2]) if home else "fm"
        remote = re.search(r"remote-secondmates/([^/]+)/data/", path)
        if remote:
            art, host = f"/home/{os.environ.get('USER') or 'gnohj'}/.local/share/firstmate-{remote[1]}/data/{folder}/artifact.html", "dev-box"
        else:
            art, host = os.path.join(os.path.dirname(path), "artifact.html"), ""
        has_art = remote or os.path.exists(art)
        if has_art:
            preregister(art, host, b)
        extra = [link("{{artifact:blue}}", act("artifact", file=art, host=host), "[A]")] if has_art else []
        extra.append(link("{{report:blue}}", act("report", file=path), "[o]"))
        out["new"].append(new_item(
            title=f"Scout finished: {outside(title or folder)}", badge="{{🔭 fm:magenta}}", qid=f"scout:{folder}", owner=home,
            lines=[f"| {outside(body)}"] if body else [], extra=extra, chat=(title or folder, folder), at=int(at)))


def jira_items(out):
    """Comments and status moves others made on your tickets, from the Library's Jira activity, under New for you."""
    state = load("jira-activity.json", {})
    if state.get("error"):
        out["needs"].append(new_item(
            title="Jira stopped answering the Library", badge="{{jira:blue}}", custom=True,
            lines=[f"| {{{{{defuse(str(state['error']))}:red.}}}}",
                   "| If the API token expired, make a new one at id.atlassian.com, update JIRA_API_TOKEN, then run `library.py save-jira-env`."]))
    for x in state.get("items", []):
        if not str(x.get("url", "")).startswith("https://"):
            continue
        key, who = outside(str(x.get("key", ""))), outside(str(x.get("who", "")))
        verb = "commented on" if x.get("kind") == "comment" else "moved"
        out["new"].append(new_item(
            title=f"{who} {verb} {key}", badge="{{jira:blue}}", qid=f"jira:{x.get('id')}", key=key,
            refs=[ticket_link(key)] + ([tint(outside(str(x.get("summary", ""))))] if x.get("summary") else []),
            chips=["{{@you:yellow.}}"] if x.get("mention") else [], lines=[f"| {outside(str(x.get('text', '')))}"],
            extra=[link("{{open:blue}}", x["url"], "[o]")], chat=(f"{who} {verb} {key}", key), at=int(x.get("at") or 0)))


def next_standup(now):
    d = datetime.fromtimestamp(now).replace(minute=0, second=0, microsecond=0)
    for days in range(8):
        day = d + timedelta(days=days)
        if day.weekday() < 5 and day.replace(hour=23) > datetime.fromtimestamp(now):
            return day.replace(hour=23).strftime("%a %H:%M")
    return ""


def bar(badge_, title, right=(), meta="", below=(), details=()):
    """A pinned one-item bar: tag, title and right-aligned buttons, then an optional status line, a button row and folded details."""
    rows = [f"- [ ] {badge_} {title}" + (f"\t{' '.join(buttons(list(right)))}" if right else "")]
    if meta:
        rows.append("  : " + meta)
    if below:
        rows.append("  : " + " ".join(buttons(list(below))))
    return rows + [f"  > {defuse(d)}" for d in details]


def slack_bar():
    """The Slack sweep's state, pinned at the foot over the review and standup bars."""
    sl = inbox_state("slack.json")
    status = sl.get("status") or {}
    if status.get("running"):
        title, meta = "sweeping…", ""
    elif status.get("connected") is False or status.get("error"):
        title = "not connected" if status.get("connected") is False else "sweep failed"
        meta = f"{{{{{defuse(str(status.get('error') or 'not connected'))}:red.}}}}"
    else:
        title = f"swept {datetime.fromtimestamp(sl['last_at']).strftime('%H:%M')}" if sl.get("last_at") else "not swept yet"
        meta = ""
    duty = [f"on call: {o.get('role')} @{outside(str(o.get('group', '')))}" for o in sl.get("oncall") or []
            if isinstance(o, dict) and o.get("role") in ("primary", "secondary")]
    if duty:
        meta = join_meta([f"{{{{{d}:yellow.}}}}" for d in duty] + ([meta] if meta else []))
    check = [link("{{check now:magenta}}", act("slack/check"), "[K]")]
    return ["\n# {pin:bottom}", *bar("{{slack:red}}", title, check, meta)]


def standup_bar():
    """The standup draft, pinned at the foot of the Inbox; its bullets fold under the title."""
    st = inbox_state("standup.json")
    md = os.path.join(INBOX, "standup.md")
    try:
        draft = [ln for ln in open(md).read().splitlines() if ln.strip()]
        edited = abs(os.path.getmtime(md) - (st.get("mtime") or 0)) > 1
    except OSError:
        draft, edited = [], False
    now = datetime.now().timestamp()
    meta = join_meta(["writing a new draft…" if st.get("running") else f"written {clock(st.get('at'))}" if st.get("at") else "no draft yet",
                      "edited" if edited else "", f"next {next_standup(now)}",
                      f"{{{{{defuse(st['error'])}:yellow.}}}}" if st.get("error") else ""])
    right = ([link("{{copy:green}}", act("standup/copy"), "[C]")] if draft else []) + [
        link("{{edit:blue}}", act("standup/edit"), "[E]"), link("{{write now:blue}}", act("standup/write"), "[W]")]
    title = "Standup"
    if st.get("date"):
        day = datetime.strptime(st["date"], "%Y-%m-%d") + timedelta(days=1)
        while day.weekday() >= 5:
            day += timedelta(days=1)
        title = f"{day:%A} standup · covers {st['label']}"
    return ["\n# {pin:bottom}", *bar("{{standup:green}}", title, meta=meta, below=right, details=draft)]


def item_lines(it, b, section, at=0):
    task = it["task"]
    box = "[x]" if it["done"] else "[~]" if b.states.get(task.get("block", "")) == "working" else "[ ]"
    head = f"- {box} {badge(it, section)} {defuse(it['title'])}" + (f" {it['flag']}" if it["flag"] else "")
    head += "".join(f" {{f:{c}}}" for c in categories(it, section)) if section in WORK_SECTIONS else ""
    if at:
        head += f"\t`{{ago:{at}}}`"
    chg = changes(task, it["pr"]) if task.get("wt") else ""
    chips = [] if section == "done" and not it["custom"] else it["chips"] + ([f"{{{{± {chg}:blue.}}}}"] if chg else [])
    meta = join_meta([as_text(r) for r in it["refs"]] + [it["owner"]] + chips)
    rows = [head, "  : " + meta, *("  " + ln for ln in it["lines"]), "  : " + " ".join(buttons(actions(it, section, b)))]
    return rows + ["  " + d for d in it["details"]]


def stamp_items(out, now):
    """When each item last changed - firstmate's text, or its CI, approvals and action chips - kept across redraws."""
    path = os.environ.get("FM_TODO_STAMPS", "")
    try:
        with open(path) as f:
            old = json.load(f)
    except (OSError, ValueError):
        old = {}
    new, ages = {}, {}
    for section, items in out.items():
        for it in items:
            ident = f"{section}\t{it['key']}\t{it['pr']}\t{plain_text(it['title'])}"
            body = [plain_text(x) for x in it["refs"] + it["chips"] + [it["action"]] + it["lines"] + it["details"] if "{{answered" not in x]
            fp = hashlib.sha1("\n".join(body).encode()).hexdigest()[:12]
            prev = old.get(ident) or {}
            at = prev["at"] if prev.get("fp") == fp and prev.get("at") else now
            new[ident] = {"fp": fp, "at": at}
            ages[id(it)] = at
    if path:
        try:
            with open(path + ".tmp", "w") as f:
                json.dump(new, f)
            os.replace(path + ".tmp", path)
        except OSError:
            pass
    return ages


def board_tab(raw, b):
    out = {name: [] for name, _, _ in SECTIONS}
    for lv, items in enumerate(board(raw, b)):
        for it in items:
            it["level"] = lv
            out[place(it, lv, b)].append(it)
    stuck_panes(out, b)
    my_pr_items(out, b)
    unlisted_tasks(out, b)
    add_prompts(out, b)
    slack_items(out)
    jira_items(out)
    scout_items(out, b)
    out["requests"] = review_items(b)
    ages = stamp_items(out, int(datetime.now().timestamp()))
    ages.update({id(it): it["at"] for items in out.values() for it in items if it["at"]})
    flag_stale(out, ages, b)
    for name in SEEN_SECTIONS:
        out[name] = [it for it in out[name] if b.seen.get(seen_key(it)[0], {}).get("fp") != seen_key(it)[1]]
    notify_new(out)
    inbox, work = [], []
    for name, title, color in SECTIONS:
        items = sorted(out[name], key=lambda it: (it["draft"], not it["flag"], -ages.get(id(it), 0)))
        if not items:
            continue
        lines = work if name in WORK_SECTIONS else inbox
        lines.append(f"\n# {title} · {len(items)} {{{color}}}" + (" {folded}" if name == "done" else ""))
        for it in items:
            lines += item_lines(it, b, name, ages.get(id(it), 0))
    return inbox + slack_bar() + review_ask_bar(b) + standup_bar(), work


CATEGORY_ORDER = {"new": 0, "indeterminate": 1, "done": 2}


def needs_reviews(b):
    """Your open PRs still short of approvals, by the Library's rule: not a draft, ticket started, under the repo's required count."""
    out = []
    for name, pr in sorted(b.my_prs.items()):
        st = b.status.get(name, {})
        lead = next((t for t in pr.get("jira") or [] if isinstance(t, dict)), {})
        if pr.get("draft") or st.get("is_draft") or lead.get("category") == "new":
            continue
        have, need = st.get("approvals") or 0, b.required.get(pr.get("repo"), 1)
        if have < need:
            out.append((name, pr, have, need))
    return out


def review_ask_bar(b):
    """A pinned bar over the standup one: the PRs needing dev review, and Y copies the ask for Slack."""
    prs = needs_reviews(b)
    if not prs:
        return []
    copy = [link("{{copy ask:green}}", act("reviews/copy", prs=",".join(n for n, *_ in prs)), "[Y]")]
    rows = [f"{repo_label(pr.get('repo', ''))} #{pr.get('number')} {pr_title(pr)} · {have}/{need}" for _, pr, have, need in prs]
    title = f"{len(prs)} PR{'s' if len(prs) != 1 else ''} need dev review"
    return ["\n# {pin:bottom}", *bar("{{review:magenta}}", title, right=copy, details=rows)]


def tickets_tab(b):
    """The Library's Mine filter (assignee or Developer is you, open sprint, not done) by Jira status, whoever holds it now."""
    groups = {}
    for key, t in (b.jira if b.sprint is None else b.sprint).items():
        groups.setdefault(t.get("name") or "No status", []).append((key, t))
    lines = []
    for status in sorted(groups, key=lambda s: (CATEGORY_ORDER.get(groups[s][0][1].get("category"), 1), s)):
        rows = sorted(groups[status], key=lambda kt: kt[0])
        done = rows[0][1].get("category") == "done"
        lines.append(f"\n# {status} · {len(rows)} " + ("{green} {folded}" if done else "{blue}"))
        for key, t in rows:
            summary = defuse(" ".join(str(t.get("summary") or key).split()))
            comps = []
            if m := re.match(r"^\[([^\]]+)\]\s*", summary):
                comps, summary = [c.strip() for c in m[1].split(",")], summary[m.end():]
            pr = b.pr_for(key, merged=True)
            task = b.tasks.get(key) or b.tasks.get(pr) or {}
            chips = b.jira_meta(key)[1:]
            if comps:
                more = f" +{len(comps) - 1}" if len(comps) > 1 else ""
                chips.append(f"{{{{{comps[0]}{more}:{COMPONENT_COLORS.get(comps[0], 'blue')}.}}}}")
            if state := b.states.get(task.get("block", "")):
                label = {"done": "idle", "blocked": "needs you"}.get(state, state)
                chips.append(f"{{{{{label}:{'red' if state in ('blocked', 'error') else 'cyan'}.}}}}")
            extra = [] if task or pr or key not in {t.get("key") for t in b.tickets} else [link("{{start:green}}", act("start", key=key), f"Start {key}? Firstmate dispatches a crewmate.")]
            it = new_item(title=summary, glyph=crew_mark(task), badge="{{merged:green}}" if pr and pr not in b.my_prs and not task else "", refs=[ticket_link(key)] + ([pr_link(*pr.partition("#")[::2])] if pr else []),
                          chips=chips, task=task, pr=pr, key=key, extra=extra, chat=(summary, key), done=t.get("category") == "done",
                          owner=b.owner_of(key, pr, comps[0] if comps else ""))
            lines += item_lines(it, b, "tickets")
    return lines


OUTPUT_SKIP = {"System Resource Report", "Claude Billing Watch"}
OUTPUT_OLDER = 40


def outputs_tab(b):
    now = datetime.now(timezone.utc)
    today = now.astimezone().date()
    live, day, week, older = [], [], [], []
    for a in sorted(b.artifacts, key=lambda a: str(a.get("updated") or ""), reverse=True):
        url = a.get("https_url") or ""
        project = (a.get("project") or {}).get("name") or ""
        if not url.startswith("https://") or not a.get("exists") or a.get("path") in b.hidden or project in OUTPUT_SKIP:
            continue
        try:
            when = datetime.fromisoformat(str(a.get("updated")).replace("Z", "+00:00"))
        except ValueError:
            continue
        title = defuse(" ".join(str(a.get("title") or "").split())) or "Untitled"
        m = re.match(rf"^\[?({TICKET})\]?\s*[-:·]?\s*", title)
        key = m[1] if m else ""
        if m:
            title = title[m.end():]
        pr = re.search(r"\s*#(\d+)$", title)
        repo = a.get("pr_repo") or {"Inferno": REPOS["inferno"], "Web": REPOS["web"]}.get(project, "")
        if pr:
            title = title[:pr.start()]
        is_live = a.get("status") == "open" and (now - when).total_seconds() < 86400
        acts = [link("{{open:blue}}", url, "[o]")]
        if not is_live and a.get("lifecycle") == "reopenable" and str(a.get("action_url") or "").startswith("https://"):
            acts.append(link("{{reopen:green}}", a["action_url"], "[R]"))
        meta = [ticket_link(key)] if key else []
        if pr and repo:
            meta.append(pr_link(repo, pr[1]))
        if project:
            meta.append(f"{{{{{project}:{COMPONENT_COLORS.get(project.lower(), 'blue')}.}}}}")
        if ago := since(a.get("updated")):
            meta.append(ago)
        meta.append("{{Live:green.}}" if is_live else "Ended" if a.get("status") == "ended" else "")
        owner = b.owner_of(key, f"{repo}#{pr[1]}" if pr and repo else "", project)
        meta.insert(len(meta) - 2 if len(meta) >= 2 else len(meta), owner)
        row = [f"- [ ] {{{{🚢 fm:green}}}} {title}", "  : " + join_meta(meta), "  : " + " ".join(buttons(acts))]
        if is_live:
            live.append(row)
        elif when.astimezone().date() == today:
            day.append(row)
        elif (now - when).days < 7:
            week.append(row)
        elif len(older) < OUTPUT_OLDER:
            older.append(row)
    out = []
    for title, items, tag in (("Live", live, "{green}"), ("Today", day, "{cyan}"), ("This week", week, "{folded}"),
                              ("Older", older, "{folded}")):
        if items:
            out += ["", f"# {title} · {len(items)} {tag}", *(ln for row in items for ln in row)]
    return out


def render_tabs(raw, b):
    """The Inbox holds what wants you, Work the ongoing PRs and tasks, Tickets every sprint ticket by status."""
    inbox, work = board_tab(raw, b)
    tabs = {"board": inbox, "work": work, "tickets": tickets_tab(b), "outputs": outputs_tab(b)}
    return {name: "\n".join(lines).strip() + "\n" if lines else "" for name, lines in tabs.items()}


if __name__ == "__main__":
    raw = sys.stdin.read() if not sys.stdin.isatty() else ""
    tabs = render_tabs(raw, Board(os.environ.get("TASKS", ""), os.environ.get("LAVISH", "")))
    if sys.argv[1:2] == ["--tabs-dir"]:
        os.makedirs(sys.argv[2], exist_ok=True)
        for name, text in tabs.items():
            if name != "board":
                with open(os.path.join(sys.argv[2], name + ".md"), "w") as f:
                    f.write(text)
    sys.stdout.write(tabs["board"])
