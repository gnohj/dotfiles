#!/usr/bin/env bash
# Report the fleet's account and home state: what is true on disk, what the live session holds, and which is which.
set -u

# Never inherit FM_HOME: a session older than a home rename holds a dead path and children would follow it.
export FM_HOME="$HOME/.local/share/firstmate"

HOME_DIR="$HOME/.local/share/firstmate"
PIN_FILE="$HOME/.local/state/claude/account-override"
b() { printf '\033[1m%s\033[0m\n' "$1"; }
kv() { printf '  %-26s %s\n' "$1" "$2"; }
sha256_digest() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi; }
fp() { [ -n "${1:-}" ] && printf '%s' "$1" | sha256_digest | cut -c1-12 || printf 'none'; }
# BSD ps carries the environment, procfs does elsewhere; this repo runs on both.
proc_env() { # <pid> -> its environment, one VAR=value per line
  if [ "$(uname)" = Darwin ]; then
    ps -Eww -p "$1" -o command= 2>/dev/null | tr ' ' '\n'
  else
    tr '\0' '\n' <"/proc/$1/environ" 2>/dev/null
  fi
}

age() { [ -f "$1" ] && echo "$(( $(date +%s) - $(stat -f %m "$1" 2>/dev/null || stat -c %Y "$1") ))s" || echo "absent"; }

# Matching only "claude" reported every pi, codex or cursor worker as dead; this is the full verified adapter list.
agent_pid() { # herdr process-info json on stdin -> "<pid> <argv0>" of the first agent found
  python3 -c '
import json, os, sys
AGENTS = {"claude","pi","pi-signed","codex","opencode","grok","kimi","cursor","omp","muse","gemini","rovo","agy"}
try: d = json.load(sys.stdin)
except Exception: sys.exit(0)
for x in d.get("result", {}).get("process_info", {}).get("foreground_processes", []):
    argv = x.get("argv") or []
    # The payload carries name/argv/cmdline and no argv0 at all, so the old argv0 test could never match.
    for cand in (x.get("name"), os.path.basename(argv[0]) if argv else None):
        if cand in AGENTS:
            print(x["pid"], cand); sys.exit(0)' 2>/dev/null
}

sshq() { ssh -n -o ConnectTimeout=10 -o BatchMode=yes "$@" 2>/dev/null; }
safe_remote_value() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._:@-]*$ ]]; }
remote_proc_env() {
  safe_remote_value "$1" && [[ "$2" =~ ^[0-9]+$ ]] || return 2
  sshq "$1" "if [ \"\$(uname)\" = Darwin ]; then ps -Eww -p '$2' -o command= 2>/dev/null | tr ' ' '\\n'; else tr '\\0' '\\n' < '/proc/$2/environ' 2>/dev/null; fi"
}

b "FLEET (on disk - true from anywhere)"
kv "home" "$HOME_DIR $([ -d "$HOME_DIR" ] && echo "(exists)" || echo "(MISSING)")"
kv "size" "$(du -sh "$HOME_DIR" 2>/dev/null | cut -f1)"
kv "session lock" "$(head -1 "$HOME_DIR/state/.lock" 2>/dev/null || echo 'not held')"
kv "watcher beacon" "$(age "$HOME_DIR/state/.last-watcher-beat") old"
kv "queued wakes" "$([ -r "$HOME_DIR/state/.wake-queue" ] && wc -l < "$HOME_DIR/state/.wake-queue" | tr -d ' ' || printf 0)"
if [ -e "$HOME/.local/share/firstmate-work" ]; then
  n=$(find "$HOME/.local/share/firstmate-work" -type f 2>/dev/null | wc -l | tr -d ' ')
  kv "retired name" "PRESENT with $n file(s) - recreated by a pre-rename process; empty is harmless, non-empty is not"
else
  kv "retired name" "gone"
fi

echo
b "ACCOUNT (who pays)"
pin=$(claude-account pin 2>/dev/null || echo '?')
kv "pin" "$pin"
kv "pin file" "$PIN_FILE $([ -f "$PIN_FILE" ] && echo '(present)' || echo '(absent = auto)')"
resolved=$(env -u CLAUDE_ACCOUNT claude-account resolve 2>/dev/null || echo unresolved)
selected_dir=$(CLAUDE_ACCOUNT="$resolved" claude-account dir 2>/dev/null || true)
origin=pin; [ "$pin" = auto ] && origin=repository
kv "a new agent would use" "$resolved (from $origin)"
kv "its state store" "${selected_dir:-$HOME/.claude (native)}"
kv "this shell's state" "${CLAUDE_CONFIG_DIR:-native}"
kv "work token" "$(fp "$(CLAUDE_ACCOUNT=work claude-account token 2>/dev/null)")"
kv "personal token" "$(fp "$(CLAUDE_ACCOUNT=personal claude-account token 2>/dev/null)")"

echo
b "QUOTA (5h / 7d used)"
for a in work personal; do
  read -r _ w5 _ w7 _ <<<"$(claude-account usage "$a" 2>/dev/null)"
  kv "$a" "$(awk -v a="${w5:-}" -v b="${w7:-}" 'BEGIN{if(a=="")print "unknown"; else printf "%d%% / %d%%", a*100, b*100}')"
done

echo
b "SECOND MATES"
if [ -f "$HOME_DIR/data/secondmates.md" ]; then
  while IFS= read -r line; do
    case "$line" in "- "*) ;; *) continue ;; esac
    id=${line#- }; id=${id%% *}
    mh=$(printf '%s' "$line" | sed -n 's/.*home: \([^;)]*\).*/\1/p')
    meta="$HOME_DIR/state/$id.meta"
    # A remotely placed mate records remote_target and remote_host; only a local one records herdr_pane_id.
    rhost=$(grep -m1 '^remote_host=' "$meta" 2>/dev/null | cut -d= -f2-)
    if [ -n "${rhost:-}" ]; then
      # remote_target is "<session>:<pane>" and that session has its own herdr socket, so the session must be named or the pane is not found.
      rsess=$(grep -m1 '^remote_herdr_session=' "$meta" 2>/dev/null | cut -d= -f2-)
      pane=$(grep -m1 '^remote_target=' "$meta" 2>/dev/null | cut -d= -f2-)
      [ -z "${rsess:-}" ] && rsess=${pane%%:*}
      pane=${pane#"$rsess":}
    else
      pane=$(grep -m1 '^herdr_pane_id=' "$meta" 2>/dev/null | cut -d= -f2-)
    fi
    if [ -z "${pane:-}" ]; then
      kv "$id" "NO ENDPOINT RECORDED  home=${mh:-?}"
      continue
    fi
    if [ -n "${rhost:-}" ] && { ! safe_remote_value "$rhost" || ! safe_remote_value "$rsess" || ! safe_remote_value "$pane"; }; then
      kv "$id" "INVALID REMOTE ENDPOINT  home=${mh:-?}"
      continue
    fi
    if [ -n "${rhost:-}" ]; then
      out=$(sshq "$rhost" "herdr --session '$rsess' pane process-info --pane '$pane'"); rc=$?
    else
      out=$(herdr pane process-info --pane "$pane" 2>/dev/null); rc=$?
    fi
    pid=""; argv0=""
    read -r pid argv0 <<<"$(printf '%s' "$out" | agent_pid)"
    [[ "${pid:-}" =~ ^[0-9]+$ ]] || pid=""
    if [ -z "${pid:-}" ]; then
      # An unreachable host is unknown, not dead; saying NO LIVE AGENT there is a lie that invites a wrong relaunch.
      if [ -n "${rhost:-}" ] && { [ "$rc" -ne 0 ] || [ -z "$out" ]; }; then
        kv "$id" "UNREACHABLE  host=$rhost pane=$pane home=${mh:-?}"
      else
        kv "$id" "NO LIVE AGENT  pane=$pane home=${mh:-?}"
      fi
    else
      if [ -n "${rhost:-}" ]; then
        tok=$(remote_proc_env "$rhost" "$pid" | sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' | head -1)
      else
        tok=$(proc_env "$pid" | sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' | head -1)
      fi
      kv "$id" "alive ${argv0:-?} pane=${rhost:+$rsess:}$pane${rhost:+ @$rhost} token=$(fp "${tok:-}")$([ -z "${tok:-}" ] && echo ' (state-dir credential)')"
    fi
  done < "$HOME_DIR/data/secondmates.md"
else
  kv "registry" "absent"
fi

echo
b "LOCAL PATCHES"
P="$HOME/Developer/agents/shared/skills/firstmate-patch/fm-patch.sh"
[ -x "$P" ] && "$P" status 2>&1 | sed 's/^/  /' || kv "fm-patch.sh" "not found"

echo
b "THIS SHELL (only meaningful inside a fleet session)"
kv "FM_HOME" "${FM_HOME:-<unset>}"
kv "CLAUDE_CONFIG_DIR" "${CLAUDE_CONFIG_DIR:-<unset>}"
kv "CLAUDE_ACCOUNT" "${CLAUDE_ACCOUNT:-<unset>}"
kv "token in env" "$(fp "${CLAUDE_CODE_OAUTH_TOKEN:-}")"
if [ -z "${FM_HOME:-}" ]; then
  echo "  note: this is a bare shell, not a fleet session - the four values above are"
  echo "        expected to be empty and say nothing about the running fleet."
fi
