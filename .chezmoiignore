.config/devbox-host

# --- Theme ownership: Omarchy vs. colorscheme-set.sh ----------------------
# These four are shipped by Omarchy wired into ITS theme engine
# (`~/.local/state/omarchy/current/theme/*`, repointed by `omarchy theme set`).
# The repo's copies are wired into colorscheme-set.sh instead. Only one engine
# can own a file, and applying the repo's copy silently retires `omarchy theme
# set` for that terminal.
#
# DEFAULT BELOW: the repo wins (this box matches the Mac; `omarchy theme set`
# stops theming the terminals). To hand a file back to Omarchy instead, move it
# ABOVE this comment so it is ignored — Omarchy's copy then stays untouched.
#   .config/ghostty/config
#   .config/kitty/kitty.conf
#   .config/btop/btop.conf
#   .config/tmux/tmux.conf
{{- end }}

