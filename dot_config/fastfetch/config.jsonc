{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // sesh startup cmds won't work with fast fetch custom images
  // https://github.com/joshmedeski/sesh/discussions/254
  // fyi: it will work with the default mac os image.. so comment this out for now
  "logo": {
    // If working with tmux, you need to use kitty-icat instead of kitty-direct
    // https://discord.com/channels/1005603569187160125/1324828708128821271/1327261766014599218
    "type": "kitty-icat",
    "source": "~/.config/fastfetch/images/gundamg.png",
    "height": 18,
    "width": 30,
    "position": "left",
    "padding": {
      "top": 6,
      "right": 3,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "┌─────────────Hardware─────────────┐",
      "outputColor": "cyan",
    },
    {
      "type": "host",
      "key": " PC ",
      "keyColor": "red",
    },
    {
      "type": "cpu",
      "key": "│ ├ ",
      "keyColor": "red",
    },
    {
      "type": "gpu",
      "key": "│ ├󰒆 ",
      "keyColor": "red",
      "format": "{name} ({core-count}) @ {frequency}",
    },
    {
      "type": "disk",
      "key": "│ ├ ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "keyColor": "red",
    },
    {
      "type": "swap",
      "key": "│ ├SW",
      "keyColor": "red",
    },
    {
      "type": "display",
      "key": "│ ├ ",
      "keyColor": "red",
      "format": "MONITOR ({name})",
      // "format": "MONITOR ({name}) {width}x{height} @ {refresh-rate} Hz - {physical-width}x{physical-height} mm ({inch} inches, {ppi} ppi)",
    },
    {
      "type": "memory",
      "key": "└ └󰍛 ",
      "keyColor": "red",
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────┘",
      "outputColor": "cyan",
    },
    {
      "type": "custom",
      "format": "┌─────────────Software─────────────┐",
      "outputColor": "cyan",
    },
    {
      "type": "os",
      "key": "􀣺 OS ",
      "keyColor": "green",
      "format": "{name} {codename} {version}",
    },
    {
      "type": "kernel",
      "key": "│ ├ ",
      "keyColor": "green",
    },
    // Brew lines scan only brew; nix counts come cached from nix-packages.sh, since that scan costs ~160ms.
    {
      "type": "packages",
      "key": "│ ├󰏖 ",
      "keyColor": "green",
      "disabled": ["am", "apk", "appimage", "cards", "choco", "crux", "dpkg", "emerge", "eopkg", "flatpak", "guix", "hpkg", "installrelease", "kiss", "linglong", "lpkg", "lpkgbuild", "macports", "moss", "mport", "nix", "opkg", "pacman", "pacstall", "paludis", "pisi", "pkg", "pkgsrc", "pkgtool", "porg", "rpm", "rum", "scoop", "snap", "soar", "sorcery", "winget", "xbps"],
      "format": "{brew} (brew)",
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 ",
      "keyColor": "green",
      "disabled": ["am", "apk", "appimage", "cards", "choco", "crux", "dpkg", "emerge", "eopkg", "flatpak", "guix", "hpkg", "installrelease", "kiss", "linglong", "lpkg", "lpkgbuild", "macports", "moss", "mport", "nix", "opkg", "pacman", "pacstall", "paludis", "pisi", "pkg", "pkgsrc", "pkgtool", "porg", "rpm", "rum", "scoop", "snap", "soar", "sorcery", "winget", "xbps"],
      "format": "{brew-cask} (brew-cask)",
    },
    {
      "type": "command",
      "key": "│ ├󰏖 ",
      "keyColor": "green",
      "text": "$HOME/.config/fastfetch/nix-packages.sh system",
      "format": "{result} (nix-system)",
    },
    {
      "type": "command",
      "key": "│ ├󰏖 ",
      "keyColor": "green",
      "text": "$HOME/.config/fastfetch/nix-packages.sh default",
      "format": "{result} (nix-default)",
    },
    {
      "type": "localip",
      "key": "│ ├IP",
      "keyColor": "green",
    },
    {
      "type": "shell",
      "key": "└ └ ",
      "keyColor": "green",
    },
    // macOS has no DE, so the group header is the tiling WM.
    {
      "type": "command",
      "key": " WM ",
      "keyColor": "blue",
      "text": "if pgrep -x rift >/dev/null; then echo \"Rift $(rift --version | cut -d' ' -f2)\"; else echo none; fi",
    },
    {
      "type": "wm",
      "key": "│ ├ ",
      "keyColor": "blue",
    },
    {
      "type": "lm",
      "key": "│ ├ ",
      "keyColor": "blue",
    },
    // terminalfont reads nothing inside herdr, so the terminal closes the branch.
    {
      "type": "terminal",
      "key": "└ └ ",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────┘",
      "outputColor": "cyan",
    },
  ],
}
