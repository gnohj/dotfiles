#!/usr/bin/env bash
# rex-session-ctl - answers rex-session-picker.sh's session calls against Rex (ids as rex-snapshot.lua writes them); needs Rex Remote Control on.
set -uo pipefail

rex="${REX_BIN_DIR:+$REX_BIN_DIR/}rex"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() {
  printf '\n%s\n\nPress any key to close.' "$1"
  read -rsn1
  exit 1
}

app_try() {
  local client
  client=$(remote client ls --json 2>/dev/null | jq -r '[.clients[] | select(.info.kind == "app" and .info.platform != "ios" and .connection_state == "connected")] | max_by(.connected_at).client_id // empty')
  [ -n "$client" ] || die "No Rex desktop app is connected."
  out=$(remote do -C "$client" "$@" 2>&1)
}

app_do() {
  app_try "$@" || die "$out"
  moved
}

# Tells the picker popup focus went elsewhere, so it skips returning to the pane it opened from.
moved() {
  [ -z "${REX_POPUP_MOVED:-}" ] || echo 1 >"$REX_POPUP_MOVED"
}

# Key actions run on the Mac's server, so it alone keeps the session history; a Dev Box picker reaches it as the Mac host.
home_do() {
  local home=() client
  [ "$(uname)" = Darwin ] || home=(-S Mac)
  client=$("$rex" --autostart=false ${home[@]+"${home[@]}"} client ls --json 2>/dev/null | jq -r '[.clients[] | select(.info.kind == "app" and .info.platform != "ios" and .connection_state == "connected")] | max_by(.connected_at).client_id // empty')
  [ -z "$client" ] || "$rex" --autostart=false ${home[@]+"${home[@]}"} do -C "$client" "$@" >/dev/null 2>&1
}

# Splits a session id into $sid and the -S flags for its host: "<host>~<id>" lives on that `rex hosts` entry, a bare id here.
on_host() {
  sid="$1"
  server=()
  case "$1" in
    *"~"*)
      sid="${1#*~}"
      local label
      label=$("$rex" --autostart=false hosts --json 2>/dev/null | jq -r --arg t "${1%%~*}" 'first(.hosts[].host.label | select(gsub("[^A-Za-z0-9]"; "-") == $t)) // empty')
      [ -n "$label" ] || die "No Rex host matches ${1%%~*}."
      server=(-S "$label")
      ;;
  esac
}

server=()
remote() {
  "$rex" --autostart=false ${server[@]+"${server[@]}"} "$@"
}


# A cached picker row can name a closed session; the server says so in 30ms (the app's select stalls 5s), so exit 3 and rex-session-picker.sh re-resolves it.
select_session() {
  local live
  if live=$(remote api call session.list '{}' 2>/dev/null); then
    jq -e --arg s "session:$sid" 'any(.sessions[]?; .session_id == $s)' <<<"$live" >/dev/null || exit 3
  fi
  app_try session.select session_id="session:$sid" && { moved; return; }
  case "$out" in *SessionNotFound*) exit 3 ;; esac
  die "$out"
}

case "${1:-} ${2:-}" in
  "api snapshot")
    exec "$rex" --autostart=false do "$here/rex-snapshot.lua"
    ;;
  "workspace list")
    printf '{"result":{"workspaces":[]}}\n'
    ;;
  "workspace focus")
    on_host "$3"
    select_session
    ;;
  "workspace close")
    on_host "$3"
    # The picker's own session: go back to the last one first, else Rex lands on a neighbour once it is gone.
    [ "${#server[@]}" != 0 ] || [ "session:$sid" != "${REX_SESSION:-}" ] || home_do return_from_session session_id="$sid"
    remote kill "session:$sid" >/dev/null 2>&1
    ;;
  "tab focus")
    on_host "${3%%:*}"
    remote api call -s "session:$sid" session.focus_window "{\"window_id\":\"window:${3#*:}\"}" >/dev/null 2>&1
    select_session
    ;;
  "agent focus")
    on_host "${3%%:*}"
    remote focus -s "session:$sid" "block:${3#*:}" >/dev/null 2>&1
    select_session
    ;;
  "pane close")
    on_host "${3%%:*}"
    remote block close -s "session:$sid" "block:${3#*:}" >/dev/null 2>&1
    ;;
  "layout --entry")
    # A rex_host entry opens on that host as rex_label (else its name), its dir sent as ~/... so the host's own session_open resolves it.
    entry=$(python3 -B "$here/entries.py" | jq -c --arg n "$3" 'first(.[] | select(.name == $n)) // empty')
    [ -n "$entry" ] || die "No entries.toml entry named $3."
    host=$(jq -r '.rex_host // empty' <<<"$entry")
    [ -z "$host" ] || server=(-S "$host")
    args=$(jq -c --arg home "$HOME" '(.rex_host // "") as $pinned | {label: (.rex_label // .name), dir: (.path | if $pinned == "" and (. == "~" or startswith("~/")) then $home + .[1:] else . end | rtrimstr("/") | if . == "" then "/" else . end), startup: (.startup_command // "")}' <<<"$entry")
    app_do session_open --args "$args"
    ;;
  layout*)
    dir="${2%/}"
    app_do session_open --args "$(jq -cn --arg d "$dir" '{label: ($d | split("/") | last), dir: $d}')"
    ;;
  *)
    die "rex-session-ctl: unsupported call: $*"
    ;;
esac
