# Path activation for the herdr system-info feeder: run it only while the herdr socket
# exists. systemd starts herdr-sysinfo.service when the socket appears; the daemon exits
# when the socket disappears, and this unit restarts it when the socket reappears. Same
# socket-keyed lifecycle as the git-status poller and the focus tracker.
[Unit]
Description=Run herdr-sysinfo only while the herdr socket exists

[Path]
PathExists=%h/.config/herdr/herdr.sock

[Install]
WantedBy=default.target
