#!/usr/bin/env bash
# Claude Code SessionStart hook: record the session id per Rex pane, so csp's rex-recover relaunch resumes that exact conversation.
[ "${TERM_PROGRAM:-}" = rex ] || exit 0
case "${REX_BLOCK:-}" in block:*) ;; *) exit 0 ;; esac
case "$REX_BLOCK" in *[!a-zA-Z0-9:-]*) exit 0 ;; esac
id=$(jq -r '.session_id // empty' 2>/dev/null)
case "$id" in "" | *[!a-zA-Z0-9-]*) exit 0 ;; esac
dir=${XDG_STATE_HOME:-$HOME/.local/state}/claude-rex-sessions
mkdir -p "$dir" && printf '%s\n' "$id" >"$dir/${REX_BLOCK#block:}"
exit 0
