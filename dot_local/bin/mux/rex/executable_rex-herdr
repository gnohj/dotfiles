#!/usr/bin/env bash
# rex-herdr - answers herdr-sesh.sh's herdr calls against Rex (ids as rex-snapshot.lua writes them); needs Rex Remote Control on.
set -uo pipefail

rex="${REX_BIN_DIR:+$REX_BIN_DIR/}rex"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() {
  printf '\n%s\n\nPress any key to close.' "$1"
  read -rsn1
  exit 1
}

app_do() {
  local client out
  client=$(remote client ls --json 2>/dev/null | jq -r '[.clients[] | select(.info.kind == "app" and .connection_state == "connected")] | max_by(.connected_at).client_id // empty')
  [ -n "$client" ] || die "No Rex app is connected."
  out=$(remote do -C "$client" "$@" 2>&1) || die "$out"
}

# Splits a session id into $sid and the -S flags for its host: "<host>~<id>" lives on that `rex hosts` entry, a bare id here.
on_host() {
  sid="$1"
  server=()
  case "$1" in
    *"~"*)
      sid="${1#*~}"
      local label
      label=$("$rex" --autostart=false hosts --json 2>/dev/null | jq -r --arg t "${1%%~*}" 'first(.hosts[].host.label | select(gsub("[^A-Za-z0-9]"; "-") == $t)) // empty')
      [ -n "$label" ] || die "No Rex host matches ${1%%~*}."
      server=(-S "$label")
      ;;
  esac
}

server=()
remote() {
  "$rex" --autostart=false ${server[@]+"${server[@]}"} "$@"
}

# sesh.toml plus the Mac's Rex-only rex.toml, which sesh itself never reads.
rex_toml="$HOME/.config/sesh/rex.toml"

entries() {
  sesh list -c -j 2>/dev/null
  [ ! -f "$rex_toml" ] || sesh -C "$rex_toml" list -c -j 2>/dev/null
}

entry_key() {
  awk -v n="$1" -v k="$2" -F'"' 'FNR == 1 || /^\[/ {name = ""} $1 ~ /^name *= *$/ {name = $2} $1 ~ ("^" k " *= *$") && name == n {print $2; exit}' "$HOME/.config/sesh/sesh.toml" "$rex_toml" 2>/dev/null
}

select_session() {
  app_do session.select session_id="session:$sid"
}

case "${1:-} ${2:-}" in
  "api snapshot")
    exec "$rex" --autostart=false do "$here/rex-snapshot.lua"
    ;;
  "workspace list")
    printf '{"result":{"workspaces":[]}}\n'
    ;;
  "workspace focus")
    on_host "$3"
    select_session
    ;;
  "workspace close")
    on_host "$3"
    remote kill "session:$sid" >/dev/null 2>&1
    ;;
  "tab focus")
    on_host "${3%%:*}"
    remote api call -s "session:$sid" session.focus_window "{\"window_id\":\"window:${3#*:}\"}" >/dev/null 2>&1
    select_session
    ;;
  "agent focus")
    on_host "${3%%:*}"
    remote focus -s "session:$sid" "block:${3#*:}" >/dev/null 2>&1
    select_session
    ;;
  "pane close")
    on_host "${3%%:*}"
    remote block close -s "session:$sid" "block:${3#*:}" >/dev/null 2>&1
    ;;
  "layout --entry")
    # A rex_host entry opens on that host as rex_label (else its name), its dir sent as ~/... so the host's own sesh_open resolves it.
    host=$(entry_key "$3" rex_host)
    label=$(entry_key "$3" rex_label)
    [ -z "$host" ] || server=(-S "$host")
    args=$(entries | jq -sc --arg n "$3" --arg home "$HOME" --arg pinned "$host" --arg label "$label" \
      'first(add[] | select(.Name == $n) | {label: (if $label != "" then $label else .Name end), dir: (.Path | rtrimstr("/") | if . == "" then "/" elif $pinned != "" and startswith($home) then "~" + .[($home | length):] else . end), startup: .StartupCommand})')
    [ -n "$args" ] || die "No sesh.toml entry named $3."
    app_do sesh_open --args "$args"
    ;;
  layout*)
    dir="${2%/}"
    app_do sesh_open --args "$(jq -cn --arg d "$dir" '{label: ($d | split("/") | last), dir: $d}')"
    ;;
  *)
    die "rex-herdr: unsupported call: $*"
    ;;
esac
