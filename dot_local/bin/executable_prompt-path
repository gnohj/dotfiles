#!/usr/bin/env bash
# Single source of truth for the "where am I" bits in the starship prompt AND the
# Claude Code status line (ccstatusline), so the two always agree.
#
# PATH output (default) - two transforms:
#   1. Strip the container root (~/Developer, ~/.treehouse, ~/.local/share) so a
#      git worktree keeps its distinguishing parent - web/master,
#      master-130256/1/master, web/infra/IHRWEB-24278 - instead of collapsing to a
#      bare basename the way starship's truncate_to_repo does (every pool slot
#      rendered as an identical "review"/"master").
#   2. Keep only the TICKET-1234 prefix of the last component, so
#      IHRWEB-24278-release-automation renders as IHRWEB-24278. starship's
#      directory.substitutions are literal-only (no regex, verified on 1.26), so
#      this cannot live in the starship config.
#
# GIT-REF output (--git-ref) - branch name, or the short SHA when HEAD is detached.
# ccstatusline's built-in git-branch widget runs only `symbolic-ref --short HEAD`,
# which FAILS on a detached HEAD and renders a misleading "no git" - i.e. in every
# treehouse pool slot, since those are always detached.
#
#   prompt-path                                  # $PWD, plain
#   prompt-path <dir>                            # that dir
#   prompt-path --stdin-json                     # dir from a Claude status-line payload on stdin
#   prompt-path --git-ref [...]                  # branch-or-sha instead of the path
#   prompt-path --align N [...]                  # size the text so both rows' separators share a column, N = cap
#   prompt-path --trailing-sep [...]             # append " ·" - only when there IS something to show
#   prompt-path --color [...]                    # emit theme ANSI (needs preserveColors on the widget)
#   prompt-path --glyph [...]                    # prefix with 🌳 worktree / 🌿 plain repo / 📁 non-git (path mode only)
#   prompt-path --account-glyph [...]            # prefix with claude-account-glyph's 🏢/🏠 (--git-ref only)
#
# --stdin-json exists for ccstatusline: it pipes the session JSON to every
# custom-command widget (execSync `input:`) and never sets the child's cwd, so
# $PWD there is whatever directory Claude Code launched from, not the session's.
#
# --align is what lines the status line's two rows up. Row 1 is glyph + path + "·",
# row 2 is account glyph + ref + "·", and the separators share a column only if both fields are
# sized against the SAME number. The two widgets are separate processes with no shared
# state, so each computes BOTH widths from the one dir it was handed and derives the
# same target - deterministic, no coordination needed. The field grows only as far as
# the longer of the two actually needs (a fixed width left ~12 dead columns whenever
# the path was short) and stops at N, past which the value truncates instead.
#
# Two traps make the obvious approaches fail:
#   * ccstatusline .trim()s every custom-command's output, so TRAILING padding is
#     destroyed - the pad has to sit before the separator, which is why the "·" is
#     emitted here instead of as its own custom-text widget.
#   * a standalone custom-text "·" also renders when its neighbour resolves empty,
#     dangling in any non-repo directory. Emitting it here ties the two together.
#
# Widths are computed from the ASCII portion plus glyphs of known width, never from
# ${#s} on the whole string: the status line runs with no LANG (see claude-statusline)
# where bash counts BYTES, so "🌿 web" measures 8 and every pad overshoots. Setting
# LC_ALL here is not an option either - a box without that locale makes bash warn on
# stderr, which starship would leak into the terminal.

set -uo pipefail

ELLIPSIS='…'
LEADER_W=3

# Both rows lead with a 3-column prefix - row 1 the kind glyph, row 2 the account glyph - so both texts start in column 4 and --align only ever sizes the TEXT, never the leader.

mode=path
trailing_sep=0
color=0
glyph=0
account_glyph=0
align=0
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --git-ref) mode=git-ref ;;
    --account-glyph) account_glyph=1 ;;
    --trailing-sep) trailing_sep=1 ;;
    --color) color=1 ;;
    --glyph) glyph=1 ;;
    --align) shift; align="${1:-0}" ;;
    --align=*) align="${1#--align=}" ;;
    *) args+=("$1") ;;
  esac
  shift
done
[ "$align" -ge 0 ] 2>/dev/null || align=0

C_TEXT='' C_DIM='' C_RESET=''
if [ "$color" = 1 ]; then
  # Theme colours read from the live colorscheme, not hardcoded, so `theme` carries through.
  CS="$HOME/.config/colorscheme/active/active-colorscheme.sh"
  [ -r "$CS" ] && . "$CS" 2>/dev/null
  ansi() {
    local h="${1#\#}"
    [ "${#h}" -eq 6 ] || return 1
    printf '\033[38;2;%d;%d;%dm' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
  }
  if [ "$mode" = git-ref ]; then
    C_TEXT="$(ansi "${gnohj_color02:-#b7ce97}" 2>/dev/null)"
  else
    C_TEXT="$(ansi "${gnohj_color04:-#a3b8c6}" 2>/dev/null)"
  fi
  C_DIM="$(ansi "${gnohj_color13:-#536571}" 2>/dev/null)"
  C_RESET=$'\033[0m'
fi

dir=""
case "${args[0]:-}" in
  --stdin-json)
    payload="$(cat)"
    # .cwd FIRST to match ccstatusline's own resolveGitCwd precedence, so the path and the ref can never describe two different repos.
    if command -v jq >/dev/null 2>&1; then
      dir="$(printf '%s' "$payload" | jq -r '.cwd // .workspace.current_dir // .workspace.project_dir // empty' 2>/dev/null)"
    fi
    # jq-free fallback: the status line runs on a minimal PATH (see claude-statusline) that may not reach a jq on every box.
    [ -n "$dir" ] || dir="$(printf '%s' "$payload" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$dir" ] || dir="$(printf '%s' "$payload" | sed -n 's/.*"current_dir"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    ;;
  '') ;;
  *) dir="${args[0]}" ;;
esac
[ -n "$dir" ] || dir="$PWD"

# Both tildes are escaped: bash tilde-expands a replacement string and a `#` pattern, so a bare ~ would expand straight back to /home/<user> and nothing would strip.
d="${dir/#$HOME/\~}"
d="${d#\~/Developer/}"
d="${d#\~/.treehouse/}"
d="${d#\~/.local/share/}"

b="${d##*/}"
if [[ $b =~ ^([A-Z]+-[0-9]+) ]]; then
  t="${BASH_REMATCH[1]}"
  if [[ $b == "$d" ]]; then d="$t"; else d="${d%/*}/$t"; fi
fi
path_w=${#d}

# Resolved even in path mode: --align needs both widths to pick one shared column.
ref=''
ref_w=0
# 📁 non-git, per herdr's vocabulary - it also keeps row 1's leader 3 columns wide outside a repo, so the two rows' text never falls out of step.
kind_glyph='📁'
inside='' gd='' gcd='' head_ref=''
if command -v git >/dev/null 2>&1 && [ -d "$dir" ]; then
  # One call for every git fact (five overran starship's timeout on a cold spawn); --path-format=absolute resolves symlinks for both dirs like the old pwd -P pair.
  info="$(git -C "$dir" rev-parse --path-format=absolute --is-inside-work-tree --git-dir --git-common-dir --abbrev-ref HEAD 2>/dev/null)"
  # --abbrev-ref, never a bare HEAD: it holds the output at 4 lines - a bare HEAD emits nothing on an unborn branch and silently shifts these fields.
  { read -r inside; read -r gd; read -r gcd; read -r head_ref; } <<<"$info"
fi
if [ "$inside" = true ]; then
  ref="$head_ref"
  # "HEAD" means detached (every treehouse pool slot) or unborn - the short SHA answers the first, symbolic-ref still names the branch for the second.
  if [ "$ref" = HEAD ]; then
    ref="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
    [ -n "$ref" ] || ref="$(git -C "$dir" symbolic-ref --short HEAD 2>/dev/null)"
  fi
  [ -n "$ref" ] && ref_w=${#ref}
  if [ -n "$gd" ] && [ -n "$gcd" ] && [ "$gd" != "$gcd" ]; then
    kind_glyph='🌳'
  else
    kind_glyph='🌿'
  fi
fi

# $pad is the TEXT width both rows share, so their separators land in one column.
pad=0
if [ "$align" -gt 0 ]; then
  fit_path=$((path_w < align ? path_w : align))
  fit_ref=$((ref_w < align ? ref_w : align))
  pad=$((fit_path > fit_ref ? fit_path : fit_ref))
fi

# Slices only the ASCII body, never the composed string: bash counts BYTES here (no LANG), so cutting across the multibyte prefix or ellipsis would split one in half.
emit() {
  local pre="$1" lead_extra="$2" body="$3" keep="$4" avail w i
  if [ "$pad" -gt 0 ]; then
    # A leader wider than LEADER_W is paid for out of the TEXT, never out of the row - that is what keeps the "·" in one column when the account glyph grows its expiry "!".
    avail=$((pad - lead_extra))
    [ "$avail" -lt 1 ] && avail=1
    if [ "${#body}" -gt "$avail" ] && [ "$avail" -gt 0 ]; then
      if [ "$keep" = tail ]; then
        body="$ELLIPSIS${body: -$((avail - 1))}"
      else
        body="${body:0:$((avail - 1))}$ELLIPSIS"
      fi
      w=$avail
    else
      w=${#body}
    fi
    i=$((avail - w))
    while [ "$i" -gt 0 ]; do
      body="$body "
      i=$((i - 1))
    done
  fi
  # C_TEXT is re-armed after the leader: the account glyph carries its own colour and reset, which would otherwise bleach the ref behind it.
  printf '%s%s%s%s%s' "$C_TEXT" "$pre" "$C_TEXT" "$body" "$C_RESET"
  [ "$trailing_sep" = 1 ] && printf '%s ·%s' "$C_DIM" "$C_RESET"
  return 0
}

if [ "$mode" = git-ref ]; then
  [ -n "$ref" ] || exit 0
  # 🏢/🏠 rendered HERE rather than as its own widget so one process owns row 2's leader: near token expiry the glyph grows a "!", and only the process that also sizes the text can take that column back.
  lead='   ' lead_w=$LEADER_W
  if [ "$account_glyph" = 1 ]; then
    # Handed $dir explicitly - ccstatusline never sets a widget's cwd, so the glyph's own path rule would read Claude Code's launch directory.
    g="$("$HOME/.local/bin/claude-account-glyph" "$dir" 2>/dev/null)"
    # Measured, never ${#g}: the emoji is 2 columns of multibyte and the "!" arrives wrapped in ANSI.
    if [ -n "$g" ]; then
      lead_w=3
      case "$g" in *'!'*) lead_w=4 ;; esac
      lead="$g "
    fi
  fi
  emit "$lead" $((lead_w - LEADER_W)) "$ref" head
  exit 0
fi

# 🌳 worktree, 🌿 plain repo - herdr's workspace-label vocabulary (mux/herdr/herdr-sesh-layout.sh), so a pane and the status line agree on what checkout you are in.
if [ "$glyph" = 1 ] && [ -n "$kind_glyph" ]; then
  emit "$kind_glyph " 0 "$d" tail
else
  emit '' 0 "$d" tail
fi
