# Linux counterpart of the macOS launchd agent `rex-tab-numbers`; numbers the dev-box server's tabs by position.
[Unit]
Description=Prefix Rex tabs with their position
After=rex-server.service
PartOf=rex-server.service

[Service]
Type=simple
ExecStart=/usr/bin/rex do --all %h/.local/bin/mux/rex/rex-tab-numbers.lua
Restart=always
RestartSec=10

[Install]
# Not default.target: rex-server is After=default.target, so that ordering cycle drops rex-server at boot.
WantedBy=rex-server.service
