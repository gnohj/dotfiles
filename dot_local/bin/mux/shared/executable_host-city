#!/usr/bin/env bash
# Prints "city-stateabbrev" (e.g. austin-tx) from the machine's public-IP
# geolocation, for the tmux host cell (host_short@city). Fully dynamic: when a
# box relocates (Dallas -> Atlanta) its public IP changes and this re-resolves
# on its own — nothing to edit. Cached ~5min so the status bar never forks a
# network call per refresh; on a network failure it prints the last known value.
# Cross-platform (macOS + Linux).

set -uo pipefail

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/host-city"
# Zone goes to a sibling file, never stdout: that is the tmux host cell's contract, split on "-".
TZ_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/host-tz"
# 5min, not 1h: an exit node flipping changes egress geo instantly.
TTL=300

# GNU stat first: its -f means "filesystem", not "format", so the BSD probe
# `stat -f %m` does NOT fail cleanly on Linux - it prints filesystem info
# ("File: ...") to stdout AND exits 1, so the || fallback appended a valid
# mtime to that garbage and the caller's $(( )) blew up under set -u. BSD stat
# has no -c at all, so it errors silently to stderr and falls through.
file_mtime() {
  local m
  m="$(stat -c %Y "$1" 2>/dev/null)" || m="$(stat -f %m "$1" 2>/dev/null)" || m=0
  case "$m" in '' | *[!0-9]*) m=0 ;; esac
  printf '%s' "$m"
}

# Fresh cache -> print it, skip the network. A missing zone counts as stale so old installs backfill.
if [ -f "$CACHE" ] && [ -f "$TZ_CACHE" ] && [ "$(( $(date +%s) - $(file_mtime "$CACHE") ))" -lt "$TTL" ]; then
  cat "$CACHE"
  exit 0
fi

# ipinfo over HTTPS (ip-api put Austin AT&T IPs in Woodway); sed, not jq, which bare tmux PATH lacks.
resp="$(curl -sf --max-time 4 'https://ipinfo.io/json' 2>/dev/null || true)"
val() { printf '%s' "$resp" | sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p" | head -n 1; }

# ipinfo gives the full state name; a function keeps the case out of $( ) for bash 3.2.
us_state_abbrev() {
  case "$1" in
    Alabama) echo AL ;; Alaska) echo AK ;; Arizona) echo AZ ;; Arkansas) echo AR ;;
    California) echo CA ;; Colorado) echo CO ;; Connecticut) echo CT ;; Delaware) echo DE ;;
    "District of Columbia") echo DC ;; Florida) echo FL ;; Georgia) echo GA ;; Hawaii) echo HI ;;
    Idaho) echo ID ;; Illinois) echo IL ;; Indiana) echo IN ;; Iowa) echo IA ;;
    Kansas) echo KS ;; Kentucky) echo KY ;; Louisiana) echo LA ;; Maine) echo ME ;;
    Maryland) echo MD ;; Massachusetts) echo MA ;; Michigan) echo MI ;; Minnesota) echo MN ;;
    Mississippi) echo MS ;; Missouri) echo MO ;; Montana) echo MT ;; Nebraska) echo NE ;;
    Nevada) echo NV ;; "New Hampshire") echo NH ;; "New Jersey") echo NJ ;; "New Mexico") echo NM ;;
    "New York") echo NY ;; "North Carolina") echo NC ;; "North Dakota") echo ND ;; Ohio) echo OH ;;
    Oklahoma) echo OK ;; Oregon) echo OR ;; Pennsylvania) echo PA ;; "Rhode Island") echo RI ;;
    "South Carolina") echo SC ;; "South Dakota") echo SD ;; Tennessee) echo TN ;; Texas) echo TX ;;
    Utah) echo UT ;; Vermont) echo VT ;; Virginia) echo VA ;; Washington) echo WA ;;
    "West Virginia") echo WV ;; Wisconsin) echo WI ;; Wyoming) echo WY ;;
    *) echo "$2" ;;
  esac
}

city=""
zone=""
if [ -n "$(val city)" ]; then
  city="$(printf '%s-%s' "$(val city)" "$(us_state_abbrev "$(val region)" "$(val country)")" \
    | tr 'A-Z ' 'a-z-' \
    | tr -cd 'a-z0-9-')"
  # Charset-clamped like the city above: this is remote data that lands on disk.
  zone="$(val timezone | tr -cd 'A-Za-z0-9/_+-')"
fi

if [ -n "$city" ] && [ "$city" != "-" ]; then
  mkdir -p "$(dirname "$CACHE")"
  printf '%s' "$city" >"$CACHE"
  # Only ever written next to a good city, so the two never describe different places.
  [ -n "$zone" ] && printf '%s' "$zone" >"$TZ_CACHE"
  printf '%s' "$city"
elif [ -f "$CACHE" ]; then
  cat "$CACHE"   # network failed -> last known location
fi
