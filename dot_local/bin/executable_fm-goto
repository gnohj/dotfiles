#!/usr/bin/env bash
# Route `fm` to the pane holding state/.lock rather than spawning a rival that takes it. Exit 0 = routed; exit 1 = launch here.
set -eu

root="${FIRSTMATE_DIR:-$HOME/Developer/firstmate}"
home="${FM_HOME:-$HOME/.local/share/firstmate}"

# The lock outlives its holder and pids get reused, so a live primary is a live lock pid sitting in the code root.
lockpid=""
[ -r "$home/state/.lock" ] && read -r lockpid <"$home/state/.lock" || true
if [ -n "$lockpid" ]; then
  if [ -d "/proc/$lockpid" ]; then
    cwd="$(readlink "/proc/$lockpid/cwd" 2>/dev/null)" || cwd=""
  else
    cwd="$(lsof -a -p "$lockpid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')" || cwd=""
  fi
  [ "$cwd" = "$root" ] || lockpid=""
fi

primary_env() {
  if [ -r "/proc/$lockpid/environ" ]; then
    tr '\0' '\n' <"/proc/$lockpid/environ" | sed -n "s/^$1=//p" | head -n 1
  else
    ps eww -o command= -p "$lockpid" 2>/dev/null | tr ' ' '\n' | sed -n "s/^$1=//p" | head -n 1
  fi
}

rex_cli() {
  if [ -n "${REX_BIN_DIR:-}" ] && [ -x "$REX_BIN_DIR/rex" ]; then printf '%s' "$REX_BIN_DIR/rex"
  elif command -v rex >/dev/null 2>&1; then command -v rex
  elif [ -x "$HOME/.local/bin/rex" ]; then printf '%s' "$HOME/.local/bin/rex"
  else return 1
  fi
}

# A primary inside Rex owns its block outright: show its session and block, wherever this `fm` was typed.
if [ -n "$lockpid" ] && [ "$(primary_env TERM_PROGRAM)" = rex ]; then
  block="$(primary_env REX_BLOCK)"
  [ -n "$block" ] && [ "$block" = "${REX_BLOCK:-}" ] && exit 1
  if rex="$(rex_cli)"; then
    session=$("$rex" --autostart=false session inspect "$block" --json 2>/dev/null | jq -r '.session_id // empty')
    "$rex" --autostart=false do session.select "session_id=$session" >/dev/null 2>&1 || true
    "$rex" --autostart=false focus -s "$block" "$block" >/dev/null 2>&1 || true
  fi
  echo "fm: the fleet is already sailing in Rex block $block - focused it." >&2
  echo "fm: to browse or edit it from here instead, run: fm-compass" >&2
  exit 0
fi

# A primary outside Rex has no pane to focus, but still must not get a rival.
[ -n "$lockpid" ] || exit 1
echo "fm: the fleet is already sailing as pid $lockpid outside this multiplexer - not starting a second primary." >&2
exit 0
