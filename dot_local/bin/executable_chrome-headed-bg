#!/usr/bin/env bash
set -uo pipefail

[ "$(uname -s)" = Darwin ] || exit 0

APP="${CHROME_HEADED_BG_APP:-Google Chrome}"
APP_BUNDLE_ID="${CHROME_HEADED_BG_BUNDLE_ID:-com.google.Chrome}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chrome-headed-bg"
PROFILE_ROOT="$HOME/.cache/chrome-headed-bg"
PORT_LO="${CHROME_HEADED_BG_PORT_LO:-9300}"
PORT_HI="${CHROME_HEADED_BG_PORT_HI:-9399}"
READY_TIMEOUT="${CHROME_HEADED_BG_TIMEOUT:-20}"
SELF="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
GUARD="$(dirname "$SELF")/chrome-cdp-guard"

die() { printf 'chrome-headed-bg: %s\n' "$1" >&2; exit "${2:-1}"; }

# One shell word, and it interpolates into an rm -rf path, so anything else is refused rather than sanitized.
check_name() {
  case "${1:-}" in
    '' | . | .. | *[!A-Za-z0-9._-]*) die "invalid name: ${1:-<empty>}" 2 ;;
  esac
}

profile_dir() { printf '%s/%s' "$PROFILE_ROOT" "$1"; }
port_file() { printf '%s/%s' "$STATE_DIR" "$1"; }

listening() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

# Both the port AND our profile: another Chrome (or `to-desktop browser-debug`) answering that port is not ours to drive or kill.
pids_for() {
  pgrep -f -- "--remote-debugging-port=$2" 2>/dev/null | while read -r p; do
    ps -o command= -p "$p" 2>/dev/null | grep -qF -- "--user-data-dir=$(profile_dir "$1")" && printf '%s\n' "$p"
  done
}

guard_pids() { pgrep -f -- "chrome-cdp-guard $1 " 2>/dev/null; }

# The state file holds "<guard port> <chrome port>"; a one-port file predates the guard and is Chrome's own.
read_ports() {
  pub="" int=""
  { read -r pub int <"$(port_file "$1")"; } 2>/dev/null || true
  case "$pub" in '' | *[!0-9]*) pub="" ;; esac
  case "$int" in '' | *[!0-9]*) int="" ;; esac
}

alive() { [ -n "$(pids_for "$1" "$3")" ] && [ -n "$(guard_pids "$2")" ] && listening "$2"; }

free_port() {
  local p="$PORT_LO"
  while [ "$p" -le "$PORT_HI" ]; do
    [ "$p" = "${1:-}" ] || listening "$p" || { printf '%s' "$p"; return 0; }
    p=$((p + 1))
  done
  return 1
}

# A driver navigates away from about:blank at once, so match the profile dir, never the window title.
AUTOMATION_WORKSPACE="${CHROME_HEADED_BG_WORKSPACE:-P}"

RIFT=/opt/homebrew/bin/rift-cli

# Prints "<window-server-id>|<rift-id-json>|<bundle-id>" for the focused window, or nothing.
focused_window() {
  "$RIFT" query workspaces 2>/dev/null |
    /usr/bin/jq -r 'first(.[].windows[] | select(.is_focused)) | "\(.window_server_id)|\(.id | tojson)|\(.bundle_id)"' 2>/dev/null
}

park_windows() {
  # Every instance under the profile root: each review starts its own Chrome process.
  local pids wsid pid index
  [ -x "$RIFT" ] || return 0
  pids="$(pgrep -f -- "--user-data-dir=$PROFILE_ROOT/" 2>/dev/null | tr '\n' ' ')"
  [ -n "$pids" ] || return 0
  index=$(( $(printf '%d' "'$AUTOMATION_WORKSPACE") - 65 ))
  while read -r wsid pid; do
    case " $pids " in
      *" $pid "*) "$RIFT" execute workspace move-window "$index" "$wsid" >/dev/null 2>&1 || true ;;
    esac
  done < <("$RIFT" query workspaces 2>/dev/null | /usr/bin/jq -r '.[].windows[] | "\(.window_server_id) \(.id.pid)"' 2>/dev/null)
}

watch_focus() {
  local prev="$1" deadline cur prev_wsid prev_id prev_bundle
  [ -n "$prev" ] && [ -x "$RIFT" ] || return 0
  IFS='|' read -r prev_wsid prev_id prev_bundle <<< "$prev"
  [ "$prev_bundle" = "$APP_BUNDLE_ID" ] && return 0
  deadline=$((SECONDS + READY_TIMEOUT + 5))
  while [ "$SECONDS" -lt "$deadline" ]; do
    cur="$(focused_window)"
    [ "${cur##*|}" = "$APP_BUNDLE_ID" ] &&
      "$RIFT" execute window focus --window-id "$prev_id" --window-server-id "$prev_wsid" >/dev/null 2>&1
    sleep 0.05
  done
}

launch() {
  local name="$1" pub="$2" port="$3" profile prev_window
  prev_window="$(focused_window)"
  profile="$(profile_dir "$name")"
  mkdir -p "$profile"
  watch_focus "$prev_window" >/dev/null 2>&1 &
  /usr/bin/open -gj -na "$APP" --args \
    --remote-debugging-port="$port" \
    --user-data-dir="$profile" \
    --no-first-run \
    --no-default-browser-check \
    --mute-audio \
    --disable-features=CalculateNativeWinOcclusion \
    --disable-backgrounding-occluded-windows \
    --disable-renderer-backgrounding \
    about:blank || return 1
  local i=0
  while [ "$i" -lt "$((READY_TIMEOUT * 4))" ]; do
    if curl -fsS --max-time 1 -o /dev/null "http://127.0.0.1:$port/json/version" 2>/dev/null ||
      curl -fsS --max-time 1 -o /dev/null "http://[::1]:$port/json/version" 2>/dev/null; then
      ( sleep 1; park_windows ) >/dev/null 2>&1 &
      break
    fi
    sleep 0.25
    i=$((i + 1))
  done
  [ "$i" -lt "$((READY_TIMEOUT * 4))" ] || return 1
  # Drivers only ever see the guard, which refuses the CDP calls that raise Chrome and parks every new window.
  nohup node "$GUARD" "$pub" "$port" "$SELF" park >/dev/null 2>&1 &
  i=0
  while [ "$i" -lt 20 ]; do
    curl -fsS --max-time 1 -o /dev/null "http://127.0.0.1:$pub/json/version" 2>/dev/null && return 0
    sleep 0.25
    i=$((i + 1))
  done
  return 1
}

ensure() {
  local name="$1" pub int
  mkdir -p "$STATE_DIR"
  command -v node >/dev/null 2>&1 || die "node is not on PATH, so no focus guard; refusing a Chrome that could steal focus"
  read_ports "$name"
  if [ -n "$pub" ] && [ -n "$int" ] && alive "$name" "$pub" "$int"; then
    printf 'http://127.0.0.1:%s\n' "$pub"
    return 0
  fi
  stop "$name"
  pub="$(free_port)" || die "no free port in $PORT_LO-$PORT_HI"
  int="$(free_port "$pub")" || die "no free port in $PORT_LO-$PORT_HI"
  if ! launch "$name" "$pub" "$int"; then
    printf '%s %s\n' "$pub" "$int" >"$(port_file "$name")"
    stop "$name"
    die "$APP or its focus guard never answered CDP on port $pub"
  fi
  printf '%s %s\n' "$pub" "$int" >"$(port_file "$name")"
  printf 'http://127.0.0.1:%s\n' "$pub"
}

url_of() {
  local name="$1" pub int
  read_ports "$name"
  [ -n "$pub" ] && [ -n "$int" ] || return 1
  alive "$name" "$pub" "$int" || return 1
  printf 'http://127.0.0.1:%s\n' "$pub"
}

stop() {
  local name="$1" pub int profile p i=0
  read_ports "$name"
  profile="$(profile_dir "$name")"
  if [ -n "$pub" ]; then
    int="${int:-$pub}"
    for p in $(pids_for "$name" "$int") $(guard_pids "$pub"); do kill "$p" 2>/dev/null; done
    # Chrome writes its profile all the way down, so removing it mid-exit leaves half a tree and a directory-not-empty per entry. Wait it out.
    while [ "$i" -lt 40 ] && [ -n "$(pids_for "$name" "$int")" ]; do
      sleep 0.25
      i=$((i + 1))
    done
  fi
  rm -f "$(port_file "$name")"
  # Guarded: an empty name would have made this the whole cache root.
  if [ -n "$name" ] && [ -d "$profile" ]; then
    rm -rf "$profile" 2>/dev/null || { sleep 1; rm -rf "$profile" 2>/dev/null; }
  fi
  return 0
}

list() {
  local f name url
  [ -d "$STATE_DIR" ] || return 0
  for f in "$STATE_DIR"/*; do
    [ -f "$f" ] || continue
    name="${f##*/}"
    if url="$(url_of "$name")"; then
      printf '%s\t%s\n' "$name" "$url"
    else
      rm -f "$f"
    fi
  done
}

cmd="${1:-}"
case "$cmd" in
  ensure)
    check_name "${2:-}"
    ensure "$2"
    ;;
  env)
    check_name "${2:-}"
    u="$(ensure "$2")" || exit 1
    # Both drivers attach instead of launching; the third is our own chrome-devtools-mcp-launch wrapper.
    printf 'export CHROME_DEVTOOLS_AXI_BROWSER_URL=%s PLAYWRIGHT_MCP_CDP_ENDPOINT=%s AGENT_BROWSER_CDP_URL=%s\n' "$u" "$u" "$u"
    ;;
  url)
    check_name "${2:-}"
    url_of "$2"
    ;;
  stop)
    check_name "${2:-}"
    stop "$2"
    ;;
  list) list ;;
  park) park_windows ;;
  *)
    echo "usage: chrome-headed-bg {ensure|env|url|stop} <name> | list | park" >&2
    exit 2
    ;;
esac
