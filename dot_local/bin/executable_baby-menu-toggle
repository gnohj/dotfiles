#!/usr/bin/env bash
set -euo pipefail

running=false
if pgrep -f -x '/Applications/Baby Menu Sidebar.app/Contents/MacOS/Baby Menu Sidebar' >/dev/null 2>&1; then
  running=true
fi

click_tray() {
  /usr/bin/osascript <<'APPLESCRIPT'
tell application "System Events"
  tell process "Baby Menu Sidebar"
    repeat with candidateBar in menu bars
      repeat with candidateItem in menu bar items of candidateBar
        set itemDescription to ""
        set itemTitle to ""
        try
          set itemDescription to description of candidateItem
        end try
        try
          set itemTitle to title of candidateItem
        end try
        if itemDescription contains "baby-menu" or itemDescription is "status menu" or itemTitle contains "baby-menu" then
          click candidateItem
          return
        end if
      end repeat
    end repeat
  end tell
end tell
error "baby-menu tray item is unavailable"
APPLESCRIPT
}

if ! $running; then
  exec /usr/bin/open --env BABY_MENU_OPEN_POPOVER_ON_START=1 -a "/Applications/Baby Menu Sidebar.app"
fi

# SIGUSR2 toggles in-app in ~10ms; the System Events click below costs ~300ms and stays as the fallback.
if pkill -USR2 -f -x '/Applications/Baby Menu Sidebar.app/Contents/MacOS/Baby Menu Sidebar' 2>/dev/null; then
  exit 0
fi

for attempt in {1..12}; do
  if click_tray 2>/dev/null; then
    exit 0
  fi
  sleep 0.2
done

click_tray
