#!/usr/bin/env bash
# The OTHER account's rate-limit headroom: 🏢 5h:61% 7d:14%
#
# Row 2 shows the session payload's numbers, which only ever describe the account THIS session authenticated as - so work quota is invisible from a personal pane and vice versa. This fills that hole from claude-account's cross-account cache.
#
# A `custom-command` widget with preserveColors=true, sharing claude-usage-pct's palette and 70/90 thresholds.
#
# Prints nothing when the other account has no stored token or has never been measured, so the row collapses instead of showing a placeholder.

# Mirrors claude-account's precedence (env > pin > path), same reason as claude-account-glyph: a personal session leaves CLAUDE_ACCOUNT unset by design, so the path rule alone would mislabel a pinned-personal pane in a work repo.
acct="${CLAUDE_ACCOUNT:-}"
pin="$HOME/.local/state/claude/account-override"
[ -z "$acct" ] && [ -r "$pin" ] && acct="$(tr -d '[:space:]' <"$pin")"
case "$acct" in
personal | work) ;;
*) case "$PWD" in */Developer/web* | */Developer/inferno* | */Developer/actions* | */.treehouse/*) acct=work ;; *) acct=personal ;; esac ;;
esac

case "$acct" in
work) other=personal glyph='🏠' ;;
*) other=work glyph='🏢' ;;
esac

# Serves cache and refreshes in the background - never blocks the render.
IFS=$'\t' read -r stamp five _ seven _ < <("$HOME/.local/bin/claude-account" usage "$other" 2>/dev/null) || true
[ -n "${five:-}" ] && [ -n "${seven:-}" ] || exit 0

green="#b7ce97"
warn="#c0aed2"
red="#da858e"
dim="#536571"
active="$HOME/.config/colorscheme/active/active-colorscheme.sh"
if [ -r "$active" ]; then
  # shellcheck disable=SC1090
  . "$active" >/dev/null 2>&1
  green="${gnohj_color02:-$green}"
  warn="${gnohj_color01:-$warn}"
  red="${gnohj_color11:-$red}"
  dim="${gnohj_color08:-$dim}"
fi

now="$(printf '%(%s)T' -1 2>/dev/null || true)"
case "$now" in '' | *[!0-9]*) now="$(date +%s)" ;; esac
case "$stamp" in '' | *[!0-9]*) stamp=0 ;; esac
# A tilde marks numbers the last fetch failed to renew (offline, rejected token), so a frozen reading never reads as a live one.
age_mark=""
[ "$((now - stamp))" -gt 900 ] && age_mark="~"

# The API sends utilization as a 0-1 float (0.03 -> "3%"); rounding matches claude-usage-pct so the two rows read alike.
render() {
  awk -v u="$1" -v g="$green" -v w="$warn" -v r="$red" 'BEGIN {
    p = u * 100
    c = (p >= 90 ? r : (p >= 70 ? w : g))
    s = sprintf("%.1f", p)
    sub(/\.0$/, "", s)
    printf "%s\t%s", c, s
  }'
}

esc() { printf '\033[38;2;%d;%d;%dm' "$((16#${1:1:2}))" "$((16#${1:3:2}))" "$((16#${1:5:2}))"; }

IFS=$'\t' read -r hex5 pct5 < <(render "$five")
IFS=$'\t' read -r hex7 pct7 < <(render "$seven")

# No trailing space: ccstatusline trims widget output, so gaps come from its own `defaultPadding`.
d="$(esc "$dim")"
printf '%s%s%s 5h:%s%s%%%s 7d:%s%s%%\033[0m' \
  "$d" "$age_mark" "$glyph" \
  "$(esc "$hex5")" "$pct5" "$d" \
  "$(esc "$hex7")" "$pct7"
