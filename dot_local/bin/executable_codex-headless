#!/usr/bin/env bash
set -euo pipefail

# mise's real binary, not ~/.local/bin/codex: a stale VPS wrapper there pins an older codex.
codex_bin="$(mise which codex 2>/dev/null || command -v codex || true)"

dir="$PWD"
skill=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) dir="$2"; shift 2 ;;
    --command) skill="$2"; shift 2 ;;
    --) shift; break ;;
    *) printf 'codex-headless: unknown argument: %s\n' "$1" >&2; exit 64 ;;
  esac
done
[ -n "$skill" ] || { printf '%s\n' 'codex-headless: --command <skill> is required' >&2; exit 64; }
case "$skill" in *[!A-Za-z0-9._-]*) printf 'codex-headless: invalid skill name: %s\n' "$skill" >&2; exit 64 ;; esac

prompt="Run the \$$skill skill non-interactively and finish without asking questions."
[ $# -gt 0 ] && prompt="$prompt Arguments: $*"

# A Codex refusal (no subscription, login, quota, 5xx) reruns the same skill on Claude instead of failing every tick.
run_on_claude() {
  printf 'codex-headless: %s, running %s on Claude instead\n' "$1" "$skill" >&2
  rm -f "${log:-}"
  cd "$dir"
  eval "$("$HOME/.local/bin/claude-account" env)"
  local ask="Run the /$skill skill non-interactively and finish without asking questions."
  [ $# -gt 1 ] && ask="$ask Arguments: $2"
  exec "$HOME/.local/bin/claude" -p --dangerously-skip-permissions --model claude-sonnet-5-5 --effort medium "$ask" </dev/null
}
args="$*"
[ -n "$codex_bin" ] || run_on_claude "codex is unavailable" "$args"

log="$(mktemp "${TMPDIR:-/tmp}/codex-headless.XXXXXX")"
trap 'rm -f "$log"' EXIT
# Skills write thread state and vault notes outside the workdir, so the workspace sandbox is too narrow.
set +e
"$codex_bin" exec \
  --skip-git-repo-check \
  --cd "$dir" \
  --model gpt-6-luna \
  -c 'model_reasoning_effort="xhigh"' \
  --sandbox danger-full-access \
  "$prompt" </dev/null 2>&1 | tee "$log"
rc=${PIPESTATUS[0]}
set -e
[ "$rc" -eq 0 ] && exit 0
refusal="$(grep -iE 'unexpected status|unauthori|forbidden|not logged in|quota|usage limit|rate limit|subscription|credits|overloaded' "$log" | tail -n1 | cut -c1-160)"
[ -n "$refusal" ] && run_on_claude "codex refused (exit $rc: $refusal)" "$args"
exit "$rc"
