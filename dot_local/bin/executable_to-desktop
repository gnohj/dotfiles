#!/usr/bin/env bash
# to-desktop <verb> [args] — land an effect on the machine you are sitting at.
# usage: to-desktop open <url> | to-desktop clip <text|-> | to-desktop paste | to-desktop paste-image | to-desktop notify <title> <message> | to-desktop browser-debug | to-desktop active-tab
#
# One file is sender, receiver, and (as --forced) the restricted ssh entry point, because chezmoi
# deploys it to every machine. Machine routing only - which multiplexer is live is `mux`'s question.
#
# Deliberately not named to-mac: the workstation is whichever machine is NOT relaying elsewhere, so a
# future Linux desktop is a workstation too. `devbox` is the only relaying role machine-identity has.
#
# Direction is resolved per call by machine-identity. Transports: ssh forced-command, kitty rc, OSC 52.
set -uo pipefail

export PATH="$HOME/.local/bin:/run/current-system/sw/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

die() { printf 'to-desktop: %s\n' "$1" >&2; exit "${2:-1}"; }

# Only http(s) may cross: an unvalidated scheme handed to a URL opener is a file:// / x-apple:// hole.
valid_url() { case "${1:-}" in http://?* | https://?*) return 0 ;; *) return 1 ;; esac; }

# DESKTOP_OS is stamped by kitty-remote-quake.sh; its presence means someone upstream owns the display. Rest is fallback for a bare ssh.
at_desktop() {
  [ -n "${DESKTOP_OS:-}" ] && return 1
  [ "$("$HOME/.local/bin/machine-identity" role 2>/dev/null || echo mac)" = devbox ] && return 1
  case "$(uname -s)" in
    Darwin) return 0 ;;
    *) [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] ;;
  esac
}

# herdr relays OSC 52 as a protocol-level clipboard write, so this reaches the workstation even over --remote.
osc_clip() { printf '\033]52;c;%s\a' "$(printf '%s' "$1" | base64 | tr -d '\n')"; }

do_open() {
  case "$(uname -s)" in
    Darwin) open "$1" ;;
    # BROWSER unset: it names desktop-open, which calls back here, so xdg-open honoring it would ping-pong.
    *) (env -u BROWSER xdg-open "$1" >/dev/null 2>&1 &) || die "no URL opener (xdg-open)" ;;
  esac
}

do_clip() {
  if command -v pbcopy >/dev/null 2>&1; then printf '%s' "$1" | pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then printf '%s' "$1" | wl-copy
  elif command -v xclip >/dev/null 2>&1; then printf '%s' "$1" | xclip -selection clipboard
  else osc_clip "$1"; fi
}

# Read side of do_clip. No OSC 52 tier: the escape protocol is write-only.
do_paste() {
  if command -v pbpaste >/dev/null 2>&1; then pbpaste
  elif command -v wl-paste >/dev/null 2>&1; then wl-paste --no-newline
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard -o
  else die "paste: no clipboard reader on the workstation"
  fi
}

# base64, not raw bytes: a PNG's NULs would not survive the caller's command substitution.
do_paste_image() {
  if command -v pngpaste >/dev/null 2>&1; then pngpaste - 2>/dev/null | base64
  elif command -v wl-paste >/dev/null 2>&1; then wl-paste --type image/png 2>/dev/null | base64
  fi
  return 0
}

# Fixed argv, no caller input: the restricted ssh key reaches this, so nothing may interpolate.
do_browser_debug() {
  [ "$(uname -s)" = Darwin ] || die "browser-debug: workstation is not macOS"
  lsof -nP -iTCP:9222 -sTCP:LISTEN >/dev/null 2>&1 && return 0
  open -na 'Google Chrome' --args --remote-debugging-port=9222 --user-data-dir="$HOME/.cache/chrome-cdp-profile"
}

# Fixed argv, no caller input: the browser list is hardcoded, so the restricted key can't steer the query.
do_active_tab() {
  [ "$(uname -s)" = Darwin ] || die "active-tab: workstation is not macOS"
  local app short url
  for app in "Google Chrome" "Helium" "Brave Browser"; do
    case "$app" in
      "Google Chrome") short=Chrome ;;
      "Helium") short=Helium ;;
      "Brave Browser") short=Brave ;;
    esac
    # `exists process` first: asking a closed browser for its URL would launch it.
    url=$(osascript <<APPLESCRIPT 2>/dev/null
tell application "System Events"
  if not (exists process "$app") then return ""
end tell
tell application "$app"
  if (count of windows) is 0 then return ""
  return URL of active tab of front window
end tell
APPLESCRIPT
    )
    # Same rule as `open`: only http(s) may cross, so a file:// tab never leaves the workstation.
    valid_url "$url" || continue
    printf '%s\t%s\n' "$short" "$url"
  done
  return 0
}

# active-tab / paste / paste-image need a value back, so unlike open/clip/notify they can't ride the tty: OSC 52 and kitty rc are one-way.
relay_read() {
  local host
  host="$(relay_host)"
  [ -n "$host" ] || die "$1: nobody is attached to relay to"
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$host" "$1"
}

do_notify() {
  if command -v mac-notify >/dev/null 2>&1; then mac-notify -t "$1" -m "$2" -T 5 2>/dev/null
  elif command -v notify-send >/dev/null 2>&1; then notify-send "$1" "$2" 2>/dev/null
  else printf '%s: %s\n' "$1" "$2"; fi
}

# Relaying a loopback url would open the WORKSTATION's loopback, where nothing is listening.
box_local_url() {
  local host
  host="${1#*://}"; host="${host%%/*}"; host="${host%%\?*}"; host="${host##*@}"
  case "$host" in \[*\]*) host="${host#\[}"; host="${host%%\]*}" ;; *) host="${host%%:*}" ;; esac
  case "$host" in localhost | 127.*.*.* | ::1) return 0 ;; esac
  # 127.0.0.1 only: Debian parks this box's own name on 127.0.1.1, which IS reachable over MagicDNS.
  awk -v h="$host" '$1 == "127.0.0.1" || $1 == "::1" { for (i = 2; i <= NF; i++) if ($i == h) { found = 1; exit } } END { exit found ? 0 : 1 }' /etc/hosts
}

relay_host() { "$HOME/.local/bin/machine-identity" mac-host 2>/dev/null; }

# Transport 1: the workstation runs no daemon, but authorized_keys pins this key to `--forced`, so ssh is the listener.
relay() {
  local host arg
  host="$(relay_host)"
  [ -n "$host" ] || return 1
  # Refused, not quoted: the forced entry re-splits on whitespace, so such an arg would arrive torn in half.
  for arg in "$@"; do
    case "$arg" in *[[:space:]]* | *[[:cntrl:]]*) return 1 ;; esac
  done
  ssh -o BatchMode=yes -o ConnectTimeout=3 "$host" "$@" >/dev/null 2>&1
}

# Transport 2: kitty's rc escape up the tty we already have. Only `open` is offered; rc-auth.py rejects the rest.
ship() {
  [ "$1" = open ] || return 1
  case "${TERM:-}" in xterm-kitty) ;; *) return 1 ;; esac
  # Refused, not escaped: a quote or backslash would let a hostile url rewrite the JSON.
  case "$2" in *[\"\\]* | *[[:space:]]* | *[[:cntrl:]]*) return 1 ;; esac
  printf '\033P@kitty-cmd{"cmd":"launch","version":[0,26,0],"no_response":true,"payload":{"args":["open","%s"],"type":"background"}}\033\\' "$2" >/dev/tty 2>/dev/null || return 1
}

verb="${1:-}"; [ -n "$verb" ] || die "missing verb (open | clip | paste | paste-image | notify | browser-debug | active-tab)" 2
shift

# Restricted ssh entry: authorized_keys forces this, so $SSH_ORIGINAL_COMMAND is re-parsed against the same verbs.
if [ "$verb" = --forced ]; then
  # noglob: word-splitting is wanted, but a `?` in a query string must not expand against the cwd.
  set -f
  # shellcheck disable=SC2086
  set -- ${SSH_ORIGINAL_COMMAND:-}
  verb="${1:-}"; [ -n "$verb" ] || die "forced: empty command" 2
  shift
  # SAFETY: paste/paste-image hand the workstation's whole clipboard to the key holder, one step wider than active-tab.
  case "$verb" in open | clip | paste | paste-image | notify | browser-debug | active-tab) ;; *) die "forced: verb not permitted: $verb" 2 ;; esac
  at_desktop || die "forced mode only runs on the workstation" 2
fi

case "$verb" in
  open)
    url="${1:?to-desktop open: missing <url>}"
    valid_url "$url" || die "refusing non-http(s) url: $url" 2
    if at_desktop; then
      do_open "$url"
    elif box_local_url "$url"; then
      die "refusing box-local url: $url would open the workstation's loopback, not this box's server - forward the port first (LocalForward in the Mac's 'Host dev-box' block)"
    elif ! relay open "$url" && ! ship open "$url"; then
      # Nobody attached: park it on the workstation's clipboard, since a browser here would be headless.
      osc_clip "$url"
      mux notify --title "🔗 to-desktop" "URL copied to your desktop - paste to open" 2>/dev/null ||
        printf 'copied to desktop clipboard: %s\n' "$url"
    fi
    ;;
  clip)
    text="${1:?to-desktop clip: missing <text|->}"
    [ "$text" = - ] && text="$(cat)"
    if at_desktop; then do_clip "$text"; else ship clip "$text" || osc_clip "$text"; fi
    ;;
  paste)
    if at_desktop; then do_paste; else relay_read paste; fi
    ;;
  paste-image)
    if at_desktop; then do_paste_image; else relay_read paste-image; fi
    ;;
  notify)
    title="${1:?to-desktop notify: missing <title>}"; msg="${2:?to-desktop notify: missing <message>}"
    if at_desktop; then do_notify "$title" "$msg"; else ship notify "$title" "$msg" || mux notify --title "$title" "$msg"; fi
    ;;
  browser-debug)
    at_desktop || die "browser-debug only runs on the workstation" 2
    do_browser_debug
    ;;
  active-tab)
    if at_desktop; then do_active_tab; else relay_read active-tab; fi
    ;;
  *) die "unknown verb '$verb' (open | clip | paste | paste-image | notify | browser-debug | active-tab)" 2 ;;
esac
