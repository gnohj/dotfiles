{{- $pal := includeTemplate "palette.json" . | fromJson -}}
# LazyDocker configuration with custom colors
# Auto-generated lazydocker config
# Docs: https://github.com/jesseduffield/lazydocker/blob/master/docs/Config.md
gui:
  scrollHeight: 2
  language: 'en'
  theme:
    activeBorderColor:
      - '{{ $pal.color02 }}'
      - bold
    inactiveBorderColor:
      - '{{ $pal.color03 }}'
    selectedLineBgColor:
      - '{{ $pal.color49 }}'
    optionsTextColor:
      - '{{ $pal.color03 }}'
  border: rounded
  showAllContainers: false
  returnImmediately: false
  wrapMainPanel: true
reporting: 'off'
confirmOnQuit: false
