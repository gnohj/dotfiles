#!/usr/bin/env bash
# source: {{ include "dot_local/libexec/tasks-reminders.swift" | sha256sum }}
# Compiled, not `swift`-interpreted: that costs ~1.3s per run and a polling sync pays it repeatedly.
set -euo pipefail

[ "$(uname -s)" = Darwin ] || exit 0
command -v swiftc >/dev/null 2>&1 || { echo "tasks-reminders: no swiftc, skipping"; exit 0; }

SRC="$HOME/.local/libexec/tasks-reminders.swift"
OUT="$HOME/.local/libexec/tasks-reminders"

mkdir -p "$HOME/.local/libexec"
swiftc -O -o "$OUT" "$SRC"
echo "tasks-reminders: built $OUT"
