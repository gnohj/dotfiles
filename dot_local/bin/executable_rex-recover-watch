#!/usr/bin/env bash
# rex-recover-watch - runs the upstream rex-recover watcher from its ~/Developer clone with pinned paths.
set -euo pipefail

clone="$HOME/Developer/rex-recover"
[ -x "$clone/bin/rex-recover" ] || { echo "rex-recover-watch: no clone at $clone (run update)" >&2; exit 1; }

if [ "$(uname)" = Darwin ]; then
  rex="$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"
  [ -x "$rex" ] || rex=$("$HOME/.local/bin/rex-app" --cli)
else
  rex=/usr/bin/rex
fi

exec /bin/sh "$clone/bin/rex-recover" --rex "$rex" --config "${XDG_CONFIG_HOME:-$HOME/.config}/rex-recover/apps.conf" --state-dir "${XDG_STATE_HOME:-$HOME/.local/state}/rex-recover"
